      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">RaceRules</string>
          <string name="Source"><![CDATA[local Rules = {}

function Rules.crossing(previous, current, line, center, width, minY, maxY)
	if previous.Z >= line or current.Z < line then return nil end
	local fraction = (line-previous.Z)/(current.Z-previous.Z)
	local x = previous.X + (current.X-previous.X)*fraction
	local y = previous.Y + (current.Y-previous.Y)*fraction
	if math.abs(x-center) <= width and y >= (minY or 0.5) and y <= (maxY or 8.5) then return fraction end
	return nil
end

function Rules.slots(entrants)
	if entrants <= 1 then return entrants end
	return math.min(entrants - 1, math.ceil(entrants * 0.6))
end

function Rules.recordKey(level)
	return "knockout:" .. level
end

function Rules.complete(data, level, time, perfect, place, competitive)
	local record = Rules.recordKey(level)
	local personal = not data.records[record] or time < data.records[record]
	if personal then data.records[record] = time end
	local reward = 50 + (perfect and 25 or 0)
	if competitive then
		reward += ({100,75,50})[place] or 0
		if place == 1 then data.wins += 1 end
	end
	if data.unlocked == level then
		data.unlocked += 1
		if level == 5 then reward += 500 end
	end
	data.xp += 30 + (perfect and 10 or 0)
	data.coins += reward
	return reward, personal
end
return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">EggServer</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Courses</string>
          <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local Levels = require(Shared.Levels)
local Obstacles = require(script.Parent.Obstacles)

local Courses = {}
local rgb = Color3.fromHex
local v = Vector3.new
local ink, cream = rgb("151f26"), rgb("ffedca")
local red, amber = rgb("ff4c42"), rgb("ffc455")

local themes = {
	["Green Meadows"] = {deck="42573f", rim="eaa935", lane="e8c86e", hazard="ef6044", ground="56908a", rock="556548", sky="f6d6ad"},
	["The Egg Cooker"] = {deck="403738", rim="f89645", lane="ccb48f", hazard="ff582e", ground="cb4325", rock="342729", sky="fbb469"},
	["Frozen Eggs"] = {deck="2d6173", rim="97eee5", lane="b9edf2", hazard="f75f6a", ground="67aac3", rock="809eba", sky="a9e4ee"},
	["Eggstraterrestrial"] = {deck="252743", rim="b99cff", lane="86eed5", hazard="fa6e9e", ground="24253d", rock="322e57", sky="a898ff"},
	["Sunken Ruins"] = {deck="554d3e", rim="efb46b", lane="90ead8", hazard="af6a43", ground="2a7364", rock="645c49", sky="d6cbb0"},
}
for _, colors in themes do
	for name, hex in colors do colors[name] = rgb(hex) end
end

local function part(c, name, px, py, pz, size, color, solid, shape, angles)
	local cf = CFrame.new(c.x+px,py,c.z+pz)
	local p = Obstacles.part(c.model,name,size,angles and cf*angles or cf,color,solid == true,shape)
	if not solid then p.CanQuery = false end
	return p
end

local function deck(c, first, last, width, offset, top, color)
	return part(c,"Runway",offset or 0,(top or 0)-0.9,(first+last)/2,v(width,1.8,last-first),color or c.colors.deck,true)
end

local function light(c, name, px, py, pz, size, color)
	local p = part(c,name,px,py,pz,size,color)
	p.Material = Enum.Material.Neon
	return p
end

local function marking(c, z, width, top, color)
	part(c,"Tread edge",0,top+0.025,z,v(width,0.05,0.24),color)
end

local function plaque(c, text, px, py, pz, width, height, color)
	local board = part(c,"Course sign",px,py,pz,v(width,height,0.38),ink)
	for _, face in {Enum.NormalId.Front,Enum.NormalId.Back} do
		local surface = Instance.new("SurfaceGui",board)
		surface.Face = face
		surface.CanvasSize = Vector2.new(700,100)
		surface.LightInfluence = 0
		local words = Instance.new("TextLabel",surface)
		words.Size = UDim2.fromScale(0.94,0.8)
		words.Position = UDim2.fromScale(0.03,0.1)
		words.BackgroundTransparency = 1
		words.TextColor3 = color
		words.Font = Enum.Font.GothamBlack
		words.Text = text
		words.TextScaled = true
	end
end

local function gate(c, text, z, width, color)
	for _, side in {-1,1} do
		part(c,"Gate stanchion",side*(width/2+0.6),4,z,v(1.05,8,1.05),ink)
		light(c,"Gate tube",side*(width/2+0.6),4,z-0.58,v(0.26,7.2,0.12),color)
	end
	plaque(c,text,0,8,z,width+2.1,2.25,color)
end

local function footing(c, first, last, width)
	deck(c,first,last,width)
	marking(c,first+0.3,width-0.7,0,c.colors.lane)
end

local function obstacle(c, kind, x, y, z, phase, overrides)
	local stats = table.clone(overrides or {})
	local def = Obstacles.definitions[kind]
	if def.speed then stats.speed = (stats.speed or def.speed)*c.pace end
	stats.color = stats.color or c.colors.hazard
	return Obstacles.add(c,kind,v(c.x+x,y,c.z+z),phase,stats)
end

local function banks(c, z, finish, width, approach, landing)
	footing(c,z,z+approach,width)
	footing(c,z+finish-landing,z+finish,width)
	return finish, width
end

local function deckDots(c, x, z, width, y)
	for _, side in {-1,1} do
		local dotX = x+(width/2-0.5)*side
		light(c,"Edge bead",dotX,y+0.035,z,v(0.32,0.08,0.98),c.colors.rim)
	end
end

local function disc(c, x, z, radius, color)
	local orientation = CFrame.Angles(0,0,math.pi/2)
	part(c,"Circular perch",x,-0.65,z,v(1.3,radius*2,radius*2),color,true,Enum.PartType.Cylinder,orientation)
	part(c,"Perch trim",x,-0.93,z,v(0.24,radius*2+0.2,radius*2+0.2),c.colors.rim,false,Enum.PartType.Cylinder,orientation)
	for i=1,8 do
		local t=i*math.pi/4
		light(c,"Perch marker",x+(radius-0.5)*math.cos(t),0.025,z+(radius-0.5)*math.sin(t),v(0.5,0.08,0.5),c.colors.lane)
	end
end

local sections = {}

function sections.bumper(c,z,index)
	local width = 19
	deck(c,z,z+33,width)
	for i=1,3 do
		local row=z+4+i*6.7
		deckDots(c,0,row,width,0)
		obstacle(c,"ball",0,0,row,index*0.57+i*1.74,{size=v(7.2,7.2,7.2), range=8.2, speed=2.3})
	end
	return 33,width
end

function sections.punch(c,z,index)
	local width = 15
	deck(c,z,z+33,width)
	for i=1,3 do
		local row=z+3+i*7
		obstacle(c,"foam",0,0,row,index*0.78+i*2.09,{size=v(10.5,4.8,3.05),range=9.8,speed=2.06})
		for _, side in {-1,1} do
			part(c,"Piston housing",side*10.4,1.2,row,v(3.1,3.3,4.9),ink)
			light(c,"Piston stripe",side*9.85,3,row,v(0.5,0.12,3.4),c.colors.rim)
		end
	end
	return 33,width
end

function sections.steps(c,z,index)
	local width=15
	banks(c,z,50,width,5,5.8)
	for i=1,3 do
		local begin=z+9.4+(i-1)*11.55
		local px=(i%2==index%2 and -1 or 1)*(c.pace>1.1 and 3 or 2.4)
		local top=(i%2)*0.35
		deck(c,begin,begin+6.4,8.8,px,top,c.colors.deck)
		deckDots(c,px,begin+1,8.8,top)
		deckDots(c,px,begin+5.4,8.8,top)
	end
	return 50,width
end

function sections.spinners(c,z,index)
	local width=16
	banks(c,z,51,width,5.6,6)
	for i=1,2 do
		local px=(i%2==index%2 and -1 or 1)*1.2
		local row=z+15.9+(i-1)*18.6
		disc(c,px,row,7.5,c.colors.deck)
		obstacle(c,"sweep",px,0,row,index+i*2.3,{size=v(17.2,0.9,1.35),speed=2.22})
	end
	return 51,width
end

function sections.rafts(c,z,index)
	local width=16
	banks(c,z,45,width,6,6)
	for i=1,2 do
		obstacle(c,"moving",0,0,z+15.55+(i-1)*13.9,index+i*2.8,{
			size=v(11,1.4,9),range=2.7,speed=1.7,color=c.colors.rim,
		})
	end
	return 45,width
end

function sections.ferry(c,z,index)
	local width=17
	banks(c,z,43,width,7,9)
	obstacle(c,"moving",0,0,z+21,index*1.43,{
		size=v(11,1.4,10),axis=Vector3.zAxis,range=7.1,speed=1.22,color=c.colors.rim,
	})
	for _, side in {-1,1} do
		light(c,"Ferry track",side*6.7,-1.65,z+20.5,v(0.38,0.16,26.8),c.colors.lane)
		for i=1,3 do
			part(c,"Ferry track brace",side*6.7,-3.25,z+9+11*i,v(0.75,3.2,0.75),ink)
		end
	end
	return 43,width
end

function sections.tilts(c,z,index)
	local width=16
	banks(c,z,46,width,6,6)
	for i=1,2 do
		obstacle(c,"tilt",i%2==index%2 and -1.65 or 1.65,0,z+15.7+(i-1)*14.8,index+i*2.1,{
			size=v(8.4,1.4,9.6),range=0.36,pitch=0.09,speed=1.8,color=c.colors.rim,
		})
	end
	return 46,width
end

function sections.swing(c,z,index)
	local width=15
	deck(c,z,z+31,width)
	for i=1,2 do
		local row=z+5+i*8.1
		for _, side in {-1,1} do
			part(c,"Pendulum stanchion",side*9,8,row,v(1,16,1),ink)
		end
		part(c,"Pendulum crossbeam",0,16,row,v(19.5,1.15,1.15),ink)
		obstacle(c,"pendulum",0,0,row,index+i*2.3,{size=v(5.7,5.7,5.7),range=8.4,speed=2.08})
	end
	return 31,width
end

function sections.duel(c,z,index)
	local width=14.5
	deck(c,z,z+37,width)
	for _, side in {-1,1} do
		light(c,"Crack Zone edge",side*(width/2-0.3),0.04,z+18.5,v(0.34,0.09,26),red)
		for i=1,5 do
			part(c,"Warning hatch",side*(width/2-0.95),0.045,z+7.5+5.4*(i-1),v(1.3,0.07,0.24),amber,false,nil,CFrame.Angles(0,side*0.62,0))
		end
	end
	marking(c,z+5.5,width-0.5,0,red)
	marking(c,z+31.5,width-0.5,0,red)
	gate(c,"CRACK ZONE",z+5.5,width,amber)
	table.insert(c.zones,{z=c.z+18.5,extent=13,width=width/2})
	obstacle(c,"sweep",0,0,z+23,index*2.14,{size=v(width+1,0.72,0.95),speed=1.95,color=amber})
	return 37,width
end

function sections.shutters(c,z,index)
	local width=15
	deck(c,z,z+39,width)
	for i=1,3 do
		local row=z+5+i*8.2
		for _, side in {-1,1} do
			part(c,"Shutter guide",side*8.9,7.3,row,v(1.25,14.6,1.5),ink)
			light(c,"Shutter height rail",side*8.25,7.3,row-0.43,v(0.16,12,0.2),amber)
		end
		part(c,"Shutter rail top",0,14.6,row,v(19,0.9,1.7),ink)
		obstacle(c,"door",0,0,row,index*0.78+i*2.11,{size=v(16,7,1.2),y=3.5,range=7.2,speed=1.5})
		marking(c,row-1.3,width-0.6,0,amber)
	end
	return 39,width
end

function sections.blink(c,z,index)
	local width=16
	banks(c,z,49,width,6,6)
	deck(c,z+21,z+28,8.8)
	for i,row in {z+13.5,z+35.5} do
		obstacle(c,"vanish",0,0,row,index*0.63+i*1.86,{size=v(9,1.4,7),period=4.15,open=1.1,color=c.colors.rim})
		for _, side in {-1,1} do
			light(c,"Ghost tile mount",side*5.4,-0.8,row,v(0.42,0.35,7),c.colors.lane)
		end
	end
	return 49,width
end

function sections.heat(c,z,index)
	local width=15
	deck(c,z,z+33,width)
	for i=1,3 do
		local row=z+4+i*6.8
		obstacle(c,"pulse",0,0,row,index*0.55+i*1.2,{size=v(width+0.25,0.22,4.65),period=3.5,open=1.32,color=c.colors.deck})
		marking(c,row-2.65,width-0.5,0,c.colors.rim)
	end
	return 33,width
end

function sections.rollers(c,z,index)
	local width=15
	deck(c,z,z+30,width)
	for i=1,3 do
		local row=z+3+i*6.8
		deckDots(c,0,row,width,0)
		obstacle(c,"roller",0,0,row,index+i*1.9,{size=v(11.5,3.5,3.5),y=1.75,range=7.5,speed=2.4})
	end
	return 30,width
end

function sections.ice(c,z,index)
	local width=16.5
	local p=deck(c,z,z+41,width,0,0,rgb("83bdcd"))
	p.CustomPhysicalProperties=PhysicalProperties.new(1,0.012,0)
	p.Material=Enum.Material.Ice
	for _, side in {-1,1} do
		light(c,"Snowball lane",side*4.15,0.026,z+20,v(0.13,0.055,29),c.colors.lane)
		obstacle(c,"snowball",side*4.15,0,z+20,index*0.68+side*1.8,{size=v(6.3,6.3,6.3),y=3.15,range=12.9,speed=1.85,color=cream})
	end
	return 41,width
end

function sections.orbit(c,z,index)
	local width=16
	banks(c,z,47,width,4.5,5)
	for i=1,3 do
		local row=z+13+i*10-10
		local px=(i%2==index%2 and -1 or 1)*2.4
		disc(c,px,row,3.95,c.colors.deck)
		local radius=4.75
		for j=1,4 do
			local t=j*math.pi/2
			light(c,"Orbital thruster",px+radius*math.cos(t),-0.9,row+radius*math.sin(t),v(0.7,0.45,0.7),c.colors.rim)
		end
	end
	return 47,width
end

function sections.relic(c,z,index)
	local width=15.5
	deck(c,z,z+32,width)
	for i=1,3 do
		local row=z+7+i*5.3
		obstacle(c,"pulse",0,0,row,index*0.7+i*1.2,{size=v(width,0.22,4),period=3.85,open=1.47,color=c.colors.rock})
		for _, side in {-1,1} do
			part(c,"Stone column",side*8.7,1.3,row,v(1.4,2.6,1.4),c.colors.rock)
			light(c,"Column beacon",side*8.7,2.72,row,v(0.72,0.35,0.72),c.colors.lane)
		end
	end
	for _, side in {-1,1} do
		part(c,"Relic pedestal",side*10.2,1.05,z+5.5,v(2.7,2.1,3.4),ink)
		part(c,"Carved basalt face",side*10.2,3.55,z+5.5,v(2.8,3,2.1),c.colors.rock)
		for _, eye in {-1,1} do
			light(c,"Relic eye",side*10.2+eye*0.63,3.86,z+4.43,v(0.45,0.36,0.12),c.colors.lane)
		end
	end
	return 32,width
end

function sections.chase(c,z,index)
	local width=13
	banks(c,z,48,width,8,7)
	deck(c,z+8,z+41,9.8)
	gate(c,"BOULDERS • USE THE ALCOVES",z+4.5,18,c.colors.rim)
	for _, side in {-1,1} do
		for _, at in {17,30} do
			deck(c,z+at-2.65,z+at+2.65,5.1,side*5.6,0,c.colors.rock)
			light(c,"Alcove lip",side*7.95,0.04,z+at,v(0.21,0.08,4.8),c.colors.lane)
			part(c,"Alcove ruin",side*8.6,1.45,z+at,v(1.15,2.9,3.2),c.colors.rock)
		end
	end
	obstacle(c,"boulder",0,0,z+25,index*0.81,{color=c.colors.rock})
	return 48,width
end

function sections.rope(c,z,index)
	local width=15
	banks(c,z,46,width,6,6)
	for i=1,3 do
		local first=10.6+(i-1)*10.1
		local px=(i%2==index%2 and -1 or 1)*1.45
		local top=0.18*(i%2)
		deck(c,z+first,z+first+5.2,8.25,px,top,rgb("926648")).Material = Enum.Material.WoodPlanks
		for _, side in {-1,1} do
			part(c,"Rope bridge beam",px+side*3.9,-0.3+top,z+first+2.6,v(0.24,0.26,5.3),c.colors.rim)
		end
	end
	for _, side in {-1,1} do
		for _, row in {z+6,z+40} do
			part(c,"Broken bridge pier",side*5.3,1.2,row,v(0.95,2.4,0.95),c.colors.rock)
			part(c,"Tether",side*5.3,0.78,row+0.68,v(0.32,0.27,1.5),c.colors.rim,false,nil,CFrame.Angles(0.61,0,0))
		end
	end
	return 46,width
end

local function landmark(c, island, z)
	local colors = c.colors
	if island=="Green Meadows" then
		local x,y = 39,11
		part(c,"Fair wheel support",x,y/2-1,z,v(0.8,y+3,1),colors.rock)
		part(c,"Fair wheel axle",x,y,z,v(2.6,2.6,1.2),colors.rim,false,Enum.PartType.Ball)
		for i=1,10 do
			local t=math.pi*i/5
			local dx,dy=math.cos(t)*11,math.sin(t)*11
			part(c,"Wheel spoke",x+dx/2,y+dy/2,z,v(11,0.26,0.28),colors.rim,false,nil,CFrame.Angles(0,0,t))
			part(c,"Gondola",x+dx,y+dy,z,v(2.8,1.6,1.9),i%2==0 and colors.hazard or colors.lane)
			light(c,"Gondola light",x+dx,y+dy-0.38,z-0.96,v(1.6,0.18,0.13),cream)
		end
	elseif island=="The Egg Cooker" then
		for i=1,5 do
			local width = 24-3*i
			part(c,"Furnace shell",39,i*2.9-6,z,v(4,width,width),colors.rock,false,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
		end
		light(c,"Furnace mouth",39,10.1,z,v(8.8,0.54,8.8),colors.hazard)
		for i=1,4 do
			part(c,"Foundry stack",39+i*3.3,7+i*2,z+5,v(2.05,15,2.05),ink)
		end
	elseif island=="Frozen Eggs" then
		for i=1,5 do
			local height=28-3.1*i
			part(c,"Glacier crown",34+i*2.6,height/2-7,z-i*1.25,v(6,height,9),i%2==0 and colors.sky or colors.rock,false,nil,CFrame.Angles(0,0,-0.21)).Material=Enum.Material.Ice
		end
	elseif island=="Eggstraterrestrial" then
		part(c,"Relay planet",43,21,z,v(24,24,24),colors.rock,false,Enum.PartType.Ball)
		part(c,"Dust ring",43,21,z,v(0.55,39,39),colors.rim,false,Enum.PartType.Cylinder,CFrame.Angles(0,0,1.2)).Transparency=0.32
	else
		for i=1,6 do
			local width=32-i*3.2
			part(c,"Temple terrace",40,3.08*i-8,z,v(width,3.4,width),colors.rock)
			part(c,"Temple trim",40,3.08*i-6.35,z,v(width+0.8,0.36,width+0.8),colors.rim)
		end
		part(c,"Temple shrine",40,14.2,z,v(8.4,6.9,8.9),ink)
		light(c,"Shrine portal",40,14.2,z-4.48,v(3.25,4.25,0.14),colors.lane)
	end
end

local function decorate(c, island, length)
	local colors = c.colors
	local water = part(c,"Island basin",0,-10.3,length/2,v(132,0.9,length+90),colors.ground)
	water.Material = if island=="The Egg Cooker" then Enum.Material.Neon else Enum.Material.SmoothPlastic
	water.Transparency = if island=="Eggstraterrestrial" then 0.18 else 0.05
	local random = Random.new(c.level*193+41)
	landmark(c,island,math.floor(length*0.38))
	for _, side in {-1,1} do
		for i=1,math.ceil(length/21) do
			local z = i*21+random:NextNumber(-7,7)-10
			local x = side*random:NextNumber(21,51)
			local tall = random:NextNumber(3,13)
			local spread = random:NextNumber(4,11)
			local rotation = CFrame.Angles(0,random:NextNumber(0,math.pi),random:NextNumber(-0.29,0.29))
			if island=="The Egg Cooker" then
				part(c,"Basalt outcrop",x,-8+tall/2,z,v(spread,tall,spread*0.8),colors.rock,false,nil,rotation)
				light(c,"Magma seam",x,-8+tall/2,z-spread/2,v(spread*0.65,0.32,0.55),colors.rim)
				if i%3==0 then
					part(c,"Flue stack",x,-7+tall,z,v(12,spread*0.48,spread*0.48),ink,false,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
				end
			elseif island=="Frozen Eggs" then
				part(c,"Ice shelf",x,-8.3,z,v(spread*2.2,2.6,spread*1.4),cream,false,nil,rotation)
				part(c,"Glacier shard",x,-8+tall/2,z-2,v(spread/2,tall,spread*0.6),colors.rock,false,nil,rotation).Material = Enum.Material.Ice
			elseif island=="Eggstraterrestrial" then
				local radius=spread*0.72
				part(c,"Planet",x,-6+tall,z,v(radius,radius,radius),i%2==0 and colors.rock or colors.rim,false,Enum.PartType.Ball)
				if i%3==0 then
					part(c,"Planet annulus",x,-6+tall,z,v(0.17,radius*1.75,radius*1.75),colors.sky,false,Enum.PartType.Cylinder,CFrame.Angles(0,0,1.26)).Transparency=0.45
				end
				light(c,"Pin star",x+side*9,-4+tall*1.1,z+3,v(0.46,0.46,0.46),colors.lane)
			elseif island=="Sunken Ruins" then
				part(c,"Fallen colonnade",x,-8+tall/2,z,v(spread*0.33,tall,spread*0.33),colors.rock,false,nil,rotation)
				part(c,"Masonry pad",x,-8.3,z,v(spread*1.32,2.2,spread*1.17),colors.rock)
				if i%4==0 then
					light(c,"Ruin lamp",x,-7.3+tall,z,v(0.34,0.64,0.34),colors.lane)
				end
			else
				part(c,"Meadow bluff",x,-8,z,v(spread*2,6,spread*2.5),colors.rock,false,Enum.PartType.Ball)
				part(c,"Tree trunk",x,-7+tall/2,z,v(0.94,tall,0.94),rgb("74513c"))
				part(c,"Tree crown",x,-6+tall,z,v(spread*0.82,spread,spread*0.82),i%2==0 and rgb("91a95b") or rgb("cfab5c"),false,Enum.PartType.Ball)
			end
		end
	end
end

function Courses.course(level, x, z)
	local spec = assert(Levels[level],"Missing course")
	local model = Instance.new("Model")
	model.Name = spec.name
	local c = {model=model,x=x,z=z,level=level,pace=spec.pace,colors=assert(themes[spec.island]),obstacles={},route={},zones={}}
	local cursor = 10
	deck(c,-17,cursor,35)
	gate(c,spec.name,-15,33,c.colors.rim)
	for i=1,6 do
		local laneX = (i-3.5)*4.5
		part(c,"Launch lane",laneX,0.03,-5.6,v(2.65,0.06,10.6),i%2==0 and c.colors.lane or c.colors.rim)
	end
	marking(c,9.25,34,0,c.colors.lane)
	for i, name in spec.sections do
		local build = assert(sections[name],name)
		local length, width = build(c,cursor,i)
		cursor += length
		table.insert(c.route,{z=z+cursor-1.05,x=x,width=width/2+1.5,minY=0.45,maxY=12.5})
	end
	deck(c,cursor,cursor+22,35)
	c.length = cursor+9
	c.finish = z+c.length
	gate(c,"FINISH",c.length+2,33,c.colors.rim)
	for i=1,14 do
		for row=0,1 do
			part(c,"Checkered finish stripe",(i-7.5)*2.36,0.035,c.length+(row-0.5)*1.2,v(2.36,0.07,1.2),(i+row)%2==0 and cream or ink)
		end
	end
	decorate(c,spec.island,c.length)
	model.Parent = workspace
	return c
end

return Courses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Http = game:GetService("HttpService")
local Rules = require(game:GetService("ReplicatedStorage"):WaitForChild("EggShared").RaceRules)
local token = Http:GenerateGUID(false)
local D = {sessions = {}}
local store

local function getStore()
	if not store then store = DataStoreService:GetDataStore("CourierProfiles_v1") end
	return store
end

local function normalize(raw)
	local data = typeof(raw) == "table" and raw or {}
	for key, fallback in {coins=0, wins=0, xp=0, unlocked=1} do
		local value = data[key]
		data[key] = if typeof(value) == "number" and value >= fallback then math.floor(value) else fallback
	end
	for _, key in {"skins","trails","records"} do
		if typeof(data[key]) ~= "table" then data[key] = {} end
	end
	data.skins.Classic = true
	if not data.skins[data.skin or ""] then data.skin = "Classic" end
	if typeof(data.title) ~= "number" then data.title = 1 end
	if typeof(data.trail) ~= "string" then data.trail = "" end
	return data
end

local function retry(operation)
	local errorMessage
	for attempt = 1, 3 do
		local ok, result = pcall(operation)
		if ok then return true, result end
		errorMessage = result
		if attempt < 3 then task.wait(attempt * 0.6) end
	end
	warn("Courier profile store:", errorMessage)
	return false, nil
end

local function key(player)
	return "u:" .. player.UserId
end

function D.load(player)
	if RunService:IsStudio() and game.GameId == 0 then
		local data = normalize(nil)
		D.sessions[player] = {data=data, temporary=true}
		return data
	end
	local ok, result = retry(function()
		return getStore():UpdateAsync(key(player), function(old)
			local envelope = typeof(old) == "table" and old or {}
			if envelope.owner and envelope.owner ~= token and (envelope.expires or 0) > os.time() then return nil end
			return {owner=token, expires=os.time()+180, data=normalize(envelope.data or (not envelope.owner and old))}
		end)
	end)
	if not result and (ok or not RunService:IsStudio()) then
		if player.Parent then player:Kick("Your courier profile is unavailable. Please rejoin in a moment.") end
		return nil
	end
	local session = {data=result and result.data or normalize(nil), temporary=result == nil}
	D.sessions[player] = session
	return session.data
end

function D.get(player)
	local session = D.sessions[player]
	return session and session.data
end

function D.save(player, release)
	local session = D.sessions[player]
	if not session then return end
	if release then session.closing = true end
	if session.saving then
		if not release then return end
		repeat task.wait(0.1) until not session.saving
		if D.sessions[player] ~= session then return end
	end
	if session.temporary then
		if release then D.sessions[player] = nil end
		return
	end
	session.saving = true
	local snapshot = table.clone(session.data)
	for _, field in {"skins","trails","records"} do snapshot[field] = table.clone(snapshot[field]) end
	local ok, result = retry(function()
		return getStore():UpdateAsync(key(player), function(old)
			if typeof(old) ~= "table" or old.owner ~= token then return nil end
			if release then return {data=snapshot} end
			return {owner=token, expires=os.time()+180, data=snapshot}
		end)
	end)
	if ok and not result and not release and player.Parent then
		player:Kick("Your courier profile moved to another server. Please rejoin.")
	end
	session.saving = false
	if release then D.sessions[player] = nil end
end

function D.summary(player)
	local data = D.get(player)
	if not data then return end
	player:SetAttribute("Coins",data.coins)
	player:SetAttribute("Wins",data.wins)
	player:SetAttribute("XP",data.xp)
	player:SetAttribute("Unlocked",data.unlocked)
end

function D.finish(player, level, time, perfect, place, competitive)
	local data = D.get(player)
	if not data then return 0, false end
	local reward, personal = Rules.complete(data,level,time,perfect,place,competitive)
	D.summary(player)
	return reward, personal
end
return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Eggs</string>
          <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local EggModel = require(Shared.EggModel)
local Eggs = {}

function Eggs.attach(player, data, hp)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then return end
	local existing = character:FindFirstChild("CourierEgg")
	if existing then existing:Destroy() end
	if hp <= 0 then return end
	local egg = EggModel.build(data.skin, head.Size.X * 1.5, false)
	local offset = CFrame.new(0,head.Size.Y/2+egg.PrimaryPart.Size.Y/2+0.34,0)
	egg:PivotTo(head.CFrame * offset)
	egg.Parent = character
	local motor = Instance.new("Motor6D")
	motor.Name = "EggMotor"
	motor.Part0 = head
	motor.Part1 = egg.PrimaryPart
	motor.C0 = offset
	motor.Parent = egg.PrimaryPart
	EggModel.condition(egg,hp)
	local previous = head:FindFirstChild("CourierTitle")
	if previous then previous:Destroy() end
	local nameplate = Instance.new("BillboardGui",head)
	nameplate.Name = "CourierTitle"
	nameplate.Size = UDim2.fromScale(6,0.8)
	nameplate.StudsOffset = Vector3.new(0,head.Size.Y+3,0)
	nameplate.MaxDistance = 36
	local title = Instance.new("TextLabel",nameplate)
	title.Size = UDim2.fromScale(1,1)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextScaled = true
	title.TextStrokeTransparency = 0.5
	title.TextColor3 = Color3.fromHex("fff4ab")
	local config = require(Shared.Config)
	title.Text = (data.skins.VIP and "VIP  •  " or "") .. (config.titles[data.title] or config.titles[1])
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		for _, name in {"CourierTrail","CourierTrailLeft","CourierTrailRight"} do
			local item = root:FindFirstChild(name)
			if item then item:Destroy() end
		end
		if data.trail ~= "" and data.trails[data.trail] then
			local left = Instance.new("Attachment",root)
			left.Name = "CourierTrailLeft"
			left.Position = Vector3.new(-0.65,0,0.5)
			local right = Instance.new("Attachment",root)
			right.Name = "CourierTrailRight"
			right.Position = Vector3.new(0.65,0,0.5)
			local trail = Instance.new("Trail",root)
			trail.Name = "CourierTrail"
			trail.Attachment0, trail.Attachment1 = left, right
			trail.Lifetime = 0.28
			trail.MinLength = 0.2
			trail.FaceCamera = true
			local color = if data.trail == "Rainbow" then Color3.fromHex("fc67ff") elseif data.trail == "VIP" then Color3.fromHex("ffdc53") else Color3.fromHex("5deaff")
			trail.Color = ColorSequence.new(color,Color3.fromHex("fff9d7"))
			trail.Transparency = NumberSequence.new(0.15,1)
		end
	end
end

function Eggs.condition(player, hp)
	local egg = player.Character and player.Character:FindFirstChild("CourierEgg")
	if not egg then return end
	EggModel.condition(egg,hp)
	if hp == 0 then
		for i = 1,8 do
			local fragment = Instance.new("WedgePart")
			fragment.Name = "Shell chip"
			fragment.Size = Vector3.new(0.32,0.28,0.42)
			fragment.Color = egg.PrimaryPart.Color
			fragment.CFrame = egg:GetPivot() * CFrame.Angles(i, i*0.4, 0)
			fragment.CanCollide = false
			fragment.CanTouch = false
			fragment.CanQuery = false
			fragment.Parent = workspace
			fragment.AssemblyLinearVelocity = Vector3.new(math.cos(i)*11,12+i,math.sin(i)*11)
			fragment.AssemblyAngularVelocity = Vector3.new(i,3,1)
			Debris:AddItem(fragment,0.7)
		end
		egg:Destroy()
	end
end
return Eggs
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Run = game:GetService("RunService")
local Physics = game:GetService("PhysicsService")
local Debris = game:GetService("Debris")
local Shared = RS:WaitForChild("EggShared")
local Config = require(Shared.Config)
local Levels = require(Shared.Levels)
local Rules = require(Shared.RaceRules)
local World = require(script.Parent.World)
local Courses = require(script.Parent.Courses)
local Obstacles = require(script.Parent.Obstacles)
local Data = require(script.Parent.Data)
local Eggs = require(script.Parent.Eggs)
local Shop = require(script.Parent.Shop)

local remote = Instance.new("RemoteEvent")
remote.Name = "CourierEvent"
remote.Parent = Shared
local queue, practiceQueue, selected, vote, rate = {}, {}, {}, {}, {}
local shopping = {}
local racers = {}
local course
local stage, deadline, level = "Lobby", 0, 1
local started, ends = 0, 0
local results, resultCount = {}, 0
local practiceMode, entrants, slots = false, 0, 0
local now = workspace.GetServerTimeNow
local lobby, demo, leaderboard, podium

pcall(function() Physics:RegisterCollisionGroup("Couriers") end)
Physics:CollisionGroupSetCollidable("Couriers","Couriers",false)

local function send(player, kind, value, extra)
	if player.Parent == Players then remote:FireClient(player,kind,value,extra) end
end

local function profile(player)
	local d = Data.get(player)
	if d then send(player,"Profile",{
		skins=d.skins, trails=d.trails, skin=d.skin, trail=d.trail, title=d.title, records=d.records,
	}) end
end

local function rootOf(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function move(player, pos, frozen)
	local root = rootOf(player)
	if not root then return end
	root.Anchored = frozen == true
	root.CFrame = CFrame.lookAt(pos, pos + Vector3.zAxis)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

local function progress(r)
	return math.clamp((r.progress-course.z)/(course.finish-course.z),0,0.99)
end

local function state(player)
	local r = racers[player]
	send(player,"State",{
		stage=stage, deadline=deadline, level=level, racing=r ~= nil, queued=queue[player] == true,
		practiceQueued=practiceQueue[player] ~= nil, selected=selected[player] or 1, vote=vote[player],
		practice=practiceMode, solo=entrants == 1, result=r and r.result,
		total=entrants, slots=slots, qualified=resultCount, scoreboard=stage == "Results" and results or nil,
	})
end

local function phase(name, duration)
	stage, deadline = name, if name=="Race" then ends else now(workspace)+(duration or 0)
	for _, player in Players:GetPlayers() do state(player) end
end

local function restartPractice(player,r,at)
	local d = Data.get(player)
	if not d or racers[player] ~= r or stage ~= "Race" then return end
	r.hp, r.recovering, r.perfect = 3, false, true
	r.immune = at + Config.protection
	r.lastHazard, r.shovedBy, r.shovedAt = nil, nil, nil
	r.routeIndex, r.progress, r.zone = 1, course.z, nil
	r.previous, r.lastSample, r.attemptStarted = r.spawn, at, at
	r.speedOrigin, r.speedAt = r.spawn, at
	move(player,r.spawn,false)
	Eggs.attach(player,d,3)
	send(player,"FX","Restart")
end

local function eliminate(player,r,reason)
	if r.finished then return end
	r.finished, r.recovering, r.zone = true, false, nil
	r.result = {out=true,dnf=true,reason=reason,hp=r.hp,progress=progress(r),practice=practiceMode}
	move(player,lobby,false)
	local data = Data.get(player)
	if data then Eggs.attach(player,data,3) end
	send(player,"FX","Out",reason)
	state(player)
end

local function failedAttempt(player,r,reason,at)
	if practiceMode then
		r.recovering = true
		r.penaltyUntil = at+Config.practiceRestartDelay
		local root = rootOf(player)
		if root then root.Anchored = true end
	else
		eliminate(player,r,reason)
	end
end

local function damage(player,r,amount,source)
	local at = now(workspace)
	if stage ~= "Race" or r.finished or r.recovering or (source ~= "fall" and at < r.immune) then return false end
	if source == r.lastHazard and at-r.lastHit < 1.3 then return false end
	r.lastHazard,r.lastHit,r.immune = source,at,at+Config.protection
	r.hp = math.max(0,r.hp-amount)
	Eggs.condition(player,r.hp)
	r.perfect = false
	if r.hp == 0 then
		send(player,"FX","Break")
		local reason = if source == "fall" then
			(if r.shovedAt and at-r.shovedAt <= 2 then "Knocked off by " .. r.shovedBy else "Fell off the island")
			elseif typeof(source) == "Instance" and source:IsA("Player") then "Shoved out by " .. source.DisplayName
			else "Shell shattered"
		failedAttempt(player,r,reason,at)
	else
		send(player,"FX","Crack",r.hp)
	end
	return true
end

local function zoneFor(root)
	if not course or not root then return nil end
	local p = root.Position
	if p.Y < 0.8 or p.Y > 10 then return nil end
	for i, zone in course.zones do
		if math.abs(p.Z-zone.z) <= zone.extent and math.abs(p.X-(zone.x or course.x)) <= (zone.width or 11.5) then return i end
	end
	return nil
end

local function shove(player)
	local r, root = racers[player],rootOf(player)
	local at = now(workspace)
	if stage ~= "Race" or (practiceMode or entrants < 2) or not r or r.finished or r.recovering or not root or root.Anchored or at < r.cooldown or at < r.immune then return end
	local zone = zoneFor(root)
	if not zone then return end
	local closest, target, gap
	for other, rival in racers do
		if other == player or rival.finished or rival.recovering or at < rival.immune then continue end
		local otherRoot = rootOf(other)
		if not otherRoot or otherRoot.Anchored or zoneFor(otherRoot) ~= zone then continue end
		local delta = otherRoot.Position-root.Position
		local distance = delta.Magnitude
		if distance <= Config.shoveRange and (distance < 0.1 or root.CFrame.LookVector:Dot(delta.Unit) > 0.12) and (not gap or distance<gap) then
			closest,target,gap = other,otherRoot,distance
		end
	end
	r.cooldown = at+Config.shoveCooldown
	send(player,"FX","Shove")
	if closest and damage(closest,racers[closest],1,player) and not racers[closest].finished and not target.Anchored then
		local rival = racers[closest]
		rival.shovedBy, rival.shovedAt = player.DisplayName, at
		local offset = target.Position-root.Position
		local flat = Vector3.new(offset.X,0,offset.Z)
		if flat.Magnitude > 0.1 then
			local canSet = target:CanSetNetworkOwnership()
			if canSet then
				target:SetNetworkOwner(nil)
				task.delay(0.18,function()
					if target:IsDescendantOf(workspace) and target:CanSetNetworkOwnership() then
						target:SetNetworkOwnershipAuto()
					end
				end)
			end
			target.AssemblyLinearVelocity = flat.Unit*24 + Vector3.yAxis*9
		end
	end
end

local function updated(player)
	profile(player)
	local d = Data.get(player)
	if d and not racers[player] then Eggs.attach(player,d,3) end
end
Shop.listen(updated)

local function action(player, key, id)
	local d = Data.get(player)
	if not d then return end
	if key == "hello" then profile(player); state(player); return end
	if key == "shove" then shove(player); return end
	if key == "lobby" then
		queue[player],practiceQueue[player],vote[player] = nil,nil,nil
		local r = racers[player]
		if r and (r.finished or practiceMode or stage == "Results") then
			racers[player] = nil
			move(player,lobby,false)
			Eggs.attach(player,d,3)
		end
		state(player)
		return
	end
	if key == "next" and racers[player] and (racers[player].finished or stage == "Results") then
		racers[player] = nil
		move(player,lobby,false)
		Eggs.attach(player,d,3)
	end
	if racers[player] then return end
	if key == "queue" or key == "next" then
		queue[player],practiceQueue[player] = true,nil
	elseif key == "practice" then
		local choice = tonumber(id) or selected[player] or 1
		if Levels[choice] then
			practiceQueue[player],queue[player],vote[player] = choice,nil,nil
		end
	elseif key == "choose" then
		local n = tonumber(id)
		if n and n % 1 == 0 and Levels[n] and n <= d.unlocked then
			selected[player] = n
			if stage == "Voting" and queue[player] then vote[player] = n end
		end
	elseif key == "skin" or key == "title" or key == "trail" then
		if shopping[player] then return end
		shopping[player] = true
		local message, pass = Shop.select(player,key,id)
		shopping[player] = nil
		send(player,"Notice",message)
		if pass then send(player,"Pass",pass) end
		updated(player)
	elseif key == "Shop" or key == "Courses" then
		send(player,"Open",key)
	end
	state(player)
end

lobby,demo,leaderboard,podium = World.lobby(action)
for _, instance in workspace:GetChildren() do
	if instance.Name == "Baseplate" and instance:IsA("BasePart") then instance:Destroy() end
end

remote.OnServerEvent:Connect(function(player,key,id)
	if typeof(key) ~= "string" or #key > 12 or (id ~= nil and (typeof(id) ~= "string" or #id > 32)) then return end
	if (key == "skin" or key == "title" or key == "trail" or key == "choose") and id == nil then return end
	local clock = os.clock()
	local limits = rate[player] or {}
	rate[player] = limits
	local bucket = if key == "shove" then "shove" else "menu"
	if limits[bucket] and clock < limits[bucket] then return end
	limits[bucket] = clock + 0.18
	action(player,key,id)
end)

local function spawned(player,character)
	local head = character:WaitForChild("Head",10)
	local root = character:WaitForChild("HumanoidRootPart",10)
	local humanoid = character:WaitForChild("Humanoid",10)
	if not head or not root or not humanoid or character ~= player.Character or not player.Parent then return end
	local function part(item)
		if item:IsA("BasePart") then item.CollisionGroup = "Couriers" end
	end
	if not character:GetAttribute("CourierCollisionReady") then
		character:SetAttribute("CourierCollisionReady",true)
		character.DescendantAdded:Connect(part)
		for _, item in character:GetDescendants() do part(item) end
	end
	local d = Data.get(player)
	if not d then return end
	local r = racers[player]
	if r and not r.finished then
		if stage == "Race" then
			if not r.recovering then failedAttempt(player,r,"Character reset",now(workspace)) end
			if r.recovering then move(player,r.spawn,true) end
			return
		elseif stage == "Preparation" or stage == "Countdown" then
			move(player,r.spawn,true)
			Eggs.attach(player,d,3)
			return
		end
	end
	move(player,lobby,false)
	Eggs.attach(player,d,3)
end

local function join(player)
	player.CharacterAdded:Connect(function(char) spawned(player,char) end)
	local d = Data.load(player)
	if not d then return end
	if player.Parent ~= Players then Data.save(player,true); return end
	Data.summary(player)
	if player.Character then task.spawn(spawned,player,player.Character) end
	profile(player)
	state(player)
	task.spawn(function() Shop.refresh(player); profile(player) end)
end

Players.PlayerAdded:Connect(join)
for _, player in Players:GetPlayers() do task.spawn(join,player) end
Players.PlayerRemoving:Connect(function(player)
	racers[player],queue[player],practiceQueue[player],selected[player],vote[player],rate[player] = nil,nil,nil,nil,nil,nil
	Data.save(player,true)
end)

task.spawn(function()
	while task.wait(45) do
		for player in Data.sessions do task.spawn(Data.save,player,false) end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player in Data.sessions do
		pending += 1
		task.spawn(function()
			Data.save(player,true)
			pending -= 1
		end)
	end
	local untilTime = os.clock()+24
	while pending > 0 and os.clock() < untilTime do task.wait(0.1) end
end)

local function finishBurst(root)
	if not root then return end
	local point = Instance.new("Attachment",workspace.Terrain)
	point.WorldPosition = root.Position + Vector3.yAxis * 2.2
	for _, tint in {Color3.fromHex("ffdc53"),Color3.fromHex("fb5791"),Color3.fromHex("36d6ec")} do
		local emitter = Instance.new("ParticleEmitter",point)
		emitter.Rate = 0
		emitter.Color = ColorSequence.new(tint)
		emitter.Lifetime = NumberRange.new(0.6,1.2)
		emitter.Speed = NumberRange.new(7,16)
		emitter.Acceleration = -Vector3.yAxis * 16
		emitter.SpreadAngle = Vector2.new(85,85)
		emitter.Size = NumberSequence.new(0.34,0.05)
		emitter.RotSpeed = NumberRange.new(-120,120)
		emitter:Emit(10)
	end
	Debris:AddItem(point,1.5)
end

local function finish(player,r,time)
	r.finished = true
	resultCount += 1
	local coins, personal = 0,false
	if not practiceMode then
		coins,personal = Data.finish(player,level,time,r.perfect,resultCount,entrants>1)
	end
	r.result = {place=resultCount,time=time,hp=r.hp,coins=coins,record=personal,practice=practiceMode}
	table.insert(results,{name=player.DisplayName,time=time,place=resultCount})
	finishBurst(rootOf(player))
	send(player,"FX","Finish",r.result)
	profile(player)
	state(player)
	for contender, other in racers do
		if not other.finished then state(contender) end
	end
	move(player,Vector3.new(course.x+math.clamp((resultCount-6)*2,-12,12),3.65,course.finish+5),true)
end

local tickAccumulator, hudAccumulator, boardAccumulator = 0,0,0
Run.Heartbeat:Connect(function(dt)
	tickAccumulator += dt
	hudAccumulator += dt
	boardAccumulator += dt
	if tickAccumulator < 1/30 then return end
	tickAccumulator %= 1/30
	local at = now(workspace)
	if stage == "Race" and course then
		local candidates = {}
		for player,r in racers do
			if r.finished then continue end
			local root = rootOf(player)
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health <= 0 and not r.recovering then
				failedAttempt(player,r,"Character reset",at)
			end
			if r.finished or not root or not humanoid or humanoid.Health <= 0 then continue end
			if r.recovering then
				if at >= r.penaltyUntil then restartPractice(player,r,at) end
				continue
			end
			local p = root.Position
			if p.Y < (course.fallY or -8.3) then
				damage(player,r,3,"fall")
				continue
			end
			local previous = r.previous
			local previousTime = r.lastSample
			r.previous,r.lastSample=p,at
			-- Discard implausible jumps, then validate course travel in route order.
			local speedAge = at-(r.speedAt or at)
			local sustained = speedAge >= 0.8 and (p.Z-r.speedOrigin.Z) > 14 + speedAge*27
			if (p-previous).Magnitude > math.max(14,(at-previousTime)*60) or sustained then
				local back = if sustained then r.speedOrigin else previous
				move(player,back,false)
				r.previous,r.speedOrigin,r.speedAt=back,back,at
				continue
			end
			if not r.speedAt or speedAge >= 0.8 then r.speedOrigin,r.speedAt=p,at end
			local gate = course.route[r.routeIndex]
			if gate then
				if Rules.crossing(previous,p,gate.z,gate.x,gate.width,gate.minY,gate.maxY) then
					r.routeIndex += 1
					gate = course.route[r.routeIndex]
				end
			else
				local fraction = Rules.crossing(previous,p,course.finish,course.x,15.8,0.5,12.5)
				if fraction and r.hp > 0 then
					local arrival = previousTime + (at-previousTime)*fraction
					if arrival <= ends then table.insert(candidates,{player=player,r=r,arrival=arrival}) end
				end
			end
			r.progress = math.clamp(p.Z,course.z,gate and gate.z or course.finish)
			r.zone = zoneFor(root)
		end
		table.sort(candidates,function(a,b)
			if a.arrival == b.arrival then return a.player.UserId < b.player.UserId end
			return a.arrival < b.arrival
		end)
		for _, entry in candidates do
			if resultCount == slots then break end
			finish(entry.player,entry.r,entry.arrival-entry.r.attemptStarted)
		end
		if resultCount == slots then
			for player, r in racers do
				if not r.finished then eliminate(player,r,"All finish slots claimed") end
			end
		else
			Obstacles.update(course,at-started,racers,damage)
		end
		if hudAccumulator >= 0.2 then
			hudAccumulator = 0
			local ranked = {}
			for player,r in racers do
				if not r.finished then table.insert(ranked,{player=player,r=r}) end
			end
			table.sort(ranked,function(a,b)
				if a.r.progress ~= b.r.progress then return a.r.progress>b.r.progress end
				return a.player.UserId < b.player.UserId
			end)
			for place, entry in ranked do
				local r=entry.r
				send(entry.player,"Race",{
					hp=r.hp, place=resultCount+place, total=entrants, zone=r.zone ~= nil,
					cooldown=r.cooldown, progress=progress(r), slots=slots, qualified=resultCount,
					recover=r.recovering and r.penaltyUntil or 0,
				})
			end
		end
	elseif stage == "Countdown" and course then
		Obstacles.update(course,0,{},damage)
	end
	Obstacles.update(demo,at % 10000,{},damage)
	if boardAccumulator >= 3 then
		boardAccumulator = 0
		local board = {}
		for player, session in Data.sessions do
			if player.Parent == Players then table.insert(board,{name=player.DisplayName,wins=session.data.wins}) end
		end
		table.sort(board,function(a,b) return a.wins>b.wins end)
		local lines={"SERVER LEADERS"}
		for i=1,math.min(3,#board) do table.insert(lines,("%d   %s   /   %d wins"):format(i,board[i].name,board[i].wins)) end
		leaderboard.Text=table.concat(lines,"\n")
		for i, marker in podium do
			marker.Text = board[i] and ("%d  %s"):format(i,board[i].name) or tostring(i)
		end
	end
end)

local function waitPhase()
	while now(workspace) < deadline do task.wait(0.1) end
end

local function ready(list)
	local found = {}
	for player in list do
		local root = rootOf(player)
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if Data.get(player) and not shopping[player] and root and hum and hum.Health > 0 then table.insert(found,player) end
	end
	table.sort(found,function(a,b) return a.UserId < b.UserId end)
	return found
end

local function choose(group)
	local cap = #Levels
	for _, p in group do cap = math.min(cap,Data.get(p).unlocked) end
	local counts = table.create(cap,0)
	for _, p in group do
		local n = vote[p] or selected[p]
		if n and n <= cap then counts[n] += 1 end
	end
	local best = 1
	for n=2,cap do if counts[n] > counts[best] then best=n end end
	return best
end

task.spawn(function()
	while true do
		phase("Lobby")
		repeat task.wait(0.25) until next(queue) or next(practiceQueue)
		practiceMode = next(queue) == nil
		if not practiceMode then
			phase("Intermission",Config.intermission)
			waitPhase()
			table.clear(vote)
			phase("Voting",Config.voting)
			waitPhase()
		end
		local group = ready(practiceMode and practiceQueue or queue)
		if practiceMode then
			for i=#group,2,-1 do group[i]=nil end
		end
		entrants=math.min(#group,Config.maxPlayers)
		if entrants == 0 then continue end
		level=if practiceMode then practiceQueue[group[1]] else choose(group)
		slots=Rules.slots(entrants)
		results,resultCount={},0
		course=Courses.course(level,0,420)
		local at=now(workspace)
		for i=1,entrants do
			local player=group[i]
			local spot=Vector3.new((i-1)%6*4.5-11.25,3.65,416-math.floor((i-1)/6)*4)
			racers[player]={hp=3, routeIndex=1, spawn=spot, previous=spot, lastSample=at,
				progress=course.z, immune=at+Config.countdown+1, cooldown=0, perfect=true}
			queue[player],practiceQueue[player],vote[player]=nil,nil,nil
			move(player,spot,true)
			Eggs.attach(player,Data.get(player),3)
		end
		phase("Preparation",0.6)
		waitPhase()
		phase("Countdown",Config.countdown)
		waitPhase()
		started=now(workspace)
		ends=started+Levels[level].time
		for player,r in racers do
			r.attemptStarted=started
			local root=rootOf(player)
			if root then
				root.Anchored=false
				r.previous,r.lastSample,r.immune=root.Position,started,started+1.5
			end
		end
		phase("Race",Levels[level].time)
		while now(workspace) < ends do
			local active=false
			for _, r in racers do if not r.finished then active=true; break end end
			if not active then break end
			task.wait(0.2)
		end
		for player,r in racers do
			if not r.finished then eliminate(player,r,"Time ran out") end
		end
		phase("Results",Config.results)
		waitPhase()
		phase("Returning",0.65)
		for player in racers do
			move(player,lobby,false)
			local d=Data.get(player)
			if d then Eggs.attach(player,d,3) end
		end
		table.clear(racers)
		Obstacles.cleanup(course)
		course.model:Destroy()
		course=nil
		waitPhase()
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Obstacles</string>
          <string name="Source"><![CDATA[local O = {}
local palette = {Color3.fromHex("ff536c"), Color3.fromHex("ffb632"), Color3.fromHex("965bff")}
local tileSafe = Color3.fromHex("9beecb")
local tileWarning = Color3.fromHex("ff9160")
local pulseSafe = Color3.fromHex("2a3c50")
local pulseWarning = Color3.fromHex("ffc34c")
local pulseLive = Color3.fromHex("ff4f54")
local function make(parent, name, size, cf, color, solid, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Anchored = true
	p.CanCollide = solid
	p.CanTouch = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	p.Parent = parent
	return p
end
O.part = make

local definitions = {
	sweep = {size = Vector3.new(22, 0.85, 1.4), y = 1.25, speed = 1.65, damage = 1},
	ball = {size = Vector3.new(6, 6, 6), y = 3, range = 9, speed = 1.8, damage = 1, shape = Enum.PartType.Ball},
	foam = {size = Vector3.new(10, 4, 3), y = 2, range = 10, speed = 1.85, damage = 1},
	pendulum = {size = Vector3.new(4.8, 4.8, 4.8), y = 2.7, range = 9.5, speed = 1.65, damage = 1, shape = Enum.PartType.Ball},
	moving = {size = Vector3.new(15, 1.4, 10), range = 3.6, speed = 1.55, solid = true},
	tilt = {size = Vector3.new(16, 1.4, 10), range = 0.25, speed = 1.7, solid = true},
	roller = {size = Vector3.new(10, 2.8, 2.8), y = 1.4, range = 5.8, speed = 1.9, damage = 1, shape = Enum.PartType.Cylinder},
	beam = {size = Vector3.new(8, 1.4, 10), solid = true},
	vanish = {size = Vector3.new(15, 1.4, 10), solid = true, period = 4, open = 1},
	collapse = {size = Vector3.new(15, 1.4, 10), solid = true, period = 5, open = 1.4},
	conveyor = {size = Vector3.new(20, 1.4, 10), solid = true, speed = 7},
	ice = {size = Vector3.new(20, 1.4, 10), solid = true},
	door = {size = Vector3.new(20, 6, 1.5), y = 3, solid = true, range = 6, speed = 1.4},
	launch = {size = Vector3.new(9, 0.5, 8), y = 0.25, solid = true, speed = 37},
	snowball = {size = Vector3.new(5, 5, 5), y = 2.5, range = 10, speed = 1.5, damage = 1, shape = Enum.PartType.Ball},
	gravity = {size = Vector3.new(17, 12, 12), y = 6, speed = 105},
	pulse = {size = Vector3.new(14, 0.22, 5), y = 0.13, period = 3.8, open = 1.25, damage = 1},
	boulder = {size = Vector3.new(8.8, 8.8, 8.8), y = 4.4, range = 18, period = 6.15, travel = 3.2, damage = 1, shape = Enum.PartType.Ball},
}
O.definitions = definitions

local function hitsRacer(localPos, half, shape)
	if shape == Enum.PartType.Ball then
		local x = math.max(0,math.abs(localPos.X)-0.74)
		local y = math.max(0,math.abs(localPos.Y)-1.65)
		local z = math.max(0,math.abs(localPos.Z)-0.74)
		return x*x+y*y+z*z < half.X*half.X
	end
	return math.abs(localPos.X) < half.X+0.85
		and math.abs(localPos.Y) < half.Y+1.75
		and math.abs(localPos.Z) < half.Z+0.85
end

function O.add(course, kind, origin, phase, overrides)
	local d = table.clone(assert(definitions[kind], kind))
	for key, value in overrides or {} do d[key] = value end
	local cf = CFrame.new(origin + Vector3.new(0, d.y or -0.7, 0))
	local p = make(course.model, kind, d.size, cf, d.color or palette[math.floor(phase) % 3 + 1], d.solid == true, d.shape)
	if not d.solid then p.CanQuery = false end
	local item = {kind = kind, part = p, base = cf, phase = phase, d = d}
	if kind == "ice" then p.CustomPhysicalProperties = PhysicalProperties.new(1, 0.015, 0) end
	if kind == "conveyor" then p.AssemblyLinearVelocity = Vector3.new(0, 0, d.speed) end
	if kind == "gravity" then p.Transparency = 0.8 end
	if kind == "pulse" then p.Material = Enum.Material.Neon end
	if kind == "boulder" then p.Material = Enum.Material.Slate end
	if kind == "pendulum" then
		item.pivot = origin + Vector3.new(0, 16, 0)
		item.arm = make(course.model, "Foam swing arm", Vector3.one, cf, Color3.fromHex("ffe6a2"), false)
	end
	table.insert(course.obstacles, item)
	return item
end

function O.update(course, age, racers, damage)
	if course.gravityApplied then
		for root in course.gravityApplied do
			local force = root:FindFirstChild("CourseLift")
			if force then force.Force = Vector3.zero end
		end
	end
	for _, o in course.obstacles do
		local p, d, kind = o.part, o.d, o.kind
		local old = p.CFrame
		local t = age * (d.speed or 1) + o.phase
		local s = math.sin(t)
		local active = true
		if kind == "sweep" then p.CFrame = o.base * CFrame.Angles(0, t, 0)
		elseif kind == "ball" then p.CFrame = o.base + Vector3.new(s * d.range, math.abs(math.sin(t * 1.6)) * 5.6, 0)
		elseif kind == "foam" or kind == "moving" then p.CFrame = o.base + (d.axis or Vector3.xAxis) * (s * d.range)
		elseif kind == "tilt" then p.CFrame = o.base * CFrame.Angles((d.pitch or 0) * math.cos(t), 0, s * d.range)
		elseif kind == "roller" then p.CFrame = (o.base + Vector3.new(s * d.range, 0, 0)) * CFrame.Angles(t, 0, 0)
		elseif kind == "snowball" then p.CFrame = o.base + Vector3.new(0, 0, s * d.range)
		elseif kind == "pendulum" then
			local bob = o.base.Position + Vector3.new(s * d.range, math.abs(s)^2 * 4, 0)
			p.Position = bob
			o.arm.Size = Vector3.new(0.7, 0.7, (bob - o.pivot).Magnitude)
			o.arm.CFrame = CFrame.lookAt((bob + o.pivot) / 2, bob)
		elseif kind == "vanish" or kind == "collapse" then
			local cycle = (age + o.phase) % d.period
			local solid = cycle < d.period - d.open
			local warning = cycle > d.period - d.open - 0.75
			local mode = if not solid then "out" elseif warning then "warning" else "solid"
			if o.mode ~= mode then
				o.mode = mode
				p.CanCollide = solid
				p.Transparency = if not solid then 0.85 elseif warning then 0.22 else 0
				p.Color = if warning then tileWarning else d.color or tileSafe
			end
		elseif kind == "pulse" then
			local cycle = (age + o.phase) % d.period
			active = cycle >= d.period - d.open
			local mode = if active then "live" elseif cycle >= d.period-d.open-0.72 then "warning" else "safe"
			if o.mode ~= mode then
				o.mode = mode
				p.Color = if mode == "live" then pulseLive elseif mode == "warning" then pulseWarning else d.color or pulseSafe
				p.Transparency = if active then 0 else 0.16
			end
		elseif kind == "boulder" then
			local cycle = (age + o.phase) % d.period
			local traveled = math.min(cycle/d.travel,1)
			active = cycle < d.travel
			local position = active and (1-traveled*2)*d.range or d.range
			p.CFrame = (o.base + Vector3.zAxis*position) * CFrame.Angles(-traveled*8.2,0,0)
			p.Transparency = if active then 0 elseif cycle >= d.period-0.95 then 0.22 else 1
		elseif kind == "door" then p.CFrame = o.base + Vector3.new(0, (s + 1) * d.range / 2, 0)
		end
		if not active then continue end
		if not d.damage and old == p.CFrame and kind ~= "launch" and kind ~= "gravity" then continue end
		for player, racer in racers do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not root or root.Anchored or racer.finished or racer.out or racer.recovering then continue end
			local probeOffset = if kind == "pulse" then 2.1 elseif kind == "sweep" or kind == "roller" then 1 else 0
			local probe = root.Position-Vector3.yAxis * probeOffset
			local localPos = p.CFrame:PointToObjectSpace(probe)
			local half = p.Size * 0.5
			if d.damage then
				if hitsRacer(localPos,half,d.shape) then
					damage(player, racer, d.damage, p)
				end
			elseif kind == "moving" or kind == "tilt" then
				local previous = old:PointToObjectSpace(root.Position)
				if math.abs(previous.X) <= half.X and math.abs(previous.Z) <= half.Z and previous.Y > half.Y + 1.4 and previous.Y < half.Y + 3.8 and root.AssemblyLinearVelocity.Y < 5 then
					local carried = p.CFrame:PointToWorldSpace(previous)
					root.CFrame += carried-root.Position
				end
			elseif math.abs(localPos.X) <= half.X and math.abs(localPos.Z) <= half.Z then
				if kind == "launch" and localPos.Y > 0 and localPos.Y < 3.4 and root.AssemblyLinearVelocity.Y <= 1 then
					root.AssemblyLinearVelocity += Vector3.new(0, d.speed, 0)
				elseif kind == "gravity" and math.abs(localPos.Y) < half.Y then
					local force = root:FindFirstChild("CourseLift")
					if not force then
						local attachment = Instance.new("Attachment", root)
						attachment.Name = "CourseLiftAttachment"
						force = Instance.new("VectorForce", root)
						force.Name = "CourseLift"
						force.Attachment0 = attachment
						force.RelativeTo = Enum.ActuatorRelativeTo.World
						force.ApplyAtCenterOfMass = true
					end
					force.Force = Vector3.yAxis * d.speed * root.AssemblyMass
					course.gravityApplied = course.gravityApplied or {}
					course.gravityApplied[root] = true
				end
			end
		end
	end
end

function O.cleanup(course)
	for root in course.gravityApplied or {} do
		for _, name in {"CourseLift", "CourseLiftAttachment"} do
			local item = root:FindFirstChild(name)
			if item then item:Destroy() end
		end
	end
end
return O
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[local Marketplace = game:GetService("MarketplaceService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local Config = require(Shared.Config)
local Data = require(script.Parent.Data)
local Shop = {}

local function grant(player,id)
	local data = Data.get(player)
	if not data then return end
	data.skins[id] = true
	if id == "VIP" then data.trails.VIP = true end
end

local function owns(player,id,pass)
	local ok,result = pcall(Marketplace.UserOwnsGamePassAsync, Marketplace,player.UserId,pass)
	if ok and result then grant(player,id) end
	return ok, result
end

function Shop.refresh(player)
	for id, pass in Config.passes do
		if pass > 0 then owns(player,id,pass) end
	end
end

function Shop.listen(changed)
	Marketplace.PromptGamePassPurchaseFinished:Connect(function(player, pass, purchased)
		if not purchased then return end
		for id, configured in Config.passes do
			if configured > 0 and configured == pass then
				-- This event is supplied by MarketplaceService on the server.
				grant(player,id)
				changed(player)
				break
			end
		end
	end)
end

function Shop.select(player,kind,id)
	local data = Data.get(player)
	if not data then return "Profile loading" end
	if kind == "skin" then
		local skin = Config.bySkin[id]
		if not skin then return "Unknown egg" end
		if not data.skins[id] then
			if typeof(skin[3]) == "number" then
				if data.coins < skin[3] then return "You need more coins" end
				data.coins -= skin[3]
				data.skins[id] = true
			else
				local pass = Config.passes[id]
				if not pass or pass <= 0 then return "Currently unavailable" end
				local ok, owned = owns(player,id,pass)
				if not ok then return "Marketplace unavailable" end
				if not owned then
					return "Review the price in Roblox", pass
				end
			end
		end
		data.skin = id
	elseif kind == "trail" then
		if id ~= "" and not data.trails[id] then
			local price = Config.trails[id]
			if not price or data.coins < price then return "Trail unavailable or insufficient coins" end
			data.coins -= price
			data.trails[id] = true
		end
		data.trail = id
	elseif kind == "title" then
		local number = tonumber(id)
		if not number or number % 1 ~= 0 or number > 4 or not Config.titleXP[number] or data.xp < Config.titleXP[number] then
			return "Title locked"
		end
		data.title = number
	end
	Data.summary(player)
	return "Equipped"
end
return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local EggModel = require(Shared.EggModel)
local Levels = require(Shared.Levels)
local Obstacles = require(script.Parent.Obstacles)

local World = {}
local color = Color3.fromHex
local tar = color("28343b")
local dark = color("151f25")
local slate = color("3f5258")
local bone = color("f4ebd4")
local yolk = color("ffbb39")
local teal = color("4ed1b2")
local coral = color("f47758")
local silver = color("718990")

local function part(parent, name, size, cf, tint, material, solid, shape)
	local item = Obstacles.part(parent, name, size, cf, tint, solid == true, shape)
	item.Material = material or Enum.Material.SmoothPlastic
	if not solid then item.CanQuery = false end
	return item
end

local function box(parent, name, position, size, tint, material, solid)
	return part(parent,name,size,CFrame.new(position),tint,material,solid)
end

local function beam(parent, name, from, to, thickness, tint, material)
	return part(parent,name,Vector3.new(thickness,thickness,(to-from).Magnitude),
		CFrame.lookAt((from+to)/2,to),tint,material)
end

local function sign(parent, name, position, size, caption, fill, ink, font, face)
	local plate = box(parent,name,position,Vector3.new(size.X,size.Y,0.35),fill,Enum.Material.Metal)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Printed face"
	gui.Face = face or Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.PixelsPerStud = 36
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = plate
	local label = Instance.new("TextLabel")
	label.Name = "Lettering"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0.055,0.10)
	label.Size = UDim2.fromScale(0.89,0.8)
	label.Font = font or Enum.Font.Oswald
	label.Text = caption
	label.TextColor3 = ink
	label.TextScaled = true
	label.Parent = gui
	return label
end

local function prompt(parent, position, caption, object, key, action)
	local marker = box(parent,object.." prompt",position,Vector3.new(1,1,1),tar)
	marker.Transparency = 1
	local input = Instance.new("ProximityPrompt")
	input.ActionText = caption
	input.ObjectText = object
	input.MaxActivationDistance = 10
	input.RequiresLineOfSight = false
	input.Parent = marker
	input.Triggered:Connect(function(player)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position-position).Magnitude <= 12 then action(player,key) end
	end)
end

local function platform(parent, name, x, z, width, depth, surface, trim)
	box(parent,name.." base",Vector3.new(x,0.21,z),Vector3.new(width,0.42,depth),trim,Enum.Material.Metal,true)
	box(parent,name.." deck",Vector3.new(x,0.48,z),Vector3.new(width-0.58,0.18,depth-0.58),surface,Enum.Material.Concrete,true)
end

local function runway(parent)
	box(parent,"Launch lane",Vector3.new(0,0.024,-7),Vector3.new(22,0.048,59),dark,Enum.Material.Asphalt)
	for _, side in {-1,1} do
		box(parent,"Lane edge",Vector3.new(side*10.8,0.052,-7),Vector3.new(0.26,0.025,59),yolk)
		for z=-30,19,7 do
			box(parent,"Lane lamp",Vector3.new(side*11.7,0.13,z),Vector3.new(0.75,0.26,0.7),yolk,Enum.Material.Neon)
		end
	end
	for z=-26,15,8 do
		for _, side in {-1,1} do
			part(parent,"Runway chevron",Vector3.new(0.28,0.026,4.2),
				CFrame.new(side*1.45,0.061,z)*CFrame.Angles(0,side*math.rad(45),0),bone)
		end
	end
end

local function crate(parent, x, z, width, tint)
	box(parent,"Freight crate",Vector3.new(x,width/2,z),Vector3.new(width,width,width),tint,Enum.Material.WoodPlanks)
	for _, side in {-1,1} do
		box(parent,"Crate band",Vector3.new(x+side*width*0.27,width/2,z),
			Vector3.new(0.27,width+0.12,width+0.12),dark,Enum.Material.Metal)
	end
end

local function railing(parent, x, fromZ, toZ)
	beam(parent,"Safety rail",Vector3.new(x,2.65,fromZ),Vector3.new(x,2.65,toZ),0.18,yolk,Enum.Material.Metal)
	beam(parent,"Safety rail",Vector3.new(x,1.35,fromZ),Vector3.new(x,1.35,toZ),0.12,silver,Enum.Material.Metal)
	for z=fromZ,toZ,6 do
		box(parent,"Rail post",Vector3.new(x,1.45,z),Vector3.new(0.27,2.9,0.27),slate,Enum.Material.Metal)
	end
	-- A single invisible wall keeps the deck edge safe without joining rail pieces into colliders.
	local barrier = box(parent,"Deck barrier",Vector3.new(x,3,(fromZ+toZ)/2),
		Vector3.new(0.25,6,toZ-fromZ),slate,nil,true)
	barrier.Transparency = 1
end

local function landscaping(parent)
	local grass = color("4d745d")
	local rock = color("60605b")
	for _, side in {-1,1} do
		box(parent,"Raised planted verge",Vector3.new(side*58,0.65,0),Vector3.new(9,1.3,92),grass,Enum.Material.Grass,true)
		for z=-38,38,12 do
			local x = side*(58 + (z%5-2)*0.45)
			local height = 3.5 + (z%4)*0.5
			box(parent,"Windbreak trunk",Vector3.new(x,1.3+height/2,z),Vector3.new(0.6,height,0.6),color("77604c"),Enum.Material.Wood)
			for i=1,3 do
				local tint = ({color("35615c"),color("577d62"),color("6f8e6c")})[i]
				part(parent,"Sculpted tree canopy",Vector3.new(4.4-i*0.44,2.2,3.6-i*0.36),
					CFrame.new(x+side*(i-2)*0.63,height+i*0.7,z)*CFrame.Angles(0,i,math.rad(-side*20)),tint)
			end
		end
		railing(parent,side*52.6,-48,48)
	end
	box(parent,"Terminal foundation",Vector3.new(0,-4.2,1),Vector3.new(131,6.4,103),rock,Enum.Material.Slate)
	box(parent,"Terminal foundation band",Vector3.new(0,-1.8,1),Vector3.new(132,1.0,104),color("9f967e"),Enum.Material.Concrete)
	local random = Random.new(861)
	for i=1,15 do
		local x = (i-8)*7.6
		local depth = random:NextNumber(13,27)
		local height = random:NextNumber(6,13)
		part(parent,"Cliff shelf",Vector3.new(11,height,depth),
			CFrame.new(x,-8-height*0.4,random:NextNumber(-24,25))*CFrame.Angles(0,random:NextNumber(-0.5,0.5),random:NextNumber(-0.15,0.15)),
			if i%2 == 0 then rock else color("776e5e"),Enum.Material.Rock)
	end
end

local function beacon(parent, x, z)
	box(parent,"Mast foot",Vector3.new(x,1.1,z),Vector3.new(2.8,2.2,2.8),tar,Enum.Material.Metal,true)
	box(parent,"Apron light mast",Vector3.new(x,7.3,z),Vector3.new(0.62,12.6,0.62),slate,Enum.Material.Metal)
	local lightBar = box(parent,"Light bar",Vector3.new(x,13.7,z),Vector3.new(4,0.55,0.72),dark,Enum.Material.Metal)
	for offset=-1.4,1.4,1.4 do
		box(parent,"Apron lamp",Vector3.new(x+offset,13.65,z-0.35),Vector3.new(0.7,0.27,0.18),bone,Enum.Material.Neon)
	end
	local light = Instance.new("PointLight")
	light.Color = bone
	light.Brightness = 0.65
	light.Range = 16
	light.Parent = lightBar
end

local function hangar(parent, action)
	local hall = Instance.new("Folder")
	hall.Name = "Race Gate"
	hall.Parent = parent
	platform(hall,"Race launch",0,29,28,26,tar,yolk)
	for _, side in {-1,1} do
		box(hall,"Hangar wall",Vector3.new(side*13.65,5.8,29),Vector3.new(0.7,11.6,26),slate,Enum.Material.Metal,true)
		for _, z in {16,24,32,40} do
			box(hall,"Hangar ribs",Vector3.new(side*13.1,5.75,z),Vector3.new(0.35,11.5,0.55),dark,Enum.Material.Metal)
		end
		for y=2,9,3.5 do
			box(hall,"Gate light",Vector3.new(side*12.98,y,15.9),Vector3.new(0.48,2.1,0.35),yolk,Enum.Material.Neon)
		end
		part(hall,"Hangar roof",Vector3.new(15,0.62,28),
			CFrame.new(side*7,12.25,29)*CFrame.Angles(0,0,side*math.rad(-11)),dark,Enum.Material.Metal,true)
		box(hall,"Runway guide",Vector3.new(side*10.7,0.59,28),Vector3.new(0.16,0.04,22),yolk)
		crate(hall,side*10.5,37,2.6,yolk)
	end
	box(hall,"Gate backing",Vector3.new(0,5.8,41.72),Vector3.new(27,11.6,0.6),tar,Enum.Material.Metal,true)
	for x=-9,9,3 do
		box(hall,"Gate interior panel",Vector3.new(x,5.1,41.36),Vector3.new(2.8,9.2,0.28),slate,Enum.Material.Metal)
	end
	box(hall,"Gate sign girder",Vector3.new(0,9.3,15.8),Vector3.new(27,0.52,0.68),dark,Enum.Material.Metal)
	sign(hall,"Gate identifier",Vector3.new(0,9.3,15.3),Vector2.new(17,2.6),"RACE GATE",yolk,dark)
	sign(hall,"Terminal title",Vector3.new(0,15.6,15.15),Vector2.new(32,3.3),"DON’T CRACK THE EGG!",dark,bone)
	for _, side in {-1,1} do
		beam(hall,"Marquee mount",Vector3.new(side*12,11.66,16.0),Vector3.new(side*12,16.7,15.6),0.55,slate,Enum.Material.Metal)
		box(hall,"Title trim",Vector3.new(side*16.6,15.6,15.15),Vector3.new(0.45,3.3,0.35),coral,Enum.Material.Metal)
	end

	box(hall,"Roof cradle",Vector3.new(0,13.7,26),Vector3.new(11,1.3,8),slate,Enum.Material.Metal)
	box(hall,"Roof cradle trim",Vector3.new(0,14.4,26),Vector3.new(10,0.35,7.5),yolk,Enum.Material.Metal)
	local trophy = EggModel.build("Golden",8,true)
	trophy.Name = "Terminal trophy"
	trophy:PivotTo(CFrame.new(0,20,24)*CFrame.Angles(0,0,math.rad(-14)))
	trophy.Parent = hall
	for _, side in {-1,1} do
		beam(hall,"Cradle bracket",Vector3.new(side*5.2,14.3,23),Vector3.new(side*4.2,18,23),0.44,dark,Enum.Material.Metal)
	end
	prompt(hall,Vector3.new(0,3,19),"Enter race","Race Gate","queue",action)
end

local function shop(parent, action)
	local kiosk = Instance.new("Folder")
	kiosk.Name = "Egg Shop"
	kiosk.Parent = parent
	local x,z = -37,-13
	platform(kiosk,"Market stall",x,z,22,16,slate,teal)
	box(kiosk,"Back wall",Vector3.new(x,4.2,z+7.4),Vector3.new(21,8.4,0.55),color("246c66"),Enum.Material.Metal,true)
	for _, side in {-1,1} do
		box(kiosk,"Market post",Vector3.new(x+side*10.2,4.4,z-3.5),Vector3.new(0.5,8.8,0.55),dark,Enum.Material.Metal)
		box(kiosk,"Market showcase",Vector3.new(x+side*7.1,1.62,z+2.4),Vector3.new(5.4,2.12,3.1),dark,Enum.Material.Metal,true)
		box(kiosk,"Showcase lighting",Vector3.new(x+side*7.1,2.75,z+2.4),Vector3.new(5.1,0.16,2.9),teal,Enum.Material.Neon)
	end
	for i=1,11 do
		part(kiosk,"Market awning",Vector3.new(1.95,0.24,8.2),
			CFrame.new(x+(i-6)*1.95,8.8,z)*CFrame.Angles(math.rad(-12),0,0),
			if i%2 == 0 then teal else bone,Enum.Material.Fabric)
	end
	box(kiosk,"Awning valance",Vector3.new(x,8.8,z-4.75),Vector3.new(21,0.5,0.62),dark,Enum.Material.Metal)
	sign(kiosk,"Shop sign",Vector3.new(x,8.8,z-5.2),Vector2.new(15,2.3),"EGG SHOP",teal,dark)
	for i, skin in {"Watermelon","Ninja","Frozen","Lava"} do
		local address = ({-8.2,-6.0,6.0,8.2})[i]
		local prop = EggModel.build(skin,1.6,true)
		prop:PivotTo(CFrame.new(x+address,3.85,z+2.4)*CFrame.Angles(0,i*0.7,0))
		prop.Parent = kiosk
	end
	prompt(kiosk,Vector3.new(x,2.5,z-3.7),"Browse shells","Egg Shop","Shop",action)
end

local function warmup(parent, action)
	local zone = Instance.new("Folder")
	zone.Name = "Warmup Bay"
	zone.Parent = parent
	local x,z = 37,-13
	platform(zone,"Warmup mat",x,z,23,19,tar,coral)
	for _, side in {-1,1} do
		box(zone,"Warmup uprights",Vector3.new(x+side*10.6,3.8,z+1),Vector3.new(0.7,7.6,0.7),slate,Enum.Material.Metal)
		box(zone,"Warmup side mat",Vector3.new(x+side*8.1,0.86,z+2),Vector3.new(2.6,0.58,7.2),coral,Enum.Material.Rubber,true)
	end
	for i=1,5 do
		local height = 0.22 + i*0.14
		box(zone,"Footwork block",Vector3.new(x+5.5,0.57+height/2,z+11.5-i*1.9),Vector3.new(1,height,1.45),
			if i%2 == 0 then yolk else coral,Enum.Material.Rubber,true)
	end
	box(zone,"Warmup sign girder",Vector3.new(x,7.0,z+1),Vector3.new(22,0.45,0.74),slate,Enum.Material.Metal)
	sign(zone,"Warmup banner",Vector3.new(x,7.0,z+0.45),Vector2.new(18,2.3),"WARMUP BAY",coral,dark)
	for i=1,19 do
		local offset = (i-10)*1.12
		part(zone,"Hazard print",Vector3.new(0.58,0.04,0.85),
			CFrame.new(x+offset,0.59,z-8.5)*CFrame.Angles(0,math.rad(25),0),yolk)
	end
	local demo = {model = zone, obstacles = {}}
	Obstacles.add(demo,"sweep",Vector3.new(x-1.8,0.58,z+3.0),1,{damage=false,size=Vector3.new(10,0.75,0.9),speed=1.9})
	prompt(zone,Vector3.new(x,2.5,z-5.1),"Start practice","Warmup Bay","practice",action)
	return demo
end

local function islandDesk(parent, action)
	local display = Instance.new("Folder")
	display.Name = "Island Atlas"
	display.Parent = parent
	local tint = color("96afe4")
	local x,z = 36,25
	platform(display,"Atlas platform",x,z,25,17,tar,tint)
	box(display,"Atlas backboard",Vector3.new(x,4.4,z+7.6),Vector3.new(24,8.8,0.5),slate,Enum.Material.Metal,true)
	sign(display,"Atlas sign",Vector3.new(x,7.4,z+7.15),Vector2.new(20,2.8),"ISLAND ATLAS",tint,dark)
	box(display,"Model table",Vector3.new(x,1.95,z+2.4),Vector3.new(22,2.8,5.4),dark,Enum.Material.Metal,true)
	local islandColors = {color("729b4a"),coral,color("8bebf1"),color("b585ec"),color("c6a47a")}
	local islands = {}
	local seen = {}
	for _, level in ipairs(Levels) do
		local island = level.island
		if island and not seen[island] then
			table.insert(islands,island)
			seen[island] = true
		end
	end
	for i, island in islands do
		local pos = x+(i-(#islands+1)/2)*4.32
		local islandColor = islandColors[i] or tint
		local center = Vector3.new(pos,3.5,z+2.6)
		box(display,"Model island base",center,Vector3.new(4.08,0.32,3.8),islandColor,Enum.Material.Slate)
		if i == 1 then
			box(display,"Mini course",center+Vector3.new(0,0.72,0),Vector3.new(2.8,0.94,1.65),yolk,Enum.Material.Fabric)
			box(display,"Mini finish arch",center+Vector3.new(1.4,1.48,0),Vector3.new(0.26,2.1,1.68),coral)
		elseif i == 2 then
			part(display,"Foundry volcano",Vector3.new(2.1,2.6,1.85),
				CFrame.new(center+Vector3.new(0,1.12,0))*CFrame.Angles(0,0,-0.24),slate,Enum.Material.Basalt)
			box(display,"Foundry lava",center+Vector3.new(0,2.47,0),Vector3.new(1.45,0.12,1.28),coral,Enum.Material.Neon)
		elseif i == 3 then
			for j=-1,1 do
				part(display,"Glacier shard",Vector3.new(0.85,2.0-math.abs(j)*0.45,1.1),
					CFrame.new(center+Vector3.new(j*0.8,0.97,0))*CFrame.Angles(0,0,math.rad(j*24)),islandColor,Enum.Material.Ice)
			end
		elseif i == 4 then
			part(display,"Orbital relay",Vector3.new(1.8,1.8,1.8),
				CFrame.new(center+Vector3.new(0,1.42,0)),islandColor,Enum.Material.Neon,false,Enum.PartType.Ball)
			beam(display,"Relay antenna",center+Vector3.new(0,0.18,0),center+Vector3.new(0,1.25,0),0.27,bone)
		else
			for _, side in {-1,1} do
				box(display,"Ruins altar column",center+Vector3.new(side*1.05,0.85,0),Vector3.new(0.42,1.55,0.53),
					islandColor,Enum.Material.Sandstone)
			end
			box(display,"Ruins altar lintel",center+Vector3.new(0,1.61,0),Vector3.new(2.73,0.37,0.84),islandColor,Enum.Material.Sandstone)
			local relic = EggModel.build("Golden",0.63,true)
			relic.Name = "Model relic"
			relic:PivotTo(CFrame.new(center+Vector3.new(0,0.65,-0.62)))
			relic.Parent = display
		end
		sign(display,island.." nameplate",Vector3.new(pos,1.92,z-0.58),Vector2.new(4.1,1.25),island,dark,islandColor,Enum.Font.GothamBold)
	end
	prompt(display,Vector3.new(x,2.5,z-3.6),"View courses","Island Atlas","Courses",action)
end

local function scoreboard(parent)
	local room = Instance.new("Folder")
	room.Name = "Winners' Circle"
	room.Parent = parent
	local x,z = -36,26
	platform(room,"Podium floor",x,z,25,18,slate,yolk)
	box(room,"Scoreboard stand",Vector3.new(x,4.3,z+7.8),Vector3.new(24,8.6,0.9),dark,Enum.Material.Metal,true)
	for _, side in {-1,1} do
		box(room,"Board rails",Vector3.new(x+side*11.95,4.3,z+7.2),Vector3.new(0.5,8.6,0.34),yolk,Enum.Material.Metal)
	end
	local board = sign(room,"Scoreboard",Vector3.new(x,5.3,z+7.0),Vector2.new(22,6.0),
		"SERVER LEADERS",dark,bone,Enum.Font.RobotoMono)
	local ranks = {}
	for place, config in {{0,3.0,yolk},{-7,2.15,teal},{7,1.45,coral}} do
		local stepX = x+config[1]
		local height = config[2]
		box(room,"Podium step",Vector3.new(stepX,height/2+0.56,z+0.8),Vector3.new(6.5,height,5.8),
			config[3],Enum.Material.Metal,true)
		box(room,"Podium tread",Vector3.new(stepX,height+0.6,z+0.8),Vector3.new(6.3,0.14,5.6),dark,Enum.Material.Rubber)
		local plate = sign(room,"Podium place",Vector3.new(stepX,0.53+height*0.56,z-2.25),Vector2.new(6.25,math.min(0.98,height-0.2)),
			tostring(place),dark,bone,Enum.Font.GothamBold)
		ranks[place] = plate
	end
	return board,ranks
end

function World.lobby(action)
	Lighting.ClockTime = 15.3
	Lighting.Brightness = 2.1
	Lighting.Ambient = color("7a8286")
	Lighting.OutdoorAmbient = color("bbc6cc")
	local air = Instance.new("Atmosphere")
	air.Name = "Terminal sky"
	air.Density = 0.23
	air.Haze = 0.72
	air.Color = color("d3e9f7")
	air.Decay = color("90aebb")
	air.Parent = Lighting

	local authored = workspace:FindFirstChild("CourierLobby")
	if not authored then
		authored = Instance.new("Folder")
		authored.Name = "CourierLobby"
		authored.Parent = workspace
	end
	if not authored:FindFirstChild("Stage floor") then
		box(authored,"Stage floor",Vector3.new(0,-1,0),Vector3.new(130,2,100),tar,Enum.Material.Asphalt,true)
	end
	local spawn = authored:FindFirstChild("CourierSpawn")
	if not spawn then
		spawn = Instance.new("SpawnLocation")
		spawn.Name = "CourierSpawn"
		spawn.Size = Vector3.new(12,0.22,7)
		spawn.Position = Vector3.new(0,0.11,-36)
		spawn.Transparency = 1
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Anchored = true
		spawn.Parent = authored
	end

	local terminal = Instance.new("Model")
	terminal.Name = "Shell Yard Terminal"
	terminal.Parent = authored
	runway(terminal)
	landscaping(terminal)
	for _, side in {-1,1} do
		beacon(terminal,side*16.5,-30)
		crate(terminal,side*47,-35,3.0,if side == 1 then coral else teal)
		crate(terminal,side*43,-37,2.2,yolk)
		box(terminal,"Apron stripe",Vector3.new(side*31,0.055,-27),Vector3.new(30,0.045,0.18),bone)
		box(terminal,"Apron stripe",Vector3.new(side*31,0.055,6),Vector3.new(30,0.045,0.18),bone)
	end
	hangar(terminal,action)
	shop(terminal,action)
	local demo = warmup(terminal,action)
	islandDesk(terminal,action)
	local board, podium = scoreboard(terminal)
	return spawn.Position+Vector3.new(0,3.56,0),demo,board,podium
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">EggClient</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("EggShared").Config)
local A = {music=0.35, effects=0.65}

function A.play(key)
	local id = Config.audio[key]
	if not id or id <= 0 then return end
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. id
	sound.Volume = key == "Music" and A.music or A.effects
	sound.Looped = key == "Music"
	sound.Parent = SoundService
	sound:Play()
	if sound.Looped then A.track = sound else Debris:AddItem(sound,20) end
end

function A.setLobby(enabled)
	if enabled and not A.track then A.play("Music") end
	if A.track then
		A.track.Volume = A.music
		if enabled then A.track:Resume() else A.track:Pause() end
	end
end
return A
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="19">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local MarketplaceService = game:GetService("MarketplaceService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("EggShared")
local Config = require(Shared.Config)
local Levels = require(Shared.Levels)
local Rules = require(Shared.RaceRules)
local Egg = require(Shared.EggModel)
local Audio = require(script.Parent.Audio)
local remote = Shared:WaitForChild("CourierEvent")
local player = Players.LocalPlayer

local rgb = Color3.fromHex
local ink, charcoal, muted = rgb("20281f"), rgb("374138"), rgb("596451")
local paper, cream = rgb("fff5d8"), rgb("ebe1c4")
local yellow, lime, rust = rgb("ffc639"), rgb("d3f480"), rgb("ff7657")
local typeface = Enum.Font.GothamMedium
local heavy = Enum.Font.GothamBlack
local digits = Enum.Font.Code
local state = {stage = "Lobby", selected = 1, level = 1, deadline = 0}
local race = {hp = 3, place = 1, total = 1, progress = 0, cooldown = 0, recover = 0}
local profile = {skins = {Classic = true}, skin = "Classic", trails = {}, records = {}, title = 1}
local tab, preview = nil, "Classic"
local setTab, draw

local gui = Instance.new("ScreenGui")
gui.Name = "CourierBroadcast"
gui.ResetOnSpawn = false
gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent, radius)
	local instance = Instance.new("UICorner")
	instance.CornerRadius = UDim.new(0, radius)
	instance.Parent = parent
end

local function outline(parent, color, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = color
	stroke.Thickness = thickness or 1
	stroke.Parent = parent
end

local function frame(parent, color, size, position, radius)
	local instance = Instance.new("Frame")
	instance.BorderSizePixel = 0
	instance.BackgroundTransparency = color and 0 or 1
	if color then instance.BackgroundColor3 = color end
	instance.Size = size
	instance.Position = position or UDim2.new()
	if radius then corner(instance, radius) end
	instance.Parent = parent
	return instance
end

local function label(parent, text, color, size, position, textSize, font)
	local instance = Instance.new("TextLabel")
	instance.BackgroundTransparency = 1
	instance.TextColor3 = color
	instance.Text = text
	instance.Font = font or typeface
	instance.TextSize = textSize
	instance.TextTruncate = Enum.TextTruncate.AtEnd
	instance.Size = size
	instance.Position = position or UDim2.new()
	instance.Parent = parent
	return instance
end

local function left(instance)
	instance.TextXAlignment = Enum.TextXAlignment.Left
	return instance
end

local function button(parent, text, color, textColor, callback)
	local instance = Instance.new("TextButton")
	instance.AutoButtonColor = true
	instance.BorderSizePixel = 0
	instance.BackgroundColor3 = color
	instance.TextColor3 = textColor
	instance.Text = text
	instance.TextTruncate = Enum.TextTruncate.AtEnd
	instance.TextSize = 13
	instance.Font = Enum.Font.GothamBold
	instance.Size = UDim2.new(1, 0, 0, 36)
	corner(instance, 5)
	instance.Parent = parent
	instance.Activated:Connect(function()
		Audio.play("Click")
		callback()
	end)
	return instance
end

local function limit(parent, x, y)
	local instance = Instance.new("UISizeConstraint")
	instance.MaxSize = Vector2.new(x, y)
	instance.Parent = parent
end

local function fire(action, value)
	remote:FireServer(action, value)
end

local function now()
	return workspace:GetServerTimeNow()
end

local function clock(seconds)
	local rounded = math.max(0, math.ceil(seconds))
	return ("%d:%02d"):format(rounded // 60, rounded % 60)
end

local function isGamepad()
	return UserInputService:GetLastInputType().Name:match("^Gamepad") ~= nil
end

local root = frame(gui, nil, UDim2.fromScale(1, 1))
local tint = frame(root, rust, UDim2.fromScale(1, 1))
tint.BackgroundTransparency = 1

local hud = frame(root, ink, UDim2.new(1, -30, 0, 69), UDim2.new(0.5, 0, 0, 8), 7)
hud.AnchorPoint = Vector2.new(0.5, 0)
limit(hud, 340, 69)
local courseName = left(label(hud, "", paper, UDim2.new(1, -117, 0, 22), UDim2.fromOffset(12, 5), 13, heavy))
local raceStatus = left(label(hud, "", lime, UDim2.new(1, -137, 0, 20), UDim2.fromOffset(12, 30), 12, digits))
local raceTime = label(hud, "0:00", yellow, UDim2.fromOffset(61, 28), UDim2.new(1, -70, 0, 3), 24, digits)
raceTime.TextXAlignment = Enum.TextXAlignment.Right
local eggs = {}
for index = 1, 3 do
	local icon = frame(hud, paper, UDim2.fromOffset(11, 15), UDim2.new(1, -55 + (index - 1) * 16, 0, 35), 7)
	icon.Rotation = 12
	eggs[index] = icon
end
local progress = frame(hud, charcoal, UDim2.new(1, -24, 0, 3), UDim2.fromOffset(12, 59), 2)
local progressFill = frame(progress, lime, UDim2.fromScale(0, 1), nil, 2)

local wallet = frame(root, paper, UDim2.fromOffset(93, 33), UDim2.new(1, -13, 0, 9), 5)
wallet.AnchorPoint = Vector2.new(1, 0)
outline(wallet, ink, 1.5)
local coin = frame(wallet, yellow, UDim2.fromOffset(14, 14), UDim2.fromOffset(10, 9), 7)
outline(coin, ink)
label(coin, "•", ink, UDim2.fromScale(1, 1), nil, 11, heavy)
local coinCount = left(label(wallet, "0", ink, UDim2.fromOffset(60, 25), UDim2.fromOffset(29, 4), 17, digits))

local dock = frame(root, ink, UDim2.new(1, -24, 0, 52), UDim2.new(0.5, 0, 1, -14), 7)
dock.AnchorPoint = Vector2.new(0.5, 1)
limit(dock, 448, 52)
local dockInterior = frame(dock, nil, UDim2.new(1, -12, 1, -12), UDim2.fromOffset(6, 6))
local play = button(dockInterior, "RACE", yellow, ink, function()
	fire((state.queued or state.practiceQueued) and "lobby" or "queue")
end)
play.Size = UDim2.new(0.25, -4, 1, 0)
for index, item in ipairs({{"ISLANDS", "Courses"}, {"LOCKER", "Shop"}, {"STATS", "Stats"}, {"AUDIO", "Settings"}}) do
	local option = button(dockInterior, item[1], charcoal, paper, function()
		setTab(item[2])
	end)
	option.TextSize = 11
	option.Size = UDim2.new(0.1875, -4, 1, 0)
	option.Position = UDim2.fromScale(0.25 + (index - 1) * 0.1875, 0)
end
local queueStatus = label(root, "", paper, UDim2.new(1, -40, 0, 26), UDim2.new(0.5, 0, 1, -74), 13, heavy)
queueStatus.AnchorPoint = Vector2.new(0.5, 1)
queueStatus.TextStrokeColor3 = ink
queueStatus.TextStrokeTransparency = 0.16

local banner = label(root, "", paper, UDim2.new(1, -20, 0, 90), UDim2.new(0.5, 0, 0.33, 0), 72, heavy)
banner.AnchorPoint = Vector2.new(0.5, 0)
banner.TextStrokeColor3 = ink
banner.TextStrokeTransparency = 0.03
banner.Visible = false

local toast = frame(root, ink, UDim2.new(1, -36, 0, 31), UDim2.new(0.5, 0, 0, 85), 5)
toast.AnchorPoint = Vector2.new(0.5, 0)
toast.Visible = false
toast.ZIndex = 12
limit(toast, 310, 31)
local toastText = label(toast, "", yellow, UDim2.new(1, -18, 1, 0), UDim2.fromOffset(9, 0), 12, heavy)
local toastVersion = 0
local function notice(message)
	toastVersion += 1
	local current = toastVersion
	toastText.Text = message
	toast.Visible = true
	task.delay(1.9, function()
		if current == toastVersion then toast.Visible = false end
	end)
end

local shove = button(root, "SHOVE", rust, ink, function() fire("shove") end)
shove.AnchorPoint = Vector2.new(1, 0.5)
shove.Position = UDim2.new(1, -14, 0.60, 0)
shove.Size = UDim2.fromOffset(92, 51)
shove.Visible = false
outline(shove, ink, 1.5)

local practiceExit = button(root, "LEAVE PRACTICE", ink, paper, function() fire("lobby") end)
practiceExit.AnchorPoint = Vector2.new(0.5, 1)
practiceExit.Position = UDim2.new(0.5, 0, 1, -14)
practiceExit.Size = UDim2.fromOffset(132, 34)
practiceExit.Visible = false

local resultOpen = button(root, "RESULTS", yellow, ink, function() setTab("Results") end)
resultOpen.AnchorPoint = Vector2.new(0.5, 1)
resultOpen.Position = UDim2.new(0.5, 0, 1, -14)
resultOpen.Size = UDim2.fromOffset(106, 36)
resultOpen.Visible = false

ContextActionService:BindAction("CourierShove", function(_, status)
	if not shove.Visible then return Enum.ContextActionResult.Pass end
	if status == Enum.UserInputState.Begin then fire("shove") end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonX)

local modal = frame(root, nil, UDim2.fromScale(1, 1))
modal.ZIndex = 10
modal.Visible = false
local shade = frame(modal, ink, UDim2.fromScale(1, 1))
shade.BackgroundTransparency = 0.56
shade.Active = true
local panel = frame(modal, paper, UDim2.new(1, -26, 0, 240), UDim2.fromScale(0.5, 0.5), 7)
panel.AnchorPoint = Vector2.new(0.5, 0.5)
limit(panel, 500, 620)
outline(panel, ink, 2)
local panelStripe = frame(panel, yellow, UDim2.new(1, 0, 0, 5), nil, 2)
local panelTitle = left(label(panel, "", ink, UDim2.new(1, -72, 0, 47), UDim2.fromOffset(15, 5), 23, heavy))
local close = button(panel, "✕", cream, ink, function() setTab(nil) end)
close.Size = UDim2.fromOffset(32, 31)
close.Position = UDim2.new(1, -44, 0, 13)
close.TextSize = 17

local list = Instance.new("ScrollingFrame")
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.Position = UDim2.fromOffset(13, 54)
list.Size = UDim2.new(1, -26, 1, -67)
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.CanvasSize = UDim2.new()
list.ScrollBarThickness = 4
list.ScrollBarImageColor3 = muted
list.Parent = panel
local layout = Instance.new("UIListLayout")
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Padding = UDim.new(0, 6)
layout.Parent = list

local function resizePanel()
	local viewportHeight = root.AbsoluteSize.Y
	if viewportHeight == 0 or not modal.Visible then return end
	panel.Size = UDim2.new(1, -26, 0, math.min(layout.AbsoluteContentSize.Y + 70, viewportHeight - 20, 620))
end
layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resizePanel)
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(resizePanel)

local rowOrder = 0
local function append(instance)
	rowOrder += 1
	instance.LayoutOrder = rowOrder
	return instance
end

local function row(text, color, size, font, height)
	return append(left(label(list, text, color or ink, UDim2.new(1, -9, 0, height or 28), UDim2.new(), size or 14, font)))
end

local function listButton(text, color, textColor, callback)
	local instance = append(button(list, text, color, textColor, callback))
	instance.Size = UDim2.new(1, -7, 0, 36)
	return instance
end

local function showCourses()
	local voting = state.stage == "Voting" and state.queued
	local unlocked = player:GetAttribute("Unlocked") or 1
	if voting then row("Choose a course for the next heat", ink, 13, heavy) end
	local previousIsland
	for index, course in ipairs(Levels) do
		local island = course.island or "Green Meadows"
		if island ~= previousIsland then
			row(string.upper(island), muted, 11, heavy, 25)
			previousIsland = island
		end
		local available = index <= unlocked
		local selected = index == state.selected
		local card = append(frame(list, selected and cream or paper, UDim2.new(1, -8, 0, 56), nil, 5))
		outline(card, selected and muted or cream)
		local detailWidth = voting and -10 or -83
		local title = ("%02d   %s"):format(index, course.name)
		if available then
			local select = button(card, title, selected and cream or paper, ink, function() fire("choose", tostring(index)) end)
			select.Size = UDim2.new(1, detailWidth, 0, 28)
			select.Position = UDim2.fromOffset(6, 2)
			select.TextXAlignment = Enum.TextXAlignment.Left
		else
			left(label(card, title, muted, UDim2.new(1, detailWidth, 0, 28), UDim2.fromOffset(6, 2), 13, heavy))
		end
		local detail = if selected then "SELECTED" elseif available then (course.rating or "OPEN") else "LOCKED FOR RACE"
		if available and not selected and typeof(detail) ~= "string" then detail = tostring(detail) end
		left(label(card, string.upper(detail), muted, UDim2.new(1, detailWidth, 0, 16), UDim2.fromOffset(6, 29), 10, digits))
		if not voting then
			local practice = button(card, "PRACTICE", ink, paper, function()
				fire("practice", tostring(index))
				setTab(nil)
			end)
			practice.Size = UDim2.fromOffset(69, 44)
			practice.Position = UDim2.new(1, -75, 0, 6)
			practice.TextSize = 10
		end
	end
end

local function showShop()
	local skin = Config.bySkin[preview]
	local cost = skin[3]
	local owned = profile.skins[preview]
	local enabled = Config.passes[preview] and Config.passes[preview] > 0
	local accent = Color3.fromRGB(table.unpack(skin[5]))
	local card = append(frame(list, ink, UDim2.new(1, -7, 0, 148), nil, 6))
	local view = Instance.new("ViewportFrame")
	view.BackgroundColor3 = accent
	view.BorderSizePixel = 0
	view.Size = UDim2.new(0.42, -12, 1, -16)
	view.Position = UDim2.fromOffset(8, 8)
	view.Ambient = rgb("e6e2d8")
	view.LightColor = paper
	view.LightDirection = Vector3.new(-1, -1, -1)
	corner(view, 4)
	view.Parent = card
	local camera = Instance.new("Camera")
	camera.CFrame = CFrame.lookAt(Vector3.new(1.7, 0.65, 4), Vector3.zero)
	camera.FieldOfView = 44
	camera.Parent = view
	view.CurrentCamera = camera
	local model = Egg.build(preview, 1.4, true)
	model.Parent = view

	local title = left(label(card, skin[2], paper, UDim2.new(0.58, -17, 0, 52), UDim2.new(0.42, 5, 0, 16), 19, heavy))
	title.TextWrapped = true
	title.TextTruncate = Enum.TextTruncate.None
	local action
	if owned and profile.skin == preview then
		action = "EQUIPPED"
	elseif owned then
		action = "EQUIP"
	elseif enabled then
		action = "VIEW PRICE"
	elseif typeof(cost) == "number" then
		action = ("BUY · %d COINS"):format(cost)
	end
	if action and action ~= "EQUIPPED" then
		local equip = button(card, action, yellow, ink, function() fire("skin", preview) end)
		equip.Size = UDim2.new(0.58, -17, 0, 34)
		equip.Position = UDim2.new(0.42, 5, 1, -47)
	else
		local message = if action then action elseif preview == "Cosmic" then "WORLD 4 REWARD" else "UNAVAILABLE"
		left(label(card, message, lime, UDim2.new(0.58, -17, 0, 34), UDim2.new(0.42, 5, 1, -47), 11, heavy))
	end

	local swatches = append(frame(list, nil, UDim2.new(1, -7, 0, math.ceil(#Config.skins / 4) * 43)))
	local grid = Instance.new("UIGridLayout")
	grid.CellSize = UDim2.new(0.25, -5, 0, 36)
	grid.CellPadding = UDim2.fromOffset(5, 7)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.Parent = swatches
	for index, item in ipairs(Config.skins) do
		local tile = button(swatches, item[1], item[1] == preview and ink or cream, item[1] == preview and paper or ink, function()
			local gamepad = isGamepad()
			preview = item[1]
			draw()
			if gamepad then GuiService.SelectedObject = close end
		end)
		tile.LayoutOrder = index
		tile.TextSize = 10
		local color = Color3.fromRGB(table.unpack(item[4]))
		local mark = frame(tile, color, UDim2.new(1, -10, 0, 3), UDim2.new(0, 5, 1, -5), 2)
		if profile.skins[item[1]] then outline(mark, item[1] == preview and paper or muted) end
	end
	row("TRAILS", muted, 11, heavy, 23)
	listButton("Remove trail", cream, ink, function() fire("trail", "") end)
	for _, id in {"Lightning", "Rainbow", "VIP"} do
		local price = Config.trails[id]
		if price or profile.trails[id] then
			local description = if profile.trail == id then "Equipped" elseif profile.trails[id] then "Equip" else ("%d coins"):format(price)
			listButton(id .. "   /   " .. description, cream, ink, function() fire("trail", id) end)
		end
	end
end

local function showStats()
	row(("%d coins     %d wins     %d XP"):format(player:GetAttribute("Coins") or 0, player:GetAttribute("Wins") or 0, player:GetAttribute("XP") or 0), ink, 16, digits, 33)
	for index, title in Config.titles do
		if index < 5 and (player:GetAttribute("XP") or 0) >= Config.titleXP[index] then
			listButton(title .. (profile.title == index and "  ✓" or ""), cream, ink, function() fire("title", tostring(index)) end)
		else
			row(title .. (index == 5 and "   /   World 4 reward" or ("   /   %d XP"):format(Config.titleXP[index])), muted, 12)
		end
	end
	for index, course in ipairs(Levels) do
		local record = profile.records[Rules.recordKey(index)]
		if record then row(("%s    %.2fs"):format(course.name, record), ink, 13, digits) end
	end
end

local function showSettings()
	for _, key in {"music", "effects"} do
		local caption = key == "music" and "Music" or "Sound effects"
		local control
		local function refresh()
			control.Text = ("%s   /   %d%%"):format(caption, math.round(Audio[key] * 100))
		end
		control = listButton("", cream, ink, function()
			Audio[key] = if Audio[key] >= 0.99 then 0 elseif Audio[key] == 0 then 0.25 else math.min(1, Audio[key] + 0.25)
			Audio.setLobby(not state.racing)
			refresh()
		end)
		refresh()
	end
end

local function showResults()
	local result = state.result
	if result then
		local finished = not result.out and not result.dnf
		local card = append(frame(list, ink, UDim2.new(1, -7, 0, 95), nil, 6))
		local place = finished and ("%02d"):format(result.place) or "OUT"
		label(card, place, finished and lime or rust, UDim2.fromOffset(103, 89), UDim2.fromOffset(3, 1), 39, heavy)
		frame(card, charcoal, UDim2.fromOffset(1, 62), UDim2.fromOffset(106, 16))
		local headline
		if result.practice and finished then headline = "PRACTICE CLEAR"
		elseif finished and (state.slots or 0) > 0 and not state.solo then headline = "QUALIFIED"
		elseif finished then headline = "FINISHED"
		else headline = "ELIMINATED" end
		left(label(card, headline, paper, UDim2.new(1, -129, 0, 23), UDim2.fromOffset(119, 10), 16, heavy))
		local summary = if finished then ("%.2fs     +%d coins"):format(result.time, result.coins or 0) else ("%d%% of course"):format(math.floor((result.progress or 0) * 100))
		left(label(card, summary, paper, UDim2.new(1, -129, 0, 22), UDim2.fromOffset(119, 35), 14, digits))
		local detail = if finished then (result.record and "PERSONAL BEST" or ("SHELL %d / 3"):format(result.hp or 0)) else (result.reason or "Time expired")
		left(label(card, detail, finished and lime or rust, UDim2.new(1, -125, 0, 21), UDim2.fromOffset(119, 63), 11, heavy))
	end
	for _, entry in state.scoreboard or {} do
		if entry.time and entry.place then
			row(("%02d  %s     %.2fs"):format(entry.place, entry.name, entry.time), muted, 12, digits, 24)
		end
	end
	local actions = append(frame(list, nil, UDim2.new(1, -7, 0, 40)))
	local replay = button(actions, "QUEUE AGAIN", yellow, ink, function() fire("next"); setTab(nil) end)
	replay.Size = UDim2.new(0.54, -4, 1, 0)
	local lobby = button(actions, "BACK TO HUB", cream, ink, function() fire("lobby"); setTab(nil) end)
	lobby.Size = UDim2.new(0.46, -4, 1, 0)
	lobby.Position = UDim2.new(0.54, 4, 0, 0)
end

local tabs = {
	Courses = {title = "Island trials", color = lime, render = showCourses},
	Shop = {title = "Egg locker", color = yellow, render = showShop},
	Stats = {title = "Courier record", color = lime, render = showStats},
	Settings = {title = "Audio", color = cream, render = showSettings},
	Results = {title = "Heat results", color = rust, render = showResults},
}

draw = function()
	for _, child in list:GetChildren() do
		if child ~= layout then child:Destroy() end
	end
	rowOrder = 0
	modal.Visible = tab ~= nil
	dock.Visible = tab == nil and not state.racing
	resultOpen.Visible = tab == nil and state.result ~= nil and state.racing == true and state.stage ~= "Returning"
	if not tab then return end
	local sheet = tabs[tab]
	panelTitle.Text = sheet.title
	panelStripe.BackgroundColor3 = sheet.color
	sheet.render()
	task.defer(resizePanel)
end

setTab = function(name)
	if name and not tabs[name] then return end
	tab = name
	draw()
	list.CanvasPosition = Vector2.zero
	if isGamepad() or GuiService.SelectedObject then
		GuiService.SelectedObject = if name then close elseif dock.Visible then play elseif state.result then resultOpen else nil
	end
end

local function confetti()
	for index = 1, 19 do
		local color = ({yellow, lime, rust})[index % 3 + 1]
		local bit = frame(root, color, UDim2.fromOffset(6, 9), UDim2.fromScale(0.5, 0.43))
		bit.ZIndex = 9
		bit.Rotation = index * 37
		TweenService:Create(bit, TweenInfo.new(0.8 + index % 4 * 0.12, Enum.EasingStyle.Quad), {
			Position = UDim2.fromScale(0.5 + math.cos(index) * 0.49, 0.49 + math.sin(index) * 0.41),
			Rotation = index * 74,
			BackgroundTransparency = 1,
		}):Play()
		Debris:AddItem(bit, 1.3)
	end
end

local fade = frame(root, ink, UDim2.fromScale(1, 1))
fade.BackgroundTransparency = 1
fade.ZIndex = 20
local function transition()
	fade.BackgroundTransparency = 0.11
	TweenService:Create(fade, TweenInfo.new(0.36, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
end

local lastCount, showGo = nil, 0
remote.OnClientEvent:Connect(function(kind, value, extra)
	if kind == "State" then
		local before = state
		state = value
		if state.racing and state.stage ~= before.stage and (state.stage == "Preparation" or state.stage == "Returning") then transition() end
		if state.stage == "Preparation" and before.stage ~= "Preparation" then
			race = {hp = 3, place = 1, total = state.total, progress = 0, cooldown = 0, recover = 0}
			lastCount = nil
		elseif state.stage == "Race" and before.stage == "Countdown" and state.racing then
			showGo = now() + 0.65
			Audio.play("Start")
		end
		Audio.setLobby(not state.racing)
		if state.stage == "Returning" or (not state.racing and tab == "Results") then
			setTab(nil)
		elseif state.result and state.racing and (not before.result or (state.stage == "Results" and before.stage ~= "Results")) then
			setTab("Results")
		elseif state.racing and not state.result and tab then
			setTab(nil)
		elseif state.stage == "Voting" and state.queued and before.stage ~= "Voting" then
			setTab("Courses")
		elseif tab == "Courses" or (tab == "Results" and state.stage == "Results") then
			local position = list.CanvasPosition
			draw()
			list.CanvasPosition = position
		else
			dock.Visible = tab == nil and not state.racing
		end
	elseif kind == "Race" then
		if value.zone and not race.zone and not state.practice and not state.solo then notice("CRACK ZONE · SHOVES LIVE") end
		race = value
	elseif kind == "Profile" then
		profile = value
		if tab == "Stats" or tab == "Shop" then
			local position = list.CanvasPosition
			local selected = GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(list)
			draw()
			list.CanvasPosition = position
			if selected then GuiService.SelectedObject = close end
		end
	elseif kind == "Open" then
		setTab(value)
	elseif kind == "Notice" then
		notice(value)
	elseif kind == "Pass" then
		local ok = pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, value)
		if not ok then notice("Purchase prompt unavailable") end
	elseif kind == "FX" then
		Audio.play(value)
		if value == "Crack" or value == "Break" then
			tint.BackgroundTransparency = 0.65
			TweenService:Create(tint, TweenInfo.new(0.32), {BackgroundTransparency = 1}):Play()
			notice(if value == "Break" then "SHELL BROKEN" elseif extra == 1 then "ONE HIT LEFT" else "SHELL CRACKED")
		elseif value == "Out" then
			notice(if typeof(extra) == "string" then extra else "ELIMINATED")
		elseif value == "Restart" then
			notice("BACK TO THE START")
		elseif value == "Finish" then
			confetti()
			if extra.coins > 0 then Audio.play("Coins") end
			if extra.place == 1 then Audio.play("Victory") end
		end
	end
end)

local queueText = {
	Lobby = "Waiting to start",
	Intermission = "Heat starts in %s",
	Voting = "Vote closes in %s",
	Preparation = "Loading course",
	Countdown = "Starting in %s",
	Race = "Queued for the next heat",
	Results = "Next heat after results",
	Returning = "Waiting to start",
}
local function updateHud(current)
	local racing = state.racing and not state.result and (state.stage == "Race" or state.stage == "Countdown" or state.stage == "Preparation")
	local lobby = not state.racing
	local leftSeconds = state.deadline - current
	hud.Visible = racing
	wallet.Visible = lobby and not modal.Visible
	coinCount.Text = tostring(player:GetAttribute("Coins") or 0)
	local queued = state.queued or state.practiceQueued
	play.Text = queued and "CANCEL" or "RACE"
	queueStatus.Visible = queued == true and lobby and not modal.Visible
	queueStatus.Text = (queueText[state.stage] or queueText.Lobby):format(clock(leftSeconds))
	practiceExit.Visible = racing and state.practice == true and not modal.Visible
	resultOpen.Visible = state.result ~= nil and state.racing == true and not modal.Visible and state.stage ~= "Returning"
	if racing then
		courseName.Text = Levels[state.level].name
		raceTime.Text = clock(leftSeconds)
		raceTime.TextColor3 = leftSeconds < 12 and state.stage == "Race" and rust or yellow
		local slots = state.slots or 0
		if state.practice then raceStatus.Text = "PRACTICE"
		elseif state.solo then raceStatus.Text = "TIME TRIAL"
		elseif slots > 0 then raceStatus.Text = ("#%d   /   %d OF %d IN"):format(race.place, state.qualified or 0, slots)
		else raceStatus.Text = ("#%d   /   %d RACERS"):format(race.place, race.total) end
		progressFill.Size = UDim2.fromScale(math.clamp(race.progress or 0, 0, 1), 1)
		for index, shell in ipairs(eggs) do
			shell.BackgroundColor3 = if index > race.hp then charcoal elseif race.hp == 1 then rust else paper
		end
	end

	local recover = race.recover or 0
	local shoveAvailable = racing and state.stage == "Race" and race.zone and not state.practice and not state.solo and recover <= current
	shove.Visible = shoveAvailable == true
	if shove.Visible then
		local cooldown = math.max(0, math.ceil((race.cooldown or 0) - current))
		shove.BackgroundColor3 = cooldown > 0 and charcoal or rust
		shove.TextColor3 = cooldown > 0 and paper or ink
		local input = UserInputService:GetLastInputType()
		shove.Text = if cooldown > 0 then ("%ds"):format(cooldown) elseif input == Enum.UserInputType.Touch then "SHOVE" elseif isGamepad() then "X  SHOVE" else "E  SHOVE"
	end
	if racing and state.stage == "Countdown" then
		local count = math.max(1, math.ceil(leftSeconds))
		banner.Visible = true
		banner.Text = tostring(count)
		banner.TextSize = 72
		if lastCount ~= count then
			lastCount = count
			Audio.play("Countdown")
		end
	elseif racing and current < showGo then
		banner.Visible = true
		banner.Text = "GO!"
		banner.TextSize = 72
	elseif racing and recover > current then
		banner.Visible = true
		banner.Text = ("RESTART IN %d"):format(math.ceil(recover - current))
		banner.TextSize = 28
	else
		banner.Visible = false
	end
end

local elapsed = 0
RunService.RenderStepped:Connect(function(deltaTime)
	elapsed += deltaTime
	local current = now()
	for _, courier in Players:GetPlayers() do
		local character = courier.Character
		local characterRoot = character and character:FindFirstChild("HumanoidRootPart")
		local egg = character and character:FindFirstChild("CourierEgg")
		local shell = egg and egg.PrimaryPart
		local motor = shell and shell:FindFirstChild("EggMotor")
		if characterRoot and motor then
			local amplitude = math.clamp(characterRoot.AssemblyLinearVelocity.Magnitude / 16, 0.2, 1)
			motor.Transform = CFrame.new(0, math.sin(current * 11) * 0.084 * amplitude, 0)
				* CFrame.Angles(math.sin(current * 6) * 0.12 * amplitude, 0, math.cos(current * 9) * 0.14 * amplitude)
			if egg:GetAttribute("Skin") == "Rainbow" then
				local rainbow = Color3.fromHSV((current % 4) / 4, 0.66, 1)
				shell.Color = rainbow
				local crown = egg:FindFirstChild("Crown")
				if crown then crown.Color = rainbow end
			end
		end
	end
	if elapsed >= 0.08 then
		elapsed = 0
		updateHud(current)
	end
end)

ContextActionService:BindAction("CourierCloseMenu", function(_, status)
	if not tab then return Enum.ContextActionResult.Pass end
	if status == Enum.UserInputState.Begin then setTab(nil) end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.ButtonB)

Audio.setLobby(true)
updateHud(now())
fire("hello")
