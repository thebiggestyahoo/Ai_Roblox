      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[local C = {}
C.maxPlayers = 15
C.intermission = 15
C.draft = 8
C.countdown = 3
C.results = 14
C.heatResults = 6
C.protection = 1.15
C.shoveCooldown = 5
C.shoveRange = 8
C.practiceRestartDelay = 1.25
C.audio = {
	Music = 0, Countdown = 0, Start = 0, Crack = 0, Break = 0, Out = 0, Restart = 0,
	Coins = 0, Shove = 0, Finish = 0, Victory = 0, Click = 0,
	CartonCommon = 0, CartonUncommon = 0, CartonRare = 0,
	CartonEpic = 0, CartonLegendary = 0, CartonMythic = 0,
}
-- Upload the original loops and cues from tools/compose_audio.py; use 0 for unavailable assets.
C.worldMusic = {temple=0, pirate=0, prehistoric=0, factory=0, frozen=0, cloud=0, neon=0, galactic=0}
C.passes = {Golden = 0, Rainbow = 0, Galaxy = 0, Royal = 0, VIP = 0}
-- Historical IDs only. Pending receipts credit the fixed-price trail balance.
-- This configuration does not enable a coin pack store.
C.legacyCoinProducts = {
	{key = "starter", name = "Starter pack", coins = 400, suggestedRobux = 29, productId = 0},
	{key = "courier", name = "Courier pack", coins = 1000, suggestedRobux = 59, productId = 0},
	{key = "collector", name = "Collector pack", coins = 2400, suggestedRobux = 119, productId = 0},
}
C.skins = {
	{"Classic", "Classic Egg", 0, {255, 240, 210}, {255, 185, 120}},
	{"Chocolate", "Chocolate Egg", false, {113, 57, 42}, {235, 154, 98}},
	{"Watermelon", "Watermelon Egg", false, {65, 184, 92}, {255, 97, 119}},
	{"Ninja", "Ninja Egg", false, {42, 46, 72}, {244, 83, 98}},
	{"Dinosaur", "Dinosaur Egg", false, {135, 219, 75}, {40, 123, 98}},
	{"Frozen", "Frozen Egg", false, {147, 225, 255}, {61, 138, 255}},
	{"Lava", "Lava Egg", false, {255, 103, 43}, {62, 34, 81}},
	{"Cosmic", "Cosmic Champion", false, {141, 75, 226}, {82, 255, 221}},
	{"Golden", "Golden Egg", false, {255, 196, 54}, {255, 245, 140}},
	{"Rainbow", "Animated Rainbow Egg", false, {250, 120, 194}, {93, 215, 255}},
	{"Galaxy", "Galaxy Egg", false, {77, 51, 161}, {250, 118, 237}},
	{"Royal", "Royal Egg", false, {157, 54, 178}, {255, 212, 74}},
	{"VIP", "VIP Egg Courier", false, {75, 234, 221}, {255, 221, 99}},
}
C.trails = {Lightning = 600, Rainbow = 900}
C.titles = {"Rookie Courier", "Egg Protector", "Professional Deliverer", "Egg Master", "Egg Legend"}
C.titleXP = {0, 100, 300, 650, 1500}
C.bySkin = {}
for _, skin in C.skins do C.bySkin[skin[1]] = skin end
return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Cosmetics</string>
          <string name="Source"><![CDATA[-- Carton IDs are acquisition identifiers. These cosmetic definitions confer
-- no movement, durability, collision, qualification, or reward advantages.
local Cosmetics = {}
Cosmetics.rarities = {
	Common = {mark = "●", color = "e4dced", weight = 40},
	Uncommon = {mark = "▲", color = "a4e1aa", weight = 27},
	Rare = {mark = "◆", color = "a9d8ff", weight = 17},
	Epic = {mark = "✦", color = "d6b9fa", weight = 10},
	Legendary = {mark = "★", color = "ffd27e", weight = 5},
	Mythic = {mark = "✸", color = "ffa6cb", weight = 1},
}
Cosmetics.rarityOrder = {"Common","Uncommon","Rare","Epic","Legendary","Mythic"}
Cosmetics.sources = {
	starter = "Granted to every courier",
	legacy = "Legacy locker cosmetic",
	classic = "Classic Carton",
	adventure = "Adventure Carton",
	enchanted = "Enchanted Carton",
	royal = "Royal Carton",
	galactic = "Galactic Carton",
	champion = "Champion Carton",
	starterCollector = "Starter Collector Carton",
	pirateCollector = "Pirate Collector Carton",
	relicCollector = "Ancient Relic Collector Carton",
	dragonCollector = "Dragon Collector Carton",
	galacticCollector = "Galactic Collector Carton",
	deluxeCollector = "Deluxe Collector Collection",
	season = "The Great Eggscape season track",
}
Cosmetics.collections = {
	{"Farmstand", "Farmstand"}, {"Expedition", "Expedition"}, {"Pirate", "Pirate"},
	{"Prehistoric", "Prehistoric"}, {"Magical", "Magical"}, {"Royal", "Royal"},
	{"Galactic", "Galactic"}, {"Championship", "Championship"}, {"Skyline", "Skyline"},
	{"Glacier", "Glacier"}, {"Foundry", "Foundry"},
}
local raw = {
	-- ID, display name, rarity rank, collection, shell/accent, model motifs, observation.
	starter = {
		{"Classic","Classic Egg",1,"Farmstand","fff0d2","ffb978","","The original, dependable delivery shell."},
	},
	legacy = {
		{"Chocolate","Chocolate Egg",1,"Farmstand","71392a","eb9a62","","Caramel icing and a handful of sugar sprinkles."},
		{"Watermelon","Watermelon Egg",1,"Farmstand","41b85c","ff6177","","A hand-striped shell with a juicy melon badge."},
		{"Ninja","Ninja Egg",3,"Skyline","2a2e48","f45362","","A scarlet headband for the quiet route."},
		{"Dinosaur","Dinosaur Egg",3,"Prehistoric","87db4b","287b62","","Soft ridges from a very tiny thunder lizard."},
		{"Frozen","Frozen Egg",4,"Glacier","93e1ff","3d8aff","","Ice shards catch the light on every turn."},
		{"Lava","Lava Egg",5,"Foundry","241d27","ff672b","","Warm magma glows between the cooled basalt plates."},
		{"Cosmic","Cosmic Champion",6,"Championship","8d4be2","52ffdd","","A comet halo for an old league champion."},
		{"Golden","Golden Egg",5,"Royal","ffc436","fff58c","","Polished gold with diamond-cut badges."},
		{"Rainbow","Animated Rainbow Egg",4,"Magical","fa78c2","5dd7ff","","A prism ribbon curves around the shell."},
		{"Galaxy","Galaxy Egg",5,"Galactic","4d33a1","fa76ed","","A little planet with a dusty ring."},
		{"Royal","Royal Egg",5,"Royal","9d36b2","ffd44a","","A jeweled crown belongs on top."},
		{"VIP","VIP Egg Courier",5,"Skyline","4beadd","ffdd63","","A retired aviator with gold-rimmed goggles."},
	},
	classic = {
		{"DaisyDip","Daisy Dip",1,"Farmstand","ffefad","f6ad62","bloom seed","Three daisies and a pollen-yellow shell."},
		{"CiderChick","Cider Chick",1,"Farmstand","f6cb6d","ed824f","beak tuft","A downy orchard chick with a crooked feather."},
		{"HoneyHush","Honey Hush",2,"Farmstand","f2aa4d","442842","stripe antenna","A striped worker bee with springy feelers."},
		{"BlueberryBasket","Blueberry Basket",2,"Farmstand","556cbc","b4df79","basket leaf","A painted berry perched in a woven basket."},
		{"PuddlePup","Puddle Pup",2,"Farmstand","dcbda8","694635","ear snout","A floppy-eared farm dog with a very muddy nose."},
		{"MoonMoth","Moon Moth",3,"Farmstand","9da3cc","f8dfb1","wing antenna","Night wings unfurl under a pair of bright feelers."},
		{"CactusSprout","Cactus Sprout",3,"Farmstand","6ab278","f48b98","cactus bloom","Round cactus pads sprout a pink flower."},
		{"PicnicParade","Picnic Parade",4,"Farmstand","f8bcc5","58b5aa","basket bow seed","A gingham bow dresses up a basket of berries."},
	},
	adventure = {
		{"Explorer","Explorer Egg",1,"Expedition","ce9a62","a74b53","hat scarf","A sun hat and handkerchief from the expedition camp."},
		{"AncientRelic","Ancient Relic Egg",2,"Expedition","b78d65","527969","panel glyph","Weathered stone with an old trail symbol."},
		{"GoldenIdol","Golden Idol Egg",3,"Expedition","b7832c","ffe294","totem bead","A hollow idol from a forgotten trail marker."},
		{"EmeraldGuardian","Emerald Guardian Egg",4,"Expedition","338771","adedad","armor crystal","A green crystal guarded by ceremonial armor."},
		{"CrystalSkull","Crystal Skull Egg",4,"Expedition","aacfe1","f1f9ff","skull shard","Deep eye sockets cut into blue crystal."},
		{"Captain","Captain Egg",2,"Pirate","653b58","f4bf70","tricorn anchor","A ship captain's hat with a brass anchor."},
		{"Treasure","Treasure Egg",3,"Pirate","926443","f2cc71","lock coins","A strapped specimen pocket jingles with spare coins."},
		{"Fossil","Fossil Egg",2,"Prehistoric","b68664","edd9ad","fossil ridge","The fossil of a curled little creature shows through."},
	},
	enchanted = {
		{"Sorcerer","Sorcerer Egg",2,"Magical","7956b7","f5beea","wizard glyph","A crooked felt hat and charcoal chalk charms."},
		{"Potion","Potion Egg",2,"Magical","64b6b7","c7ee88","bottle bubble","A corked flask full of peppermint bubbles."},
		{"EnchantedBook","Enchanted Book Egg",3,"Magical","8c4866","eac26f","book lock","A very small field guide with oversized clasps."},
		{"Phoenix","Phoenix Egg",4,"Magical","e87449","ffe397","flame wing","Swept flame feathers shaped like sunrise."},
		{"CelestialWizard","Celestial Wizard Egg",5,"Magical","4d478d","edd7ff","wizard orbit star","A constellation and orbiting moons crown a tall hat."},
		{"Nimbus","Nimbus Egg",2,"Skyline","a8c6df","fff4df","cloud bolt","Cloud puffs keep the little lightning stripe company."},
		{"CrystalWisp","Crystal Wisp",3,"Glacier","6cafc4","c9fbff","crystal halo","Frozen lanterns hang around a crystal plume."},
		{"SugarSpell","Sugar Spell",3,"Magical","e79dbd","9edace","candy bow","Sugared ribbons decorate a wizard's favorite treat."},
	},
	royal = {
		{"SilkRibbon","Silk Ribbon Egg",2,"Royal","d66388","ffc3bb","bow fringe","Silk loops and tiny tassels cover a parade shell."},
		{"MarbleCrest","Marble Crest Egg",3,"Royal","c9bdbe","76618e","crest panel","A sculpted coat of arms is inset into carved marble."},
		{"PearlKnight","Pearl Knight Egg",3,"Royal","bab7cf","6b89ac","armor visor","Rounded pearl armor with a blue visor."},
		{"RoseCourt","Rose Court Egg",4,"Royal","974968","ffbdcc","bloom crown","A crown threaded with three roses."},
		{"VelvetOrb","Velvet Orb Egg",4,"Royal","623869","df9946","crown orb","The court orb sits under a tiny coronet."},
		{"SovereignSwan","Sovereign Swan",5,"Royal","e0d6d8","e3b15e","wing beak halo","Pale fanned wings and a gold circlet."},
		{"PalaceMirror","Palace Mirror",3,"Royal","9794bb","f4be73","mirror fringe","A mirror set in quilted velvet and brass."},
		{"SunsetDuchess","Sunset Duchess",5,"Royal","a34765","ffdb92","crest flare crown","The rays of the sun frame a royal insignia."},
	},
	galactic = {
		{"SpaceExplorer","Space Explorer Egg",2,"Galactic","e5dfdb","6196b6","helmet pack","A hand-me-down pressure helmet and oxygen pack."},
		{"Alien","Alien Egg",2,"Galactic","78b581","9369d0","antenna visor","A wide-eyed explorer from a neighboring moon."},
		{"Meteor","Meteor Egg",3,"Galactic","74566b","f9a269","crater flame","Fresh impact craters and glowing reentry fins."},
		{"Nebula","Nebula Egg",4,"Galactic","7257a6","f0a9ec","cloud star","Clusters of dust and neon points form a nebula."},
		{"GalacticEmperor","Galactic Emperor",5,"Galactic","443d79","a9e8e0","crown orbit planet","Three little satellites circle a celestial crown."},
		{"PulseDrive","Pulse Drive",3,"Galactic","445c72","6be7da","panel bolt pack","A frame of coolant lines powers this little rocket."},
		{"MoonCourier","Moon Courier",3,"Galactic","8e9eae","efe2a6","crater antenna helmet","An ancient rover with a sun-faded helmet."},
		{"RingBeacon","Ring Beacon",4,"Galactic","576d94","e6b4ff","planet halo orb","A double ring guards an ice-blue navigation beacon."},
	},
	champion = {
		{"CheckeredChamp","Checkered Champ",3,"Championship","dad1dd","e47766","checker visor","A racing visor meets the checkered finish line."},
		{"BronzeBolt","Bronze Bolt",3,"Championship","925a47","ffb575","bolt medal","A sprint medal cast in burnished bronze."},
		{"SilverFeather","Silver Feather",4,"Championship","b6bad2","69a8b8","medal wing","Silver wings celebrate a comeback finish."},
		{"ArenaTorch","Arena Torch",4,"Championship","c77854","ffde9a","torch crest","The arena torch is reborn as a parade egg."},
		{"VictoryLaurels","Victory Laurels",5,"Championship","d3aa53","c7edb1","leaf medal crown","Laurels frame a champion's hanging medal."},
		{"GoldPodium","Gold Podium",5,"Championship","f3c158","8f536a","trophy checker","The winner's cup and two finish-line stripes."},
		{"CloudTrophy","Cloud Trophy",5,"Championship","bba5e3","ffed8f","trophy cloud halo","A trophy rising from a celebratory cloud."},
		{"GrandFinale","Grand Finale",6,"Championship","3f4c83","ffd7a0","trophy flare orbit","A luminous winner's cup framed in dancing lights."},
	},
	starterCollector = {
		{"RainCoat","Rain Coat Egg",2,"Farmstand","f4d678","69b8c7","hood boot","A rain slicker built for very small puddle jumps."},
		{"BerryBaker","Berry Baker Egg",2,"Farmstand","e0a6b6","f5e2cb","chef apron","An apron and baker's cap with a dusting of flour."},
		{"PumpkinCart","Pumpkin Cart Egg",3,"Farmstand","ec9654","4c8f68","leaf wheel","A lacquered autumn cart with its harvest on top."},
		{"RoseBeetle","Rose Beetle Egg",3,"Farmstand","bc5c74","e5ac80","stripe wing","A rose-colored beetle with bronze wing cases."},
	},
	pirateCollector = {
		{"GhostShip","Ghost Ship Egg",4,"Pirate","52878c","b9f6ea","ship sail halo","A stern lantern glows through ghostly sails."},
		{"Kraken","Kraken Egg",4,"Pirate","965686","6acbad","tentacle orb","Four tentacles guard a sea-glass pearl."},
		{"GoldenCompass","Golden Compass Egg",5,"Pirate","ba884c","ffe094","compass fringe","A compass framed in hanging brass markers."},
		{"Saltwind","Saltwind Egg",3,"Pirate","89725e","b2d8d4","tricorn sail","An old captain's hat beneath a painted canvas sail."},
	},
	relicCollector = {
		{"JadeSentinel","Jade Sentinel Egg",4,"Expedition","4e8773","e5c18b","totem armor","A jade guide carved with protective armor."},
		{"CavernLens","Cavern Lens Egg",3,"Expedition","516d76","f3d99f","mirror pack","An expedition lantern and a storage pack."},
		{"SandOracle","Sand Oracle Egg",4,"Expedition","bc8257","8de2d3","hood orb glyph","A copper oracle keeps an aquamarine pearl."},
		{"AncientGuardian","Ancient Guardian",6,"Expedition","295c59","efbd64","totem crown orbit","A crown and orbiting stones animate this old guardian."},
	},
	dragonCollector = {
		{"AncientDragon","Ancient Dragon Egg",5,"Prehistoric","995485","f5a365","ridge flame wing","A cave dragon with feather-shaped flames."},
		{"StormWyvern","Storm Wyvern Egg",5,"Magical","49548d","a7f2f1","horn bolt wing","A lightning stripe splits two folded wings."},
		{"FrostWyrm","Frost Wyrm Egg",4,"Glacier","7eafd0","e4fcff","horn shard tentacle","The icy horns of a glacier-dwelling wyrm."},
		{"AmberDrake","Amber Drake Egg",4,"Prehistoric","ae7843","ffc46b","fossil horn wing","A fossil drake caught in sunlit amber."},
	},
	galacticCollector = {
		{"IonNavigator","Ion Navigator",4,"Galactic","41818a","b4f5f2","visor compass panel","An ion compass glows behind tinted glass."},
		{"SatelliteScout","Satellite Scout",4,"Galactic","6870a2","ffc06e","antenna solar orbit","A solar-powered scout with three small satellites."},
		{"RedDwarf","Red Dwarf Egg",5,"Galactic","914d67","ffa666","flare planet crater","A glowing stellar rim marks these old craters."},
		{"EventHorizon","Event Horizon",6,"Galactic","382d5b","f6c4f9","planet orbit flare","A shifting ring circles a dark stellar core."},
	},
	deluxeCollector = {
		{"CloudConductor","Cloud Conductor",5,"Skyline","7da2ca","fae198","cloud hat bolt","A weather conductor keeps lightning tucked under a hat."},
		{"PalaceArtisan","Palace Artisan",5,"Royal","94668b","f1c985","apron crest fringe","A royal artisan's apron made from parade ribbons."},
		{"SugarEngine","Sugar Engine",5,"Foundry","dd8da2","9de5de","candy wheel pack","An elaborate clockwork wagon delivers sugar drops."},
		{"DaydreamBeacon","Daydream Beacon",6,"Magical","7566b9","ffdda2","flame mirror orbit","A magical mirror scatters dancing lights."},
	},
	season = {
		{"CampLantern","Camp Lantern",2,"Expedition","87724b","ffcd76","torch pack","An expedition lantern with a comfortable back strap."},
		{"IndigoFieldNote","Indigo Field Note",3,"Expedition","6a6193","e0b87b","book compass","A field notebook cataloging mountain paths."},
		{"TideChart","Tide Chart Egg",3,"Pirate","518e9b","e7d7a3","compass book","A chart pitched at the angle of a passing swell."},
		{"CannonPearl","Cannon Pearl",4,"Pirate","52516b","a9dfd3","ship orb lock","A ship's bow frames a rare pearl."},
		{"Raptor","Raptor Egg",2,"Prehistoric","6e9859","e2b382","ridge beak","A chirpy hatchling with a serrated spine."},
		{"Triceratops","Triceratops Egg",3,"Prehistoric","7a8e6d","ead59f","horn crest","A broad frill and three short horns."},
		{"Amber","Amber Egg",3,"Prehistoric","b47142","f9bf58","fossil bubble","Tiny bubbles surround a perfectly preserved fossil."},
		{"LavaCourier","Lava Courier",3,"Foundry","8a4f58","ffb562","boot flame","Heat-resistant boots and smoldering fins."},
		{"ConveyorCaptain","Conveyor Captain",4,"Foundry","65516e","eeb57e","wheel helmet","A factory captain's round helmet and two spoked wheels."},
		{"IceSignal","Ice Signal",3,"Glacier","6ebbce","ebd4fc","shard antenna bolt","A radio signal trapped in a field of ice."},
		{"CrystalLift","Crystal Lift",4,"Glacier","6894b9","d2f3eb","crystal pack orbit","A counterweight set suspends ice crystals in midair."},
		{"SkyGlider","Sky Glider Egg",3,"Skyline","a5a5d9","ffca92","wing visor","Rounded wings fold under a pilot visor."},
		{"CrownVoyager","Crown Voyager",4,"Royal","a3698f","edca73","crown sail","A little sailboat ferries a palace crown."},
		{"CometShuttle","Comet Shuttle",4,"Galactic","6f5895","a2e4ef","solar flame pack","Solar panels flare around a comet-chasing shuttle."},
		{"MeteorChaser","Meteor Chaser",5,"Galactic","645977","fdbf8c","crater helmet orbit","A meteor helmet with three trailing navigation lights."},
		{"MedalMaker","Medal Maker",4,"Championship","b9836c","fee194","apron medal wheel","The maker who cuts and stamps every race medal."},
		{"RelicPathfinder","Relic Pathfinder",5,"Expedition","897653","a5e9a6","totem compass halo","A trail-finding spirit with an illuminated dial."},
		{"EggscapeBeacon","Eggscape Beacon",6,"Championship","4b628b","ffe9a2","trophy orb orbit","The season's gold beacon inside a winner's trophy."},
	},
}
local order = {"starter","legacy","classic","adventure","enchanted","royal","galactic","champion",
	"starterCollector","pirateCollector","relicCollector","dragonCollector","galacticCollector","deluxeCollector","season"}
Cosmetics.entries, Cosmetics.byId = {}, {}
for _, source in ipairs(order) do
	for _, egg in ipairs(raw[source]) do
		local id,name,rank,collection,shell,accent,style,description = table.unpack(egg)
		local entry = {
			id=id, name=name, rarity=Cosmetics.rarityOrder[rank], rank=rank,
			collection=collection, shell=shell, accent=accent, style=style,
			description=description, source=source,
		}
		assert(not Cosmetics.byId[id],id)
		Cosmetics.byId[id] = entry
		table.insert(Cosmetics.entries, entry)
	end
end
return Cosmetics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">EconomyConfig</string>
          <string name="Source"><![CDATA[local Cosmetics = require(script.Parent.Cosmetics)

local Economy = {}

Economy.royalePlacementCoins = {150, 100, 75, 50, 50, 50, 40, 40, 40, 30, 30, 30, 20, 20, 20}
Economy.quickPlacementCoins = {35, 25, 20, 15, 15, 15, 10, 10, 10, 10, 10, 10, 10, 10, 10}
Economy.seasonXP = {royaleFinish = 65, royalePlacement = 85, championship = 60, quickFinish = 85, adventureFinish = 60, perfect = 20, relic = 25}
Economy.medalThresholds = {gold = 0.76, silver = 0.88}
Economy.relicsPerWorld = 3
Economy.collectionMilestone = 10

Economy.quests = {
	{id="deliver", name="Complete three courses", period="daily", metric="finishes", goal=3, coins=35, xp=35},
	{id="clean", name="Finish with an undamaged egg", period="daily", metric="perfect", goal=1, coins=25, xp=25},
	{id="personal", name="Set three personal bests", period="weekly", metric="best", goal=3, coins=80, xp=105},
	{id="gold", name="Earn two Gold medals in Adventure", period="weekly", metric="gold", goal=2, coins=70, xp=95},
	{id="explore", name="Find two hidden relics", period="lifetime", metric="relics", goal=2, coins=70, xp=95},
	{id="podium", name="Place top three five times", period="lifetime", metric="podiums", goal=5, coins=200, xp=180, carton="classic"},
	{id="championship", name="Win an Egg Royale title", period="lifetime", metric="championships", goal=1, coins=50, xp=200},
}

Economy.cartons = {
	{id="classic", name="Classic Carton", price=500, color="AEE7A5", material="Paper", rewards={}},
	{id="adventure", name="Adventure Carton", price=750, color="EDB97F", material="Wood", rewards={}},
	{id="enchanted", name="Enchanted Carton", price=1250, color="BEA4FE", material="Runes", rewards={}},
	{id="royal", name="Royal Carton", price=2000, color="FFD879", material="Velvet", rewards={}},
	{id="galactic", name="Galactic Carton", price=2500, color="82D6F3", material="Metal", rewards={}},
	{id="champion", name="Champion Carton", price=0, wins=1, color="FFE4A0", material="Trophy", rewards={}},
}

-- Assign experience game pass IDs in Creator Dashboard before enabling any offer.
-- These are one-time entitlements to a disclosed list of cosmetics.
Economy.collectors = {
	{id="starterCollector", name="Starter Collector Carton", passId=0, suggestedRobux=199, eggs={}},
	{id="pirateCollector", name="Pirate Collector Carton", passId=0, suggestedRobux=399, eggs={}},
	{id="relicCollector", name="Ancient Relic Collector Carton", passId=0, suggestedRobux=399, eggs={}},
	{id="dragonCollector", name="Dragon Collector Carton", passId=0, suggestedRobux=599, eggs={}},
	{id="galacticCollector", name="Galactic Collector Carton", passId=0, suggestedRobux=799, eggs={}},
	{id="deluxeCollector", name="Deluxe Collector Collection", passId=0, suggestedRobux=1499, eggs={}},
}
Economy.collectors[1].extras = {{kind="accessory",id="Sun Pin",name="Sun Pin egg accessory"}}
Economy.collectors[2].extras = {{kind="banner",id="Hidden Grotto",name="Hidden Grotto profile banner"}}
Economy.collectors[3].extras = {{kind="victory",id="Relic Spark",name="Relic Spark celebration"}}
Economy.collectors[4].extras = {{kind="accessory",id="Crown Patch",name="Crown Patch egg accessory"}}
Economy.collectors[5].extras = {{kind="trail",id="Aurora",name="Aurora trail"}}
Economy.collectors[6].extras = {
	{kind="victory",id="Celestial Finale",name="Celestial Finale celebration"},
	{kind="banner",id="Star Trail",name="Star Trail profile banner"},
}

Economy.directOffers = {
	{id="expeditionTrail",name="Expedition Trail",passId=0,suggestedRobux=99,eggs={},extras={
		{kind="trail",id="Expedition",name="Expedition trail"},
	}},
	{id="crownParade",name="Crown Parade Celebration",passId=0,suggestedRobux=199,eggs={},extras={
		{kind="victory",id="Crown Parade",name="Crown Parade celebration"},
	}},
	{id="compassPin",name="Jade Compass Accessory",passId=0,suggestedRobux=89,eggs={},extras={
		{kind="accessory",id="Jade Compass",name="Jade Compass egg accessory"},
	}},
	{id="explorerProfile",name="Explorer Profile Set",passId=0,suggestedRobux=149,eggs={},extras={
		{kind="title",id="Royal Explorer",name="Royal Explorer title"},
		{kind="banner",id="Expedition Dawn",name="Expedition Dawn profile banner"},
	}},
}

Economy.cartonById, Economy.collectorById, Economy.sourceOf = {}, {}, {}
for _, carton in Economy.cartons do Economy.cartonById[carton.id] = carton end
for _, offer in Economy.collectors do Economy.collectorById[offer.id] = offer end

for _, offer in Economy.directOffers do Economy.collectorById[offer.id] = offer end

local legacyPools = {
	Chocolate="classic", Watermelon="classic", Ninja="adventure", Dinosaur="adventure",
	Frozen="enchanted", Lava="enchanted", Cosmic="champion",
	Golden="royal", Rainbow="royal", Galaxy="galactic", Royal="royal", VIP="champion",
}

for _, egg in ipairs(Cosmetics.entries) do
	local source = legacyPools[egg.id] or egg.source
	Economy.sourceOf[egg.id] = source
	local carton = Economy.cartonById[source]
	local collector = Economy.collectorById[source]
	if carton then
		table.insert(carton.rewards,{id=egg.id,weight=Cosmetics.rarities[egg.rarity].weight})
	elseif collector then
		table.insert(collector.eggs,egg.id)
	end
end

function Economy.odds(carton, ownedSkins)
	local entries, weight = {}, 0
	for _, reward in ipairs(carton.rewards) do
		if not ownedSkins[reward.id] then
			weight += reward.weight
			table.insert(entries, {id=reward.id,weight=reward.weight})
		end
	end
	for _, reward in ipairs(entries) do reward.probability = reward.weight/weight end
	return entries
end

function Economy.placement(mode, place)
	local list = if mode == "royale" then Economy.royalePlacementCoins elseif mode == "quick" then Economy.quickPlacementCoins else {}
	return list[place] or 0
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">EggModel</string>
          <string name="Source"><![CDATA[local Cosmetics = require(script.Parent.Cosmetics)
local EggModel = {}
local rgb = Color3.fromHex
local plastic, metal, neon = Enum.Material.SmoothPlastic, Enum.Material.Metal, Enum.Material.Neon
local sphere = "Sphere"
local shellHeight = 1.4
local gold = rgb("f2bb49")
local cream = rgb("fff4cb")
local coal = rgb("28232f")
local tau = math.pi * 2

local function piece(egg, name, size, cf, tint, shape, material)
	local p = Instance.new(shape == "Wedge" and "WedgePart" or "Part")
	p.Name = name
	p.Size = size * egg.width
	p.CFrame = CFrame.new(cf.Position * egg.width) * cf.Rotation
	p.Color = tint
	p.Material = material or plastic
	if shape == sphere then
		-- Use a built-in sphere mesh so the shell and small beads can keep distinct axis sizes.
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.one
		mesh.Parent = p
	end
	p.Anchored = egg.anchored
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.Parent = egg.model
	if egg.model.PrimaryPart and not egg.anchored then
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = egg.model.PrimaryPart
		weld.Part1 = p
		weld.Parent = p
	end
	return p
end

local function surface(theta, y, relief)
	local radius = 0.5 * math.sqrt(1 - (y / (shellHeight / 2)) ^ 2)
	local normal = Vector3.new(math.sin(theta) * radius * 4, y / 0.49, -math.cos(theta) * radius * 4).Unit
	local position = Vector3.new(math.sin(theta) * radius, y, -math.cos(theta) * radius) + normal * relief
	return CFrame.lookAt(position, position + normal)
end

local function bead(egg, name, theta, y, w, h, tint, material, relief, spin)
	return piece(egg,name,Vector3.new(w,h,w*0.23),surface(theta,y,relief or 0.02) * CFrame.Angles(0,0,spin or 0),tint,sphere,material)
end

local function segment(egg, name, a, b, thickness, height, tint, material)
	local cf = CFrame.lookAt((a+b)/2,b)
	return piece(egg,name,Vector3.new(thickness,height,(a-b).Magnitude+thickness*0.35),cf,tint,nil,material)
end

local function line(egg, name, points, thickness, tint, material, relief)
	for i=1,#points-1 do
		local a,b = points[i],points[i+1]
		segment(egg,name,surface(a[1],a[2],relief or 0.04).Position,surface(b[1],b[2],relief or 0.04).Position,thickness,thickness,tint,material)
	end
end

local function ring(egg, name, radius, y, tilt, bandHeight, thickness, colors, material, count)
	local axis = CFrame.Angles(0,0,tilt)
	for i=0,count-1 do
		local angleA, angleB = i*tau/count, (i+1)*tau/count
		local a = axis * Vector3.new(math.sin(angleA)*radius,y,-math.cos(angleA)*radius)
		local b = axis * Vector3.new(math.sin(angleB)*radius,y,-math.cos(angleB)*radius)
		local cf = CFrame.lookAt((a+b)/2,b,axis.UpVector)
		piece(egg,name,Vector3.new(thickness,bandHeight,(b-a).Magnitude+0.016),cf,colors[i%#colors+1],nil,material)
	end
end

local styles = {}

function styles.Chocolate(egg)
	local caramel = rgb("e8a66b")
	piece(egg,"Caramel glaze",Vector3.new(0.93,0.67,0.93),CFrame.new(0,0.39,0),caramel,sphere)
	for i=1,6 do
		bead(egg,"Icing drip",i*tau/6,0.28-0.034*(i%3),0.16,0.24+(i%3)*0.045,caramel,nil,0.026)
	end
	for i, tint in {cream,rgb("f47fa4"),rgb("7edbc1"),cream,rgb("f47fa4")} do
		bead(egg,"Sugar sprinkle",i*tau/5,0.37,0.035,0.10,tint,nil,0.057,0.9-i*0.38)
	end
end

function styles.Watermelon(egg)
	for i=1,6 do
		local angle = (i-0.5)*tau/6
		line(egg,"Rind stripe",{{angle-0.15,-0.53},{angle+0.08,-0.22},{angle-0.09,0.16},{angle+0.05,0.46}},
			0.043,rgb("1d7c49"),nil,0.072)
	end
	bead(egg,"Watermelon slice",0,0.01,0.31,0.30,egg.accent,nil,0.031)
	for i, seed in {{-0.14,0.06},{0.14,0.06},{0,-0.05}} do
		bead(egg,"Watermelon seed",seed[1],seed[2],0.035,0.055,coal,nil,0.055,(i-2)*0.34)
	end
end

function styles.Ninja(egg)
	ring(egg,"Scarlet headband",0.49,0.24,0,0.14,0.038,{egg.accent},plastic,10)
	bead(egg,"Mask panel",0,0.18,0.47,0.19,coal,nil,0.058)
	for _, side in {-1,1} do
		bead(egg,"Mask eye",side*0.20,0.20,0.10,0.047,cream,nil,0.093,side*0.20)
		piece(egg,"Headband tie",Vector3.new(0.075,0.30,0.14),
			CFrame.new(0.47+side*0.07,0.30+side*0.10,0.16)*CFrame.Angles(-0.82,0,-0.85-side*0.27),egg.accent)
	end
end

function styles.Dinosaur(egg)
	for i=1,5 do
		local y = 0.56-(i-1)*0.225
		local size = 0.16+0.04*(1-(i-3)^2/4)
		piece(egg,"Dinosaur spine",Vector3.new(size,0.19,size*1.28),
			surface(math.pi,y,0.064)*CFrame.Angles(0,math.pi,0),egg.accent,"Wedge")
	end
	for i, spot in {{0.4,0.2},{-0.55,0.36},{0.72,-0.24},{-0.56,-0.27},{2.05,-0.14},{-2.1,0.17}} do
		local size = if i%2 == 0 then 0.11 else 0.16
		bead(egg,"Dinosaur speckle",spot[1],spot[2],size,size*0.73,rgb("dfad63"))
	end
end

function styles.Frozen(egg)
	for i, shard in {{-0.65,0.47,0.38},{1.04,0.32,0.26},{2.45,0.45,0.46},{-2.0,0.31,0.31}} do
		piece(egg,"Glacier shard",Vector3.new(0.13,shard[3],0.19),
			surface(shard[1],shard[2],0.083)*CFrame.Angles(0,i*1.25,0.2),if i%2 == 0 then egg.accent else rgb("d8fbff"),"Wedge",Enum.Material.Ice)
	end
	local badge = surface(0,-0.05,0.04)
	for i=0,2 do
		piece(egg,"Snowflake",Vector3.new(0.058,0.33,0.019),badge*CFrame.Angles(0,0,i*math.pi/3),rgb("ebffff"),nil,neon)
	end
end

function styles.Lava(egg)
	for i=0,3 do
		local start = 0.32+i*tau/4
		line(egg,"Magma vein",{{start-0.19,0.47},{start+0.10,0.29},{start-0.13,0.03},{start+0.14,-0.19},{start,-0.45}},
			0.042,if i%2 == 0 then rgb("ff721f") else rgb("ffc147"),neon,0.055)
	end
	for i=0,2 do
		piece(egg,"Basalt outcrop",Vector3.new(0.23,0.24,0.19),
			surface(i*tau/3+0.3,0.47,0.055)*CFrame.Angles(0,0,0.6+i*0.8),rgb("423038"),"Wedge",Enum.Material.Basalt)
	end
end

function styles.Cosmic(egg)
	ring(egg,"Comet halo",0.57,0,-0.28,0.048,0.042,{egg.accent},neon,12)
	bead(egg,"Champion star",0.05,0.29,0.22,0.21,cream,neon,0.045)
	for _, side in {-1,1} do
		piece(egg,"Comet fin",Vector3.new(0.15,0.28,0.18),
			surface(side*1.45,-0.17,0.10)*CFrame.Angles(0,0,side*0.4),egg.accent,"Wedge",metal)
	end
end

function styles.Golden(egg)
	ring(egg,"Gold filigree",0.44,-0.39,0,0.105,0.048,{rgb("b37320"),gold},metal,10)
	for i=0,3 do
		local front = surface(i*math.pi/2,0.13,0.038)
		piece(egg,"Gold ingot badge",Vector3.new(0.18,0.23,0.036),front*CFrame.Angles(0,0,math.pi/4),cream,nil,metal)
	end
end

function styles.Rainbow(egg)
	ring(egg,"Prism ribbon",0.53,0.015,-0.34,0.165,0.04,{
		rgb("f95b69"),rgb("ff923b"),rgb("ffd449"),rgb("8de582"),rgb("58cae9"),rgb("a17af2"),
	},neon,12)
	for i=0,3 do
		bead(egg,"Prism highlight",i*tau/4,0.35,0.082,0.17,cream,neon,0.022,i)
	end
end

function styles.Galaxy(egg)
	ring(egg,"Saturn ring",0.625,0,0.32,0.045,0.12,{rgb("cf9eed"),rgb("efd1f7")},metal,12)
	for i, point in {{0,0.31},{0.39,0.42},{-0.37,-0.18},{1.5,-0.26},{-2.3,0.33},{2.6,0.24},{3.08,-0.34}} do
		local size = if i%2 == 0 then 0.07 else 0.035
		bead(egg,"Starlight",point[1],point[2],size,size,if i%2 == 0 then egg.accent else cream,neon)
	end
end

function styles.Royal(egg)
	ring(egg,"Crown band",0.37,0.495,0,0.12,0.07,{gold},metal,10)
	for i=0,4 do
		local azimuth = i*tau/5
		local cf = CFrame.Angles(0,azimuth,0)*CFrame.new(0,0.64,-0.35)*CFrame.Angles(-0.24,0,0)
		piece(egg,"Crown point",Vector3.new(0.145,0.24,0.12),cf,gold,"Wedge",metal)
		piece(egg,"Crown jewel",Vector3.new(0.068,0.068,0.038),cf*CFrame.new(0,0.062,-0.071),if i==0 then rgb("8bf0df") else rgb("f77f98"),sphere,neon)
	end
end

function styles.VIP(egg)
	ring(egg,"Courier webbing",0.50,0.15,0,0.12,0.044,{rgb("20596a")},plastic,10)
	for _, side in {-1,1} do
		bead(egg,"Aviator frame",side*0.21,0.16,0.21,0.19,gold,metal,0.038)
		bead(egg,"Aviator lens",side*0.21,0.16,0.157,0.143,rgb("295976"),metal,0.066)
		bead(egg,"Lens glint",side*0.21-0.04,0.184,0.051,0.035,cream,nil,0.086,0.5)
	end
end

local motifs = {}
local ocean = rgb("233858")
local white = rgb("fff6e8")

local function solid(egg, name, size, x, y, z, color, shape, yaw, roll, material)
	return piece(egg,name,Vector3.new(table.unpack(size)),CFrame.new(x,y,z)*CFrame.Angles(0,yaw or 0,roll or 0),color,shape,material)
end

local function face(egg, name, x, y, width, height, tint)
	local theta = x * 2
	return bead(egg,name,theta,y,width,height,tint,nil,0.048)
end

local function spokes(egg, name, cf, count, width, length, tint, material)
	for i=0,count-1 do
		piece(egg,name,Vector3.new(width,length,0.032),cf*CFrame.Angles(0,0,i*math.pi/count),tint,nil,material)
	end
end

function motifs.bloom(egg)
	for i, point in {{-0.69,0.28},{0.24,0.43},{0.73,-0.13}} do
		local cf = surface(point[1],point[2],0.049)
		for p=1,5 do
			local turn = CFrame.Angles(0,0,p*tau/5)
			piece(egg,"Flower petal",Vector3.new(0.086,0.149,0.038),cf*turn*CFrame.new(0,0.095,0),i==2 and white or egg.accent,sphere)
		end
		piece(egg,"Flower heart",Vector3.new(0.09,0.09,0.04),cf*CFrame.new(0,0,-0.028),gold,sphere)
	end
end

function motifs.seed(egg)
	for i=1,12 do
		bead(egg,"Seeds",i*2.399,(i%5-2)*0.215,0.06,0.1,cream,nil,0.04,i*0.32)
	end
end

function motifs.beak(egg)
	solid(egg,"Upper beak",{0.235,0.14,0.29},0,0,-0.49,egg.accent,"Wedge",math.pi)
	solid(egg,"Lower beak",{0.19,0.05,0.21},0,-0.08,-0.49,gold,sphere)
	for _, side in {-1,1} do
		face(egg,"Bright eye",side*0.23,0.17,0.085,0.11,coal)
	end
end

function motifs.tuft(egg)
	for _, side in {-1,1} do
		solid(egg,"Soft tuft",{0.15,0.25,0.11},side*0.075,0.715,0,egg.accent,sphere,0,-side*0.26)
	end
end

function motifs.stripe(egg)
	for i=1,3 do
		local y = (i-2)*0.27
		ring(egg,"Shell stripe",i==2 and 0.505 or 0.473,y,0,0.105,0.026,{egg.accent},plastic,12)
	end
end

function motifs.antenna(egg)
	for _, side in {-1,1} do
		segment(egg,"Bendy feeler",Vector3.new(side*0.18,0.51,0),Vector3.new(side*0.31,0.83,-0.027),0.043,0.043,coal)
		solid(egg,"Feeler tip",{0.13,0.13,0.13},side*0.31,0.83,-0.027,egg.accent,sphere)
	end
end

function motifs.basket(egg)
	local brown = rgb("a16b55")
	for i=1,4 do
		ring(egg,"Wicker weave",0.43+i*0.02,-0.59+i*0.08,0,0.055,0.055,{brown,gold},plastic,10)
	end
	for i=0,5 do
		local a,b = math.pi*i/6,math.pi*(i+1)/6
		segment(egg,"Wicker handle",Vector3.new(math.cos(a)*0.55,math.sin(a)*0.77,-0.04),
			Vector3.new(math.cos(b)*0.55,math.sin(b)*0.77,-0.04),0.045,0.045,brown)
	end
end

function motifs.leaf(egg)
	for side=-1,1,2 do
		solid(egg,"Layered leaves",{0.18,0.34,0.08},side*0.19,0.61,0, rgb("71a96c"),sphere,0,-side*0.73)
		solid(egg,"Leaf vein",{0.025,0.19,0.028},side*0.19,0.635,-0.047,cream,nil,0,-side*0.73)
	end
end

function motifs.ear(egg)
	for _, side in {-1,1} do
		solid(egg,"Floppy ear",{0.23,0.51,0.17},side*0.38,0.31,0.015,egg.accent,sphere,0,side*0.42)
	end
end

function motifs.snout(egg)
	solid(egg,"Puppy muzzle",{0.31,0.19,0.15},0,-0.13,-0.52,cream,sphere)
	solid(egg,"Nose",{0.12,0.08,0.057},0,-0.08,-0.605,coal,sphere)
	for _, side in {-1,1} do
		face(egg,"Pup eye",side*0.21,0.18,0.068,0.082,ocean)
	end
end

function motifs.wing(egg)
	for _, side in {-1,1} do
		for i=1,3 do
			local x = side*(0.49+0.055*i)
			local y = 0.2-i*0.115
			solid(egg,"Wing feather",{0.17,0.38,0.13},x,y,0.19,if i%2==0 then cream else egg.accent,sphere,0,-side*(0.39+i*0.24))
		end
	end
end

function motifs.cactus(egg)
	for _, side in {-1,1} do
		local x = side*0.55
		solid(egg,"Cactus pad",{0.27,0.44,0.18},x,side*0.09,0,rgb("8eca86"),sphere,0,-side*0.31)
		for i=1,2 do
			solid(egg,"Pale thorn",{0.05,0.09,0.042},x,-0.13+i*0.1+side*0.09,-0.11,cream,"Wedge")
		end
	end
end

function motifs.bow(egg)
	for _, side in {-1,1} do
		solid(egg,"Bow loop",{0.26,0.13,0.11},side*0.16,0.36,-0.46,egg.accent,sphere,0,side*0.21)
		solid(egg,"Bow tail",{0.094,0.19,0.038},side*0.081,0.244,-0.47,egg.accent,nil,0,side*0.31)
	end
	solid(egg,"Bow knot",{0.10,0.12,0.12},0,0.36,-0.53,white,sphere)
end

function motifs.hat(egg)
	solid(egg,"Expedition brim",{1.11,0.067,0.8},0,0.48,0,gold,sphere)
	solid(egg,"Felt crown",{0.64,0.33,0.59},0,0.57,0,egg.accent,sphere)
	ring(egg,"Hat band",0.294,0.55,0,0.059,0.028,{coal},plastic,8)
end

function motifs.scarf(egg)
	ring(egg,"Scarf wrap",0.448,-0.34,-0.12,0.10,0.06,{egg.accent},plastic,11)
	solid(egg,"Scarf tail",{0.18,0.31,0.10},0.39,-0.41,-0.26,egg.accent,nil,0,-0.35)
end

function motifs.panel(egg)
	for i=1,5 do
		local cf = surface(i*tau/5,0.09,0.045)
		piece(egg,"Shell panel",Vector3.new(0.24,0.34,0.047),cf,egg.accent,nil,metal)
		piece(egg,"Panel seam",Vector3.new(0.12,0.018,0.02),cf*CFrame.new(0,0.07,-0.035),coal)
	end
end

function motifs.glyph(egg)
	for i=0,2 do
		local a = i*tau/3
		line(egg,"Carved glyph",{{a-0.16,0.12},{a,0.28},{a+0.16,0.12},{a,0.04},{a-0.16,0.12}},0.035,egg.accent,neon)
		bead(egg,"Glyph dot",a,-0.065,0.047,0.047,cream,neon)
	end
end

function motifs.totem(egg)
	for _, side in {-1,1} do
		solid(egg,"Carved brow",{0.19,0.075,0.095},side*0.15,0.21,-0.46,cream,nil,0,side*0.23)
		face(egg,"Carved eye",side*0.15,0.095,0.102,0.09,ocean)
	end
	solid(egg,"Idol mouth",{0.24,0.08,0.09},0,-0.19,-0.495,egg.accent)
end

function motifs.bead(egg)
	ring(egg,"Carved neckband",0.45,-0.3,0,0.051,0.037,{gold,egg.accent},metal,10)
	for i=1,7 do
		bead(egg,"Engraved bead",i*tau/7,-0.37,0.11,0.11,cream,metal)
	end
end

function motifs.armor(egg)
	for _, side in {-1,1} do
		solid(egg,"Pauldron",{0.30,0.29,0.44},side*0.42,0.18,0,egg.accent,sphere)
		solid(egg,"Armor stud",{0.091,0.091,0.05},side*0.42,0.18,-0.218,cream,sphere)
	end
end

function motifs.crystal(egg)
	for i=1,4 do
		local angle = i*tau/4
		local cf = surface(angle,0.41,0.1)*CFrame.Angles(0,0,0.24)
		piece(egg,"Faceted crystal",Vector3.new(0.15,0.34,0.15),cf,egg.accent,"Wedge",Enum.Material.Glass)
		piece(egg,"Crystal glint",Vector3.new(0.042,0.16,0.03),cf*CFrame.new(0,0.02,-0.055),white,nil,neon)
	end
end

function motifs.skull(egg)
	for _, side in {-1,1} do
		face(egg,"Eye socket",side*0.18,0.12,0.19,0.18,ocean)
	end
	for i=-1,1 do
		face(egg,"Cut tooth",i*0.09,-0.23,0.073,0.131,white)
	end
	face(egg,"Nasal socket",0,-0.04,0.095,0.1,coal)
end

function motifs.shard(egg)
	for i=0,3 do
		piece(egg,"Shell shard",Vector3.new(0.09,0.28+i*0.048,0.12),
			surface(i*math.pi/2+0.22,0.27+i*0.062,0.073)*CFrame.Angles(0,0,0.28),egg.accent,"Wedge",Enum.Material.Ice)
	end
end

function motifs.tricorn(egg)
	solid(egg,"Captain brim",{1.18,0.10,0.79},0,0.51,0,coal,sphere)
	for i=1,3 do
		local cf = CFrame.Angles(0,i*tau/3,0)*CFrame.new(0,0.61,-0.27)*CFrame.Angles(-0.24,0,0)
		piece(egg,"Captain's folded felt",Vector3.new(0.67,0.24,0.12),cf,egg.accent,"Wedge")
	end
end

function motifs.anchor(egg)
	local cf = surface(0,-0.13,0.078)
	spokes(egg,"Anchor shank",cf,2,0.048,0.25,gold,metal)
	for _, side in {-1,1} do
		piece(egg,"Anchor fluke",Vector3.new(0.053,0.123,0.03),cf*CFrame.new(side*0.09,-0.099,0)*CFrame.Angles(0,0,-side*0.61),gold,nil,metal)
	end
end

function motifs.lock(egg)
	local cf = surface(0,0.04,0.085)
	piece(egg,"Lock body",Vector3.new(0.22,0.17,0.06),cf,gold,nil,metal)
	piece(egg,"Keyhole",Vector3.new(0.047,0.079,0.021),cf*CFrame.new(0,0,-0.035),coal,sphere)
end

function motifs.coins(egg)
	for i=-1,1 do
		local x = i*0.115
		solid(egg,"Gold coin",{0.05,0.14,0.14},x,-0.31+math.abs(i)*0.08,-0.42,gold,nil,math.pi/4+i*0.21,0,metal)
	end
end

function motifs.fossil(egg)
	for i=0,9 do
		local angle = i*0.86
		local size = 0.038+0.006*i
		bead(egg,"Fossil spiral",math.cos(angle)*size*i,math.sin(angle)*size*i*0.58,size+0.028,size+0.016,egg.accent,nil,0.042,angle)
	end
end

function motifs.ridge(egg) styles.Dinosaur(egg) end
function motifs.wizard(egg)
	solid(egg,"Wizard brim",{0.92,0.093,0.83},0,0.50,0,egg.accent,sphere)
	for i=1,4 do
		local span = 0.66-i*0.115
		solid(egg,"Bent wizard peak",{span,0.16,span},i*0.036,0.49+0.136*i,0,egg.accent,sphere,0,-0.23)
	end
end

function motifs.bottle(egg)
	solid(egg,"Flask neck",{0.29,0.23,0.28},0,0.65,0,egg.accent,sphere)
	solid(egg,"Flask stopper",{0.30,0.13,0.29},0,0.78,0,gold,sphere)
	ring(egg,"Potion fill line",0.49,-0.15,0.11,0.034,0.021,{white},neon,12)
end

function motifs.bubble(egg)
	for i=1,5 do
		local size = i%2==0 and 0.097 or 0.059
		bead(egg,"Suspended bubble",i*0.58-1.55,(i%3-1)*0.24,size,size,white,nil,0.076)
	end
end

function motifs.book(egg)
	local cf = surface(0,-0.089,0.08)*CFrame.Angles(0,0,0.19)
	piece(egg,"Book pages",Vector3.new(0.28,0.33,0.11),cf,cream)
	piece(egg,"Book cover",Vector3.new(0.30,0.36,0.055),cf*CFrame.new(0,0,-0.057),egg.accent)
	piece(egg,"Book spine",Vector3.new(0.058,0.36,0.14),cf*CFrame.new(-0.127,0,0),coal)
end

function motifs.flame(egg)
	for i=-1,1 do
		solid(egg,"Flame feather",{0.15,0.38+0.07*(i%2),0.21},0.12*i,0.67,0.15,egg.accent,"Wedge",0,i*0.29,neon)
	end
end

function motifs.orbit(egg)
	for i=1,3 do
		local phase = i*tau/3
		local dot = solid(egg,"Orbit mote",{0.11,0.11,0.11},math.cos(phase)*0.69,0.18+0.1*math.sin(phase),math.sin(phase)*0.69,
			i==1 and white or egg.accent,sphere,0,0,neon)
		dot:SetAttribute("OrbitPhase",phase)
		if not egg.anchored then
			local light = Instance.new("PointLight",dot)
			light.Color = egg.accent
			light.Range = 2.5
			light.Brightness = 0.5
		end
	end
end

function motifs.star(egg)
	for i=0,4 do
		spokes(egg,"Hand-drawn star",surface(0.67*i-1.2,(i%2)*0.36-0.12,0.06),2,0.031,0.11,cream,neon)
	end
end

function motifs.cloud(egg)
	for i=-2,2 do
		solid(egg,"Cloud tuft",{0.36,0.28+i%2*0.1,0.30},i*0.20,-0.29+i%2*0.1,0.24,white,sphere)
	end
end

function motifs.bolt(egg)
	line(egg,"Lightning bolt",{{0.24,0.44},{-0.23,0.05},{0.25,0.051},{-0.17,-0.39}},0.1,gold,neon,0.067)
end

function motifs.halo(egg) ring(egg,"Radiant halo",0.6,0.21,0.24,0.048,0.041,{egg.accent,cream},neon,12) end

function motifs.candy(egg)
	for i=-1,1 do
		solid(egg,"Candy button",{0.12,0.16,0.067},i*0.16,-0.09-math.abs(i)*0.04,-0.51,if i==0 then egg.accent else cream,sphere)
	end
	ring(egg,"Sugar stripe",0.392,0.43,0.06,0.12,0.03,{egg.accent,white},plastic,12)
end

function motifs.fringe(egg)
	for i=1,9 do
		bead(egg,"Hanging tassel",i*tau/9,-0.32,0.09,0.19,gold,nil,0.048,i%2*0.19)
	end
end

function motifs.crest(egg)
	local cf = surface(0,0.04,0.074)
	piece(egg,"Crest shield",Vector3.new(0.29,0.36,0.061),cf,egg.accent,"Wedge",metal)
	spokes(egg,"Crest badge",cf*CFrame.new(0,0,-0.051),2,0.042,0.16,cream)
end

function motifs.visor(egg)
	solid(egg,"Tinted visor",{0.61,0.23,0.16},0,0.12,-0.47,ocean,sphere,0,0,metal)
	solid(egg,"Visor reflection",{0.19,0.048,0.028},-0.14,0.16,-0.549,egg.accent,sphere,0,-0.13)
end

function motifs.crown(egg) styles.Royal(egg) end

function motifs.orb(egg)
	solid(egg,"Orb cradle",{0.31,0.071,0.26},0,-0.06,-0.52,gold,sphere,0,0,metal)
	solid(egg,"Glassy orb",{0.22,0.22,0.22},0,0.04,-0.56,egg.accent,sphere,0,0,Enum.Material.Glass)
end

function motifs.mirror(egg)
	solid(egg,"Mirror rim",{0.32,0.36,0.095},0,0.1,-0.487,gold,sphere,0,-0.23,metal)
	solid(egg,"Silver mirror",{0.23,0.26,0.043},0,0.10,-0.543,white,sphere,0,-0.23,metal)
end

function motifs.flare(egg)
	for i=0,5 do
		local cf = CFrame.Angles(0,i*tau/6,0)*CFrame.new(0,0.06,-0.57)*CFrame.Angles(-0.52,0,0)
		piece(egg,"Rayed prism",Vector3.new(0.08,0.25,0.09),cf,egg.accent,"Wedge",neon)
	end
end

function motifs.helmet(egg)
	ring(egg,"Pressure helmet collar",0.451,-0.303,0,0.11,0.07,{cream,egg.accent},metal,12)
	solid(egg,"Helmet shield",{0.68,0.46,0.23},0,0.15,-0.40,ocean,sphere,0,0,metal)
	for _, side in {-1,1} do
		solid(egg,"Helmet latch",{0.13,0.24,0.18},side*0.431,0.12,-0.048,egg.accent,sphere)
	end
end

function motifs.pack(egg)
	solid(egg,"Courier pack",{0.43,0.47,0.27},0,-0.025,0.452,egg.accent,nil,0,0,metal)
	for _, side in {-1,1} do
		solid(egg,"Pack latch",{0.09,0.16,0.06},side*0.13,0.11,0.603,cream,nil)
	end
end

function motifs.crater(egg)
	for i=1,5 do
		local theta,y = i*2.4,(i%3-1)*0.28
		bead(egg,"Crater rim",theta,y,0.18,0.145,egg.accent,nil,0.055)
		bead(egg,"Crater hollow",theta,y,0.11,0.079,ocean,nil,0.076)
	end
end

function motifs.planet(egg)
	ring(egg,"Planetary ring",0.65,-0.05,-0.37,0.052,0.098,{egg.accent},metal,12)
	solid(egg,"Companion planet",{0.24,0.24,0.24},0.58,0.43,0.13,cream,sphere)
end

function motifs.checker(egg)
	for i=0,11 do
		for row=-1,0 do
			piece(egg,"Racing check",Vector3.new(0.13,0.122,0.025),surface(i*tau/12,row*0.12-0.22,0.035),
				(i+row)%2==0 and white or ocean)
		end
	end
end

function motifs.medal(egg)
	ring(egg,"Ribbon collar",0.48,-0.25,0,0.069,0.036,{egg.accent},plastic,10)
	solid(egg,"Racer medal",{0.21,0.24,0.073},0,-0.31,-0.472,gold,sphere,0,0,metal)
	solid(egg,"Stamped medal",{0.105,0.11,0.044},0,-0.3,-0.507,cream,sphere)
end

function motifs.torch(egg)
	solid(egg,"Torch handle",{0.095,0.42,0.11},0.48,0.05,0.059,gold)
	solid(egg,"Torch flame",{0.18,0.25,0.16},0.48,0.35,0.059,egg.accent,"Wedge",0,0.35,neon)
end

function motifs.trophy(egg)
	solid(egg,"Trophy stem",{0.13,0.19,0.10},0,0.61,0.01,gold)
	solid(egg,"Trophy bowl",{0.39,0.29,0.28},0,0.81,0.01,gold,sphere,0,0,metal)
	for _, side in {-1,1} do
		solid(egg,"Trophy handle",{0.14,0.15,0.073},side*0.189,0.80,0.015,egg.accent,sphere)
	end
end

function motifs.hood(egg)
	solid(egg,"Hood fabric",{0.77,0.38,0.74},0,0.47,0.04,egg.accent,sphere)
	ring(egg,"Hood stitching",0.355,0.48,0,0.048,0.029,{white},plastic,10)
end

function motifs.boot(egg)
	for _, side in {-1,1} do
		solid(egg,"Rounded boot",{0.24,0.17,0.41},side*0.28,-0.53,-0.12,egg.accent,sphere)
		solid(egg,"Boot sole",{0.23,0.055,0.39},side*0.28,-0.60,-0.12,ocean,sphere)
	end
end

function motifs.chef(egg)
	for i=0,2 do
		solid(egg,"Chef cap puff",{0.32,0.31,0.31},math.cos(i*tau/3)*0.12,0.73,math.sin(i*tau/3)*0.12,white,sphere)
	end
	ring(egg,"Chef cap brim",0.26,0.63,0,0.10,0.04,{cream},plastic,10)
end

function motifs.apron(egg)
	piece(egg,"Canvas apron",Vector3.new(0.37,0.37,0.053),surface(0,-0.22,0.045),cream)
	piece(egg,"Deep apron pocket",Vector3.new(0.23,0.135,0.058),surface(0,-0.29,0.07),egg.accent)
end

function motifs.wheel(egg)
	for side=-1,1,2 do
		local cf = CFrame.new(side*0.43,-0.42,0.09)*CFrame.Angles(0,side*math.pi/2,0)
		piece(egg,"Cart wheel",Vector3.new(0.31,0.31,0.12),cf,coal,sphere)
		spokes(egg,"Wheel spoke",cf*CFrame.new(0,0,-0.066),3,0.035,0.235,gold,metal)
	end
end

function motifs.ship(egg)
	solid(egg,"Carved hull",{1.05,0.28,0.72},0,-0.42,0.035,ocean,sphere)
	ring(egg,"Hull trim",0.46,-0.35,0,0.052,0.066,{egg.accent},metal,10)
end

function motifs.sail(egg)
	solid(egg,"Sail mast",{0.063,0.59,0.068},0,0.58,0.29,gold)
	solid(egg,"Pressed canvas",{0.52,0.44,0.13},0,0.68,0.31,cream,"Wedge",0,-0.31)
end

function motifs.tentacle(egg)
	for i=0,3 do
		local rotation = CFrame.Angles(0,i*tau/4+0.37,0)
		local a = rotation * Vector3.new(0.32,-0.32,0)
		local b = rotation * Vector3.new(0.58,-0.4,0)
		local c = rotation * Vector3.new(0.68,-0.23,0)
		segment(egg,"Tentacle base",a,b,0.13,0.11,egg.accent)
		segment(egg,"Tentacle end",b,c,0.087,0.08,egg.accent)
		piece(egg,"Tentacle suction pad",Vector3.new(0.08,0.08,0.055),CFrame.new(b),cream,sphere)
	end
end

function motifs.compass(egg)
	local cf = surface(0,0.0,0.08)
	piece(egg,"Compass housing",Vector3.new(0.31,0.31,0.065),cf,gold,sphere,metal)
	piece(egg,"Compass dial",Vector3.new(0.25,0.25,0.05),cf*CFrame.new(0,0,-0.037),ocean,sphere)
	spokes(egg,"Compass needle",cf*CFrame.new(0,0,-0.064)*CFrame.Angles(0,0,0.45),2,0.027,0.204,egg.accent,neon)
end

function motifs.horn(egg)
	for _, side in {-1,1} do
		solid(egg,"Paired horn",{0.16,0.28,0.14},side*0.33,0.57,-0.14,cream,"Wedge",0,-side*0.27)
	end
end

function motifs.solar(egg)
	for _, side in {-1,1} do
		solid(egg,"Solar foil",{0.37,0.033,0.25},side*0.53,-0.22,0.17,rgb("5778af"),nil,0,side*0.15,metal)
		solid(egg,"Solar trace",{0.3,0.041,0.023},side*0.53,-0.187,0.17,egg.accent,nil,0,side*0.15,neon)
	end
end

local function addCracks(egg, tint)
	for i=0,2 do
		local a = 0.98+i*tau/3
		local upper = {{a-0.18,0.35},{a+0.07,0.17},{a-0.12,-0.01}}
		local lower = {{a-0.12,-0.01},{a+0.13,-0.16},{a+0.025,-0.32},{a+0.22,-0.46}}
		line(egg,"Crack1",upper,0.025,tint,nil,0.053)
		line(egg,"Crack2",lower,0.027,tint,nil,0.058)
	end
end

function EggModel.build(id, width, anchored)
	local skin = Cosmetics.byId[id] or Cosmetics.byId.Classic
	local shellColor = rgb(skin.shell)
	local model = Instance.new("Model")
	model.Name = "CourierEgg"
	local egg = {
		model=model, width=width, anchored=anchored == true, accent=rgb(skin.accent),
	}
	local material = if id == "Frozen" then Enum.Material.Ice
		elseif (id == "Golden" or skin.rank >= 5) then metal else plastic
	model.PrimaryPart = piece(egg,"Shell",Vector3.new(1,shellHeight,1),CFrame.identity,shellColor,sphere,material)
	local style = styles[id]
	if style then style(egg) end
	for motif in string.gmatch(skin.style,"%S+") do
		motifs[motif](egg)
	end
	local paleCrack = shellColor.R*0.2126+shellColor.G*0.7152+shellColor.B*0.0722 < 0.43
	addCracks(egg,if paleCrack then rgb("ffe2aa") else rgb("392633"))
	EggModel.condition(model,3)
	model:SetAttribute("Skin",id)
	return model
end

function EggModel.condition(model, hp)
	for _, p in model:GetChildren() do
		if p.Name == "Crack1" then p.Transparency = hp < 3 and 0 or 1 end
		if p.Name == "Crack2" then p.Transparency = hp < 2 and 0 or 1 end
	end
end

-- Preview clients animate the orbit parts only on the model currently in view.
-- World copies keep their low-cost welded orbit markers.
function EggModel.previewPose(model, angle, elapsed)
	local cf = CFrame.Angles(0,angle,0)
	model:PivotTo(cf)
	local width = model.PrimaryPart.Size.X
	for _, part in ipairs(model:GetChildren()) do
		local phase = part:GetAttribute("OrbitPhase")
		if phase then
			local spin = phase+elapsed*1.45
			part.CFrame = cf*CFrame.new(math.cos(spin)*width*0.69,(0.18+0.11*math.sin(2*spin))*width,math.sin(spin)*width*0.69)
		end
	end
end

return EggModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Levels</string>
          <string name="Source"><![CDATA[local Levels = {}

Levels.worlds = {
	{key="temple", name="The Lost Temple", color="356950", accent="ffdb73", hook="An expedition unlocks a living mountain.", icon="idol", relic="Sun idol"},
	{key="pirate", name="The Pirate's Secret", color="216985", accent="ffbe7a", hook="Follow a flooded cave to a ship that should not exist.", icon="ship", relic="Compass piece"},
	{key="prehistoric", name="Prehistoric Panic", color="3d693e", accent="ffd084", hook="A research station races a creature migration.", icon="fossil", relic="Amber fossil"},
	{key="factory", name="The Impossible Factory", color="8a4e85", accent="ffd787", hook="An impossible candy workshop has a delivery deadline.", icon="gear", relic="Candy recipe stamp"},
	{key="frozen", name="Frostbite Peaks", color="40658e", accent="b4f3ff", hook="The last mountain lift leaves before the storm.", icon="crystal", relic="Frost crystal"},
	{key="cloud", name="Cloud Kingdom", color="614c96", accent="ffe19a", hook="Chase the sky fleet through a city on the wind.", icon="cloud", relic="Sky seal"},
	{key="neon", name="Neon Metropolis", color="523982", accent="8effec", hook="Beat the last train across a city that never dims.", icon="tower", relic="Signal chip"},
	{key="galactic", name="Galactic Escape", color="3b3b79", accent="f2a9ff", hook="Evacuate a station while its gravity reboots.", icon="planet", relic="Star fragment"},
}
Levels.worldByKey = {}
for _, world in ipairs(Levels.worlds) do
	Levels.worldByKey[world.key] = world
end

local rating = {"Beginner", "Easy", "Moderate", "Hard", "Expert"}

local function course(worldKey,key,name,stars,hook,sections,championship)
	local world = Levels.worldByKey[worldKey]
	local limit = 185 + stars*4
	local index = #Levels+1
	Levels[index] = {
		key=key, worldKey=worldKey, island=world.name, name=name, stars=stars,
		rating=rating[stars], hook=hook, sections=sections, time=limit,
		medal={gold=115+stars*4, silver=142+stars*4, bronze=limit},
		pace=0.86+stars*0.03, championship=championship == true,
	}
	return index
end

-- Chapters use consecutive playable encounters. A course's order determines
-- where its optional relic can be found and where Adventure restores the player.
course("temple","sun-vault","The Sun Vault",2,"Open the jungle vault, outrun the idol's stone guard, and catch a minecart.",
	{"expedition","idolRoom","boulderRun","cartTracks","waterfall","sunExit"})
course("temple","broken-aqueduct","The Broken Aqueduct",3,"Follow the dry canal into a flooded temple and reopen its sky bridge.",
	{"rootway","floodgates","relicGallery","crackBridge","waterfall","cartTracks"})
course("temple","echoes-below","Echoes Below",4,"Find a route through the mountain's rotating rooms before the lanterns go dark.",
	{"relicGallery","turningDoors","rootway","cartTracks","boulderRun","sunExit"})
course("pirate","tideglass-grotto","Tideglass Grotto",2,"Find the village trapdoor, ride the spillway, and board a hidden ship.",
	{"harbor","seaSlide","rigging","ghostShip","floodgates","reefExit"})
course("pirate","moon-tide-run","Moon Tide Run",3,"Cross flooded docks and sail a rocking ferry to the smuggler's rope bridge.",
	{"smuggler","tidePools","ghostShip","crackBridge","seaSlide","reefExit"})
course("pirate","captains-last-call","Captain's Last Call",4,"Race the returning tide from the captain's hold to an open-water escape.",
	{"ghostShip","smuggler","seaSlide","rigging","tidePools","reefExit"})
course("prehistoric","amber-outpost","Amber Outpost",2,"Power the research lifts and guide your egg through a giant creature migration.",
	{"fieldStation","rootway","migration","researchLift","fossilBasin","canopyExit"})
course("prehistoric","raptor-ridge","Raptor Ridge",3,"Escape a ridge-side dig by climbing fossil terraces and crossing the nest trails.",
	{"fossilBasin","migration","canopyLift","crackBridge","fieldStation","canopyExit"})
course("prehistoric","last-tram-out","Last Tram Out",4,"Keep up with the supply tram as the forest breaks through the research base.",
	{"researchLift","fieldStation","cartTracks","migration","canopyLift","canopyExit"})
course("factory","midnight-delivery","Midnight Delivery",1,"Take the candy line through frosting rollers before the packing bell.",
	{"candyWorks","chocolateRiver","mixingRoom","frostingLine","crackBridge","sugarExit"})
course("factory","runaway-recipe","Runaway Recipe",3,"Chase a runaway batch between giant mixers and the furnace belts.",
	{"mixingRoom","candyWorks","furnace","caramelLift","frostingLine","sugarExit"})
course("factory","clockwork-cocoa","Clockwork Cocoa",4,"Read the boiler signals and ride a transforming assembly line out of the factory.",
	{"furnace","chocolateRiver","caramelLift","candyWorks","mixingRoom","sugarExit"})
course("frozen","glacier-express","Glacier Express",2,"Catch the mountain gondola after braving a snowball slalom.",
	{"skiVillage","avalanche","iceCaves","gondola","frostSpan","summitExit"})
course("frozen","crystal-underpass","Crystal Underpass",3,"Cut through a crystal cave and a frozen sluice to reach the summit.",
	{"iceCaves","frostSpan","floodgates","skiVillage","avalanche","gondola"})
course("frozen","whiteout-relay","Whiteout Relay",4,"Chain sheltered snowbanks and low-visibility bridge crossings above the valley.",
	{"gondola","avalanche","skiVillage","iceCaves","crackBridge","summitExit"})
course("cloud","windward-courier","Windward Courier",2,"Deliver to the sky fleet through floating gardens and gust gates.",
	{"skyGarden","gustGates","cloudSteps","airships","ringway","skyExit"})
course("cloud","floating-bell","The Floating Bell",3,"Cross drifting airships and climb a tower of cloud stairs to ring the harbor bell.",
	{"airships","skyGarden","ringway","cloudSteps","crackBridge","skyExit"})
course("cloud","thunder-mail","Thunder Mail",4,"Race a storm along sky bridges while wind switches the faster lanes.",
	{"gustGates","airships","ringway","frostSpan","cloudSteps","skyExit"})
course("neon","last-light-express","Last Light Express",2,"Catch the city's final elevated train by following its glowing signals.",
	{"rooftop","signalYard","maglev","arcade","overpass","neonExit"})
course("neon","signal-chase","Signal Chase",3,"Navigate the switchyard, climb a billboard spine, and race the night tram.",
	{"signalYard","rooftop","overpass","maglev","arcade","neonExit"})
course("neon","midnight-switch","Midnight Switch",4,"Use neon shortcuts and the slower service walkways to beat a power surge.",
	{"arcade","overpass","signalYard","crackBridge","maglev","neonExit"})
course("galactic","station-sunrise","Station Sunrise",3,"Leave the crew ring and leap onto the emergency shuttle.",
	{"orbitalDock","gravityLab","airlock","cargoSpin","satellites","launchExit"})
course("galactic","out-of-orbit","Out of Orbit",4,"Race a spin-up test through satellite arrays and a fractured cargo ring.",
	{"satellites","cargoSpin","orbitalDock","crackBridge","gravityLab","launchExit"})
course("galactic","ring-rescue","Ring Rescue",5,"Use the station's emergency doors, shifting cargo decks, and rescue thrusters.",
	{"airlock","orbitalDock","ringway","gravityLab","satellites","launchExit"})
Levels.final = course("galactic","championship","The Crown Launch",5,"Three finalists chase one golden capsule through a championship-only course.",
	{"crownEntry","cargoSpin","crownFerry","crackBridge","crownTower","crownFinish"},true)

return Levels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">RaceRules</string>
          <string name="Source"><![CDATA[local Rules = {}

function Rules.crossing(previous, current, line, center, width, minY, maxY)
	if previous.Z >= line or current.Z < line then return nil end
	local fraction = (line-previous.Z)/(current.Z-previous.Z)
	local x = previous.X + (current.X-previous.X)*fraction
	local y = previous.Y + (current.Y-previous.Y)*fraction
	if math.abs(x-center) <= width and y >= (minY or 0.5) and y <= (maxY or 8.5) then return fraction end
	return nil
end

local cuts = {12, 9, 6, 3}
Rules.heatCount = #cuts + 1

function Rules.slots(starting, heat, remaining)
	local cut = cuts[heat]
	if not cut then return math.min(remaining,1) end
	return math.min(remaining, math.max(2, math.ceil(starting*cut/15)))
end

function Rules.drawMaps(random, levels)
	local candidates = {}
	for index, info in ipairs(levels) do
		if index ~= levels.final then
			table.insert(candidates,{index=index,stars=info.stars or 1,seed=random:NextNumber()})
		end
	end
	table.sort(candidates,function(a,b)
		if a.stars ~= b.stars then return a.stars < b.stars end
		if a.seed ~= b.seed then return a.seed < b.seed end
		return a.index < b.index
	end)
	assert(#candidates >= #cuts, "Egg Royale needs four qualifier maps")
	local maps = {}
	for heat = 1,#cuts do
		local min = math.floor((heat-1)*#candidates/#cuts)+1
		local max = math.floor(heat*#candidates/#cuts)
		maps[heat] = candidates[random:NextInteger(min,max)].index
	end
	maps[Rules.heatCount] = assert(levels.final, "Egg Royale needs a championship map")
	return maps
end

function Rules.recordKey(level)
	return "adventure:v1:" .. level
end

function Rules.rank(entries)
	table.sort(entries,function(a,b)
		if a.finishPlace ~= b.finishPlace then
			return (a.finishPlace or math.huge) < (b.finishPlace or math.huge)
		end
		if a.active ~= b.active then return a.active end
		if a.progress ~= b.progress then return a.progress > b.progress end
		if a.hp ~= b.hp then return a.hp > b.hp end
		return a.userId < b.userId
	end)
	return entries
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">SeasonConfig</string>
          <string name="Source"><![CDATA[local Cosmetics = require(script.Parent.Cosmetics)

local Season = {
	id="great-eggscape", name="The Great Eggscape", number=1, xpPerTier=180, count=50,
	premiumPassId=0, suggestedRobux=1000, tiers={},
}

local function item(kind, id, name, amount)
	return {kind=kind, id=id, name=name, amount=amount}
end

local seasonalEggs = {}
for _, egg in ipairs(Cosmetics.entries) do
	if egg.source == "season" then table.insert(seasonalEggs,egg) end
end

local freeMilestones = {
	[1]=item("carton","classic","Classic Carton"),
	[5]=item("coins",nil,"100 Egg Coins",100),
	[10]=item("carton","classic","Classic Carton"),
	[15]=item("carton","adventure","Adventure Carton"),
	[20]=item("title","Explorer","Explorer title"),
	[25]=item("coins",nil,"250 Egg Coins",250),
	[30]=item("carton","adventure","Adventure Carton"),
	[35]=item("trail","Expedition","Expedition trail"),
	[40]=item("coins",nil,"500 Egg Coins",500),
	[45]=item("carton","enchanted","Enchanted Carton"),
	[50]=item("carton","royal","Royal Carton"),
}
local accessoryNames = {"Sun Pin", "Trail Ribbon", "Jade Compass", "Star Pin", "Cloud Patch", "Crown Patch"}
local banners = {"Expedition Dawn", "Hidden Grotto", "Magma Light", "Moonrise", "Royal Violet", "Star Trail"}
local titles = {"Relic Seeker", "Canyon Scout", "Storm Sailor", "Jungle Guide", "Moon Pilot", "Royal Explorer"}
local victories = {"Carton Confetti", "Relic Spark", "Shooting Star", "Aurora Burst", "Crown Parade", "Celestial Finale"}

for tier=1,Season.count do
	local amount = 25+math.floor(tier/10)*5
	local free = freeMilestones[tier] or item("coins",nil,("%d Egg Coins"):format(amount),amount)
	local eggIndex = if tier == 50 then #seasonalEggs elseif tier % 3 == 1 then (tier+2)//3 else nil
	local egg = eggIndex and seasonalEggs[eggIndex]
	local cycle = math.ceil(tier/8)
	local premium
	if egg then
		premium=item("egg",egg.id,egg.name)
	elseif tier%4 == 0 and banners[cycle] then
		premium=item("banner",banners[cycle],banners[cycle].." banner")
	elseif tier%4 == 1 and victories[cycle] then
		premium=item("victory",victories[cycle],victories[cycle].." victory")
	elseif tier%4 == 2 and titles[cycle] then
		premium=item("title",titles[cycle],titles[cycle].." title")
	elseif accessoryNames[cycle] then
		premium=item("accessory",accessoryNames[cycle],accessoryNames[cycle])
	else
		premium=item("trail","Aurora","Aurora trail")
	end
	table.insert(Season.tiers,{free=free,premium=premium})
end

function Season.level(xp)
	return math.clamp(1+math.floor(xp/Season.xpPerTier),1,Season.count)
end

return Season
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">TrophyModel</string>
          <string name="Source"><![CDATA[local Trophy = {}
local gold = Color3.fromHex("ffd15e")
local trim = Color3.fromHex("ffa63f")
local base = Color3.fromHex("402357")

function Trophy.build()
	local trophy = Instance.new("Model")
	trophy.Name = "Egg Royale Cup"
	local function part(name, size, pivot, color, shape)
		local t = Instance.new("Part")
		t.Name = name
		t.Size = size
		t.CFrame = pivot
		t.Color = color
		t.Material = if color == base then Enum.Material.SmoothPlastic else Enum.Material.Metal
		t.Shape = shape or Enum.PartType.Block
		t.Anchored = true
		t.CanCollide = false
		t.CanTouch = false
		t.CanQuery = false
		t.Parent = trophy
		return t
	end
	local stem = part("Cup pedestal",Vector3.new(1.5,0.31,1.11),CFrame.new(0,0.15,0),base)
	trophy.PrimaryPart = stem
	part("Gold nameplate",Vector3.new(1.17,0.14,0.05),CFrame.new(0,0.17,-0.56),gold)
	part("Stem",Vector3.new(0.31,0.49,0.33),CFrame.new(0,0.55,0),trim)
	part("Cup",Vector3.new(1.36,1.12,1.12),CFrame.new(0,1.29,0),gold,Enum.PartType.Ball)
	part("Cup lip",Vector3.new(0.18,1.42,1.42),CFrame.new(0,1.64,0)*CFrame.Angles(0,0,math.pi/2),trim,Enum.PartType.Cylinder)
	for _, side in {-1,1} do
		for index=0,6 do
			local a = index*math.pi/6-math.pi/2
			part("Looped handle",Vector3.new(0.19,0.19,0.19),
				CFrame.new(side*(0.51+math.cos(a)*0.49),1.38+math.sin(a)*0.37,0),trim,Enum.PartType.Ball)
		end
	end
	return trophy
end

return Trophy
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">EggServer</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CoinPacks</string>
          <string name="Source"><![CDATA[local Marketplace = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local Config = require(Shared.Config)
local Data = require(script.Parent.Data)

local CoinPacks = {}
local byProduct = {}

for _, pack in Config.legacyCoinProducts do
	local id = pack.productId
	if typeof(id) == "number" and id > 0 and id % 1 == 0
		and typeof(pack.coins) == "number" and pack.coins > 0 and pack.coins % 1 == 0 then
		if byProduct[id] ~= nil then
			byProduct[id] = false
			warn("Courier coin packs share developer product ID", id)
		else
			byProduct[id] = pack
		end
	end
end

function CoinPacks.start(onChanged)
	Marketplace.ProcessReceipt = function(receipt)
		local pack = byProduct[receipt.ProductId]
		local id = receipt.PurchaseId
		if not pack or typeof(id) ~= "string" or id == "" then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end
		local granted, credited = Data.grantCoinPack(player,id,pack.coins)
		if not granted then return Enum.ProductPurchaseDecision.NotProcessedYet end
		if credited and onChanged then task.defer(onChanged,player) end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

return CoinPacks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Courses</string>
          <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local Levels = require(Shared.Levels)
local Obstacles = require(script.Parent.Obstacles)

local Courses = {}
local rgb = Color3.fromHex
local v = Vector3.new
local ink, cream = rgb("151f26"), rgb("ffedca")
local red, amber = rgb("ff4c42"), rgb("ffc455")

local tones = {
	temple={"668270","d4ab6d","30664c"}, pirate={"93674b","c59863","17667f"},
	prehistoric={"62734b","97b867","4e8b64"}, factory={"975a82","ce9db7","78526c"},
	frozen={"81c6df","bde9f0","4c8fb7"}, cloud={"887dc0","b5b5e4","716ba8"},
	neon={"423c67","62508b","252849"}, galactic={"494877","7271b8","1d2446"},
}

local function colorsFor(world)
	local tonesForWorld = tones[world.key]
	return {
		deck=rgb(tonesForWorld[1]), rock=rgb(tonesForWorld[2]), ground=rgb(tonesForWorld[3]),
		rim=rgb(world.accent), lane=rgb("b0f5c3"), hazard=rgb("ff815e"),
	}
end

local function part(c, name, px, py, pz, size, color, solid, shape, angles)
	local cf = CFrame.new(c.x+px,py,c.z+pz)
	local p = Obstacles.part(c.model,name,size,angles and cf*angles or cf,color,solid == true,shape)
	if not solid then p.CanQuery = false end
	return p
end

local function deck(c, first, last, width, offset, top, color)
	return part(c,"Runway",offset or 0,(top or 0)-0.9,(first+last)/2,v(width,1.8,last-first),color or c.colors.deck,true)
end

local function light(c, name, px, py, pz, size, color, shape, angles)
	local p = part(c,name,px,py,pz,size,color,false,shape,angles)
	p.Material = Enum.Material.Neon
	p.CastShadow = false
	return p
end

local function marking(c, z, width, top, color)
	part(c,"Tread edge",0,top+0.025,z,v(width,0.05,0.24),color)
end

local function plaque(c, text, px, py, pz, width, height, color)
	local board = part(c,"Course sign",px,py,pz,v(width,height,0.38),ink)
	for _, face in {Enum.NormalId.Front,Enum.NormalId.Back} do
		local surface = Instance.new("SurfaceGui",board)
		surface.Face = face
		surface.CanvasSize = Vector2.new(700,100)
		surface.LightInfluence = 0
		local words = Instance.new("TextLabel",surface)
		words.Size = UDim2.fromScale(0.94,0.8)
		words.Position = UDim2.fromScale(0.03,0.1)
		words.BackgroundTransparency = 1
		words.TextColor3 = color
		words.Font = Enum.Font.FredokaOne
		words.Text = text
		words.TextScaled = true
	end
end

local function gate(c, text, z, width, color)
	for _, side in {-1,1} do
		part(c,"Gate stanchion",side*(width/2+0.6),4,z,v(1.05,8,1.05),ink)
		light(c,"Gate tube",side*(width/2+0.6),4,z-0.58,v(0.26,7.2,0.12),color)
	end
	plaque(c,text,0,8,z,width+2.1,2.25,color)
end

local function finishGate(c)
	local z = c.length+3.4
	local color = c.colors.rim
	for _, side in {-1,1} do
		part(c,"Finish tower",side*15.15,5.5,z,v(1.2,11,1.5),ink)
		light(c,"Finish tower lamp",side*15.15,5.5,z-0.78,v(0.29,9.25,0.1),color)
	end
	local board = part(c,"Finish scoreboard",0,11.85,z,v(31.4,5.65,0.6),ink)
	for _, side in {-1,1} do
		light(c,"Scoreboard trim",0,11.85+side*2.6,z,v(30.55,0.14,0.72),color)
	end
	c.finishDisplay = {}
	for _, face in {Enum.NormalId.Front,Enum.NormalId.Back} do
		local surface = Instance.new("SurfaceGui",board)
		surface.Face = face
		surface.CanvasSize = Vector2.new(850,153)
		surface.LightInfluence = 0
		surface.MaxDistance = 155
		local title = Instance.new("TextLabel",surface)
		title.Name = "Finish heading"
		title.BackgroundTransparency = 1
		title.Position = UDim2.fromScale(0.04,0.065)
		title.Size = UDim2.fromScale(0.92,0.39)
		title.Text = "FINISH"
		title.TextColor3 = cream
		title.Font = Enum.Font.FredokaOne
		title.TextScaled = true
		local counter = Instance.new("TextLabel",surface)
		counter.Name = "Finish slots"
		counter.BackgroundTransparency = 1
		counter.Position = UDim2.fromScale(0.06,0.51)
		counter.Size = UDim2.fromScale(0.88,0.38)
		counter.Text = "-- / -- IN"
		counter.TextColor3 = color
		counter.Font = Enum.Font.GothamBold
		counter.TextScaled = true
		table.insert(c.finishDisplay,counter)
	end
end

local ball = Enum.PartType.Ball
local cylinder = Enum.PartType.Cylinder
local vertical = CFrame.Angles(0,0,math.pi/2)
local deckWidth, arenaWidth = 34, 30
local bayTint = rgb("a1e6b6")

local function bay(c,z,width)
	part(c,"Safe waiting stripe",0,0.036,z,v(width,0.072,1.2),bayTint)
	for _, side in {-1,1} do
		light(c,"Refuge lamp",side*(width/2+0.4),0.3,z,v(0.38,0.56,0.72),c.colors.lane)
	end
end

local function hazard(c,kind,x,y,z,phase,settings)
	local stats = table.clone(settings or {})
	local definition = Obstacles.definitions[kind]
	if definition.speed and kind ~= "wind" and kind ~= "slide" and kind ~= "launch" and kind ~= "gravity" then
		stats.speed = (stats.speed or definition.speed)*c.pace
	end
	stats.color = stats.color or c.colors.hazard
	return Obstacles.add(c,kind,v(c.x+x,y,c.z+z),phase,stats)
end

local function ledge(c,first,last,width,x,top)
	deck(c,first,last,width,x,top,c.colors.deck)
	local mid = (first+last)*0.5
	for _, side in {-1,1} do
		part(c,"Platform lip",x+side*(width*0.5-0.18),top+0.028,mid,v(0.3,0.055,last-first),c.colors.rim)
	end
end

local function ramp(c,x,first,last,width,bottom,top)
	local span, rise = last-first, top-bottom
	local angle = math.atan2(-rise,span)
	local cf = CFrame.Angles(angle,0,0)
	part(c,"Sloped runway",x,(top+bottom)*0.5-0.55,(first+last)*0.5,
		v(width,1.1,math.sqrt(span*span+rise*rise)+0.3),c.colors.deck,true,nil,cf)
end

local function rideDetail(c,ride,name,offset,size,tint,shape,angles)
	local base = ride.CFrame*CFrame.new(offset)
	local detail = Obstacles.part(c.model,name,size,angles and base*angles or base,tint,false,shape)
	detail.CanQuery, detail.CastShadow, detail.Massless = false, false, true
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = ride, detail, detail
	detail.Anchored = false
end

local function rail(c,x,first,last)
	for _, side in {-1,1} do
		part(c,"Cart rail",x+side*2.75,-1.36,(first+last)*0.5,v(0.24,0.24,last-first),c.colors.rim)
	end
	for row=first+2,last-2,5.4 do
		part(c,"Rail tie",x,-1.65,row,v(6.9,0.24,0.75),ink)
	end
end

local function flaggedLane(c,x,first,last,width)
	ledge(c,first,last,width,x,0)
	for row=first+2,last-2,10 do
		part(c,"Detour marker",x,0.035,row,v(1.5,0.07,1.25),c.colors.lane)
	end
end

local encounters = {}

function encounters.weave(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,4 do
		local side = if (i+variant)%2==0 then 1 else -1
		local row = z+9+i*(length-22)/5
		local height = i==2 and 3.2 or 4.8
		part(c,"Slalom barricade",side*6,height/2,row,v(17,height,3.15),c.colors.rock,true)
		part(c,"Barricade cap",side*6,height,row,v(17.3,0.28,3.4),c.colors.rim)
		bay(c,row-3.9,28)
	end
end

function encounters.sweepers(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,3 do
		local row = z+8+i*(length-20)/4
		local x = ((i+variant)%2==0 and -1 or 1)*6
		hazard(c,"sweep",x,0,row,i*1.9,{size=v(13.5,0.78,1.1),y=0.56,speed=1.04+i*0.11})
		part(c,"Sweep center",x,0.035,row,v(0.07,13.5,13.5),c.colors.rock,false,cylinder,vertical)
		bay(c,row-7.8,28)
	end
end

function encounters.rollers(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,3 do
		local row = z+7+i*(length-20)/4
		local x = ((i+variant)%2==0 and -1 or 1)*6
		hazard(c,"roller",x,0,row,i*2.07,{size=v(10.6,2.5,2.5),y=1.25,range=4.8,speed=1.33})
		bay(c,row-3.9,28)
	end
end

function encounters.bouncers(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,3 do
		local row = z+8+i*(length-22)/4
		local x = ((i+variant)%2==0 and -1 or 1)*4.8
		hazard(c,"ball",x,0,row,i*1.93,{size=v(6.1,6.1,6.1),y=3.05,range=6.6,bounce=1.85,speed=1.21})
		bay(c,row-5.1,28)
	end
end

function encounters.hammers(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,3 do
		local row = z+9+i*(length-22)/4
		local side = if (i+variant)%2==0 then 1 else -1
		part(c,"Hammer support",side*15.7,8,row,v(1.3,16,1.3),ink)
		part(c,"Hammer bracket",side*10.5,16,row,v(11,0.8,0.8),c.colors.rock)
		hazard(c,"pendulum",side*5.5,0,row,i*2.3,{size=v(5.2,5.2,5.2),range=6.2,speed=1.22})
		bay(c,row-4.8,28)
	end
end

function encounters.pistons(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,4 do
		local row = z+9+i*(length-24)/5
		local side = if (i+variant)%2==0 then 1 else -1
		part(c,"Hydraulic piston housing",side*14.7,2.6,row,v(3,5.2,4.5),ink)
		hazard(c,"foam",side*7.8,0,row,i*1.78,{size=v(9.6,4.2,2.1),y=2.1,range=5,speed=1.18})
		bay(c,row-3.7,28)
	end
end

function encounters.locks(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,3 do
		local row = z+9+i*(length-22)/4
		local side = if (i+variant)%2==0 then 1 else -1
		hazard(c,"gate",side*7.75,0,row,i*1.69,{size=v(14.5,5.4,1.2),y=2.7,color=c.colors.rim})
		part(c,"Door jamb",side*14.8,5,row,v(1.4,10,2.5),c.colors.rock,true)
		part(c,"Door lintel",side*7.6,10,row,v(15.2,1.2,2.45),c.colors.rock)
		part(c,"Fixed barrier", -side*6.5,2.45,row,v(12.8,4.9,1.2),c.colors.rock,true)
		bay(c,row-4.7,28)
	end
end

function encounters.hotFloor(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,4 do
		local row = z+9+i*(length-24)/5
		local x = ((i+variant)%2==0 and -1 or 1)*6.2
		hazard(c,"pulse",x,0,row,i*1.71,{size=v(17.4,0.22,4.45),period=5.28,open=1.54,color=ink})
		bay(c,row-4.6,28)
	end
end

function encounters.boulderLane(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,2 do
		local row = z+length*(0.28+(i-1)*0.43)
		local x = ((i+variant)%2==0 and -1 or 1)*5.45
		for _, side in {-1,1} do
			part(c,"Boulder refuge",x+side*8.3,0.07,row,v(3.15,0.14,13.4),c.colors.lane)
			part(c,"Carved boulder rail",x+side*6.3,0.2,row,v(0.33,0.4,18),c.colors.rock)
		end
		hazard(c,"boulder",x,0,row,i*3.9,{size=v(9.25,9.25,9.25),y=4.63,range=12.5,period=8,travel=3.35,color=c.colors.rock})
	end
end

function encounters.migration(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,3 do
		local row = z+9+i*(length-22)/4
		local side = if (i+variant)%2==0 then 1 else -1
		local x = side*4.5
		local moving = hazard(c,"sentry",x,0,row,i*2.24,{
			color=rgb("78a853"), size=v(7.8,5.2,5.55), y=2.6, period=9.1, range=9.4,
		})
		moving.part.Shape = ball
		moving.details = {}
		local function detail(name,dx,y,dz,size,tint)
			local object = part(c,name,x+dx,y,row+dz,size,tint,false,ball)
			table.insert(moving.details,{part=object,offset=CFrame.new(dx,y-2.6,dz)})
		end
		detail("Marching hatchling head",-3.8,4.25,0,v(3.2,3.1,3),rgb("92c85c"))
		detail("Marching hatchling eye",-4.6,4.8,-1.21,v(0.55,0.77,0.38),ink)
		detail("Marching hatchling tail",4.0,2.0,0,v(4.6,1.5,1.6),rgb("6d9b52"))
		for _, dx in {-1.7,1.6} do
			detail("Marching hatchling foot",dx,0.69,-1.65,v(1.8,1.3,1.7),rgb("5f884a"))
		end
		bay(c,row-4.8,28)
	end
end

function encounters.belts(c,z,length,variant)
	local span = (length-14)/3
	for i=1,3 do
		local first = z+7+(i-1)*span
		local row = first+span/2
		local side = if (i+variant)%2==0 then 1 else -1
		hazard(c,"conveyor",side*7.5,0,row,i,{size=v(15,1.4,span+0.05),speed=8.5,color=ink})
		hazard(c,"conveyor",-side*7.5,0,row,i,{size=v(15,1.4,span+0.05),speed=-4,color=c.colors.rock})
		for offset=-span/2+3,span/2-1,4 do
			part(c,"Belt arrow",side*7.5,0.032,row+offset,v(3.7,0.064,0.75),c.colors.lane)
		end
		hazard(c,"pulse",side*7.5,0,row+span/2-3.2,i*2.1,{size=v(11.8,0.22,2.9),period=4.75,open=1.28,color=ink})
	end
end

function encounters.rafter(c,z,length,variant)
	local side = if variant%2==0 then 1 else -1
	local x = side*7.9
	local start, finish = z+7, z+length-7
	rail(c,x,start,finish)
	local span = finish-start
	local ride = hazard(c,"moving",x,0,start+span/2,0.7*variant,{
		size=v(10.1,1.4,14.5), range=(span-13.4)/2, speed=0.46, axis=Vector3.zAxis, color=c.colors.rim,
	}).part
	local theme = c.worldKey
	for _, edge in {-1,1} do
		if theme == "temple" or theme == "prehistoric" or theme == "neon" then
			for _, axel in {-1,1} do
				rideDetail(c,ride,"Courier trolley wheel",v(edge*4.4,-0.85,axel*4.4),v(0.75,1.65,1.65),ink,cylinder)
			end
			rideDetail(c,ride,"Courier trolley rail",v(edge*4.95,1.12,0),v(0.45,0.73,13.8),c.colors.rock)
		elseif theme == "pirate" or theme == "factory" then
			rideDetail(c,ride,"Cargo ferry pontoon",v(edge*4.4,-0.52,0),v(2.45,2.1,13.5),c.colors.rock,ball)
			rideDetail(c,ride,"Cargo ferry trim",v(edge*5,1.08,0),v(0.42,0.6,13.4),ink)
		else
			rideDetail(c,ride,"Gondola shell",v(edge*4.75,0.02,0),v(1.15,2.9,13.7),c.colors.rock,ball)
			rideDetail(c,ride,"Gondola marker",v(edge*4.98,0.18,0),v(0.42,0.68,7.9),c.colors.lane)
		end
	end
	for i=1,4 do
		local pace = span/4
		local first = start+(i-1)*pace
		flaggedLane(c,-x+((i%2==0 and 1 or -1)*1.8),first,first+pace-(i==4 and 0 or 3.65),10.4)
	end
end

function encounters.balance(c,z,length,variant)
	local span = (length-14)/4
	for i=1,4 do
		local x = (if (i+variant)%2==0 then 1 else -1)*2.65
		local first = z+7+(i-1)*span
		local size = span-3.65
		hazard(c,"tilt",x,0,first+size/2,i*1.4,
			{size=v(13,1.4,size),range=0.2,speed=0.95,color=c.colors.rim})
		flaggedLane(c,12.4,first,first+span-(i==4 and 0 or 3.3),5.6)
	end
end

function encounters.carousel(c,z,length,variant)
	local span = (length-14)/3
	for i=1,3 do
		local row = z+7+(i-0.5)*span
		local x = (if (i+variant)%2==0 then 1 else -1)*2.3
		local diameter = span-2.45
		hazard(c,"spin",x,0,row,0,{size=v(1.4,diameter,diameter),speed=(i%2==0 and -1 or 1)*0.86,color=c.colors.rim})
		hazard(c,"sweep",x,0,row,i*1.67,{size=v(diameter-1.9,0.63,0.94),y=0.59,speed=0.98})
	end
	flaggedLane(c,-11.6,z+7,z+length-7,5.2)
end

function encounters.piers(c,z,length,variant)
	local span = (length-14)/4
	for i=1,4 do
		local x = (if (i+variant)%2==0 then 1 else -1)*2.85
		local first = z+7+(i-1)*span
		local top = ({0,0.75,1.35,0.5})[i]
		ledge(c,first,first+span-(i==4 and 0 or 3.4),13.15,x,top)
		part(c,"Pier support",x,-3.85,first+4.2,v(3.6,7,3.6),c.colors.rock)
		ledge(c,first,first+span-(i==4 and 0 or 2.7),6,11.7,0)
	end
end

function encounters.blink(c,z,length,variant)
	local span = (length-14)/4
	for i=1,4 do
		local row = z+7+(i-0.5)*span
		local x = (if (i+variant)%2==0 then 1 else -1)*2.25
		hazard(c,"vanish",x,0,row,i*1.1,{size=v(12,1.4,span-2.8),period=6.4,open=1.75,color=c.colors.rim})
		ledge(c,row-span/2,row+span/2-2.3,5.7,-11.95,0)
	end
end

function encounters.shoves(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	local row = z+length/2
	local width = 27
	for _, side in {-1,1} do
		light(c,"Crack Zone edge",side*width/2,0.045,row,v(0.3,0.09,length-24),red)
	end
	gate(c,"CRACK ZONE · SHOVES ENABLED",z+10,width,amber)
	table.insert(c.zones,{z=c.z+row,extent=length/2-12,width=width/2})
	bay(c,z+length-8,28)
end

function encounters.lifts(c,z,length,variant)
	local span = (length-14)/3
	for i=1,3 do
		local row = z+7+(i-0.5)*span
		local x = (if (i+variant)%2==0 then 1 else -1)*2.7
		hazard(c,"moving",x,0.67,row,i*1.85,
			{size=v(13.85,1.4,span-2.75),range=1.15,speed=0.91,axis=Vector3.yAxis,color=c.colors.rim})
		ledge(c,row-span/2,row+span/2-2.2,6.4,11.2,0)
		for _, side in {-1,1} do
			part(c,"Lift columns",x+side*7.7,2.55,row,v(0.65,8,0.65),c.colors.rock)
		end
	end
end

function encounters.gust(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,3 do
		local row = z+8+i*(length-21)/4
		local side = if (i+variant)%2==0 then 1 else -1
		hazard(c,"wind",side*4.5,0,row,i,{size=v(17,10,11),axis=Vector3.xAxis*-side,speed=19,color=c.colors.rim})
		for offset=-2,2,2 do
			light(c,"Gust direction dash",side*4.5+offset,0.051,row+offset*0.75,v(1.1,0.09,0.42),c.colors.rim)
		end
		part(c,"Windbreak",side*12,1.5,row,v(2.6,3,8.1),c.colors.rock,true)
		bay(c,row-6.25,28)
	end
end

function encounters.boost(c,z,length,variant)
	deck(c,z,z+length,arenaWidth)
	for i=1,3 do
		local side = if (i+variant)%2==0 then 1 else -1
		local row = z+8+i*(length-21)/4
		hazard(c,"launch",side*5.7,0,row-3.1,i,{size=v(6,0.44,5.8),y=0.22,speed=35,color=c.colors.lane})
		part(c,"Hop barrier",side*5.7,0.92,row+2,v(6.7,1.84,0.8),c.colors.rock,true)
		hazard(c,"pulse",-side*6,0,row+2,i*2.4,{size=v(11.1,0.22,3),period=5.15,open=1.23,color=ink})
		bay(c,row-7.1,28)
	end
end

function encounters.slide(c,z,length,variant)
	local side = if variant%2==0 then 1 else -1
	local x = side*6.6
	local first, top, last = z+7,z+length*0.34,z+length-7
	ramp(c,x,first,top,12.3,0,4.4)
	ramp(c,x,top,last,12.3,4.4,0)
	hazard(c,"slide",x,2,(top+last)/2,0,{size=v(10.4,9,last-top-2),speed=22,color=c.colors.rim})
	for _, sideEdge in {-1,1} do
		part(c,"Slide edge",x+sideEdge*5.9,2.2,(top+last)/2,v(0.34,0.32,last-top),c.colors.rim,false,nil,
			CFrame.Angles(math.atan2(4.4,last-top),0,0))
	end
	local span = (last-first)/3
	for i=1,3 do
		ledge(c,first+(i-1)*span,first+i*span-(i==3 and 0 or 3.4),10.6,-x+(i%2==0 and -1.7 or 1.7),0)
	end
end

function encounters.switchback(c,z,length,variant)
	local start, span = z+7,(length-14)/5
	for i=1,5 do
		local first = start+(i-1)*span
		local x = (if variant%2==0 then 1 else -1)*({0,4.6,7.3,4.6,0})[i]
		local top = ({0,1.6,3.35,1.6,0})[i]
		ledge(c,first,first+span-(i==5 and 0 or 1.65),15,x,top)
		part(c,"Climb column",x,-3.6,first+span/2,v(2.8,7,2.8),c.colors.rock)
	end
end

function encounters.ice(c,z,length,variant)
	local floor = deck(c,z,z+length,arenaWidth,0,0,rgb("a8d8e5"))
	floor.CustomPhysicalProperties = PhysicalProperties.new(1,0.135,0)
	floor.Material = Enum.Material.Ice
	for i=1,3 do
		local row = z+9+i*(length-24)/4
		local side = if (i+variant)%2==0 then 1 else -1
		hazard(c,"snowball",side*5.1,0,row,i*2.4,{range=7.8,speed=1.35,color=cream})
		part(c,"Grippy snow shelf",-side*8,0.08,row-1.5,v(8.4,0.16,7.9),cream,true)
	end
end

function encounters.gravity(c,z,length,variant)
	local first, span = z+7,(length-14)/4
	for i=1,4 do
		local row = first+(i-0.5)*span
		local x = (if (i+variant)%2==0 then 1 else -1)*3.25
		local top = (i%2)*1.15
		local size = span-3.45
		ledge(c,row-size/2,row+size/2,14,x,top)
		hazard(c,"gravity",x,top,row,i,{size=v(12,11,size),y=5.5,speed=41,color=c.colors.lane})
		light(c,"Lift field marker",x,top+0.048,row,v(0.09,5.6,5.6),c.colors.lane,cylinder,vertical)
	end
	flaggedLane(c,-12.6,z+7,z+length-7,4.3)
end

local chapters = {
	-- Each chapter places three differently authored encounters under one set piece.
	expedition = {"Expedition camp","weave","piers","pistons"},
	idolRoom = {"Open the sun vault","locks","carousel","hotFloor"},
	boulderRun = {"Boulder escape: use the side refuges","boulderLane","piers","boulderLane"},
	cartTracks = {"Minecart dispatch: ride or take the ledges","rafter","belts","rafter"},
	waterfall = {"Waterfall crossing","gust","balance","slide"},
	sunExit = {"The mountain opens","switchback","boost","locks"},
	rootway = {"Roots over the ravine","weave","balance","switchback"},
	floodgates = {"Floodgates: wait for the green signal","locks","hotFloor","slide"},
	relicGallery = {"Lantern gallery","pistons","switchback","hammers"},
	crackBridge = {"Expedition relay bridge","piers","shoves","balance"},
	turningDoors = {"Clockwork stone doors","locks","sweepers","carousel"},
	harbor = {"Coastal village and the hidden trapdoor","weave","piers","locks"},
	seaSlide = {"Cavern spillway","slide","locks","slide"},
	rigging = {"Cross the rigging","hammers","balance","gust"},
	ghostShip = {"The ship under the mountain","rafter","balance","hammers"},
	reefExit = {"Last boat through the sea gate","locks","rafter","boost"},
	smuggler = {"Smuggler's lookout","pistons","switchback","locks"},
	tidePools = {"Low tide crossings","blink","slide","piers"},
	fieldStation = {"Field research station","weave","lifts","pistons"},
	migration = {"Creature migration: watch the trail","migration","gust","migration"},
	researchLift = {"Lift to canopy command","lifts","switchback","belts"},
	fossilBasin = {"Fossil terraces","switchback","piers","boulderLane"},
	canopyExit = {"Get to the canopy rescue platform","gust","switchback","boost"},
	canopyLift = {"Ride the canopy lifts","lifts","gust","rafter"},
	candyWorks = {"Candy workshop conveyor","belts","bouncers","weave"},
	chocolateRiver = {"Chocolate river barge","slide","rafter","balance"},
	mixingRoom = {"Giant mixers","carousel","sweepers","belts"},
	frostingLine = {"Frosting presses","pistons","rollers","boost"},
	sugarExit = {"Catch the last delivery belt","belts","locks","boost"},
	furnace = {"Boiler test loop","hotFloor","locks","rollers"},
	caramelLift = {"Caramel cooling towers","lifts","balance","belts"},
	skiVillage = {"Alpine outpost","weave","slide","ice"},
	avalanche = {"Avalanche alleys","ice","boulderLane","ice"},
	iceCaves = {"Crystal caves","blink","locks","switchback"},
	gondola = {"Mountain gondola","rafter","lifts","gust"},
	frostSpan = {"Span over frostfall","balance","piers","ice"},
	summitExit = {"Final whiteout","ice","switchback","boost"},
	skyGarden = {"Floating gardens","piers","weave","gust"},
	gustGates = {"Forecast: strong crosswind","gust","locks","boost"},
	cloudSteps = {"Stairways in the clouds","switchback","blink","lifts"},
	airships = {"A fleet on the wind","rafter","gust","balance"},
	ringway = {"Ringway transit","carousel","piers","gravity"},
	skyExit = {"Sky bell finale","boost","gust","switchback"},
	rooftop = {"Roof garden sprint","switchback","piers","weave"},
	signalYard = {"Switchyard: watch signal bars","locks","hotFloor","belts"},
	maglev = {"Maglev train crossing","rafter","belts","pistons"},
	arcade = {"Arcade alleys","bouncers","blink","pistons"},
	overpass = {"Billboard overpass","lifts","switchback","gust"},
	neonExit = {"Race the city power surge","belts","hotFloor","boost"},
	orbitalDock = {"Orbital docking bay","locks","rafter","boost"},
	gravityLab = {"Gravity reboot in progress","gravity","blink","gravity"},
	airlock = {"Emergency pressure doors","locks","gust","hotFloor"},
	cargoSpin = {"Rotating cargo ring","carousel","balance","sweepers"},
	satellites = {"Satellite array","blink","piers","gravity"},
	launchExit = {"Escape shuttle launch","locks","boost","belts"},
	crownEntry = {"Championship mission control","sweepers","locks","boost"},
	crownFerry = {"Transfer to the gold capsule","rafter","gravity","carousel"},
	crownTower = {"Launch tower climb","lifts","switchback","gust"},
	crownFinish = {"Final ascent","belts","locks","boost"},
}

local function tree(c,x,z,height,tint)
	part(c,"Storybook trunk",x,(height-6)/2-3,z,v(height*0.14,height-6,height*0.14),rgb("78563e"))
	part(c,"Storybook canopy",x,height-8,z,v(height*0.76,height*0.44,height*0.71),tint,false,ball)
	part(c,"Canopy lobe",x+height*0.18,height-9,z+height*0.1,v(height*0.52,height*0.34,height*0.55),tint,false,ball)
end

local function pillars(c,x,z,height)
	part(c,"Column pedestal",x,-0.35,z,v(5.8,1.3,6),c.colors.rock)
	part(c,"Carved column",x,height/2,z,v(3.7,height,3.6),c.colors.rock)
	part(c,"Lintel stone",x,height,z,v(6,1.35,5.6),c.colors.rim)
end

local function templeScene(c,z,chapter,index)
	for _, side in {-1,1} do
		for i=1,3 do tree(c,side*(26+i*3),z+(i-2)*34,26+i*3,rgb(i%2==0 and "78984d" or "4b8652")) end
	end
	if chapter == "waterfall" or chapter == "sunExit" or chapter == "floodgates" then
		for _, side in {-1,1} do
			local x = side*24
			part(c,"Aqueduct bluff",x,10,z+14,v(11,37,43),c.colors.rock)
			for i=1,4 do
				local veil = part(c,"Waterfall veil",x+(i-2)*2.4,9,z-8+(i%2)*1.7,v(2.8,34,1.55),rgb(i%2==0 and "a0ebde" or "48bcae"))
				veil.Transparency = 0.19
			end
			for i=1,4 do
				part(c,"Waterfall foam",x+(i-2.5)*3,-3.2,z-10,v(6,2.8,5),rgb("dbfff5"),false,ball)
			end
		end
	elseif chapter == "cartTracks" then
		for _, side in {-1,1} do
			for i=1,3 do
				pillars(c,side*22,z+(i-2)*17,11)
				light(c,"Mine signal lantern",side*19.4,10.4,z+(i-2)*17,v(0.64,0.83,0.68),c.colors.rim)
			end
		end
		part(c,"Mine gallery arch",0,15,z,v(48,2.5,2.1),c.colors.rock)
	else
		local x = index%2==0 and 37 or -37
		for i=1,5 do
			local width = 34-i*4.3
			part(c,"Sun temple terrace",x,i*3.8-5,z,v(width,4,width),c.colors.rock)
		end
		part(c,"Sun altar",x,17.7,z,v(8.7,4.2,8),c.colors.deck)
		light(c,"Sun seal",x,19.4,z-4.15,v(2.5,2.5,0.5),c.colors.rim)
		for _, side in {-1,1} do pillars(c,side*19,z-18,11.2) end
	end
end

local function ship(c,x,z,scale)
	for i=1,6 do
		local row = z+(i-3.5)*9*scale
		local width = (20-math.abs(i-3.5)*4.4)*scale
		part(c,"Timber hull",x,-3.6,row,v(width,6.2*scale,9.2*scale),rgb("79563f"),
			false,nil,CFrame.Angles(0,0,(i-3.5)*0.019))
		part(c,"Gold gunwale",x,0.2,row,v(width+0.45,0.4,9.3*scale),c.colors.rim)
	end
	for i=1,2 do
		local row = z+(i-1.5)*21*scale
		local height = (i==1 and 26 or 20)*scale
		part(c,"Pirate mast",x,height/2,row,v(1.35,height,1.35),rgb("72503f"))
		part(c,"Crossyard",x,height*0.78,row,v(16*scale,0.8,0.88),c.colors.rock)
		part(c,"Wind-filled sail",x,height*0.56,row-0.8,v(12.6*scale,9.4*scale,2.15),cream,false,ball)
		part(c,"Sail jewel",x,height*0.56,row-1.9,v(2.4*scale,2.4*scale,0.42),c.colors.rim,false,nil,CFrame.Angles(0,0,math.pi/4))
	end
end

local function pirateScene(c,z,chapter,index)
	if chapter == "ghostShip" or chapter == "rigging" then
		-- The concealed ship hangs directly over the playable hold and cargo routes.
		ship(c,0,z,1.15)
		for _, side in {-1,1} do
			part(c,"Cavern face",side*32,7,z,v(14,32,41),rgb("506476"),false,nil,CFrame.Angles(0,0,side*0.18))
		end
	elseif chapter == "harbor" or chapter == "reefExit" then
		for _, side in {-1,1} do
			for i=1,2 do
				local x, row = side*(27+i*6),z+(i-1.5)*20
				part(c,"Harbor cottage",x,4,row,v(9,8,11),c.colors.rock)
				part(c,"Tile roof",x,9,row,v(10.4,4,12),rgb(i%2==0 and "428586" or "b77056"),false,ball)
				light(c,"Cottage window",x-2.6,3.8,row-5.6,v(1.5,1.8,0.16),cream)
			end
		end
		ship(c,index%2==0 and 34 or -34,z+28,0.86)
	else
		for _, side in {-1,1} do
			for i=1,4 do
				part(c,"Sea grotto spire",side*(21+i*3),8,z+(i-2)*15,v(7+i,23+i*3,10),c.colors.rock,false,ball)
				part(c,"Grotto tip",side*(20+i*3),19,z+(i-2)*15,v(3.5,11,5),rgb("7aa0a7"),false,ball)
			end
		end
	end
end

local function prehistoricScene(c,z,chapter)
	for _, side in {-1,1} do
		for i=1,4 do
			tree(c,side*(22+i*5),z+(i-2.5)*20,24+i*5,rgb(i%2==0 and "719e48" or "589555"))
		end
	end
	if chapter == "migration" or chapter == "fossilBasin" then
		local x = -37
		local tint = chapter == "migration" and rgb("638a4e") or rgb("e3ca9e")
		part(c,"Longneck body",x,6,z,v(19,16,31),tint,false,ball)
		part(c,"Longneck neck",x,15,z-11,v(7,22,8),tint,false,ball)
		part(c,"Longneck head",x,24,z-14,v(8.8,6.7,9),tint,false,ball)
		part(c,"Longneck eye",x+3.7,25.1,z-16,v(1.35,1.35,1.35),ink,false,ball)
		for _, a in {-1,1} do
			for _, b in {-1,1} do part(c,"Longneck leg",x+a*4.9,-1,z+b*8,v(5.4,13,5.4),tint,false,ball) end
		end
	else
		for _, side in {-1,1} do
			local x = side*26
			part(c,"Field research cabin",x,5,z,v(13.5,9.8,22),c.colors.rock)
			part(c,"Cabin visor",x,10,z,v(14.5,1.12,22.7),c.colors.rim)
			for i=1,3 do
				light(c,"Observation glass",x-side*6.8,6.6,z+(i-2)*5,v(0.18,3.2,4),rgb("a9ebc4"))
			end
		end
	end
end

local function factoryScene(c,z,chapter)
	for _, side in {-1,1} do
		for i=1,3 do
			local x, row = side*(22+i*3),z+(i-2)*20
			part(c,"Recipe vat",x,4,row,v(10,9+i*0.5,9+i*0.5),c.colors.rock,false,cylinder,vertical)
			part(c,"Vat rim",x,9,row,v(0.63,10.3,10.3),c.colors.rim,false,cylinder,vertical)
			part(c,"Candy turbine",x,11.8,row,v(5,5,5),rgb(i%2==0 and "ef8496" or "9edbd5"),false,ball)
			part(c,"Vat pipe",x+side*4.8,8,row+3.2,v(2,14,2),ink)
		end
	end
	local glaze = chapter == "furnace" and rgb("f79d5c") or rgb("ffbbe1")
	for _, j in {-1,1} do
		part(c,"Overhead frosting pipe",j*9,14,z+2,v(2.15,2.15,42),glaze)
		part(c,"Overhead frosting manifold",j*9,13.4,z-20,v(4.8,4.8,4.8),glaze,false,ball)
	end
end

local function frozenScene(c,z,chapter)
	for _, side in {-1,1} do
		for i=1,5 do
			local x,row = side*(22+i*4),z+(i-3)*16
			local tall = 21+i*3
			part(c,"Glacier ridge",x,tall*0.32-5,row,v(12,tall,15),rgb(i%2==0 and "72b2cc" or "a9dce9"),
				false,nil,CFrame.Angles(0,i*0.22,side*i*0.08)).Material = Enum.Material.Ice
			part(c,"Glacier frost crown",x,tall*0.72-5,row,v(11.8,6.5,13.4),cream,false,ball)
		end
	end
	if chapter == "gondola" or chapter == "summitExit" then
		part(c,"Gondola station beam",0,13,z,v(48,2.05,2.1),ink)
		pillars(c,-20,z,13)
		pillars(c,20,z,13)
	end
end

local function cloudScene(c,z,chapter,index)
	for _, side in {-1,1} do
		for i=1,3 do
			local x,row = side*(25+i*7),z+(i-2)*33
			part(c,"Cloudbank",x,-5,row,v(27,9+i,16),rgb(i%2==0 and "d5dafa" or "f4eef8"),false,ball)
			part(c,"Sky borough",x,2,row,v(10,16+i*2,10),c.colors.rock,false,cylinder,vertical)
			part(c,"Borough cap",x,11+i,row,v(6,10.7,10.7),c.colors.rim,false,cylinder,vertical)
		end
	end
	if chapter == "airships" or chapter == "skyExit" then
		local x = index%2==0 and -31 or 31
		ship(c,x,z,0.77)
		part(c,"Airship balloon",x,28,z,v(22,13,33),rgb("edb5d5"),false,ball)
		for _, side in {-1,1} do
			part(c,"Airship rope",x+side*5,19,z+side*8,v(0.32,17,0.32),ink)
		end
	end
end

local function neonScene(c,z,chapter)
	for _, side in {-1,1} do
		for i=1,4 do
			local x,row = side*(23+i*3),z+(i-2.5)*21
			local height = 18+(i%3)*6
			part(c,"Metropolis tower",x,height/2-4,row,v(10.5,height,12),c.colors.rock)
			for j=1,3 do
				light(c,"Tower floor light",x-side*5.3,height-j*4.2,row,v(0.17,0.75,8.8),c.colors.rim)
			end
			part(c,"Rooftop cap",x,height-3,row,v(11.2,1.3,12.6),ink)
		end
	end
	if chapter == "maglev" or chapter == "neonExit" or chapter == "signalYard" then
		for i=1,3 do
			local row = z+(i-2)*14
			part(c,"Parked courier express",24,-0.65,row,v(8.2,7.2,13.4),rgb("d280c3"),false,ball)
			light(c,"Express window",19.97,0.46,row,v(0.11,2.1,6.8),rgb("ffc671"))
		end
	end
end

local function galacticScene(c,z,chapter,index)
	for _, side in {-1,1} do
		local x = side*(27+(index%2)*8)
		part(c,"Station habitat",x,11,z-10,v(17,17,21),c.colors.rock,false,ball)
		part(c,"Habitat equator",x,11,z-10,v(0.85,24,24),ink,false,cylinder,vertical)
		for i=1,4 do
			light(c,"Habitat window",x+side*6.15,9+i,z-11+(i%2)*3,v(1.3,0.77,1.3),c.colors.rim)
		end
		part(c,"Solar wing",x+side*14,13,z+15,v(16,0.55,8.8),c.colors.rock,false,nil,CFrame.Angles(0,0,side*0.31))
	end
	if chapter == "launchExit" or chapter == "crownFinish" then
		local hull = chapter == "crownFinish" and rgb("f5c659") or cream
		part(c,"Escape capsule",0,17,z+32,v(14,28,17),hull,false,ball)
		part(c,"Capsule glass",0,22,z+23,v(5.8,5.8,1.8),c.colors.deck,false,ball)
		for _, side in {-1,1} do
			part(c,"Capsule fin",side*8.9,11,z+33,v(8.2,2.5,6.1),c.colors.rock,false,nil,CFrame.Angles(0,0,-side*0.34))
		end
	end
end

local scenes = {
	temple=templeScene,pirate=pirateScene,prehistoric=prehistoricScene,factory=factoryScene,
	frozen=frozenScene,cloud=cloudScene,neon=neonScene,galactic=galacticScene,
}

local function addRelic(c,z,world,spec)
	local side = if c.level%2==0 then 1 else -1
	local x = side*20.4
	deck(c,z-2.8,z+6.9,10,x,0)
	part(c,"Relic plinth",x,0.44,z+2,v(3.5,0.9,3.5),c.colors.rock)
	local tint = c.colors.rim
	local body
	if world.key == "temple" then
		body = part(c,world.relic,x,1.65,z+2,v(1.45,1.85,1.25),tint,false,ball)
		for _, dx in {-0.33,0.33} do part(c,"Idol eye",x+dx,1.9,z+1.45,v(0.21,0.23,0.1),ink) end
		part(c,"Idol pedestal cuff",x,1.02,z+2,v(1.65,0.25,1.3),tint)
	elseif world.key == "pirate" then
		body = part(c,world.relic,x,1.63,z+2,v(0.38,1.75,1.75),tint,false,cylinder,CFrame.Angles(0,math.pi/2,0))
		part(c,"Compass needle",x,1.63,z+1.74,v(0.24,1.1,0.12),ink,false,nil,CFrame.Angles(0,0,math.pi/5))
	elseif world.key == "prehistoric" then
		body = part(c,world.relic,x,1.63,z+2,v(1.45,1.86,1.15),tint,false,ball)
		for _, dx in {-0.46,0,0.46} do part(c,"Fossil toe",x+dx,1.82,z+1.54,v(0.37,0.43,0.14),ink,false,ball) end
		part(c,"Fossil heel",x,1.43,z+1.47,v(0.77,0.48,0.18),ink,false,ball)
	elseif world.key == "factory" or world.key == "neon" then
		body = part(c,world.relic,x,1.58,z+2,v(1.52,1.38,0.43),tint,false,nil,CFrame.Angles(0,0,0.2))
		for dx=-1,1 do part(c,"Engraved circuit",x+dx*0.33,1.58,z+1.74,v(0.13,0.7,0.12),ink) end
	elseif world.key == "cloud" then
		body = part(c,world.relic,x,1.63,z+2,v(0.32,1.36,1.36),tint,false,cylinder,CFrame.Angles(0,math.pi/2,0))
		part(c,"Seal wing",x-0.74,1.55,z+2,v(1.04,0.6,0.28),cream,false,ball,CFrame.Angles(0,0,-0.25))
		part(c,"Seal wing",x+0.74,1.55,z+2,v(1.04,0.6,0.28),cream,false,ball,CFrame.Angles(0,0,0.25))
	else
		body = part(c,world.relic,x,1.65,z+2,v(0.92,1.7,0.92),tint,false,nil,CFrame.Angles(math.pi/6,math.pi/4,math.pi/8))
		part(c,"Crystal satellite",x+0.6,1.18,z+1.7,v(0.57,0.74,0.55),tint,false,nil,CFrame.Angles(0.18,0.4,0.3))
	end
	body.Material = Enum.Material.Neon
	local halo = Instance.new("PointLight",body)
	halo.Color, halo.Brightness, halo.Range = tint, 0.9, 7.5
	table.insert(c.relics,{id=spec.key,position=body.Position,part=body})
end

local function launchYard(c,spec,world)
	deck(c,-18,8,38)
	gate(c,spec.name,-15,36,c.colors.rim)
	for i=1,15 do
		local x = (i-8)*2.15
		part(c,"Launch position",x,0.03,-4.0,v(1.48,0.06,5.6),i%2==0 and c.colors.lane or c.colors.rim)
	end
	scenes[world.key](c,12,spec.sections[1],1)
end

local function landscape(c,world)
	for first=-52,c.length+52,280 do
		local span = math.min(283,c.length+53-first)
		local floor = part(c,"World backdrop",0,-10.55,first+span/2,v(144,0.8,span),c.colors.ground)
		floor.Material = if world.key == "factory" or world.key == "galactic" then Enum.Material.SmoothPlastic else Enum.Material.Glass
		if world.key == "galactic" or world.key == "cloud" then floor.Transparency = 0.54 end
	end
end

function Courses.course(level,x,z)
	local spec = assert(Levels[level],"Missing course")
	local world = assert(Levels.worldByKey[spec.worldKey],"Missing world")
	local model = Instance.new("Model")
	model.Name = spec.name
	local c = {
		model=model,x=x,z=z,level=level,worldKey=spec.worldKey,pace=spec.pace,colors=colorsFor(world),
		obstacles={},route={},zones={},relics={},finishWidth=17.7,
	}
	launchYard(c,spec,world)
	model:SetAttribute("CinematicStart",v(x-33,17,z-24))
	model:SetAttribute("CinematicEnd",v(x+25,12,z-7))
	model:SetAttribute("CinematicFocus",v(x,7,z+25))
	local cursor = 8
	local hasZone = table.find(spec.sections,"crackBridge") ~= nil
	for index, chapter in ipairs(spec.sections) do
		local layout = assert(chapters[chapter],chapter)
		gate(c,string.upper(layout[1]),cursor+2,30,c.colors.rim)
		for beat=2,#layout do
			local length = 77+((level*3+index*5+beat*7)%17)
			if layout[beat] == "shoves" then length = 42 end
			deck(c,cursor,cursor+7,deckWidth)
			deck(c,cursor+length-7,cursor+length,deckWidth)
			encounters[layout[beat]](c,cursor,length,index*3+beat*5+level)
			if beat==3 then scenes[world.key](c,cursor+length/2,chapter,index) end
			cursor += length
		end
		deck(c,cursor,cursor+13,deckWidth)
		bay(c,cursor+7,deckWidth-1)
		if index==2+level%4 and not spec.championship then addRelic(c,cursor+4,world,spec) end
		table.insert(c.route,{
			z=z+cursor+3,x=x,width=deckWidth/2+0.9,minY=0.45,maxY=17.5,
			checkpoint=v(x,3.65,z+cursor+7),
		})
		cursor += 13
		if index==3 and not hasZone then
			encounters.shoves(c,cursor,35,0)
			cursor += 35
		end
	end
	deck(c,cursor,cursor+24,36)
	c.length = cursor+9
	c.finish = z+c.length
	finishGate(c)
	for i=1,14 do
		for row=0,1 do
			part(c,"Checkered finish stripe",(i-7.5)*2.48,0.035,c.length+(row-0.5)*1.2,v(2.48,0.07,1.2),(i+row)%2==0 and cream or ink)
		end
	end
	landscape(c,world)
	model.Parent = workspace
	Obstacles.activate(c)
	Obstacles.update(c,0,{},function() end)
	return c
end

return Courses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Http = game:GetService("HttpService")
local token = Http:GenerateGUID(false)
local D = {sessions = {}}
local store

local function getStore()
	if not store then store = DataStoreService:GetDataStore("CourierProfiles_v1") end
	return store
end

local function clone(value)
	if typeof(value) ~= "table" then return value end
	local copy = {}
	for k, child in value do copy[k] = clone(child) end
	return copy
end

local function normalize(raw)
	local data = typeof(raw) == "table" and raw or {}
	for key, fallback in {coins=0, legacyCoins=0, wins=0, championships=0, xp=0, unlocked=1, deliveries=0, cartonRevision=0, championCartonsOpened=0} do
		local value = data[key]
		data[key] = if typeof(value) == "number" and value >= fallback and value < math.huge then math.floor(value) else fallback
	end
	if data.economyVersion ~= 2 then
		-- Old play rewards and Robux coin packs previously used the same balance.
		-- Preserve that balance for fixed-price trails and use earned coins for cartons.
		data.legacyCoins += data.coins
		data.coins = 0
		data.economyVersion = 2
	end
	for _, key in {"skins","trails","records","favorites","medals","relics","museum","earnedSkins","cartonCredits","collections","seasons","questStats","titlesOwned","accessories","victories","banners","entitlements","placements"} do
		if typeof(data[key]) ~= "table" then data[key] = {} end
	end
	data.skins.Classic = true
	if not data.skins[data.skin or ""] then data.skin = "Classic" end
	if typeof(data.title) ~= "number" then data.title = 1 end
	if typeof(data.trail) ~= "string" then data.trail = "" end
	return data
end

local function retry(operation)
	local errorMessage
	for attempt = 1, 3 do
		local ok, result = pcall(operation)
		if ok then return true, result end
		errorMessage = result
		if attempt < 3 then task.wait(attempt * 0.6) end
	end
	warn("Courier profile store:", errorMessage)
	return false, nil
end

local function key(player)
	return "u:" .. player.UserId
end

local function receiptLedger(envelope)
	return typeof(envelope.receipts) == "table" and envelope.receipts or {}
end

function D.load(player)
	if RunService:IsStudio() and game.GameId == 0 then
		local data = normalize(nil)
		D.sessions[player] = {data=data, temporary=true}
		return data
	end
	local ok, result = retry(function()
		return getStore():UpdateAsync(key(player), function(old)
			local envelope = typeof(old) == "table" and old or {}
			if envelope.owner and envelope.owner ~= token and (envelope.expires or 0) > os.time() then return nil end
			return {
				owner=token, expires=os.time()+180, receipts=receiptLedger(envelope),
				data=normalize(envelope.data or (not envelope.owner and old)),
			}
		end)
	end)
	if not result and (ok or not RunService:IsStudio()) then
		if player.Parent then player:Kick("Your courier profile is unavailable. Please rejoin in a moment.") end
		return nil
	end
	local session = {data=result and result.data or normalize(nil), temporary=result == nil, receipts=result and receiptLedger(result)}
	D.sessions[player] = session
	return session.data
end

function D.get(player)
	local session = D.sessions[player]
	return session and session.data
end

local function beginWrite(player, session, waitForTurn, allowClosing)
	while session.saving do
		if not waitForTurn then return false end
		task.wait(0.1)
	end
	if D.sessions[player] ~= session or (session.closing and not allowClosing) then return false end
	session.saving = true
	return true
end

local function unappliedCoins(receipts, applied)
	local coins = 0
	for receiptId, amount in receipts do
		if applied[receiptId] == nil then coins += amount end
	end
	return coins
end

local function persist(player, session, release, receiptId, coinAmount)
	local snapshot = clone(session.data)
	local ok, result = retry(function()
		return getStore():UpdateAsync(key(player), function(old)
			if typeof(old) ~= "table" or old.owner ~= token then return nil end
			local receipts = receiptLedger(old)
			if receiptId and receipts[receiptId] == nil then
				receipts = table.clone(receipts)
				receipts[receiptId] = coinAmount
			end
			-- A prior write can commit even when its response is lost. Carry those
			-- grants forward in every save before acknowledging them in memory.
			local savedData = table.clone(snapshot)
			savedData.legacyCoins += unappliedCoins(receipts, session.receipts)
			if release then return {data=savedData, receipts=receipts} end
			return {owner=token, expires=os.time()+180, data=savedData, receipts=receipts}
		end)
	end)
	if result then
		local receipts = receiptLedger(result)
		session.data.legacyCoins += unappliedCoins(receipts, session.receipts)
		session.receipts = receipts
	end
	session.saving = false
	return ok, result
end

function D.save(player, release)
	local session = D.sessions[player]
	if not session then return end
	if release then session.closing = true end
	if session.temporary then
		if release then D.sessions[player] = nil end
		return
	end
	if not beginWrite(player,session,release,release) then return end
	local balance = session.data.legacyCoins
	local ok, result = persist(player,session,release)
	if ok and not result and not release and player.Parent then
		player:Kick("Your courier profile moved to another server. Please rejoin.")
	end
	if release then D.sessions[player] = nil end
	if result and not release and session.data.legacyCoins ~= balance and player.Parent then D.summary(player) end
end

-- Reward mutations are synchronous before the first service yield. A single
-- session owns the profile lock and each save serializes after the prior write.
function D.transact(player, mutate)
	local session = D.sessions[player]
	if not session or session.closing or session.readOnly then return false end
	if session.temporary then return true, mutate(session.data) end
	if not beginWrite(player,session,true,false) then return false end
	if session.readOnly then
		session.saving = false
		return false
	end
	local before = clone(session.data)
	local ok, changed, value = pcall(mutate,session.data)
	if not ok then
		session.data = before
		session.saving = false
		session.readOnly = true
		warn("Courier reward transaction:",changed)
		if player.Parent then player:Kick("Your progress is syncing. Please rejoin in a moment.") end
		return false
	end
	if not changed then
		session.saving = false
		return true, changed, value
	end
	local _, result = persist(player,session,false)
	if not result then
		-- A timed-out write may have committed. Keep the same mutated snapshot
		-- and close the session so retrying this request cannot reroll a reward.
		session.readOnly = true
		if player.Parent then player:Kick("Your progress is syncing. Please rejoin in a moment.") end
		return false
	end
	return true, changed, value
end

function D.canPurchase(player)
	local session = D.sessions[player]
	return session ~= nil and not session.temporary and not session.closing and not session.readOnly
end

function D.grantCoinPack(player, receiptId, coins)
	local session = D.sessions[player]
	if not session or session.temporary or session.readOnly or not beginWrite(player,session,true,false) then return false end
	if session.receipts[receiptId] ~= nil then
		session.saving = false
		return true, false
	end
	local _, result = persist(player,session,false,receiptId,coins)
	if not result then return false end
	if player.Parent then D.summary(player) end
	return true, true
end

function D.summary(player)
	local data = D.get(player)
	if not data then return end
	player:SetAttribute("Coins",data.coins)
	player:SetAttribute("LegacyCoins",data.legacyCoins)
	player:SetAttribute("Championships",data.championships)
	player:SetAttribute("Wins",data.wins)
	player:SetAttribute("XP",data.xp)
	player:SetAttribute("Unlocked",data.unlocked)
end

return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Eggs</string>
          <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local EggModel = require(Shared.EggModel)
local Trophy = require(Shared.TrophyModel)
local Eggs = {}
local activePoses = setmetatable({}, {__mode = "k"})

local function releasePose(egg)
	local release = activePoses[egg]
	if release then
		activePoses[egg] = nil
		release()
	end
end

local trailColors = {
	Lightning={"5deaff","fff9d7"}, Rainbow={"fc67ff","6beeff"}, VIP={"ffdc53","fff9d7"},
	Expedition={"feac62","74e6b2"}, Aurora={"78f8ef","cf99ff"},
}
local accessoryColors = {
	["Sun Pin"]="ffd35f", ["Trail Ribbon"]="ff9bc4", ["Jade Compass"]="73e7bb",
	["Star Pin"]="89dfff", ["Cloud Patch"]="efe1ff", ["Crown Patch"]="ffb56f",
}
local victoryColors = {
	["Carton Confetti"]={"ff81b2","8cf0ff"}, ["Relic Spark"]={"87ffd5","ffdd78"},
	["Shooting Star"]={"bba9ff","9df1ff"}, ["Aurora Burst"]={"86f4e4","e8a2ff"},
	["Crown Parade"]={"ffcd65","ff8768"}, ["Celestial Finale"]={"b9adff","fff5ba"},
}

local championRed = Color3.fromHex("ff334b")

function Eggs.aura(player, data)
	local character = player.Character
	if not character then return end
	local enabled = (data.wins or 0) > 0 and player:GetAttribute("WinnerAura") ~= false
	local highlight = character:FindFirstChild("ChampionOutline")
	if enabled and not highlight then
		highlight = Instance.new("Highlight")
		highlight.Name = "ChampionOutline"
		highlight.Adornee = character
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.OutlineColor = championRed
		highlight.OutlineTransparency = 0.04
		highlight.FillColor = championRed
		highlight.FillTransparency = 0.89
		highlight.Parent = character
	elseif not enabled and highlight then
		highlight:Destroy()
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local cosmetic = root:FindFirstChild("CourierTrail")
	if cosmetic then cosmetic.Enabled = not enabled end
	if not enabled then
		for _, name in {"ChampionTrail", "ChampionTrailLeft", "ChampionTrailRight"} do
			local object = root:FindFirstChild(name)
			if object then object:Destroy() end
		end
		return
	end
	if root:FindFirstChild("ChampionTrail") then return end

	local left = Instance.new("Attachment")
	left.Name = "ChampionTrailLeft"
	left.Position = Vector3.new(-0.78,-0.14,0.54)
	left.Parent = root
	local right = Instance.new("Attachment")
	right.Name = "ChampionTrailRight"
	right.Position = Vector3.new(0.78,-0.14,0.54)
	right.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = "ChampionTrail"
	trail.Attachment0, trail.Attachment1 = left, right
	trail.Color = ColorSequence.new(championRed,Color3.fromHex("b8192d"))
	trail.Transparency = NumberSequence.new(0.2,1)
	trail.LightEmission = 0.55
	trail.Lifetime = 0.34
	trail.MinLength = 0.26
	trail.FaceCamera = true
	trail.Parent = root
end

local function poseArms(character, humanoid, torso, egg, offset)
	local shell = egg.PrimaryPart
	local poseObjects, shoulders = {}, {}
	local r15 = humanoid.RigType == Enum.HumanoidRigType.R15
	for side, direction in {Left=-1, Right=1} do
		local arm = character:FindFirstChild(r15 and (side .. "UpperArm") or (side .. " Arm"))
		if not arm then continue end
		local target = Vector3.new(direction*shell.Size.X*0.38, -shell.Size.Y*0.36, shell.Size.Z*0.12)
		if r15 then
			local hand = character:FindFirstChild(side .. "Hand")
			if not hand then continue end
			local grip = Instance.new("Attachment")
			grip.Name = side .. "ShellGrip"
			grip.Position = target
			grip.Parent = shell

			local elbow = Instance.new("Attachment")
			elbow.Name = side .. "CarryElbow"
			elbow.Position = Vector3.new(direction*(torso.Size.X*0.6+arm.Size.X*0.5), -torso.Size.Y*0.38, -torso.Size.Z*0.42)
			elbow.Parent = torso

			local carry = Instance.new("IKControl")
			carry.Name = side .. "EggCarry"
			carry.Type = Enum.IKControlType.Position
			carry.ChainRoot = arm
			carry.EndEffector = hand
			carry.EndEffectorOffset = CFrame.new(0,-hand.Size.Y*0.36,0)
			carry.Target = grip
			carry.Pole = elbow
			carry.SmoothTime = 0.04
			carry.Priority = 10
			carry.Parent = humanoid
			table.insert(poseObjects, carry)
			table.insert(poseObjects, elbow)
		else
			local shoulder = torso:FindFirstChild(side .. " Shoulder")
			if not shoulder or not shoulder:IsA("Motor6D") or not shoulder.Enabled then continue end
			local wrist = offset:PointToWorldSpace(target)
			local up = (shoulder.C0.Position-wrist).Unit
			local back = Vector3.xAxis:Cross(up).Unit
			local right = up:Cross(back)
			local brace = Instance.new("Weld")
			brace.Name = side .. "EggCarry"
			brace.Part0, brace.Part1 = torso, arm
			brace.C0 = CFrame.fromMatrix(wrist+up*arm.Size.Y*0.48,right,up,back)
			shoulder.Enabled = false
			brace.Parent = shell
			table.insert(shoulders,shoulder)
			table.insert(poseObjects,brace)
		end
	end
	activePoses[egg] = function()
		for _, object in poseObjects do object:Destroy() end
		for _, shoulder in shoulders do
			if shoulder.Parent then shoulder.Enabled = true end
		end
	end
	egg.Destroying:Once(function() releasePose(egg) end)
end

local function decorateShell(shell, accessory)
	local color = accessoryColors[accessory or ""]
	if not color then return end
	for index=0,4 do
		local angle = index*math.pi*0.4
		local pin = Instance.new("Part")
		pin.Name = "Equipped shell pin"
		pin.Shape = Enum.PartType.Ball
		pin.Material = Enum.Material.SmoothPlastic
		pin.Color = if index%2 == 0 then Color3.fromHex(color) else Color3.fromHex("fff7dc")
		pin.Size = Vector3.new(0.15,0.15,0.10)*shell.Size.X
		pin.CFrame = shell.CFrame*CFrame.new(
			(shell.Size.X*0.10)*math.cos(angle),
			(shell.Size.Y*0.21)+(shell.Size.X*0.10)*math.sin(angle),
			-shell.Size.Z*0.455
		)
		pin.CanCollide, pin.CanTouch, pin.CanQuery = false,false,false
		pin.Massless = true
		local weld = Instance.new("WeldConstraint",pin)
		weld.Part0, weld.Part1 = shell,pin
		pin.Parent = shell
	end
end

function Eggs.celebrate(player, data)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local colors = victoryColors[data.victory or ""] or {"ffcc60","fff2bd"}
	local trophy = Trophy.build()
	trophy:PivotTo(CFrame.new(root.Position+Vector3.new(0,3,0))*CFrame.Angles(0,math.pi,0))
	trophy.Parent = workspace
	Debris:AddItem(trophy,3)
	local confetti = Instance.new("ParticleEmitter")
	confetti.Name = "Victory color burst"
	confetti.Color = ColorSequence.new(Color3.fromHex(colors[1]),Color3.fromHex(colors[2]))
	confetti.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,0.24),NumberSequenceKeypoint.new(1,0)})
	confetti.Lifetime = NumberRange.new(0.9,1.7)
	confetti.Speed = NumberRange.new(4,11)
	confetti.SpreadAngle = Vector2.new(110,110)
	confetti.Acceleration = Vector3.new(0,-12,0)
	confetti.Rate = 0
	confetti.LightEmission = 0.55
	confetti.Parent = trophy.PrimaryPart
	confetti:Emit(data.victory and 52 or 28)
end

function Eggs.attach(player, data, hp)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then return end
	local existing = character:FindFirstChild("CourierEgg")
	if existing then
		releasePose(existing)
		existing:Destroy()
	end
	if hp <= 0 then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not humanoid or not torso then return end
	local egg = EggModel.build(data.skin, math.clamp(torso.Size.X*0.72,0.65,2.6), false)
	local shell = egg.PrimaryPart
	local offset = CFrame.new(0,-torso.Size.Y*0.22,-(torso.Size.Z+shell.Size.Z)*0.5-0.12)
	egg:PivotTo(torso.CFrame * offset)
	egg.Parent = character
	local motor = Instance.new("Motor6D")
	motor.Name = "EggMotor"
	motor.Part0 = torso
	motor.Part1 = egg.PrimaryPart
	motor.C0 = offset
	motor.Parent = egg.PrimaryPart
	poseArms(character,humanoid,torso,egg,offset)
	decorateShell(shell,data.accessory)
	EggModel.condition(egg,hp)
	local previous = head:FindFirstChild("CourierTitle")
	if previous then previous:Destroy() end
	local nameplate = Instance.new("BillboardGui",head)
	nameplate.Name = "CourierTitle"
	nameplate.Size = UDim2.fromScale(6,0.8)
	nameplate.StudsOffset = Vector3.new(0,head.Size.Y+0.85,0)
	nameplate.MaxDistance = 36
	local title = Instance.new("TextLabel",nameplate)
	title.Size = UDim2.fromScale(1,1)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextScaled = true
	title.TextStrokeTransparency = 0.5
	title.TextColor3 = Color3.fromHex("fff4ab")
	local config = require(Shared.Config)
	title.Text = (data.skins.VIP and "VIP  •  " or "") .. (data.customTitle or config.titles[data.title] or config.titles[1])
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		for _, name in {"CourierTrail","CourierTrailLeft","CourierTrailRight"} do
			local item = root:FindFirstChild(name)
			if item then item:Destroy() end
		end
		if data.trail ~= "" and data.trails[data.trail] then
			local left = Instance.new("Attachment",root)
			left.Name = "CourierTrailLeft"
			left.Position = Vector3.new(-0.65,0,0.5)
			local right = Instance.new("Attachment",root)
			right.Name = "CourierTrailRight"
			right.Position = Vector3.new(0.65,0,0.5)
			local trail = Instance.new("Trail",root)
			trail.Name = "CourierTrail"
			trail.Attachment0, trail.Attachment1 = left, right
			trail.Lifetime = 0.28
			trail.MinLength = 0.2
			trail.FaceCamera = true
			local colors = trailColors[data.trail] or trailColors.Lightning
			trail.Color = ColorSequence.new(Color3.fromHex(colors[1]),Color3.fromHex(colors[2]))
			trail.Transparency = NumberSequence.new(0.15,1)
		end
	end
	Eggs.aura(player,data)
end

function Eggs.condition(player, hp)
	local egg = player.Character and player.Character:FindFirstChild("CourierEgg")
	if not egg then return end
	EggModel.condition(egg,hp)
	if hp == 0 then
		for i = 1,8 do
			local fragment = Instance.new("WedgePart")
			fragment.Name = "Shell chip"
			fragment.Size = Vector3.new(0.32,0.28,0.42)
			fragment.Color = egg.PrimaryPart.Color
			fragment.CFrame = egg:GetPivot() * CFrame.Angles(i, i*0.4, 0)
			fragment.CanCollide = false
			fragment.CanTouch = false
			fragment.CanQuery = false
			fragment.Parent = workspace
			fragment.AssemblyLinearVelocity = Vector3.new(math.cos(i)*11,12+i,math.sin(i)*11)
			fragment.AssemblyAngularVelocity = Vector3.new(i,3,1)
			Debris:AddItem(fragment,0.7)
		end
		releasePose(egg)
		egg:Destroy()
	end
end
return Eggs
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Run = game:GetService("RunService")
local Physics = game:GetService("PhysicsService")
local Debris = game:GetService("Debris")
local Http = game:GetService("HttpService")
local Shared = RS:WaitForChild("EggShared")
local Config = require(Shared.Config)
local Economy = require(Shared.EconomyConfig)
local Levels = require(Shared.Levels)
local Rules = require(Shared.RaceRules)
local World = require(script.Parent.World)
local Courses = require(script.Parent.Courses)
local Obstacles = require(script.Parent.Obstacles)
local Data = require(script.Parent.Data)
local Eggs = require(script.Parent.Eggs)
local Shop = require(script.Parent.Shop)
local CoinPacks = require(script.Parent.CoinPacks)
local Progression = require(script.Parent.Progression)
local Social = require(script.Parent.Social)

local remote = Instance.new("RemoteEvent")
remote.Name = "CourierEvent"
remote.Parent = Shared
local queue, practiceQueue, selected, rate = {}, {}, {}, {}
local shopping = {}
local racers = {}
local contenders, roster = {}, {}
local raceMode = "royale"
local privateRound = false
local championship, tournamentId
local random = Random.new()
local course
local stage, deadline, level = "Lobby", 0, 1
local started, ends = 0, 0
local results, resultCount = {}, 0
local practiceMode, entrants, slots = false, 0, 0
local tournament, duel, heat = false, false, 0
local mapPlan, draftStarted, victor
local now = workspace.GetServerTimeNow
local lobby, demo, leaderboard, podium

pcall(function() Physics:RegisterCollisionGroup("Couriers") end)
Physics:CollisionGroupSetCollidable("Couriers","Couriers",false)

local function send(player, kind, value, extra)
	if player.Parent == Players then remote:FireClient(player,kind,value,extra) end
end

local function profile(player)
	local summary = Progression.summary(player)
	if summary then send(player,"Profile",summary) end
end

local function rootOf(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function move(player, pos, frozen)
	local root = rootOf(player)
	if not root then return end
	root.Anchored = frozen == true
	root.CFrame = CFrame.lookAt(pos, pos + Vector3.zAxis)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

local function progress(r)
	return math.clamp((r.progress-course.z)/(course.finish-course.z),0,0.99)
end

local function queuedCount(ticket)
	local count = 0
	for _, entry in queue do
		if not ticket or entry.mode == ticket.mode and entry.private == ticket.private then count += 1 end
	end
	return count
end

local function state(player)
	local r, ticket = racers[player], queue[player]
	local spectate, standings = {}, {}
	if stage == "Race" and not privateRound then
		for other, entry in racers do
			if other ~= player and not entry.finished then table.insert(spectate,other.UserId) end
		end
		table.sort(spectate)
	end
	for _, entry in roster do
		table.insert(standings,{
			userId=entry.userId, name=entry.name, skin=entry.skin, status=entry.status, place=entry.place,
		})
	end
	table.sort(standings,function(a,b)
		if a.place ~= b.place then return (a.place or math.huge) < (b.place or math.huge) end
		return a.userId < b.userId
	end)
	player:SetAttribute("CourseRacing",stage == "Race" and r ~= nil and not r.finished)
	send(player,"State",{
		stage=stage, deadline=deadline, level=level, racing=r ~= nil, queued=ticket ~= nil,
		practiceQueued=practiceQueue[player] ~= nil, selected=selected[player] or 1,
		practice=practiceMode, solo=entrants == 1, result=r and r.result,
		total=entrants, slots=slots, qualified=math.min(resultCount,slots),
		scoreboard=stage == "Results" and results or nil,
		room=roster[player] ~= nil or contenders[player] == true, tournament=tournament,
		duel=duel, heat=heat, heats=Rules.heatCount,
		draftStarted=draftStarted, maps=mapPlan, victor=victor,
		queuedCount=queuedCount(ticket), capacity=Config.maxPlayers,
		roundName=if duel then "Championship" elseif heat > 0 then "Round " .. heat elseif tournament then "Map draw" else nil,
		mode=raceMode, queueMode=ticket and ticket.mode, spectate=spectate, standings=standings,
		championship=championship,
	})
end

local function broadcast()
	for _, player in Players:GetPlayers() do state(player) end
end

local function phase(name, duration)
	stage, deadline = name, if name=="Race" then ends else now(workspace)+(duration or 0)
	broadcast()
end

local function finishDisplay()
	for _, label in course.finishDisplay or {} do
		label.Text = ("%02d / %02d %s"):format(math.min(resultCount,slots),slots,duel and "CHAMPION" or tournament and "QUALIFIED" or "FINISHED")
	end
end

local function restartPractice(player,r,at)
	local d = Data.get(player)
	if not d or racers[player] ~= r or stage ~= "Race" then return end
	local checkpoint = r.checkpoint or r.spawn
	r.hp, r.recovering, r.perfect = 3, false, false
	r.immune = at + Config.protection
	r.lastHazard, r.shovedBy, r.shovedAt = nil, nil, nil
	r.routeIndex = r.checkpointIndex or 1
	r.progress, r.zone = math.max(course.z,checkpoint.Z), nil
	r.previous, r.lastSample = checkpoint, at
	r.speedOrigin, r.speedAt = checkpoint, at
	move(player,checkpoint,false)
	Eggs.attach(player,d,3)
	send(player,"FX","Restart",r.checkpoint ~= nil)
end

local function eliminate(player,r,reason)
	if r.finished then return end
	r.finished, r.recovering, r.zone = true, false, nil
	contenders[player] = nil
	local entry = roster[player]
	if entry then entry.status = "Eliminated" end
	r.result = {out=true,dnf=true,reason=reason,hp=r.hp,progress=progress(r),practice=practiceMode,mode=raceMode}
	move(player,lobby,false)
	local data = Data.get(player)
	if data then Eggs.attach(player,data,3) end
	send(player,"FX","Out",reason)
	broadcast()
end

local function releaseTicket(ticket, departing)
	if not ticket then return end
	for _, member in ticket.group do
		if queue[member] == ticket then
			queue[member] = nil
			if member ~= departing and departing then send(member,"Notice","Your party left the race queue") end
		end
	end
end

local function setTicket(group, mode, map, private)
	local ticket = {group=table.clone(group), mode=mode, map=map, private=private == true, at=now(workspace)}
	for _, player in ticket.group do
		queue[player],practiceQueue[player] = ticket,nil
	end
	return ticket
end

local function playable(map)
	return type(map) == "number" and map%1 == 0 and Levels[map] ~= nil and map ~= Levels.final
end

local function failedAttempt(player,r,reason,at)
	if practiceMode then
		r.recovering = true
		r.penaltyUntil = at+Config.practiceRestartDelay
		local root = rootOf(player)
		if root then root.Anchored = true end
	else
		eliminate(player,r,reason)
	end
end

local function damage(player,r,amount,source)
	local at = now(workspace)
	if stage ~= "Race" or r.finished or r.recovering or (source ~= "fall" and at < r.immune) then return false end
	if source == r.lastHazard and at-r.lastHit < 1.3 then return false end
	r.lastHazard,r.lastHit,r.immune = source,at,at+Config.protection
	r.hp = math.max(0,r.hp-amount)
	Eggs.condition(player,r.hp)
	r.perfect = false
	if r.hp == 0 then
		send(player,"FX","Break")
		local reason = if source == "fall" then
			(if r.shovedAt and at-r.shovedAt <= 2 then "Knocked off by " .. r.shovedBy else "Fell off the island")
			elseif typeof(source) == "Instance" and source:IsA("Player") then "Shoved out by " .. source.DisplayName
			else "Shell shattered"
		failedAttempt(player,r,reason,at)
	else
		send(player,"FX","Crack",r.hp)
	end
	return true
end

local function zoneFor(root)
	if not course or not root then return nil end
	local p = root.Position
	if p.Y < 0.8 or p.Y > 10 then return nil end
	for i, zone in course.zones do
		if math.abs(p.Z-zone.z) <= zone.extent and math.abs(p.X-(zone.x or course.x)) <= (zone.width or 11.5) then return i end
	end
	return nil
end

local function shove(player)
	local r, root = racers[player],rootOf(player)
	local at = now(workspace)
	if stage ~= "Race" or (practiceMode or entrants < 2) or not r or r.finished or r.recovering or not root or root.Anchored or at < r.cooldown or at < r.immune then return end
	local zone = zoneFor(root)
	if not zone then return end
	local closest, target, gap
	for other, rival in racers do
		if other == player or rival.finished or rival.recovering or at < rival.immune then continue end
		local otherRoot = rootOf(other)
		if not otherRoot or otherRoot.Anchored or zoneFor(otherRoot) ~= zone then continue end
		local delta = otherRoot.Position-root.Position
		local distance = delta.Magnitude
		if distance <= Config.shoveRange and (distance < 0.1 or root.CFrame.LookVector:Dot(delta.Unit) > 0.12) and (not gap or distance<gap) then
			closest,target,gap = other,otherRoot,distance
		end
	end
	r.cooldown = at+Config.shoveCooldown
	send(player,"FX","Shove")
	if closest and damage(closest,racers[closest],1,player) and not racers[closest].finished and not target.Anchored then
		local rival = racers[closest]
		rival.shovedBy, rival.shovedAt = player.DisplayName, at
		local offset = target.Position-root.Position
		local flat = Vector3.new(offset.X,0,offset.Z)
		if flat.Magnitude > 0.1 then
			local canSet = target:CanSetNetworkOwnership()
			if canSet then
				target:SetNetworkOwner(nil)
				task.delay(0.18,function()
					if target:IsDescendantOf(workspace) and target:CanSetNetworkOwnership() then
						target:SetNetworkOwnershipAuto()
					end
				end)
			end
			target.AssemblyLinearVelocity = flat.Unit*24 + Vector3.yAxis*9
		end
	end
end

local function updated(player,reveal)
	profile(player)
	if reveal and not racers[player] then send(player,"BoxReward",reveal) end
	local d = Data.get(player)
	if d and not racers[player] then Eggs.attach(player,d,3) end
end
Shop.listen(updated)
CoinPacks.start(function(player)
	profile(player)
	send(player,"Notice","Coins added to your locker")
end)

local function action(player, key, id)
	local d = Data.get(player)
	if not d then return end
	if key == "hello" then profile(player); state(player); return end
	if key == "shove" then shove(player); return end
	local r = racers[player]
	if key == "lobby" then
		if contenders[player] and (not r or not r.result or r.result.advanced) then return end
		releaseTicket(queue[player],player)
		practiceQueue[player] = nil
		if r and (r.finished or practiceMode or stage == "Results") then
			racers[player] = nil
			move(player,lobby,false)
			Eggs.attach(player,d,3)
		end
		broadcast()
		return
	end
	if contenders[player] and (not r or not r.result or r.result.advanced) then return end
	if (key == "next" or key == "queue" or key == "quick" or key == "practice") and r and r.finished then
		racers[player] = nil
		move(player,lobby,false)
		Eggs.attach(player,d,3)
	end
	if racers[player] then return end
	if key == "queue" or key == "quick" or key == "next" then
		local mode = if key == "quick" or id == "quick" then "quick" else "royale"
		releaseTicket(queue[player],player)
		setTicket({player},mode,selected[player],false)
		broadcast()
		return
	elseif key == "practice" then
		local choice = tonumber(id) or selected[player] or 1
		if playable(choice) then
			releaseTicket(queue[player],player)
			practiceQueue[player] = {map=choice, at=now(workspace)}
			broadcast()
		end
		return
	elseif key == "choose" then
		local n = tonumber(id)
		if playable(n) then selected[player] = n end
	elseif key == "aura" and d.wins > 0 then
		player:SetAttribute("WinnerAura",player:GetAttribute("WinnerAura") == false)
		Eggs.aura(player,d)
	elseif key == "Shop" or key == "Courses" then
		send(player,"Open",key)
	elseif key == "carton" or key == "season" or key == "favorite" or key == "premium"
		or key == "skin" or key == "title" or key == "trail" or key == "quest"
		or key == "accessory" or key == "victory" or key == "banner" then
		if shopping[player] then return end
		shopping[player] = true
		local message,reveal,pass = Shop.action(player,key,id)
		shopping[player] = nil
		if message then send(player,"Notice",message) end
		if reveal then send(player,"BoxReward",reveal) end
		if pass then send(player,"Pass",pass) end
		updated(player)
	end
	state(player)
end

Social.start({
	canUse=function(player)
		return not racers[player] and not contenders[player] and not queue[player] and not practiceQueue[player]
	end,
	canSpectate=function(viewer,target)
		return stage == "Race" and not privateRound and not (racers[viewer] and not racers[viewer].finished)
			and racers[target] ~= nil and not racers[target].finished
	end,
	queue=function(group, mode, map, private)
		if #group == 0 or #group > Config.maxPlayers or (mode ~= "quick" and mode ~= "royale") then
			return false,"Invalid race"
		end
		for _, player in group do
			if not Data.get(player) or racers[player] or contenders[player] or queue[player] or practiceQueue[player] then
				return false,"Everyone needs to be available in the lobby"
			end
		end
		if private and mode ~= "quick" then return false,"Private races use Quick Race" end
		setTicket(group,mode,playable(map) and map or selected[group[1]],private)
		broadcast()
		return true,private and "Private race queued" or "Party queued"
	end,
})

lobby,demo,leaderboard,podium = World.lobby(action)
for _, instance in workspace:GetChildren() do
	if instance.Name == "Baseplate" and instance:IsA("BasePart") then instance:Destroy() end
end

remote.OnServerEvent:Connect(function(player,key,id)
	if typeof(key) ~= "string" or #key > 16 or (id ~= nil and (typeof(id) ~= "string" or #id > 90)) then return end
	if (key == "skin" or key == "title" or key == "trail" or key == "choose" or key == "carton" or key == "premium") and id == nil then return end
	local clock = os.clock()
	local limits = rate[player] or {}
	rate[player] = limits
	local bucket = if key == "shove" then "shove" else "menu"
	if limits[bucket] and clock < limits[bucket] then return end
	limits[bucket] = clock + 0.18
	action(player,key,id)
end)

local function spawned(player,character)
	local head = character:WaitForChild("Head",10)
	local root = character:WaitForChild("HumanoidRootPart",10)
	local humanoid = character:WaitForChild("Humanoid",10)
	if not head or not root or not humanoid or character ~= player.Character or not player.Parent then return end
	local function part(item)
		if item:IsA("BasePart") then item.CollisionGroup = "Couriers" end
	end
	if not character:GetAttribute("CourierCollisionReady") then
		character:SetAttribute("CourierCollisionReady",true)
		character.DescendantAdded:Connect(part)
		for _, item in character:GetDescendants() do part(item) end
	end
	local d = Data.get(player)
	if not d then return end
	local r = racers[player]
	if r and not r.finished then
		if stage == "Race" then
			if not r.recovering then failedAttempt(player,r,"Character reset",now(workspace)) end
			if r.recovering then move(player,r.checkpoint or r.spawn,true) end
			return
		elseif stage == "Preparation" or stage == "Countdown" then
			move(player,r.spawn,true)
			Eggs.attach(player,d,3)
			return
		end
	end
	move(player,lobby,false)
	Eggs.attach(player,d,3)
end

local function join(player)
	player.CharacterAdded:Connect(function(char) spawned(player,char) end)
	local d = Data.load(player)
	if not d then return end
	if player.Parent ~= Players then Data.save(player,true); return end
	Data.summary(player)
	if player.Character then task.spawn(spawned,player,player.Character) end
	profile(player)
	state(player)
	task.spawn(function() Shop.refresh(player); profile(player) end)
end

Players.PlayerAdded:Connect(join)
for _, player in Players:GetPlayers() do task.spawn(join,player) end
Players.PlayerRemoving:Connect(function(player)
	releaseTicket(queue[player],player)
	local entry, r = roster[player], racers[player]
	if entry then
		entry.status = "Disconnected"
		if r then entry.roundResult = r end
	end
	racers[player],practiceQueue[player],selected[player],rate[player] = nil,nil,nil,nil
	contenders[player],shopping[player] = nil,nil
	broadcast()
	Data.save(player,true)
end)

task.spawn(function()
	while task.wait(45) do
		for player in Data.sessions do task.spawn(Data.save,player,false) end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player in Data.sessions do
		pending += 1
		task.spawn(function()
			Data.save(player,true)
			pending -= 1
		end)
	end
	local untilTime = os.clock()+24
	while pending > 0 and os.clock() < untilTime do task.wait(0.1) end
end)

local function finishBurst(root)
	if not root then return end
	local point = Instance.new("Attachment",workspace.Terrain)
	point.WorldPosition = root.Position + Vector3.yAxis * 2.2
	for _, tint in {Color3.fromHex("ffdc53"),Color3.fromHex("fb5791"),Color3.fromHex("36d6ec")} do
		local emitter = Instance.new("ParticleEmitter",point)
		emitter.Rate = 0
		emitter.Color = ColorSequence.new(tint)
		emitter.Lifetime = NumberRange.new(0.6,1.2)
		emitter.Speed = NumberRange.new(7,16)
		emitter.Acceleration = -Vector3.yAxis * 16
		emitter.SpreadAngle = Vector2.new(85,85)
		emitter.Size = NumberSequence.new(0.34,0.05)
		emitter.RotSpeed = NumberRange.new(-120,120)
		emitter:Emit(10)
	end
	Debris:AddItem(point,1.5)
end

local function award(player, place)
	local entry = roster[player]
	if not entry or entry.place then return end
	entry.place = place
	if player.Parent ~= Players or not Data.get(player) then return end
	local reward = Progression.place(player,place,"royale",tournamentId) or {}
	local r = racers[player]
	if r and r.result then
		r.result.tournamentPlace = place
		r.result.coins = (r.result.coins or 0)+(reward.coins or 0)
		r.result.xp = (r.result.xp or 0)+(reward.xp or 0)
	end
	profile(player)
	return reward
end

local function crown(player,r,reason)
	if victor then return end
	victor = player.DisplayName
	local entry = roster[player]
	entry.status = "Champion"
	local reward = award(player,1) or {}
	local d = Data.get(player)
	local championships = d and d.championships or 0
	local championCarton = Economy.cartonById.champion
	local cartons = 0
	if d and championCarton then
		local unlocked = math.floor(championships/championCarton.wins) - d.championCartonsOpened
		cartons = math.clamp(unlocked,0,#Economy.odds(championCarton,d.skins))
	end
	r.result.champion,r.result.advanced,r.result.reason = true,false,reason
	championship = {
		userId=player.UserId,name=player.DisplayName,skin=entry.skin,
		coins=reward.coins or 0,xp=reward.xp or 0,time=r.result.time,reason=reason,
		victory=d and d.victory,banner=d and d.banner,championships=championships,championCartonsAvailable=cartons,
	}
	player:SetAttribute("WinnerAura",true)
	if d then
		Eggs.aura(player,d)
		Eggs.celebrate(player,d)
	end
end

local function claimUnfinishedChampion(player,r,reason)
	r.finished,r.finishPlace,r.zone = true,1,nil
	r.result = {place=1,hp=r.hp,coins=0,completed=false,mode=raceMode}
	crown(player,r,reason)
	resultCount = 1
	table.insert(results,{name=player.DisplayName,place=1,completed=false,userId=player.UserId})
	finishDisplay()
	finishBurst(rootOf(player))
	send(player,"FX","Finish",r.result)
end

local function finish(player,r,time)
	r.finished, r.zone = true, nil
	resultCount += 1
	r.finishPlace = resultCount
	local entry = roster[player]
	if entry then entry.status = duel and "Finished" or "Qualified" end
	local data = Data.get(player)
	local previousBest = data and data.records[Rules.recordKey(level)]
	local reward = if privateRound then {} else Progression.finish(player,{
		level=level,mode=raceMode,time=time,perfect=r.perfect,place=resultCount,
	}) or {}
	r.result = {
		place=resultCount,time=time,hp=r.hp,coins=reward.coins or 0,record=reward.record == true,
		practice=practiceMode,advanced=tournament and not duel,completed=true,perfect=r.perfect,
		previousBest=previousBest,medal=reward.medal,xp=reward.xp or 0,mode=raceMode,
	}
	if duel and not victor then crown(player,r,"First across the finish") end
	table.insert(results,{name=player.DisplayName,time=time,place=resultCount,userId=player.UserId})
	finishDisplay()
	finishBurst(rootOf(player))
	send(player,"FX","Finish",r.result)
	profile(player)
	if not privateRound then task.spawn(Data.save,player,false) end
	broadcast()
	move(player,Vector3.new(course.x+math.clamp((resultCount-6)*2,-12,12),3.65,course.finish+5),true)
end

local tickAccumulator, hudAccumulator, boardAccumulator = 0,0,0
Run.Heartbeat:Connect(function(dt)
	tickAccumulator += dt
	hudAccumulator += dt
	boardAccumulator += dt
	if tickAccumulator < 1/30 then return end
	tickAccumulator %= 1/30
	local at = now(workspace)
	if stage == "Race" and course then
		local candidates = {}
		for player,r in racers do
			if r.finished then continue end
			local root = rootOf(player)
			local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health <= 0 and not r.recovering then
				failedAttempt(player,r,"Character reset",at)
			end
			if r.finished or not root or not humanoid or humanoid.Health <= 0 then continue end
			if r.recovering then
				if at >= r.penaltyUntil then restartPractice(player,r,at) end
				continue
			end
			local p = root.Position
			if p.Y < (course.fallY or -8.3) then
				damage(player,r,3,"fall")
				continue
			end
			local previous = r.previous
			local previousTime = r.lastSample
			r.previous,r.lastSample=p,at
			-- Discard implausible jumps, then validate course travel in route order.
			local speedAge = at-(r.speedAt or at)
			local sustained = speedAge >= 0.8 and (p.Z-r.speedOrigin.Z) > 14 + speedAge*27
			if (p-previous).Magnitude > math.max(14,(at-previousTime)*60) or sustained then
				local back = if sustained then r.speedOrigin else previous
				move(player,back,false)
				r.previous,r.speedOrigin,r.speedAt=back,back,at
				continue
			end
			if not r.speedAt or speedAge >= 0.8 then r.speedOrigin,r.speedAt=p,at end
			local gate = course.route[r.routeIndex]
			if gate then
				if Rules.crossing(previous,p,gate.z,gate.x,gate.width,gate.minY,gate.maxY) then
					r.routeIndex += 1
					if practiceMode and gate.checkpoint then
						r.checkpoint,r.checkpointIndex = gate.checkpoint,r.routeIndex
						send(player,"FX","Checkpoint",r.routeIndex-1)
					end
					gate = course.route[r.routeIndex]
				end
			else
				local fraction = Rules.crossing(previous,p,course.finish,course.x,course.finishWidth or 15.8,course.finishMinY or 0.5,course.finishMaxY or 12.5)
				if fraction and r.hp > 0 then
					local arrival = previousTime + (at-previousTime)*fraction
					if arrival <= ends then table.insert(candidates,{player=player,r=r,arrival=arrival}) end
				end
			end
			r.progress = math.clamp(p.Z,course.z,gate and gate.z or course.finish)
			r.bestProgress = math.max(r.bestProgress or course.z,r.progress)
			r.zone = zoneFor(root)
			if practiceMode then
				for _, relic in course.relics or {} do
					if not r.seenRelics[relic.id] and (p-relic.position).Magnitude <= (relic.radius or 4.2) then
						r.seenRelics[relic.id] = true
						if Progression.relic(player,Levels[level].worldKey,relic.id) then
							profile(player)
							send(player,"FX","Relic",relic.id)
						end
					end
				end
			end
		end
		table.sort(candidates,function(a,b)
			if a.arrival == b.arrival then return a.player.UserId < b.player.UserId end
			return a.arrival < b.arrival
		end)
		local finishCapacity = duel and entrants or slots
		for _, entry in candidates do
			if resultCount >= finishCapacity then break end
			finish(entry.player,entry.r,entry.arrival-entry.r.attemptStarted)
		end
		if resultCount >= finishCapacity then
			for player, r in racers do
				if not r.finished then eliminate(player,r,"All finish slots claimed") end
			end
		else
			Obstacles.update(course,at-started,racers,damage)
			if duel and not victor then
				local only, count
				count = 0
				for player, r in racers do
					if not r.finished then
						only = player
						count += 1
					end
				end
				if count == 1 and entrants > 1 then
					claimUnfinishedChampion(only,racers[only],"Last racer standing")
					broadcast()
				end
			end
		end
		if hudAccumulator >= 0.2 then
			hudAccumulator = 0
			local ranked = {}
			for player,r in racers do
				if not r.finished then table.insert(ranked,{player=player,r=r}) end
			end
			table.sort(ranked,function(a,b)
				if a.r.progress ~= b.r.progress then return a.r.progress>b.r.progress end
				return a.player.UserId < b.player.UserId
			end)
			for place, entry in ranked do
				local r=entry.r
				send(entry.player,"Race",{
					hp=r.hp, place=resultCount+place, total=entrants, zone=r.zone ~= nil,
					cooldown=r.cooldown, progress=progress(r), slots=slots, qualified=math.min(resultCount,slots),
					recover=r.recovering and r.penaltyUntil or 0,
				})
			end
		end
	elseif stage == "Countdown" and course then
		Obstacles.update(course,0,{},damage)
	end
	Obstacles.update(demo,at % 10000,{},damage)
	if boardAccumulator >= 3 then
		boardAccumulator = 0
		local board = {}
		for player, session in Data.sessions do
			if player.Parent == Players then table.insert(board,{name=player.DisplayName,wins=session.data.wins}) end
		end
		table.sort(board,function(a,b) return a.wins>b.wins end)
		local lines={"SERVER LEADERS"}
		for i=1,math.min(3,#board) do table.insert(lines,("%d   %s   /   %d wins"):format(i,board[i].name,board[i].wins)) end
		leaderboard.Text=table.concat(lines,"\n")
		for i, marker in podium do
			marker.Text = board[i] and ("%d  %s"):format(i,board[i].name) or tostring(i)
		end
	end
end)

local function waitPhase()
	while now(workspace) < deadline do task.wait(0.1) end
end

local function readyPlayer(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return player.Parent == Players and Data.get(player) ~= nil and not shopping[player]
		and rootOf(player) ~= nil and humanoid ~= nil and humanoid.Health > 0
end

local function eligibleTicket(ticket)
	for _, player in ticket.group do
		if queue[player] ~= ticket or not readyPlayer(player) then return false end
	end
	return true
end

local function buildGroup(first)
	local tickets, seen = {}, {}
	local group = {}
	for _, ticket in queue do
		if not seen[ticket] and ticket.mode == first.mode and not ticket.private and eligibleTicket(ticket) then
			seen[ticket] = true
			table.insert(tickets,ticket)
		end
	end
	table.sort(tickets,function(a,b)
		if a.at ~= b.at then return a.at < b.at end
		return a.group[1].UserId < b.group[1].UserId
	end)
	for _, ticket in tickets do
		if #group+#ticket.group <= Config.maxPlayers then
			for _, player in ticket.group do table.insert(group,player) end
		end
	end
	return group
end

local function rankRound(group)
	local ranked = {}
	for _, player in group do
		local entry = roster[player]
		local r = racers[player] or (entry and entry.roundResult)
		if r then
			local active = player.Parent == Players and not r.finished
			table.insert(ranked,{
				player=player, userId=player.UserId, active=active, finishPlace=r.finishPlace,
				progress=r.bestProgress or r.progress, hp=r.hp, race=r,
			})
		end
	end
	return Rules.rank(ranked)
end

local function settleChampionship(ranked)
	if victor then return end
	local first = ranked[1]
	if not first or not first.active then return end
	claimUnfinishedChampion(first.player,first.race,"Led the field when time ran out")
end

local function settleRound(group)
	local ranked = rankRound(group)
	local advancing, promoted = {}, {}
	if tournament then
		if duel then
			settleChampionship(ranked)
		else
			for _, line in ranked do
				if #advancing >= slots then break end
				local player,r = line.player,line.race
				if player.Parent ~= Players or (not line.finishPlace and not line.active) then continue end
				if not line.finishPlace then
					r.finished,r.zone = true,nil
					r.result = {
						place=#advancing+1,hp=r.hp,advanced=true,completed=false,mode=raceMode,
						reason="Qualified on distance",progress=progress(r),
					}
					roster[player].status = "Qualified"
					resultCount += 1
					table.insert(results,{name=player.DisplayName,place=r.result.place,completed=false,userId=player.UserId})
				end
				table.insert(advancing,player)
				promoted[player] = true
			end
			finishDisplay()
		end
	end
	local placement = math.max(2,#advancing+1)
	for _, line in ranked do
		local player,r = line.player,line.race
		if not promoted[player] and not (r.result and r.result.champion) then
			if player.Parent == Players and not r.finished then
				eliminate(player,r,duel and "Championship ended" or "Time ran out")
			end
			if tournament then
				award(player,math.min(placement,Config.maxPlayers))
				placement += 1
			end
		end
	end
	return advancing
end

local function runHeat(group,map,slotCount,final)
	level,entrants,slots,duel = map,#group,slotCount,final
	results,resultCount = {},0
	course = Courses.course(level,0,420)
	finishDisplay()
	local at = now(workspace)
	for i,player in group do
		local offset = if #group == 1 then 0 else ((i-1)/(#group-1)-0.5)*31
		local spot = Vector3.new(course.x+offset,3.65,course.z-4)
		local r = {hp=3,routeIndex=1,spawn=spot,previous=spot,lastSample=at,
			progress=course.z,immune=at+Config.countdown+1,cooldown=0,perfect=true,seenRelics={}}
		racers[player] = r
		local entry = roster[player]
		if entry then
			entry.status,entry.roundResult = "Racing",r
		end
		queue[player],practiceQueue[player] = nil,nil
		move(player,spot,true)
		Eggs.attach(player,Data.get(player),3)
	end
	phase("Preparation",1.7)
	waitPhase()
	phase("Countdown",Config.countdown)
	waitPhase()
	started = now(workspace)
	ends = started+Levels[level].time
	local live = 0
	for player,r in racers do
		live += 1
		r.attemptStarted = started
		local root = rootOf(player)
		if root then
			root.Anchored = false
			r.previous,r.lastSample,r.immune = root.Position,started,started+1.5
			r.speedOrigin,r.speedAt = root.Position,started
		end
	end
	slots = math.min(slots,live)
	finishDisplay()
	phase("Race",Levels[level].time)
	while now(workspace) < ends do
		local active = false
		for _,r in racers do if not r.finished then active=true; break end end
		if not active then break end
		task.wait(0.15)
	end
	local advancing = settleRound(group)
	phase("Results",if #advancing>0 then Config.heatResults else Config.results)
	waitPhase()

	local output, forfeited = {}, {}
	for _, player in advancing do
		if readyPlayer(player) then
			table.insert(output,player)
		else
			table.insert(forfeited,player)
		end
	end
	for index, player in forfeited do
		contenders[player] = nil
		award(player,math.min(math.max(1,#output)+index,Config.maxPlayers))
	end
	if #output == 0 then phase("Returning",0.5) end
	for player in racers do
		move(player,lobby,false)
		local data = Data.get(player)
		if data then Eggs.attach(player,data,3) end
	end
	table.clear(racers)
	Obstacles.cleanup(course)
	course.model:Destroy()
	course = nil
	if stage == "Returning" then waitPhase() end
	return output
end

local function runTournament(group)
	tournament = true
	tournamentId = Http:GenerateGUID(false)
	local starting = #group
	for _,player in group do
		local data = Data.get(player)
		contenders[player] = true
		roster[player] = {userId=player.UserId,name=player.DisplayName,skin=data.skin,status="Ready"}
		queue[player] = nil
	end
	mapPlan = Rules.drawMaps(random,Levels)
	draftStarted = now(workspace)
	phase("Draft",Config.draft)
	waitPhase()
	local available, forfeited = {}, {}
	for _,player in group do
		table.insert(if readyPlayer(player) then available else forfeited,player)
	end
	for i,player in forfeited do
		contenders[player] = nil
		award(player,math.min(math.max(1,#available)+i,Config.maxPlayers))
	end
	group = available
	for index,map in mapPlan do
		if #group == 0 then break end
		local final = index == Rules.heatCount
		if #group == 1 and not final then continue end
		heat = index
		group = runHeat(group,map,Rules.slots(starting,index,#group),final)
	end
end

local function nextActivity()
	local first, adventurer
	for _, ticket in queue do
		if (not first or ticket.at < first.at) and eligibleTicket(ticket) then first = ticket end
	end
	for player, ticket in practiceQueue do
		if (not adventurer or ticket.at < practiceQueue[adventurer].at) and readyPlayer(player) then
			adventurer = player
		end
	end
	if adventurer and (not first or practiceQueue[adventurer].at < first.at) then return nil,adventurer end
	return first,nil
end

task.spawn(function()
	while true do
		table.clear(contenders)
		table.clear(roster)
		tournament,duel,heat,practiceMode,privateRound = false,false,0,false,false
		mapPlan,draftStarted,victor,championship = nil,nil,nil,nil
		entrants,slots,resultCount = 0,0,0
		raceMode = "royale"
		phase("Lobby")
		local ticket, adventurer
		repeat
			task.wait(0.2)
			ticket,adventurer = nextActivity()
		until ticket or adventurer
		if adventurer then
			practiceMode,raceMode = true,"adventure"
			runHeat({adventurer},practiceQueue[adventurer].map,1,false)
		elseif ticket.private then
			privateRound,raceMode = true,"quick"
			runHeat(ticket.group,ticket.map or 1,#ticket.group,false)
		else
			raceMode = ticket.mode
			phase("Intermission",Config.intermission)
			while now(workspace) < deadline and queuedCount(ticket) < Config.maxPlayers and queuedCount(ticket) > 0 do
				task.wait(0.12)
			end
			local group = buildGroup(ticket)
			if #group >= 2 and ticket.mode == "royale" then
				runTournament(group)
			elseif #group > 0 then
				raceMode = "quick"
				if ticket.mode == "royale" then send(group[1],"Notice","Only one racer joined. Starting Quick Race.") end
				local first = queue[group[1]]
				runHeat(group,(first and first.map) or selected[group[1]] or 1,#group,false)
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Obstacles</string>
          <string name="Source"><![CDATA[local O = {}
local palette = {Color3.fromHex("ff536c"), Color3.fromHex("ffb632"), Color3.fromHex("965bff")}
local tileSafe = Color3.fromHex("9beecb")
local tileWarning = Color3.fromHex("ff9160")
local tileReturning = Color3.fromHex("bdf7e7")
local pulseSafe = Color3.fromHex("2a3c50")
local pulseWarning = Color3.fromHex("ffc34c")
local pulseLive = Color3.fromHex("ff4f54")
local function make(parent, name, size, cf, color, solid, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Anchored = true
	p.CanCollide = solid
	p.CanTouch = false
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then p.Shape = shape end
	p.Parent = parent
	return p
end
O.part = make

local definitions = {
	sweep = {size = Vector3.new(22, 0.85, 1.4), y = 1.25, speed = 1.65, damage = 1},
	ball = {size = Vector3.new(6, 6, 6), y = 3, range = 9, speed = 1.8, damage = 1, shape = Enum.PartType.Ball},
	foam = {size = Vector3.new(10, 4, 3), y = 2, range = 10, speed = 1.85, damage = 1},
	pendulum = {size = Vector3.new(4.8, 4.8, 4.8), y = 2.7, range = 9.5, speed = 1.65, damage = 1, shape = Enum.PartType.Ball},
	moving = {size = Vector3.new(15, 1.4, 10), range = 3.6, speed = 1.55, solid = true},
	tilt = {size = Vector3.new(16, 1.4, 10), range = 0.25, speed = 1.7, solid = true},
	roller = {size = Vector3.new(10, 2.8, 2.8), y = 1.4, range = 5.8, speed = 1.9, damage = 1, shape = Enum.PartType.Cylinder},
	beam = {size = Vector3.new(8, 1.4, 10), solid = true},
	vanish = {size = Vector3.new(15, 1.4, 10), solid = true, period = 4, open = 1},
	collapse = {size = Vector3.new(15, 1.4, 10), solid = true, period = 5, open = 1.4},
	conveyor = {size = Vector3.new(20, 1.4, 10), solid = true, speed = 7},
	ice = {size = Vector3.new(20, 1.4, 10), solid = true},
	door = {size = Vector3.new(20, 6, 1.5), y = 3, solid = true, range = 6, speed = 1.4},
	launch = {size = Vector3.new(9, 0.5, 8), y = 0.25, solid = true, speed = 37},
	snowball = {size = Vector3.new(5, 5, 5), y = 2.5, range = 10, speed = 1.5, damage = 1, shape = Enum.PartType.Ball},
	gravity = {size = Vector3.new(17, 12, 12), y = 6, speed = 105},
	pulse = {size = Vector3.new(14, 0.22, 5), y = 0.13, period = 3.8, open = 1.25, damage = 1},
	wind = {size = Vector3.new(10, 10, 14), y = 5, speed = 22},
	slide = {size = Vector3.new(10, 10, 14), y = 5, speed = 25},
	gate = {size = Vector3.new(9, 5, 1.2), y = 2.5, solid = true, period = 6.4, open = 3.5, range = 6.2},
	spin = {size = Vector3.new(1.4, 12, 12), solid = true, speed = 0.7, shape = Enum.PartType.Cylinder},
	sentry = {size = Vector3.new(7, 5.8, 4.8), y = 2.9, range = 7.7, period = 8.6, open = 3.7, damage = 1},
	boulder = {size = Vector3.new(8.8, 8.8, 8.8), y = 4.4, range = 18, period = 6.15, travel = 3.2, damage = 1, shape = Enum.PartType.Ball},
}
O.definitions = definitions

local function hitsRacer(localPos, half, shape, bodyHalf)
	if shape == Enum.PartType.Ball then
		local x = math.max(0,math.abs(localPos.X)-0.55)
		local y = math.max(0,math.abs(localPos.Y)-bodyHalf)
		local z = math.max(0,math.abs(localPos.Z)-0.55)
		return x*x+y*y+z*z < half.X*half.X
	end
	return math.abs(localPos.X) < half.X+0.55
		and math.abs(localPos.Y) < half.Y+bodyHalf
		and math.abs(localPos.Z) < half.Z+0.55
end

local function buildRideable(course, item)
	local platform, base, d = item.part, item.base, item.d
	local guide = make(course.model,"Platform guide",Vector3.one,base,platform.Color,false)
	guide.Transparency = 1
	guide.CanQuery = false
	guide.CastShadow = false

	local slides = item.kind == "moving"
	local axis = if slides then d.axis or Vector3.xAxis else Vector3.zAxis
	local perpendicular = if axis == Vector3.yAxis then Vector3.zAxis else Vector3.yAxis
	local mount = CFrame.fromMatrix(Vector3.zero,axis,perpendicular)
	local fixedAttachment = Instance.new("Attachment",guide)
	fixedAttachment.CFrame = mount
	local deckAttachment = Instance.new("Attachment",platform)
	deckAttachment.CFrame = mount

	local actuator = Instance.new(if slides then "PrismaticConstraint" else "HingeConstraint")
	actuator.Name = "Platform drive"
	actuator.Attachment0 = fixedAttachment
	actuator.Attachment1 = deckAttachment
	actuator.ActuatorType = Enum.ActuatorType.Servo
	actuator.LimitsEnabled = true
	local startingPosition = math.sin(item.phase)*d.range
	if slides then
		actuator.LowerLimit = -d.range-0.25
		actuator.UpperLimit = d.range+0.25
		actuator.LinearResponsiveness = 18
		actuator.ServoMaxForce = 240000
		actuator.Speed = d.speed*d.range+0.65
		actuator.TargetPosition = startingPosition
		platform.CFrame = base+axis*startingPosition
	else
		actuator.LowerAngle = -math.deg(d.range)-3
		actuator.UpperAngle = math.deg(d.range)+3
		actuator.AngularResponsiveness = 18
		actuator.ServoMaxTorque = 900000
		actuator.AngularSpeed = d.speed*d.range+0.35
		actuator.TargetAngle = math.deg(startingPosition)
		platform.CFrame = base*CFrame.Angles(0,0,startingPosition)
	end
	actuator.Parent = platform
	platform.CustomPhysicalProperties = PhysicalProperties.new(1,0.9,0,80,100)
	platform.Anchored = false
	item.actuator = actuator
end

local function buildSpin(course, item)
	local platform, base, d = item.part, item.base, item.d
	local guide = make(course.model,"Carousel axle",Vector3.one,base,platform.Color,false)
	guide.Transparency, guide.CanQuery, guide.CastShadow = 1, false, false
	local bearing = Instance.new("Attachment",guide)
	bearing.CFrame = CFrame.fromMatrix(Vector3.zero,Vector3.yAxis,Vector3.zAxis)
	local floorBearing = Instance.new("Attachment",platform)
	-- The cylinder's positive X axis becomes world Y when it stands upright.
	floorBearing.CFrame = CFrame.fromMatrix(Vector3.zero,Vector3.xAxis,Vector3.zAxis)
	platform.CFrame = base*CFrame.Angles(0,0,math.pi/2)
	local motor = Instance.new("HingeConstraint",platform)
	motor.Name = "Carousel motor"
	motor.Attachment0, motor.Attachment1 = bearing, floorBearing
	motor.ActuatorType = Enum.ActuatorType.Motor
	motor.AngularVelocity, motor.MotorMaxTorque = d.speed, 110000
	platform.CustomPhysicalProperties = PhysicalProperties.new(1,0.9,0,80,100)
	platform.Anchored = false
	item.actuator = motor
end

-- A returning floor can catch someone landing on top. Wait a full cycle
-- instead if it would spawn around someone already falling through its space.
local function overlapsFallingRacer(part, racers)
	local half = part.Size * 0.5
	for player, racer in racers do
		if racer.finished or racer.out or racer.recovering then continue end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root then continue end
		local position = part.CFrame:PointToObjectSpace(root.Position)
		if math.abs(position.X) > half.X+0.8 or math.abs(position.Z) > half.Z+0.8 then continue end
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local standingHeight = humanoid and humanoid.HipHeight+root.Size.Y/2 or 3
		if position.Y > -half.Y-2.8 and position.Y < half.Y+standingHeight-0.15 then
			return true
		end
	end
	return false
end

function O.add(course, kind, origin, phase, overrides)
	local d = table.clone(assert(definitions[kind], kind))
	for key, value in overrides or {} do d[key] = value end
	local cf = CFrame.new(origin + Vector3.new(0, d.y or -0.7, 0))
	local p = make(course.model, kind, d.size, cf, d.color or palette[math.floor(phase) % 3 + 1], d.solid == true, d.shape)
	if not d.solid then p.CanQuery = false end
	local item = {kind = kind, part = p, base = cf, phase = phase, d = d}
	if kind == "moving" or kind == "tilt" then buildRideable(course,item)
	elseif kind == "spin" then buildSpin(course,item) end
	if kind == "ice" then p.CustomPhysicalProperties = PhysicalProperties.new(1, 0.015, 0) end
	if kind == "conveyor" then p.AssemblyLinearVelocity = (d.axis or Vector3.zAxis)*d.speed end
	if kind == "gravity" or kind == "wind" or kind == "slide" then
		p.Transparency, p.CastShadow = 0.91, false
	end
	if kind == "gate" or kind == "sentry" then
		item.signal = make(course.model,"Timing signal",Vector3.new(d.size.X,0.06,1.7),
			CFrame.new(origin + Vector3.new(0,0.06,-2.6)),tileSafe,false)
		item.signal.Material = Enum.Material.Neon
		item.signal.CanQuery = false
	end
	if kind == "pulse" then p.Material = Enum.Material.Neon end
	if kind == "boulder" then
		p.Material = Enum.Material.Slate
		local start = cf.Position + Vector3.zAxis*d.range
		local warning = make(course.model,"Boulder warning",Vector3.new(3,0.08,1.2),
			CFrame.new(start.X,origin.Y+0.05,start.Z),pulseWarning,false)
		warning.Material = Enum.Material.Neon
		warning.CanQuery = false
		item.warning = warning
	end
	if kind == "pendulum" then
		item.pivot = origin + Vector3.new(0, 16, 0)
		item.arm = make(course.model, "Foam swing arm", Vector3.one, cf, Color3.fromHex("ffe6a2"), false)
	end
	table.insert(course.obstacles, item)
	return item
end

function O.activate(course)
	for _, item in course.obstacles do
		if item.actuator and item.part:CanSetNetworkOwnership() then
			-- The deck's contacts and travel stay on the server even with multiple riders.
			item.part:SetNetworkOwner(nil)
		end
	end
end

function O.update(course, age, racers, damage)
	if course.gravityApplied then
		for root in course.gravityApplied do
			local force = root:FindFirstChild("CourseLift")
			if force then force.Force = Vector3.zero end
		end
	end
	for _, o in course.obstacles do
		local p, d, kind = o.part, o.d, o.kind
		local t = age * (d.speed or 1) + o.phase
		local s = math.sin(t)
		if o.actuator then
			if kind == "moving" then o.actuator.TargetPosition = s*d.range
			elseif kind == "tilt" then o.actuator.TargetAngle = math.deg(s*d.range) end
			continue
		end
		local active = true
		if kind == "sweep" then p.CFrame = o.base * CFrame.Angles(0, t, 0)
		elseif kind == "ball" then p.CFrame = o.base + Vector3.new(s * d.range, math.abs(math.sin(t * 1.6)) * (d.bounce or 5.6), 0)
		elseif kind == "foam" then p.CFrame = o.base + (d.axis or Vector3.xAxis) * (s * d.range)
		elseif kind == "roller" then p.CFrame = (o.base + Vector3.new(s * d.range, 0, 0)) * CFrame.Angles(t, 0, 0)
		elseif kind == "snowball" then p.CFrame = o.base + Vector3.new(0, 0, s * d.range)
		elseif kind == "pendulum" then
			local bob = o.base.Position + Vector3.new(s * d.range, math.abs(s)^2 * 4, 0)
			p.Position = bob
			o.arm.Size = Vector3.new(0.7, 0.7, (bob - o.pivot).Magnitude)
			o.arm.CFrame = CFrame.lookAt((bob + o.pivot) / 2, bob)
		elseif kind == "vanish" or kind == "collapse" then
			local cycle = (age + o.phase) % d.period
			local solid = cycle < d.period - d.open
			if solid and not p.CanCollide and age >= (o.blockedUntil or 0) and overlapsFallingRacer(p,racers) then
				o.blockedUntil = age+d.period-cycle
			end
			local blocked = age < (o.blockedUntil or 0)
			local mode
			if cycle >= d.period-0.48 then mode = "returning"
			elseif blocked then mode = "out"
			elseif not solid then mode = "out"
			elseif cycle > d.period-d.open-0.75 then mode = "warning"
			else mode = "solid" end
			if o.mode ~= mode then
				o.mode = mode
				p.CanCollide = mode == "solid" or mode == "warning"
				p.Transparency = if mode == "out" then 0.85 elseif mode == "returning" then 0.58 elseif mode == "warning" then 0.22 else 0
				p.Color = if mode == "warning" then tileWarning elseif mode == "returning" then tileReturning else d.color or tileSafe
			end
		elseif kind == "pulse" then
			local cycle = (age + o.phase) % d.period
			active = cycle >= d.period - d.open
			local mode = if active then "live" elseif cycle >= d.period-d.open-0.95 then "warning" else "safe"
			if o.mode ~= mode then
				o.mode = mode
				p.Color = if mode == "live" then pulseLive elseif mode == "warning" then pulseWarning else d.color or pulseSafe
				p.Transparency = if active then 0 else 0.16
			end
		elseif kind == "boulder" then
			local cycle = (age + o.phase) % d.period
			local traveled = math.min(cycle/d.travel,1)
			active = cycle < d.travel
			local position = active and (1-traveled*2)*d.range or d.range
			p.CFrame = (o.base + Vector3.zAxis*position) * CFrame.Angles(-traveled*8.2,0,0)
			local warning = not active and cycle >= d.period-1.15
			p.Transparency = if active then 0 elseif warning then 0.65 else 1
			o.warning.Transparency = if warning then 0 else 1
		elseif kind == "door" then p.CFrame = o.base + Vector3.new(0, (s + 1) * d.range / 2, 0)
		elseif kind == "gate" or kind == "sentry" then
			local cycle = (age+o.phase)%d.period
			local amount = if cycle < d.open then math.min(cycle/0.65,(d.open-cycle)/0.65,1) else 0
			if kind == "gate" then
				p.CFrame = o.base + Vector3.yAxis*amount*d.range
				-- The moving door is a readable wait, never a crushing hazard.
				p.CanCollide = amount < 0.82 and not overlapsFallingRacer(p,racers)
			else
				active = cycle < d.open
				local walk = math.clamp(cycle/d.open,0,1)
				p.CFrame = o.base + Vector3.xAxis*d.range*(1-2*walk)
				p.Transparency = if active then 0.1 elseif cycle > d.period-1.1 then 0.72 else 1
				for _, detail in ipairs(o.details or {}) do
					detail.part.CFrame = p.CFrame*detail.offset
					detail.part.Transparency = p.Transparency
				end
			end
			if kind == "gate" then
				o.signal.Color = if amount > 0.81 then tileSafe elseif cycle > d.period-1 or cycle < d.open then pulseWarning else pulseLive
			else
				o.signal.Color = if active then pulseLive elseif cycle > d.period-1.1 then pulseWarning else tileSafe
			end
		end
		if not active then continue end
		local forceZone = kind == "gravity" or kind == "wind" or kind == "slide"
		if not d.damage and kind ~= "launch" and not forceZone then continue end
		for player, racer in racers do
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not root or root.Anchored or racer.finished or racer.out or racer.recovering then continue end
			local localPos = p.CFrame:PointToObjectSpace(root.Position)
			local half = p.Size * 0.5
			if d.damage then
				local hit
				if kind == "pulse" or kind == "sweep" or kind == "roller" then
					local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
					local standHeight = root.Size.Y*0.5 + (humanoid and humanoid.HipHeight or 0)
					if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then
						local leg = player.Character:FindFirstChild("Left Leg")
						standHeight += leg and leg.Size.Y or 2
					end
					local feet = root.Position.Y-standHeight
					hit = feet < p.Position.Y + (kind == "roller" and half.Z or half.Y) + 0.18
						and math.abs(localPos.X) < half.X + 0.5
						and math.abs(kind == "roller" and (root.Position.Z-p.Position.Z) or localPos.Z) < half.Z + 0.46
				else
					hit = hitsRacer(localPos,half,d.shape,math.max(0.9,root.Size.Y*0.67))
				end
				if hit then damage(player, racer, d.damage, p) end
			elseif math.abs(localPos.X) <= half.X and math.abs(localPos.Z) <= half.Z then
				if kind == "launch" and localPos.Y > 0 and localPos.Y < 5 and root.AssemblyLinearVelocity.Y <= 1 then
					root.AssemblyLinearVelocity += Vector3.new(0, d.speed, 0)
				elseif forceZone and math.abs(localPos.Y) < half.Y then
					local force = root:FindFirstChild("CourseLift")
					if not force then
						local attachment = Instance.new("Attachment", root)
						attachment.Name = "CourseLiftAttachment"
						force = Instance.new("VectorForce", root)
						force.Name = "CourseLift"
						force.Attachment0 = attachment
						force.RelativeTo = Enum.ActuatorRelativeTo.World
						force.ApplyAtCenterOfMass = true
					end
					local axis = if kind == "gravity" then Vector3.yAxis elseif kind == "slide" then Vector3.zAxis else d.axis or Vector3.xAxis
					force.Force += axis * d.speed * root.AssemblyMass
					course.gravityApplied = course.gravityApplied or {}
					course.gravityApplied[root] = true
				end
			end
		end
	end
end

function O.cleanup(course)
	for root in course.gravityApplied or {} do
		for _, name in {"CourseLift", "CourseLiftAttachment"} do
			local item = root:FindFirstChild(name)
			if item then item:Destroy() end
		end
	end
end
return O
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[local shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local Economy = require(shared.EconomyConfig)
local Season = require(shared.SeasonConfig)
local Levels = require(shared.Levels)
local Rules = require(shared.RaceRules)
local Cosmetics = require(shared.Cosmetics)
local Data = require(script.Parent.Data)

local Progression = {}
local ranks = {Bronze=1, Silver=2, Gold=3}
local collections = {}
for _, egg in ipairs(Cosmetics.entries) do
	if egg.collection then
		collections[egg.collection] = collections[egg.collection] or {}
		table.insert(collections[egg.collection],egg.id)
	end
end

local function seasonData(data)
	if not data.seasons[Season.id] then
		data.seasons[Season.id] = {xp=0,premium=false,claimedFree={},claimedPremium={}}
	end
	return data.seasons[Season.id]
end

local function addXP(data, amount)
	data.xp += amount
	seasonData(data).xp += amount
end

function Progression.credit(data, id, amount)
	data.cartonCredits[id] = (data.cartonCredits[id] or 0) + (amount or 1)
end

function Progression.grantEgg(data, id, earned)
	if not Cosmetics.byId[id] or data.skins[id] then return false end
	data.skins[id] = true
	data.cartonRevision += 1
	local collection = Cosmetics.byId[id].collection
	if collection and not data.collections[collection] then
		local complete = true
		for _, required in collections[collection] do
			if not data.skins[required] then complete = false break end
		end
		if complete then
			data.collections[collection] = true
			data.titlesOwned[collection.." Collector"] = true
		end
	end
	if earned then
		data.earnedSkins[id] = true
		local total = 0
		for _ in data.earnedSkins do total += 1 end
		local reached = math.floor(total/Economy.collectionMilestone)
		if reached > (data.collectionMilestone or 0) then
			data.collectionMilestone = reached
			Progression.credit(data,"classic")
		end
	end
	return true
end

local function questBucket(data, period)
	local now = os.time()
	local calendar = if period == "daily" then math.floor(now/86400)
		elseif period == "weekly" then math.floor((now+259200)/604800)
		else 0
	local bucket = data.questStats[period]
	if not bucket or bucket.calendar ~= calendar then
		bucket = {calendar=calendar,counts={},claimed={},courses={}}
		data.questStats[period] = bucket
	end
	return bucket
end

local function note(data, metric, level)
	for _, period in {"daily","weekly","lifetime"} do
		local bucket = questBucket(data,period)
		if metric == "finishes" and period == "daily" then
			local key = tostring(level)
			if bucket.courses[key] then continue end
			bucket.courses[key] = true
		end
		bucket.counts[metric] = (bucket.counts[metric] or 0)+1
	end
end

local function questStatus(data, quest)
	local bucket = questBucket(data,quest.period)
	return {
		progress=math.min(quest.goal,bucket.counts[quest.metric] or 0),
		goal=quest.goal,claimed=bucket.claimed[quest.id] == true,
	}
end

function Progression.claimQuests(data, id)
	local total = 0
	for _, quest in ipairs(Economy.quests) do
		if id ~= "claim" and id ~= quest.id then continue end
		local status = questStatus(data,quest)
		if not status.claimed and status.progress >= quest.goal then
			questBucket(data,quest.period).claimed[quest.id] = true
			data.coins += quest.coins
			addXP(data,quest.xp)
			if quest.carton then Progression.credit(data,quest.carton) end
			total += 1
		end
	end
	return total
end

local function grantReward(data, reward)
	if reward.kind == "egg" then Progression.grantEgg(data,reward.id)
	elseif reward.kind == "carton" then Progression.credit(data,reward.id)
	elseif reward.kind == "coins" then data.coins += reward.amount
	elseif reward.kind == "trail" then data.trails[reward.id] = true
	elseif reward.kind == "title" then data.titlesOwned[reward.id] = true
	elseif reward.kind == "victory" then data.victories[reward.id] = true
	elseif reward.kind == "banner" then data.banners[reward.id] = true
	elseif reward.kind == "accessory" then data.accessories[reward.id] = true end
end

function Progression.claimSeason(data, premiumOnly)
	local state = seasonData(data)
	local count = 0
	for tier=1,Season.level(state.xp) do
		local key = tostring(tier)
		local rewards = Season.tiers[tier]
		if not premiumOnly and not state.claimedFree[key] then
			grantReward(data,rewards.free)
			state.claimedFree[key] = true
			count += 1
		end
		if state.premium and not state.claimedPremium[key] then
			grantReward(data,rewards.premium)
			state.claimedPremium[key] = true
			count += 1
		end
	end
	return count
end

function Progression.grantPremium(data, id)
	if id == "season" then
		local state = seasonData(data)
		if state.premium then return false end
		state.premium = true
		Progression.claimSeason(data,true)
		return true
	end
	local offer = Economy.collectorById[id]
	if not offer or data.entitlements[id] then return false end
	for _, egg in offer.eggs do Progression.grantEgg(data,egg) end
	for _, extra in offer.extras or {} do grantReward(data,extra) end
	data.entitlements[id] = true
	return true
end

function Progression.finish(player, result)
	local data = Data.get(player)
	local level = Levels[result.level]
	if not data or not level then return {coins=0,xp=0} end
	local mode, time = result.mode, result.time
	local recordKey = Rules.recordKey(result.level)
	local record = not data.records[recordKey] or time < data.records[recordKey]
	if record then
		data.records[recordKey] = time
		note(data,"best")
	end
	local medal
	if mode == "adventure" then
		local limit = level.time or 180
		local thresholds = level.medal or {}
		local gold = thresholds.gold or limit*Economy.medalThresholds.gold
		local silver = thresholds.silver or limit*Economy.medalThresholds.silver
		medal = if time <= gold then "Gold" elseif time <= silver then "Silver" else "Bronze"
		if medal == "Gold" then note(data,"gold",result.level) end
		local key = tostring(result.level)
		if not data.medals[key] or ranks[medal] > (ranks[data.medals[key]] or 0) then
			data.medals[key] = medal
		end
		if level.worldKey and not data.collections["medal:"..level.worldKey] then
			local complete, count = true, 0
			for i, course in ipairs(Levels) do
				if course.worldKey ~= level.worldKey or course.championship then continue end
				count += 1
				if not data.medals[tostring(i)] then complete = false break end
			end
			if complete and count > 0 then
				data.collections["medal:"..level.worldKey] = true
				Progression.credit(data,"adventure")
			end
		end
	end
	local coins = if mode == "quick" then Economy.placement(mode,result.place) else 0
	local xpKey = mode .. "Finish"
	local xp = (Economy.seasonXP[xpKey] or 0) + (result.perfect and Economy.seasonXP.perfect or 0)
	data.deliveries += 1
	data.coins += coins
	addXP(data,xp)
	if data.unlocked == result.level then data.unlocked += 1 end
	note(data,"finishes",result.level)
	if result.perfect then note(data,"perfect") end
	if mode == "quick" and result.place <= 3 then note(data,"podiums") end
	Data.summary(player)
	return {coins=coins,record=record,medal=medal,xp=xp}
end

function Progression.place(player, place, mode, raceId)
	local data = Data.get(player)
	if not data or mode ~= "royale" or not Economy.royalePlacementCoins[place] then return {coins=0,xp=0} end
	-- Main owns the per-tournament award latch. Remember the most recent ID as
	-- a second guard if a caller provides it.
	if raceId and data.placements.royale == raceId then return {coins=0,xp=0} end
	data.placements.royale = raceId
	local coins = Economy.placement(mode,place)
	local xp = Economy.seasonXP.royalePlacement
	data.coins += coins
	if place == 1 then
		data.wins += 1
		data.championships += 1
		xp += Economy.seasonXP.championship
		note(data,"championships")
	end
	if place <= 3 then note(data,"podiums") end
	addXP(data,xp)
	Data.summary(player)
	task.spawn(Data.save,player,false)
	return {coins=coins,xp=xp}
end

function Progression.relic(player, worldKey, relicId)
	local data = Data.get(player)
	if not data then return false end
	local relics = data.relics[worldKey] or {}
	if relics[relicId] then return false end
	relics[relicId] = true
	data.relics[worldKey] = relics
	local count = 0
	for _ in relics do count += 1 end
	if count == Economy.relicsPerWorld then
		Progression.credit(data, if worldKey == "galactic" then "galactic" elseif worldKey == "cloud" or worldKey == "frozen" then "enchanted" else "adventure")
	end
	addXP(data,Economy.seasonXP.relic)
	note(data,"relics")
	Data.summary(player)
	task.spawn(Data.save,player,false)
	return true
end

function Progression.summary(player)
	local data = Data.get(player)
	if not data then return nil end
	local quests = {}
	for _, quest in ipairs(Economy.quests) do quests[quest.id] = questStatus(data,quest) end
	return {
		skins=data.skins, trails=data.trails, skin=data.skin, trail=data.trail, title=data.title,
		records=data.records, deliveries=data.deliveries, coins=data.coins, legacyCoins=data.legacyCoins,
		championships=data.championships, wins=data.wins, xp=data.xp, favorites=data.favorites,
		medals=data.medals, relics=data.relics, season=seasonData(data), quests=quests,
		cartonCredits=data.cartonCredits, cartonRevision=data.cartonRevision, championCartonsOpened=data.championCartonsOpened,
		collections=data.collections, entitlements=data.entitlements, titlesOwned=data.titlesOwned,
		accessories=data.accessories, victories=data.victories, banners=data.banners,
		customTitle=data.customTitle, accessory=data.accessory, victory=data.victory, banner=data.banner,
	}
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[local Marketplace = game:GetService("MarketplaceService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local Config = require(Shared.Config)
local Economy = require(Shared.EconomyConfig)
local Season = require(Shared.SeasonConfig)
local Cosmetics = require(Shared.Cosmetics)
local Data = require(script.Parent.Data)
local Progression = require(script.Parent.Progression)

local Shop = {}
local random = Random.new()
local passByOffer, offerByPass = {}, {}

local function register(offer, pass)
	if typeof(pass) ~= "number" or pass <= 0 or pass % 1 ~= 0 then return end
	passByOffer[offer] = pass
	if offerByPass[pass] ~= nil then
		offerByPass[pass] = false
		warn("Conflicting Egg Courier game pass ID",pass)
	else
		offerByPass[pass] = offer
	end
end

for id, offer in Economy.collectorById do register(id,offer.passId) end
register("season",Season.premiumPassId)
for id, pass in Config.passes do register("legacy:"..id,pass) end

local function grant(player, offer)
	return Data.transact(player,function(data)
		if string.sub(offer,1,7) == "legacy:" then
			local id = string.sub(offer,8)
			local changed = Progression.grantEgg(data,id)
			if id == "VIP" and not data.trails.VIP then
				data.trails.VIP = true
				changed = true
			end
			return changed
		end
		return Progression.grantPremium(data,offer)
	end)
end

local function owns(player, pass)
	return pcall(Marketplace.UserOwnsGamePassAsync,Marketplace,player.UserId,pass)
end

function Shop.refresh(player)
	if not Data.canPurchase(player) then return end
	for pass, offer in offerByPass do
		if not offer then continue end
		local ok, owned = owns(player,pass)
		if ok and owned then grant(player,offer) end
	end
	Data.summary(player)
end

function Shop.listen(changed)
	Marketplace.PromptGamePassPurchaseFinished:Connect(function(player,pass,purchased)
		local offer = offerByPass[pass]
		if not purchased or not offer or not Data.canPurchase(player) then return end
		local ok, owned = owns(player,pass)
		if not ok or not owned then return end
		local saved, granted = grant(player,offer)
		if saved and granted then
			Data.summary(player)
			local collector = Economy.collectorById[offer]
			local reveal = if collector and #collector.eggs > 0 then {
				id=offer, name=collector.name, eggs=collector.eggs, extras=collector.extras,
			} else nil
			changed(player,reveal)
		end
	end)
end

local function prompt(player, offer)
	if offer ~= "season" and not Economy.collectorById[offer] then return "Collector offer unavailable" end
	local pass = passByOffer[offer]
	if not pass or offerByPass[pass] ~= offer or not Data.canPurchase(player) then
		return "This offer is currently unavailable"
	end
	local ok, owned = owns(player,pass)
	if not ok then return "Roblox purchases are unavailable" end
	if owned then
		grant(player,offer)
		Data.summary(player)
		return "Already unlocked"
	end
	return "Review the price in Roblox",nil,pass
end

local function openCarton(player, quote)
	local cartonId, revision = string.match(quote,"^(%a+)|(%d+)$")
	local carton = Economy.cartonById[cartonId]
	if not carton then return "Carton unavailable" end
	local saved, changed, message = Data.transact(player,function(data)
		if tonumber(revision) ~= data.cartonRevision then return false,"Review the updated odds and try again" end
		local entries = Economy.odds(carton,data.skins)
		if #entries == 0 then return false,"Carton collection complete" end
		local voucher = (data.cartonCredits[cartonId] or 0) > 0
		if carton.wins then
			if data.championships < (data.championCartonsOpened+1)*carton.wins then
				return false,"Win an Egg Royale championship to unlock this carton"
			end
		elseif not voucher and data.coins < carton.price then
			return false,"Earn more Egg Coins to open this carton"
		end
		local sum = 0
		for _, reward in entries do sum += reward.weight end
		local pick = random:NextInteger(1,sum)
		local eggId
		for _, reward in entries do
			pick -= reward.weight
			if pick <= 0 then eggId = reward.id break end
		end
		if not eggId then return false,"Carton reward unavailable" end
		if carton.wins then data.championCartonsOpened += 1
		elseif voucher then data.cartonCredits[cartonId] -= 1
		else data.coins -= carton.price end
		Progression.grantEgg(data,eggId,true)
		return true,{id=cartonId,name=carton.name,eggs={eggId},rarity=Cosmetics.byId[eggId].rarity}
	end)
	if not saved then return "Progress is syncing" end
	if not changed then return message end
	Data.summary(player)
	return nil,message
end

local function claim(player, id, season)
	local saved, changed, count = Data.transact(player,function(data)
		local result = if season then Progression.claimSeason(data) else Progression.claimQuests(data,id)
		return result > 0,result
	end)
	if not saved then return "Progress is syncing" end
	if not changed then return "No rewards ready to claim" end
	Data.summary(player)
	return ("%d reward%s claimed"):format(count,count == 1 and "" or "s")
end

local equipFields = {
	accessory="accessories", victory="victories", banner="banners",
}

function Shop.select(player,kind,id)
	local data = Data.get(player)
	if not data then return "Profile loading" end
	if kind == "skin" then
		if not Cosmetics.byId[id] then return "Unknown egg" end
		if not data.skins[id] then return "Unlock this egg to equip it" end
		data.skin = id
	elseif kind == "favorite" then
		if not data.skins[id] then return "Unlock this egg to favorite it" end
		data.favorites[id] = if data.favorites[id] then nil else true
		task.spawn(Data.save,player,false)
		return if data.favorites[id] then "Added to favorites" else "Removed from favorites"
	elseif kind == "trail" then
		if id ~= "" and not data.trails[id] then
			local price = Config.trails[id]
			if not price then return "Trail unavailable" end
			local saved, changed = Data.transact(player,function(current)
				if current.coins+current.legacyCoins < price then return false end
				local oldCoins = math.min(price,current.legacyCoins)
				current.legacyCoins -= oldCoins
				current.coins -= price-oldCoins
				current.trails[id] = true
				return true
			end)
			if not saved then return "Progress is syncing" end
			if not changed then return "Earn more coins for this trail" end
		end
		data.trail = id
	elseif kind == "title" then
		if data.titlesOwned[id] then
			data.customTitle = id
		else
			local number = tonumber(id)
			if not number or number % 1 ~= 0 or not Config.titleXP[number] or data.xp < Config.titleXP[number] then
				return "Title locked"
			end
			data.title, data.customTitle = number,nil
		end
	elseif equipFields[kind] then
		if id ~= "" and not data[equipFields[kind]][id] then return "Cosmetic locked" end
		data[kind] = if id ~= "" then id else nil
	else
		return "Unknown cosmetic"
	end
	Data.summary(player)
	return "Equipped"
end

function Shop.action(player,key,id)
	if typeof(id) ~= "string" then return "Item unavailable" end
	if key == "carton" then return openCarton(player,id) end
	if key == "premium" then return prompt(player,id) end
	if key == "season" then
		if id == "claim" then return claim(player,id,true) end
		return "Season action unavailable"
	end
	if key == "quest" then return claim(player,id,false) end
	return Shop.select(player,key,id)
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Social</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("EggShared")
local Data = require(script.Parent.Data)

local Social = {}
local PARTY_LIMIT = 5
local INVITE_DURATION = 25
local museumDecorations = {velvet=true, ocean=true, sunset=true}

function Social.start(options)
	local remote = Instance.new("RemoteEvent")
	remote.Name = "CourierSocial"
	local groups, invites, requests, relationships = {}, {}, {}, {}

	local function deliver(player, kind, payload)
		if player.Parent == Players then remote:FireClient(player, kind, payload) end
	end

	local function notice(player, message)
		deliver(player, "Notice", message)
	end

	local function publicPlayer(player)
		local data = Data.get(player)
		return {
			id = player.UserId, name = player.DisplayName,
			skin = data and data.skin or "Classic",
			racing = player:GetAttribute("CourseRacing") == true,
		}
	end

	local function snapshot(player)
		local members, inbound, roster = {}, {}, {}
		local group = groups[player]
		if group then
			for _, member in group.members do table.insert(members, publicPlayer(member)) end
		end
		for sender, expiry in invites[player] or {} do
			if expiry > os.clock() and sender.Parent == Players then
				table.insert(inbound, publicPlayer(sender))
			end
		end
		for _, candidate in Players:GetPlayers() do
			if candidate ~= player and Data.get(candidate) then
				table.insert(roster, publicPlayer(candidate))
			end
		end
		table.sort(roster, function(a, b)
			if a.name == b.name then return a.id < b.id end
			return a.name < b.name
		end)
		deliver(player, "Party", {
			leader = group and group.members[1].UserId or player.UserId,
			members = members, invites = inbound, roster = roster,
			limit = PARTY_LIMIT,
		})
	end

	local function update(group)
		for _, member in group.members do snapshot(member) end
	end

	local function removeMember(player)
		local group = groups[player]
		if not group then return end
		groups[player] = nil
		local index = table.find(group.members, player)
		if index then table.remove(group.members, index) end
		update(group)
	end

	local function isFriend(player, target)
		if player == target then return true end
		-- Local multi-client tests use simulated accounts.
		if RunService:IsStudio() and (player.UserId < 0 or target.UserId < 0) then return true end
		local playerCache = relationships[player]
		local cached = playerCache and playerCache[target]
		if cached and cached.expires > os.clock() then return cached.allowed end
		local ok, allowed = pcall(player.IsFriendsWith, player, target.UserId)
		if player.Parent == Players and target.Parent == Players then
			playerCache = relationships[player] or {}
			relationships[player] = playerCache
			playerCache[target] = {expires = os.clock() + (ok and 30 or 3), allowed = ok and allowed == true}
		end
		return ok and allowed == true
	end

	local function hasAccess(player, target)
		local group = groups[player]
		local allowed = player == target or (group and group == groups[target]) or isFriend(player, target)
		return allowed and player.Parent == Players and target.Parent == Players
	end

	local function targetOf(id)
		if typeof(id) ~= "number" or id ~= math.floor(id) or math.abs(id) > 2^53 then return nil end
		local target = Players:GetPlayerByUserId(id)
		return target and Data.get(target) and target or nil
	end

	local function isAvailable(player)
		return player.Parent == Players and Data.get(player) ~= nil and options.canUse(player)
	end

	local function displayedSlots(data)
		local cabinet = data.museum or {}
		local slots = {}
		for slot = 1, 4 do
			local skin = cabinet[tostring(slot)]
			if typeof(skin) == "string" and data.skins[skin] then
				slots[tostring(slot)] = skin
			end
		end
		-- First-time visitors see owned favorites until the owner arranges a display.
		if not cabinet.arranged and next(slots) == nil then
			local favorites = {}
			for skin, favorite in data.favorites or {} do
				if favorite and data.skins[skin] then
					table.insert(favorites, skin)
				end
			end
			table.sort(favorites)
			if data.skin and not table.find(favorites, data.skin) then table.insert(favorites, 1, data.skin) end
			for slot = 1, math.min(4, #favorites) do slots[tostring(slot)] = favorites[slot] end
		end
		return slots
	end

	local function museum(owner, visitor)
		local data = Data.get(owner)
		if not data then return end
		local decoration = data.museum and data.museum.decoration
		local medals, records, collections = 0, 0, 0
		local ribbons = {gold=0, silver=0, bronze=0}
		for _, medal in data.medals or {} do
			local rank = typeof(medal) == "string" and string.lower(medal) or nil
			if rank and ribbons[rank] ~= nil then
				medals += 1
				ribbons[rank] += 1
			end
		end
		for _ in data.records or {} do records += 1 end
		for _, collection in data.collections or {} do if collection then collections += 1 end end
		deliver(visitor, "Museum", {
			owner = publicPlayer(owner), editable = owner == visitor, slots = displayedSlots(data),
			decoration = museumDecorations[decoration] and decoration or "velvet",
			championships = data.championships or data.wins or 0,
			medals = medals, ribbons = ribbons, records = records, collections = collections,
		})
	end

	local actions = {}
	actions.refresh = snapshot
	function actions.invite(player, id)
		local target = targetOf(id)
		if not target or target == player then return end
		if not isFriend(player, target) then
			notice(player, "Party invites are for Roblox friends in this server.")
			return
		end
		if not isAvailable(player) or not isAvailable(target) then
			notice(player, "Both players need to be in the lobby.")
			return
		end
		local group = groups[player]
		if group and group.members[1] ~= player then
			notice(player, "Only the party leader can invite.")
			return
		end
		if (group and #group.members >= PARTY_LIMIT) or groups[target] then
			notice(player, "That player or party is unavailable.")
			return
		end
		local inbound = invites[target] or {}
		invites[target] = inbound
		if (inbound[player] or 0) > os.clock() then return end
		local expiry = os.clock() + INVITE_DURATION
		inbound[player] = expiry
		snapshot(target)
		notice(target, player.DisplayName .. " sent a party invite. Open Friends to respond.")
		notice(player, "Party invite sent to " .. target.DisplayName .. ".")
		task.delay(INVITE_DURATION, function()
			if invites[target] == inbound and inbound[player] == expiry then
				inbound[player] = nil
				snapshot(target)
			end
		end)
	end

	function actions.accept(player, id)
		local sender = targetOf(id)
		local inbound = invites[player]
		if not sender or not inbound or (inbound[sender] or 0) <= os.clock() then
			notice(player, "That invite has expired.")
			return
		end
		if groups[player] or not isAvailable(player) or not isAvailable(sender) then
			notice(player, "Both players need to be available in the lobby.")
			return
		end
		local group = groups[sender]
		if group and (group.members[1] ~= sender or #group.members >= PARTY_LIMIT) then
			notice(player, "That party is unavailable.")
			return
		end
		invites[player] = nil
		if not group then
			group = {members = {sender}}
			groups[sender] = group
		end
		groups[player] = group
		table.insert(group.members, player)
		update(group)
		notice(player, "Joined " .. sender.DisplayName .. "’s party.")
	end

	function actions.decline(player, id)
		local sender = targetOf(id)
		if sender and invites[player] then invites[player][sender] = nil end
		snapshot(player)
	end

	function actions.leave(player)
		if not isAvailable(player) then
			notice(player, "Return to the lobby before leaving your party.")
			return
		end
		removeMember(player)
		snapshot(player)
	end

	function actions.queue(player, request)
		if typeof(request) ~= "table" then return end
		local mode, course, private = request.mode, request.course, request.private == true
		if mode ~= "royale" and mode ~= "quick" then return end
		if typeof(course) ~= "number" or course < 1 or course ~= math.floor(course) then return end
		local group = groups[player]
		if not group or group.members[1] ~= player then return end
		local live = table.clone(group.members)
		for _, member in live do
			if not isAvailable(member) then
				notice(player, "All party members need to be available in the lobby.")
				return
			end
		end
		local ok, message = options.queue(live, mode, course, private and mode == "quick")
		if not ok then
			notice(player, message or "The party could not join the queue.")
			return
		end
		for _, member in live do
			notice(member, message or "Your party joined the race queue.")
		end
	end

	function actions.spectate(player, id)
		local target = targetOf(id)
		if not target or target == player or not hasAccess(player, target) or not isAvailable(player)
			or not options.canSpectate(player, target) then
			notice(player, "Choose a friend who is currently racing.")
			return
		end
		deliver(player, "Spectate", target.UserId)
	end

	function actions.museum(player, id)
		local owner = if id == nil then player else targetOf(id)
		if owner and hasAccess(player, owner) and isAvailable(player) then
			museum(owner, player)
		else
			notice(player, "Visit a friend’s museum from the lobby.")
		end
	end

	function actions.pedestal(player, request)
		if typeof(request) ~= "table" or not isAvailable(player) then return end
		local slot = request.slot
		local skin = request.skin
		local data = Data.get(player)
		if typeof(slot) ~= "number" or slot % 1 ~= 0 or slot < 1 or slot > 4
			or typeof(skin) ~= "string" or (skin ~= "" and data.skins[skin] ~= true) then return end
		local cabinet = displayedSlots(data)
		cabinet.decoration = data.museum and data.museum.decoration
		cabinet.arranged = true
		cabinet[tostring(slot)] = if skin == "" then nil else skin
		data.museum = cabinet
		museum(player, player)
		task.defer(Data.save, player, false)
	end

	function actions.decorate(player, decoration)
		if typeof(decoration) ~= "string" or not museumDecorations[decoration] or not isAvailable(player) then return end
		local data = Data.get(player)
		local cabinet = table.clone(data.museum or {})
		cabinet.decoration = decoration
		data.museum = cabinet
		museum(player, player)
		task.defer(Data.save, player, false)
	end

	remote.OnServerEvent:Connect(function(player, action, payload)
		if typeof(action) ~= "string" or #action > 12 or not actions[action] then return end
		local clock = os.clock()
		local limits = requests[player] or {}
		requests[player] = limits
		local bucket = if action == "refresh" then "refresh" elseif action == "invite" then "invite" else "interaction"
		if (limits[bucket] or 0) > clock then return end
		limits[bucket] = clock + (if action == "invite" then 1.5 else 0.18)
		if not Data.get(player) then return end
		actions[action](player, payload)
	end)
	Players.PlayerRemoving:Connect(function(player)
		removeMember(player)
		requests[player], relationships[player], invites[player] = nil, nil, nil
		for _, cache in relationships do cache[player] = nil end
		for target, inbound in invites do
			if inbound[player] then
				inbound[player] = nil
				snapshot(target)
			end
		end
	end)
	remote.Parent = Shared
end

return Social
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local EggModel = require(Shared.EggModel)
local Levels = require(Shared.Levels)
local Obstacles = require(script.Parent.Obstacles)

local World = {}
local color = Color3.fromHex
local tar = color("3e4267")
local dark = color("151f25")
local slate = color("585887")
local bone = color("f4ebd4")
local yolk = color("ffbb39")
local teal = color("4ed1b2")
local coral = color("f47758")
local silver = color("718990")

local function part(parent, name, size, cf, tint, material, solid, shape)
	local item = Obstacles.part(parent, name, size, cf, tint, solid == true, shape)
	item.Material = material or Enum.Material.SmoothPlastic
	if not solid then item.CanQuery = false end
	return item
end

local function box(parent, name, position, size, tint, material, solid)
	return part(parent,name,size,CFrame.new(position),tint,material,solid)
end

local function beam(parent, name, from, to, thickness, tint, material)
	return part(parent,name,Vector3.new(thickness,thickness,(to-from).Magnitude),
		CFrame.lookAt((from+to)/2,to),tint,material)
end

local function sign(parent, name, position, size, caption, fill, ink, font, face)
	local plate = box(parent,name,position,Vector3.new(size.X,size.Y,0.35),fill,Enum.Material.Metal)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Printed face"
	gui.Face = face or Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.PixelsPerStud = 36
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.Parent = plate
	local label = Instance.new("TextLabel")
	label.Name = "Lettering"
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0.055,0.10)
	label.Size = UDim2.fromScale(0.89,0.8)
	label.Font = font or Enum.Font.FredokaOne
	label.Text = caption
	label.TextColor3 = ink
	label.TextScaled = true
	label.Parent = gui
	return label
end

local function prompt(parent, position, caption, object, key, action)
	local marker = box(parent,object.." prompt",position,Vector3.new(1,1,1),tar)
	marker.Transparency = 1
	local input = Instance.new("ProximityPrompt")
	input.ActionText = caption
	input.ObjectText = object
	input.MaxActivationDistance = 10
	input.RequiresLineOfSight = false
	input.Parent = marker
	input.Triggered:Connect(function(player)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position-position).Magnitude <= 12 then action(player,key) end
	end)
end

local function platform(parent, name, x, z, width, depth, surface, trim)
	box(parent,name.." base",Vector3.new(x,0.21,z),Vector3.new(width,0.42,depth),trim,Enum.Material.Metal,true)
	box(parent,name.." deck",Vector3.new(x,0.48,z),Vector3.new(width-0.58,0.18,depth-0.58),surface,Enum.Material.Concrete,true)
end

local function runway(parent)
	box(parent,"Launch lane",Vector3.new(0,0.024,-7),Vector3.new(22,0.048,59),dark,Enum.Material.Asphalt)
	for _, side in {-1,1} do
		box(parent,"Lane edge",Vector3.new(side*10.8,0.052,-7),Vector3.new(0.26,0.025,59),yolk)
		for z=-30,19,7 do
			box(parent,"Lane lamp",Vector3.new(side*11.7,0.13,z),Vector3.new(0.75,0.26,0.7),yolk,Enum.Material.Neon)
		end
	end
	for z=-26,15,8 do
		for _, side in {-1,1} do
			part(parent,"Runway chevron",Vector3.new(0.28,0.026,4.2),
				CFrame.new(side*1.45,0.061,z)*CFrame.Angles(0,side*math.rad(45),0),bone)
		end
	end
end

local function crate(parent, x, z, width, tint)
	box(parent,"Freight crate",Vector3.new(x,width/2,z),Vector3.new(width,width,width),tint,Enum.Material.WoodPlanks)
	for _, side in {-1,1} do
		box(parent,"Crate band",Vector3.new(x+side*width*0.27,width/2,z),
			Vector3.new(0.27,width+0.12,width+0.12),dark,Enum.Material.Metal)
	end
end

local function railing(parent, x, fromZ, toZ)
	beam(parent,"Safety rail",Vector3.new(x,2.65,fromZ),Vector3.new(x,2.65,toZ),0.18,yolk,Enum.Material.Metal)
	beam(parent,"Safety rail",Vector3.new(x,1.35,fromZ),Vector3.new(x,1.35,toZ),0.12,silver,Enum.Material.Metal)
	for z=fromZ,toZ,6 do
		box(parent,"Rail post",Vector3.new(x,1.45,z),Vector3.new(0.27,2.9,0.27),slate,Enum.Material.Metal)
	end
	-- A single invisible wall keeps the deck edge safe without joining rail pieces into colliders.
	local barrier = box(parent,"Deck barrier",Vector3.new(x,3,(fromZ+toZ)/2),
		Vector3.new(0.25,6,toZ-fromZ),slate,nil,true)
	barrier.Transparency = 1
end

local function landscaping(parent)
	local grass = color("4d745d")
	local rock = color("60605b")
	for _, side in {-1,1} do
		box(parent,"Raised planted verge",Vector3.new(side*58,0.65,0),Vector3.new(9,1.3,92),grass,Enum.Material.Grass,true)
		for z=-38,38,12 do
			local x = side*(58 + (z%5-2)*0.45)
			local height = 3.5 + (z%4)*0.5
			box(parent,"Windbreak trunk",Vector3.new(x,1.3+height/2,z),Vector3.new(0.6,height,0.6),color("77604c"),Enum.Material.Wood)
			for i=1,3 do
				local tint = ({color("35615c"),color("577d62"),color("6f8e6c")})[i]
				part(parent,"Sculpted tree canopy",Vector3.new(4.4-i*0.44,2.2,3.6-i*0.36),
					CFrame.new(x+side*(i-2)*0.63,height+i*0.7,z)*CFrame.Angles(0,i,math.rad(-side*20)),tint)
			end
		end
		railing(parent,side*52.6,-48,48)
	end
	box(parent,"Terminal foundation",Vector3.new(0,-4.2,1),Vector3.new(131,6.4,103),rock,Enum.Material.Slate)
	box(parent,"Terminal foundation band",Vector3.new(0,-1.8,1),Vector3.new(132,1.0,104),color("9f967e"),Enum.Material.Concrete)
	local random = Random.new(861)
	for i=1,15 do
		local x = (i-8)*7.6
		local depth = random:NextNumber(13,27)
		local height = random:NextNumber(6,13)
		part(parent,"Cliff shelf",Vector3.new(11,height,depth),
			CFrame.new(x,-8-height*0.4,random:NextNumber(-24,25))*CFrame.Angles(0,random:NextNumber(-0.5,0.5),random:NextNumber(-0.15,0.15)),
			if i%2 == 0 then rock else color("776e5e"),Enum.Material.Rock)
	end
end

local function beacon(parent, x, z)
	box(parent,"Mast foot",Vector3.new(x,1.1,z),Vector3.new(2.8,2.2,2.8),tar,Enum.Material.Metal,true)
	box(parent,"Apron light mast",Vector3.new(x,7.3,z),Vector3.new(0.62,12.6,0.62),slate,Enum.Material.Metal)
	local lightBar = box(parent,"Light bar",Vector3.new(x,13.7,z),Vector3.new(4,0.55,0.72),dark,Enum.Material.Metal)
	for offset=-1.4,1.4,1.4 do
		box(parent,"Apron lamp",Vector3.new(x+offset,13.65,z-0.35),Vector3.new(0.7,0.27,0.18),bone,Enum.Material.Neon)
	end
	local light = Instance.new("PointLight")
	light.Color = bone
	light.Brightness = 0.65
	light.Range = 16
	light.Parent = lightBar
end

local function hangar(parent, action)
	local hall = Instance.new("Folder")
	hall.Name = "Race Gate"
	hall.Parent = parent
	platform(hall,"Race launch",0,29,28,26,tar,yolk)
	for _, side in {-1,1} do
		box(hall,"Hangar wall",Vector3.new(side*13.65,5.8,29),Vector3.new(0.7,11.6,26),slate,Enum.Material.Metal,true)
		for _, z in {16,24,32,40} do
			box(hall,"Hangar ribs",Vector3.new(side*13.1,5.75,z),Vector3.new(0.35,11.5,0.55),dark,Enum.Material.Metal)
		end
		for y=2,9,3.5 do
			box(hall,"Gate light",Vector3.new(side*12.98,y,15.9),Vector3.new(0.48,2.1,0.35),yolk,Enum.Material.Neon)
		end
		part(hall,"Hangar roof",Vector3.new(15,0.62,28),
			CFrame.new(side*7,12.25,29)*CFrame.Angles(0,0,side*math.rad(-11)),dark,Enum.Material.Metal,true)
		box(hall,"Runway guide",Vector3.new(side*10.7,0.59,28),Vector3.new(0.16,0.04,22),yolk)
		crate(hall,side*10.5,37,2.6,yolk)
	end
	box(hall,"Gate backing",Vector3.new(0,5.8,41.72),Vector3.new(27,11.6,0.6),tar,Enum.Material.Metal,true)
	for x=-9,9,3 do
		box(hall,"Gate interior panel",Vector3.new(x,5.1,41.36),Vector3.new(2.8,9.2,0.28),slate,Enum.Material.Metal)
	end
	box(hall,"Gate sign girder",Vector3.new(0,9.3,15.8),Vector3.new(27,0.52,0.68),dark,Enum.Material.Metal)
	sign(hall,"Gate identifier",Vector3.new(0,9.3,15.3),Vector2.new(17,2.6),"RACE GATE",yolk,dark)
	sign(hall,"Terminal title",Vector3.new(0,15.6,15.15),Vector2.new(32,3.3),"DON’T CRACK THE EGG!",dark,bone)
	for _, side in {-1,1} do
		beam(hall,"Marquee mount",Vector3.new(side*12,11.66,16.0),Vector3.new(side*12,16.7,15.6),0.55,slate,Enum.Material.Metal)
		box(hall,"Title trim",Vector3.new(side*16.6,15.6,15.15),Vector3.new(0.45,3.3,0.35),coral,Enum.Material.Metal)
	end

	box(hall,"Roof cradle",Vector3.new(0,13.7,26),Vector3.new(11,1.3,8),slate,Enum.Material.Metal)
	box(hall,"Roof cradle trim",Vector3.new(0,14.4,26),Vector3.new(10,0.35,7.5),yolk,Enum.Material.Metal)
	local trophy = EggModel.build("Golden",8,true)
	trophy.Name = "Terminal trophy"
	trophy:PivotTo(CFrame.new(0,20,24)*CFrame.Angles(0,0,math.rad(-14)))
	trophy.Parent = hall
	for _, side in {-1,1} do
		beam(hall,"Cradle bracket",Vector3.new(side*5.2,14.3,23),Vector3.new(side*4.2,18,23),0.44,dark,Enum.Material.Metal)
	end
	prompt(hall,Vector3.new(-6.2,3,19),"Join Egg Royale","Race Gate","queue",action)
	prompt(hall,Vector3.new(6.2,3,19),"Join Quick Race","Race Gate","quick",action)
	sign(hall,"Royale arrow",Vector3.new(-6.2,5,16),Vector2.new(8,1.4),"EGG ROYALE",coral,dark)
	sign(hall,"Quick arrow",Vector3.new(6.2,5,16),Vector2.new(8,1.4),"QUICK RACE",teal,dark)
end

local function shop(parent, action)
	local kiosk = Instance.new("Folder")
	kiosk.Name = "Egg Locker"
	kiosk.Parent = parent
	local x,z = -37,-13
	platform(kiosk,"Market stall",x,z,22,16,slate,teal)
	box(kiosk,"Back wall",Vector3.new(x,4.2,z+7.4),Vector3.new(21,8.4,0.55),color("246c66"),Enum.Material.Metal,true)
	for _, side in {-1,1} do
		box(kiosk,"Market post",Vector3.new(x+side*10.2,4.4,z-3.5),Vector3.new(0.5,8.8,0.55),dark,Enum.Material.Metal)
		box(kiosk,"Market showcase",Vector3.new(x+side*7.1,1.62,z+2.4),Vector3.new(5.4,2.12,3.1),dark,Enum.Material.Metal,true)
		box(kiosk,"Showcase lighting",Vector3.new(x+side*7.1,2.75,z+2.4),Vector3.new(5.1,0.16,2.9),teal,Enum.Material.Neon)
	end
	for i=1,11 do
		part(kiosk,"Market awning",Vector3.new(1.95,0.24,8.2),
			CFrame.new(x+(i-6)*1.95,8.8,z)*CFrame.Angles(math.rad(-12),0,0),
			if i%2 == 0 then teal else bone,Enum.Material.Fabric)
	end
	box(kiosk,"Awning valance",Vector3.new(x,8.8,z-4.75),Vector3.new(21,0.5,0.62),dark,Enum.Material.Metal)
	sign(kiosk,"Shop sign",Vector3.new(x,8.8,z-5.2),Vector2.new(15,2.3),"EGG LOCKER",teal,dark)
	for i, skin in {"Watermelon","Ninja","Frozen","Lava"} do
		local address = ({-8.2,-6.0,6.0,8.2})[i]
		local prop = EggModel.build(skin,1.6,true)
		prop:PivotTo(CFrame.new(x+address,3.85,z+2.4)*CFrame.Angles(0,i*0.7,0))
		prop.Parent = kiosk
	end
	prompt(kiosk,Vector3.new(x,2.5,z-3.7),"Browse eggs and cartons","Egg Locker","Shop",action)
end

local function warmup(parent, action)
	local zone = Instance.new("Folder")
	zone.Name = "Warmup Bay"
	zone.Parent = parent
	local x,z = 37,-13
	platform(zone,"Warmup mat",x,z,23,19,tar,coral)
	for _, side in {-1,1} do
		box(zone,"Warmup uprights",Vector3.new(x+side*10.6,3.8,z+1),Vector3.new(0.7,7.6,0.7),slate,Enum.Material.Metal)
		box(zone,"Warmup side mat",Vector3.new(x+side*8.1,0.86,z+2),Vector3.new(2.6,0.58,7.2),coral,Enum.Material.Rubber,true)
	end
	for i=1,5 do
		local height = 0.22 + i*0.14
		box(zone,"Footwork block",Vector3.new(x+5.5,0.57+height/2,z+11.5-i*1.9),Vector3.new(1,height,1.45),
			if i%2 == 0 then yolk else coral,Enum.Material.Rubber,true)
	end
	box(zone,"Warmup sign girder",Vector3.new(x,7.0,z+1),Vector3.new(22,0.45,0.74),slate,Enum.Material.Metal)
	sign(zone,"Warmup banner",Vector3.new(x,7.0,z+0.45),Vector2.new(18,2.3),"WARMUP BAY",coral,dark)
	for i=1,19 do
		local offset = (i-10)*1.12
		part(zone,"Hazard print",Vector3.new(0.58,0.04,0.85),
			CFrame.new(x+offset,0.59,z-8.5)*CFrame.Angles(0,math.rad(25),0),yolk)
	end
	local demo = {model = zone, obstacles = {}}
	Obstacles.add(demo,"sweep",Vector3.new(x-1.8,0.58,z+3.0),1,{damage=false,size=Vector3.new(10,0.75,0.9),speed=1.9})
	prompt(zone,Vector3.new(x,2.5,z-5.1),"Explore in Adventure","Warmup Bay","practice",action)
	return demo
end

local function miniature(parent, world, center)
	local land, accent = color(world.color), color(world.accent)
	local function modelPart(name, x, y, z, width, height, depth, tint, shape, tilt)
		return part(parent,name,Vector3.new(width,height,depth),
			CFrame.new(center+Vector3.new(x,y,z))*CFrame.Angles(0,0,tilt or 0),tint,nil,false,shape)
	end
	modelPart(world.name.." map tile",0,0,0,4.9,0.34,4.4,land)
	if world.key == "temple" then
		for i=1,3 do modelPart("Temple terrace",0,i*0.38,0,3.2-i*0.52,0.42,2.7-i*0.42,accent) end
		modelPart("Temple door",0,0.61,-0.97,0.67,0.94,0.12,dark)
	elseif world.key == "pirate" then
		modelPart("Hidden ship hull",0,0.52,0,3.6,0.62,1,accent)
		modelPart("Mast",0,1.35,0,0.16,1.8,0.16,dark)
		modelPart("Sail",0.42,1.5,-0.08,0.94,0.82,0.12,bone,nil,-0.2)
	elseif world.key == "prehistoric" then
		for i=-1,1 do
			modelPart("Giant fern",i*1.04,0.74,i*0.46,1.26,1.12,1.22,i==0 and accent or teal,Enum.PartType.Ball)
		end
		modelPart("Amber fossil",0.58,0.39,-1.15,0.72,0.66,0.64,accent,Enum.PartType.Ball)
	elseif world.key == "factory" then
		modelPart("Candy mixer vat",0,0.61,0,2.55,0.87,2.27,accent)
		modelPart("Copper chimney",-0.75,1.6,0.26,0.57,1.4,0.55,coral,nil,-0.19)
		modelPart("Candy batch",0.76,1.28,-0.28,0.95,0.82,0.91,bone,Enum.PartType.Ball)
	elseif world.key == "frozen" or world.key == "cloud" then
		for i=-1,1 do
			local height = 1.85-math.abs(i)*0.46
			modelPart(world.key=="cloud" and "Drifting cloud" or "Glacier peak",i*0.92,height*0.51,0,
				1.14,height,1.32,i%2==0 and bone or accent,world.key=="cloud" and Enum.PartType.Ball or nil,i*0.31)
		end
	elseif world.key == "neon" then
		for i=-1,1 do
			local height = 1.85-math.abs(i)*0.47
			modelPart("Neon tower",i*1.04,height/2,0,0.8,height,1.04,accent)
			modelPart("Signal windows",i*1.04,height/2,-0.56,0.11,height*0.76,0.08,dark)
		end
	else
		modelPart("Orbiting station",0,1.25,0,1.5,1.5,1.5,accent,Enum.PartType.Ball)
		modelPart("Solar vanes",0,1.12,0,3.28,0.12,0.57,bone,nil,0.21)
	end
end

local function islandDesk(parent, action)
	local display = Instance.new("Folder")
	display.Name = "Adventure Atlas"
	display.Parent = parent
	local tint = color("b7abff")
	local x,z = 36,25
	platform(display,"Atlas platform",x,z,25,17,tar,tint)
	box(display,"Atlas backboard",Vector3.new(x,4.4,z+7.6),Vector3.new(24,8.8,0.5),slate,Enum.Material.Metal,true)
	sign(display,"Atlas sign",Vector3.new(x,7.4,z+7.15),Vector2.new(20,2.8),"ADVENTURE ATLAS",tint,dark)
	box(display,"Model table",Vector3.new(x,1.72,z+2.3),Vector3.new(23,2.3,9.5),dark,Enum.Material.Metal,true)
	for i, world in ipairs(Levels.worlds) do
		local column = (i-1)%4
		local row = (i-1)//4
		local pos = x+(column-1.5)*5.45
		local center = Vector3.new(pos,3.08+row*0.36,z+row*4.65)
		miniature(display,world,center)
		sign(display,world.key.." nameplate",center+Vector3.new(0,0.06,-2.25),Vector2.new(4.9,0.63),
			world.name,dark,color(world.accent),Enum.Font.GothamBold)
	end
	prompt(display,Vector3.new(x,2.5,z-4.4),"Explore worlds","Adventure Atlas","Courses",action)
end

local function scoreboard(parent)
	local room = Instance.new("Folder")
	room.Name = "Winners' Circle"
	room.Parent = parent
	local x,z = -36,26
	platform(room,"Podium floor",x,z,25,18,slate,yolk)
	box(room,"Scoreboard stand",Vector3.new(x,4.3,z+7.8),Vector3.new(24,8.6,0.9),dark,Enum.Material.Metal,true)
	for _, side in {-1,1} do
		box(room,"Board rails",Vector3.new(x+side*11.95,4.3,z+7.2),Vector3.new(0.5,8.6,0.34),yolk,Enum.Material.Metal)
	end
	local board = sign(room,"Scoreboard",Vector3.new(x,5.3,z+7.0),Vector2.new(22,6.0),
		"SERVER LEADERS",dark,bone,Enum.Font.RobotoMono)
	local ranks = {}
	for place, config in {{0,3.0,yolk},{-7,2.15,teal},{7,1.45,coral}} do
		local stepX = x+config[1]
		local height = config[2]
		box(room,"Podium step",Vector3.new(stepX,height/2+0.56,z+0.8),Vector3.new(6.5,height,5.8),
			config[3],Enum.Material.Metal,true)
		box(room,"Podium tread",Vector3.new(stepX,height+0.6,z+0.8),Vector3.new(6.3,0.14,5.6),dark,Enum.Material.Rubber)
		local plate = sign(room,"Podium place",Vector3.new(stepX,0.53+height*0.56,z-2.25),Vector2.new(6.25,math.min(0.98,height-0.2)),
			tostring(place),dark,bone,Enum.Font.GothamBold)
		ranks[place] = plate
	end
	return board,ranks
end

function World.lobby(action)
	Lighting.ClockTime = 15.3
	Lighting.Brightness = 2.1
	Lighting.Ambient = color("7a8286")
	Lighting.OutdoorAmbient = color("bbc6cc")
	local air = Instance.new("Atmosphere")
	air.Name = "Terminal sky"
	air.Density = 0.23
	air.Haze = 0.72
	air.Color = color("d3e9f7")
	air.Decay = color("90aebb")
	air.Parent = Lighting

	local authored = workspace:FindFirstChild("CourierLobby")
	if not authored then
		authored = Instance.new("Folder")
		authored.Name = "CourierLobby"
		authored.Parent = workspace
	end
	if not authored:FindFirstChild("Stage floor") then
		box(authored,"Stage floor",Vector3.new(0,-1,0),Vector3.new(130,2,100),tar,Enum.Material.Asphalt,true)
	end
	local spawn = authored:FindFirstChild("CourierSpawn")
	if not spawn then
		spawn = Instance.new("SpawnLocation")
		spawn.Name = "CourierSpawn"
		spawn.Size = Vector3.new(12,0.22,7)
		spawn.Position = Vector3.new(0,0.11,-36)
		spawn.Transparency = 1
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Anchored = true
		spawn.Parent = authored
	end

	local terminal = Instance.new("Model")
	terminal.Name = "Shell Yard Terminal"
	terminal.Parent = authored
	runway(terminal)
	landscaping(terminal)
	for _, side in {-1,1} do
		beacon(terminal,side*16.5,-30)
		crate(terminal,side*47,-35,3.0,if side == 1 then coral else teal)
		crate(terminal,side*43,-37,2.2,yolk)
		box(terminal,"Apron stripe",Vector3.new(side*31,0.055,-27),Vector3.new(30,0.045,0.18),bone)
		box(terminal,"Apron stripe",Vector3.new(side*31,0.055,6),Vector3.new(30,0.045,0.18),bone)
	end
	hangar(terminal,action)
	shop(terminal,action)
	local demo = warmup(terminal,action)
	islandDesk(terminal,action)
	local board, podium = scoreboard(terminal)
	return spawn.Position+Vector3.new(0,3.56,0),demo,board,podium
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">EggClient</string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">AdventureAtlas</string>
            <string name="Source"><![CDATA[local Atlas = {}

local function part(parent, size, position, color, shape, rotation)
	local object = Instance.new("Part")
	object.Size = size
	object.CFrame = CFrame.new(position) * (rotation or CFrame.identity)
	object.Color = color
	object.Shape = shape or Enum.PartType.Block
	object.Material = Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanQuery = false
	object.Parent = parent
end

local v = Vector3.new
local rgb = Color3.fromHex
local ball = Enum.PartType.Ball
local cylinder = Enum.PartType.Cylinder
local disc = CFrame.Angles(0, 0, math.pi / 2)

local scenes = {
	temple = function(scene, color, accent)
		for step = 0, 3 do
			part(scene, v(3.6-step*0.66, 0.47, 3.7-step*0.66), v(0.25,0.78+step*0.47,0), accent:Lerp(color, step*0.14))
		end
		part(scene,v(0.85,0.48,0.13),v(0.25,2.1,0.86),rgb("60446b"))
		for _, x in {-2.4,2.1} do
			part(scene,v(0.24,1.1,0.24),v(x,1.25,0.55),rgb("8f5c4b"))
			part(scene,v(1.16,0.85,1.12),v(x,1.98,0.55),rgb("57bf76"),ball)
		end
	end,
	pirate = function(scene, color, accent)
		part(scene,v(3.6,0.78,1.9),v(0,0.85,0),rgb("875237"),ball)
		part(scene,v(3.12,0.14,1.4),v(0,1.17,0),accent)
		part(scene,v(0.15,2.4,0.15),v(0.03,2.22,0),rgb("6c463d"))
		part(scene,v(1.75,1.25,0.24),v(0.03,2.53,0.16),rgb("fff1dc"),ball)
		part(scene,v(1.2,0.42,0.12),v(-0.48,3.33,0.04),color)
	end,
	jungle = function(scene, color, accent)
		for i = 1, 4 do
			local x, z = (i-2.5)*1.15, (i%2-0.5)*1.5
			part(scene,v(0.31,1.2,0.31),v(x,1.15,z),rgb("815741"))
			part(scene,v(1.5,1.22,1.3),v(x,2,z),if i%2==0 then color else accent,ball)
		end
		part(scene,v(2.4,0.23,0.35),v(0,0.76,1.35),rgb("f6d5a2"))
	end,
	factory = function(scene, color, accent)
		part(scene,v(3.5,1.29,2.45),v(0,1.13,0),color)
		part(scene,v(3.75,0.24,2.64),v(0,1.9,0),accent)
		for i = 1, 3 do
			local x = i - 2
			part(scene,v(0.46,0.65,0.12),v(x,1.34,1.25),rgb("fff5b6"))
			part(scene,v(0.41,1.1+i*0.18,0.41),v(x,2.37,-0.7),accent)
		end
	end,
	galaxy = function(scene, color, accent)
		part(scene,v(2.2,2.2,2.2),v(0.15,1.52,0),color,ball)
		part(scene,v(0.12,3.84,3.84),v(0.15,1.52,0),accent,cylinder,CFrame.Angles(0,0,1.09))
		for _, x in {-2,2.35} do
			part(scene,v(0.71,0.71,0.71),v(x,1.16,0.7),rgb("fce295"),ball)
		end
	end,
	frost = function(scene, color, accent)
		for i = 1, 3 do
			local x = (i-2)*1.17
			local height = (i==2 and 2.27 or 1.57)
			local tilt = CFrame.Angles(0,0,(i-2)*0.15)
			part(scene,v(0.85,height,0.89),v(x,0.6+height/2,0),color,Enum.PartType.Block,tilt)
			part(scene,v(0.84,0.24,0.88),v(x,0.58+height,0),accent,Enum.PartType.Block,tilt)
		end
	end,
	neon = function(scene,color,accent)
		for i=1,4 do
			local h = (i==2 and 2.65 or (i==4 and 1.9 or 1.4))
			local x = (i-2.5)*0.99
			part(scene,v(0.72,h,0.76),v(x,0.62+h/2,0.1),color:Lerp(rgb("443562"),i*0.13))
			for j=1,math.floor(h/0.4) do
				part(scene,v(0.36,0.15,0.05),v(x,0.57+j*0.38,0.51),accent)
			end
		end
		part(scene,v(4.32,0.14,0.65),v(0,0.91,1.34),rgb("fa7dbc"))
	end,
	sky = function(scene, color, accent)
		for i = 1, 3 do
			part(scene,v(1.45,1.01,1.57),v((i-2)*1.25,0.67+i*0.27,0.34-i*0.34),color,ball)
			part(scene,v(0.43,1,0.43),v((i-2)*1.25,1.37+i*0.27,0.33-i*0.34),accent)
		end
	end,
	tide = function(scene, color, accent)
		part(scene,v(3.2,0.15,2.56),v(0,0.65,0),color)
		for i = 1, 4 do
			part(scene,v(0.39,1.3,0.39),v((i-2.5)*0.77,1.29,-0.25),accent)
		end
		part(scene,v(2.95,0.21,0.74),v(0,2,-0.25),accent)
	end,
}

local function modelType(world)
	local name = (world.key .. " " .. world.name):lower()
	if name:find("temple") then return "temple" end
	if name:find("pirate") or name:find("secret") then return "pirate" end
	if name:find("prehistor") or name:find("jungle") then return "jungle" end
	if name:find("factory") or name:find("candy") then return "factory" end
	if name:find("galac") or name:find("space") then return "galaxy" end
	if name:find("frost") or name:find("frozen") then return "frost" end
	if name:find("sky") or name:find("cloud") then return "sky" end
	if name:find("neon") then return "neon" end
	return "tide"
end

function Atlas.preview(parent, world, size, position, closeUp)
	local color = rgb(world.color)
	local accent = rgb(world.accent)
	local view = Instance.new("ViewportFrame")
	view.Size, view.Position = size, position
	view.BackgroundColor3 = color:Lerp(rgb("fff6eb"),0.55)
	view.BorderSizePixel = 0
	view.Active = false
	view.Ambient = rgb("f4e6ff")
	view.LightColor = rgb("fff1d7")
	view.LightDirection = v(-1,-1,-0.5)
	view.Parent = parent

	local corners = Instance.new("UICorner")
	corners.CornerRadius = UDim.new(0,11)
	corners.Parent = view
	local scene = Instance.new("WorldModel")
	scene.Parent = view
	part(scene,v(0.72,6.25,6.25),v(0,-0.22,0),color:Lerp(rgb("4e355f"),0.32),cylinder,disc)
	part(scene,v(0.25,5.91,5.91),v(0,0.27,0),color,cylinder,disc)
	part(scene,v(2.4,0.11,0.66),v(-1.02,0.44,1.34),accent)
	part(scene,v(0.72,0.11,1.68),v(0.29,0.44,1.39),accent)
	scenes[modelType(world)](scene, color, accent)
	local camera = Instance.new("Camera")
	camera.FieldOfView = closeUp and 37 or 39
	camera.CFrame = CFrame.lookAt(closeUp and v(7.6,5.5,8) or v(8.9,6.65,9.7), v(0,0.9,0))
	camera.Parent = view
	view.CurrentCamera = camera
	return view, camera
end

local function worldCard(ctx, parent, world, position, goal)
	local color = rgb(world.color)
	local card = ctx.frame(parent,color,UDim2.new(0.5,-17,0,155),position,12)
	ctx.outline(card, ctx.ink, 2)
	Atlas.preview(card, world, UDim2.new(1,-12,1,-56), UDim2.fromOffset(6,6), false)
	local open = ctx.button(card, world.name, ctx.paper, ctx.ink, function()
		ctx.selectWorld(world.key)
	end)
	open.TextSize = 13
	open.Size = UDim2.new(1,-12,0,42)
	open.Position = UDim2.new(0,6,1,-48)
	local previewButton = Instance.new("TextButton")
	previewButton.Name = "Open world preview"
	previewButton.Size = UDim2.new(1,-12,1,-55)
	previewButton.Position = UDim2.fromOffset(6,6)
	previewButton.BackgroundTransparency = 1
	previewButton.Text = ""
	previewButton.Selectable = false
	previewButton.Activated:Connect(function() ctx.selectWorld(world.key) end)
	previewButton.Parent = card
	local route = ctx.label(card, ("%d COURSES"):format(goal), ctx.ink,
		UDim2.new(1,-14,0,20), UDim2.fromOffset(7,8), 9, ctx.digits)
	route.BackgroundColor3 = ctx.paper
	route.BackgroundTransparency = 0.1
	ctx.corner(route, 8)
end

local function showAtlas(ctx)
	local worldList = ctx.levels.worlds
	ctx.row("Choose a destination for Adventure Mode.", ctx.muted, 13, nil, 26)
	local lines = math.ceil(#worldList/2)
	local area = ctx.append(ctx.frame(ctx.list,rgb("dce2ff"),UDim2.new(1,-7,0,lines*177+9),nil,11))
	for index=1,lines do
		local y = 87 + (index-1)*177
		ctx.frame(area,rgb("7b6ac7"),UDim2.new(0.57,0,0,6),UDim2.new(0.22,0,0,y),2)
		if index<lines then
			local x = if index%2==1 then 0.76 else 0.24
			ctx.frame(area,rgb("7b6ac7"),UDim2.fromOffset(6,177),UDim2.new(x,0,0,y),2)
			ctx.frame(area,rgb("ffe97b"),UDim2.fromOffset(9,9),UDim2.new(x,-1,0,y+94),3)
		end
	end
	for index, world in ipairs(worldList) do
		local count = 0
		for k, spec in ipairs(ctx.levels) do
			if spec.worldKey == world.key and k ~= ctx.levels.final then count += 1 end
		end
		local line = math.floor((index-1)/2)
		local flip = (index%2==0) ~= (line%2==1)
		worldCard(ctx,area,world,UDim2.new(flip and 0.5 or 0,8,0,8+177*line),count)
	end
end

local function showWorld(ctx, world)
	local color = rgb(world.color)
	local hero = ctx.append(ctx.frame(ctx.list, color, UDim2.new(1,-7,0,184), nil, 12))
	ctx.outline(hero, ctx.ink, 2)
	local _, camera = Atlas.preview(hero, world, UDim2.new(1,-14,1,-14), UDim2.fromOffset(7,7), true)
	if not ctx.reducedMotion then
		local target = camera.CFrame
		camera.CFrame = CFrame.lookAt(v(11,7,11),v(0,0.9,0))
		game:GetService("TweenService"):Create(camera,TweenInfo.new(0.55,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{CFrame=target}):Play()
	end
	local caption = ctx.frame(hero,ctx.ink,UDim2.new(1,-14,0,37),UDim2.new(0,7,1,-44),8)
	ctx.label(caption,world.name,ctx.paper,UDim2.fromScale(1,1),nil,21,ctx.heavy)
	ctx.listButton("← Adventure Atlas", ctx.cream, ctx.ink, function() ctx.selectWorld(nil) end)
	local relics = ctx.profile.relics and ctx.profile.relics[world.key]
	local found = 0
	for _, discovered in relics or {} do if discovered then found += 1 end end
	ctx.row(("%d / %d relics discovered"):format(found,ctx.economy.relicsPerWorld),ctx.ink,12,ctx.digits,25)
	if world.hook then
		local hook = ctx.row(world.hook, ctx.muted, 12, nil, 42)
		hook.TextWrapped = true
		hook.TextTruncate = Enum.TextTruncate.None
	end
	for index, course in ipairs(ctx.levels) do
		if course.worldKey ~= world.key or index == ctx.levels.final then continue end
		local completed = ctx.profile.records and ctx.profile.records[ctx.rules.recordKey(index)]
		local medal = ctx.profile.medals and ctx.profile.medals[tostring(index)]
		local card = ctx.append(ctx.frame(ctx.list, ctx.cream, UDim2.new(1,-7,0,131), nil, 9))
		ctx.outline(card, ctx.ink, 1.5)
		ctx.left(ctx.label(card,course.name,ctx.ink,UDim2.new(1,-24,0,28),UDim2.fromOffset(12,4),18,ctx.heavy))
		local description = ctx.left(ctx.label(card,course.hook or "",ctx.muted,UDim2.new(1,-24,0,26),UDim2.fromOffset(12,32),11))
		description.TextWrapped = true
		local stars = math.clamp(course.stars or 1,1,5)
		local record = completed and ("  ·  Best %.2fs"):format(completed) or "  ·  No time yet"
		local medalText = typeof(medal) == "string" and ("  ·  " .. medal) or ""
		ctx.left(ctx.label(card, ("%s %d/5%s%s"):format(string.rep("★",stars),stars,record,medalText),
			ctx.ink, UDim2.new(1,-24,0,19),UDim2.fromOffset(12,62),11,ctx.digits))
		local action = ctx.button(card,"PLAY ADVENTURE",ctx.yellow,ctx.ink,function()
			ctx.send("practice", tostring(index))
			ctx.close()
		end)
		action.Size = UDim2.new(0.55,-13,0,42)
		action.Position = UDim2.new(0,10,1,-46)
		local selected = ctx.state.selected == index
		local quick = ctx.button(card,selected and "QUICK RACE PICK" or "SET AS QUICK PICK",selected and ctx.lime or ctx.paper,ctx.ink,function()
			if not selected then ctx.send("choose",tostring(index)) end
		end)
		quick.TextSize = 11
		quick.Size, quick.Position = UDim2.new(0.45,-13,0,42),UDim2.new(0.55,3,1,-46)
		quick.Active, quick.Selectable = not selected, not selected
	end
end

function Atlas.render(ctx)
	local selected
	for _, world in ipairs(ctx.levels.worlds) do
		if world.key == ctx.worldKey then selected = world break end
	end
	if selected then showWorld(ctx,selected) else showAtlas(ctx) end
end

return Atlas
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Audio</string>
            <string name="Source"><![CDATA[local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("EggShared").Config)
local A = {music=0.35, effects=0.65}
local trackId
local activeWorld

local function soundFor(id, volume, looped)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. id
	sound.Volume = volume
	sound.Looped = looped
	sound.Parent = SoundService
	return sound
end

function A.play(key)
	local id = Config.audio[key]
	if not id or id <= 0 then return end
	local sound = soundFor(id,A.effects,false)
	sound:Play()
	Debris:AddItem(sound,20)
end

function A.refreshVolume()
	if A.track then A.track.Volume = A.music end
end

function A.setScene(worldKey, racing)
	activeWorld = racing and worldKey or nil
	local id = if racing then Config.worldMusic and Config.worldMusic[worldKey] or 0 else Config.audio.Music
	if id == trackId then
		A.refreshVolume()
		return
	end
	if A.track then A.track:Destroy() end
	A.track = nil
	trackId = id
	if id and id > 0 then
		A.track = soundFor(id,A.music,true)
		A.track:Play()
	end
end

function A.setLobby(enabled)
	A.setScene(activeWorld,not enabled)
end

return A
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CartonReveal</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")
local Shared = RS:WaitForChild("EggShared")
local Cosmetics = require(Shared.Cosmetics)
local EggModel = require(Shared.EggModel)
local Audio = require(script.Parent.Audio)
local Reveal = {}
local active

local rgb = Color3.fromHex
local ink, plum, white = rgb("28204f"), rgb("53407c"), rgb("fff6f2")
local lightGold, gold, mint = rgb("fff0bd"), rgb("ffca57"), rgb("adf1c0")
local materials = Enum.Material
-- Shell, lining, trim, material, stamped packaging symbol.
local packaging = {
	classic={"b9d99b","eedca9","57997c",materials.SmoothPlastic,"farm"},
	adventure={"994b36","dec795","ffc37c",materials.Wood,"compass"},
	enchanted={"6952b5","ecd4ff","ffbaf1",materials.SmoothPlastic,"rune"},
	royal={"ad7955","a74f67","ffde8e",materials.Metal,"crown"},
	galactic={"485f87","90bbdc","91f3e4",materials.Metal,"circuit"},
	champion={"bb874f","f9d2a1","ffe89a",materials.Metal,"trophy"},
	starterCollector={"cc9288","f8e4b4","fff2db",materials.SmoothPlastic,"farm"},
	pirateCollector={"80514b","ded0aa","eebc70",materials.Wood,"compass"},
	relicCollector={"b38968","eac29c","baf1ca",materials.Sandstone,"rune"},
	dragonCollector={"8a4d72","ffb881","fcea9e",materials.SmoothPlastic,"claw"},
	galacticCollector={"4e5b93","a6a8e1","a9eaff",materials.Metal,"circuit"},
	deluxeCollector={"9f699c","f6bada","ffdd9c",materials.SmoothPlastic,"crown"},
}

local function widget(class, parent, color, size, position, radius)
	local object = Instance.new(class)
	object.BorderSizePixel = 0
	object.BackgroundTransparency = if color then 0 else 1
	if color then object.BackgroundColor3 = color end
	object.Size = size
	object.Position = position or UDim2.new()
	if radius then
		local corner = Instance.new("UICorner",object)
		corner.CornerRadius = UDim.new(0,radius)
	end
	object.Parent = parent
	return object
end

local function text(object, value, color, size)
	object.Text = value
	object.TextColor3 = color
	object.TextSize = size
	object.Font = Enum.Font.FredokaOne
	object.TextTruncate = Enum.TextTruncate.AtEnd
	return object
end

local function button(parent, title, color, size, position, callback)
	local item = text(widget("TextButton",parent,color,size,position,12),title,ink,15)
	item.Activated:Connect(callback)
	return item
end

local function asset(parent, name, size, position, color, material, class, rotation)
	local part = Instance.new(class or "Part")
	part.Name = name
	part.Size = size
	part.CFrame = CFrame.new(position) * (rotation or CFrame.identity)
	part.Color = color
	part.Material = material or materials.SmoothPlastic
	part.Anchored, part.CanCollide, part.CanQuery, part.CanTouch = true,false,false,false
	part.Parent = parent
	return part
end

local function rounded(parent, name, size, position, color, material)
	local part = asset(parent,name,size,position,color,material)
	local mesh = Instance.new("SpecialMesh",part)
	mesh.MeshType = Enum.MeshType.Sphere
	return part
end

local function packageModel(view, key)
	local main, lining, highlight, material, ornament = table.unpack(packaging[key] or packaging.classic)
	main, lining, highlight = rgb(main), rgb(lining), rgb(highlight)
	local v = Vector3.new
	local base = Instance.new("Model", view)
	local cap = Instance.new("Model",view)
	local bevel = materials.SmoothPlastic
	local stage = asset(view,"Turntable",v(0.21,5.85,5.85),v(0,-0.40,0),plum,bevel,nil,CFrame.Angles(0,0,math.pi/2))
	stage.Shape = Enum.PartType.Cylinder
	asset(base,"Carton tray base",v(3.7,0.35,2.8),v(0,0,0),main,material)
	for _, x in {-1.75,1.75} do
		asset(base,"Carton fold",v(0.22,0.53,2.65),v(x,0.28,0),main,material)
	end
	for _, z in {-1.33,1.33} do
		asset(base,"Carton long fold",v(3.48,0.52,0.22),v(0,0.27,z),main,material)
	end
	for _, x in {-1.16,0,1.16} do
		for _, z in {-0.65,0.65} do
			rounded(base,"Moulded egg compartment",v(0.99,0.34,0.99),v(x,0.30,z),lining,bevel)
			rounded(base,"Compartment recess",v(0.61,0.22,0.61),v(x,0.389,z),main,material)
			rounded(base,"Compartment glimmer",v(0.49,0.043,0.49),v(x,0.483,z),highlight,materials.Neon)
		end
	end
	for _, x in {-0.58,0.58} do
		asset(base,"Carton divider",v(0.13,0.34,2.48),v(x,0.275,0),lining,bevel)
	end
	asset(base,"Center divider",v(3.44,0.32,0.13),v(0,0.27,0),lining,bevel)
	asset(cap,"Lid panel",v(3.72,0.21,2.8),v(0,0,0),main,material)
	asset(cap,"Lid label",v(2.85,0.028,2.20),v(0,0.116,0),lining,bevel)
	for _, x in {-1.49,1.49} do
		asset(cap,"Print border",v(0.047,0.035,2.27),v(x,0.128,0),highlight,bevel)
	end
	for _, z in {-1.13,1.13} do
		asset(cap,"Print border",v(3.0,0.035,0.05),v(0,0.128,z),highlight,bevel)
	end

	if ornament=="farm" then
		asset(cap,"Farm sign",v(1.18,0.04,0.68),v(0,0.14,0.13),main,bevel)
		asset(cap,"Painted roof",v(1.06,0.06,0.51),v(0,0.165,-0.33),highlight,bevel,"WedgePart")
		asset(cap,"Printed barn door",v(0.36,0.052,0.40),v(0,0.158,0.18),white,bevel)
	elseif ornament=="circuit" then
		for i=-1,1 do
			asset(cap,"Printed trace",v(1.08,0.04,0.074),v(0,0.155,i*0.36),highlight,materials.Neon)
			rounded(cap,"Circuit contact",v(0.13,0.045,0.13),v(0.69,0.16,i*0.36),main,bevel)
		end
	elseif ornament=="crown" or ornament=="trophy" then
		asset(cap,"Gold leaf base",v(1.04,0.051,0.12),v(0,0.162,0.43),highlight,materials.Metal)
		for i=-1,1 do
			asset(cap,"Gold leaf point",v(0.27,0.07,0.58-math.abs(i)*0.17),v(i*0.34,0.165,0.11),highlight,materials.Metal,"WedgePart")
		end
	else
		for i=1,4 do
			asset(cap,"Printed seal",v(0.062,0.038,1.02),v(0,0.150,0),highlight,bevel,nil,CFrame.Angles(0,i*math.pi/4,0))
		end
		rounded(cap,"Seal center",v(0.28,0.058,0.28),v(0,0.179,0),main,bevel)
	end
	base.WorldPivot, cap.WorldPivot = CFrame.identity, CFrame.identity
	return base, cap
end

local function knownRewards(payload)
	local results = {}
	for _, reward in ipairs(payload.eggs or payload.rewards or {}) do
		local id = if type(reward)=="table" then reward.id else reward
		local egg = Cosmetics.byId[id]
		if egg then table.insert(results,egg) end
	end
	return results
end

local function easeOut(r)
	return 1-(1-math.clamp(r,0,1))^3
end

function Reveal.show(gui, payload, props)
	local rewards = knownRewards(payload)
	local extras = payload.extras or {}
	if #rewards == 0 and #extras == 0 then return end
	if active then active:Destroy() end
	local layer = widget("Frame",gui,ink,UDim2.fromScale(1,1))
	layer.Name = "CartonReveal"
	layer.ZIndex = 50
	layer.Active = true
	layer.BackgroundTransparency = 0.19
	active = layer
	local panel = widget("Frame",layer,ink,UDim2.new(1,-18,1,-18),UDim2.fromScale(0.5,0.5),19)
	panel.AnchorPoint = Vector2.new(0.5,0.5)
	local constraint = Instance.new("UISizeConstraint",panel)
	constraint.MaxSize = Vector2.new(540,510)
	local border = Instance.new("UIStroke",panel)
	border.Color = gold
	border.Thickness = 3
	local title = text(widget("TextLabel",panel,nil,UDim2.new(1,-77,0,44),UDim2.fromOffset(17,5)),payload.name or "Carton",white,23)
	title.TextXAlignment = Enum.TextXAlignment.Left

	local viewport = widget("ViewportFrame",panel,plum,UDim2.new(1,-24,0.48,-36),UDim2.fromOffset(12,49),16)
	viewport.Ambient = rgb("e9dbff")
	viewport.LightDirection = Vector3.new(-0.6,-1,-0.37)
	viewport.LightColor = rgb("fff0d9")
	local world = Instance.new("WorldModel",viewport)
	local camera = Instance.new("Camera",viewport)
	camera.CFrame = CFrame.lookAt(Vector3.new(5.0,3.6,7.5),Vector3.new(0,0.48,0))
	camera.FieldOfView = 39
	viewport.CurrentCamera = camera
	local base, lid = packageModel(world,payload.id)
	local eggs = {}
	for i=1,math.min(3,#rewards) do
		local egg = EggModel.build(rewards[i].id,0.88,true)
		table.insert(eggs,egg)
	end

	local status = text(widget("TextLabel",panel,nil,UDim2.new(1,-24,0,34),UDim2.new(0,12,0.48,15)),"Opening carton…",gold,18)
	local list = widget("ScrollingFrame",panel,plum,UDim2.new(1,-24,0.52,-112),UDim2.new(0,12,0.48,50),11)
	list.Visible = false
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = 4
	list.ScrollBarImageColor3 = gold
	local flow = Instance.new("UIListLayout",list)
	flow.Padding = UDim.new(0,5)
	flow.SortOrder = Enum.SortOrder.LayoutOrder
	local padding = Instance.new("UIPadding",list)
	padding.PaddingLeft, padding.PaddingRight = UDim.new(0,7),UDim.new(0,8)
	padding.PaddingTop, padding.PaddingBottom = UDim.new(0,6),UDim.new(0,6)

	local selected = rewards[1]
	local items = {}
	local done = false
	local connection
	local finish
	local previousSelection = GuiService.SelectedObject
	local gamepad = UserInputService:GetLastInputType().Name:find("Gamepad",1,true) ~= nil
	local skip = button(panel,"Skip",gold,UDim2.new(1,-24,0,43),UDim2.new(0,12,1,-53),function() finish() end)
	local collection = button(panel,"Collection",lightGold,UDim2.new(0.48,-12,0,43),UDim2.new(0,12,1,-53),function()
		layer:Destroy()
		if props.onCollection then props.onCollection() end
	end)
	local equip = button(panel,"Equip egg",mint,UDim2.new(0.52,-17,0,43),UDim2.new(0.48,5,1,-53),function()
		if not selected then return end
		props.send("skin",selected.id)
		layer:Destroy()
		if props.onCollection then props.onCollection() end
	end)
	collection.Visible, equip.Visible = false, false
	local close = button(panel,"×",lightGold,UDim2.fromOffset(42,37),UDim2.new(1,-51,0,8),function() layer:Destroy() end)
	if gamepad then GuiService.SelectedObject = skip end

	local function pose(age)
		local turn = math.max(0, 2.7-age)*0.41
		local rise = easeOut(age/0.54)
		local open = easeOut((age-0.68)/0.82)
		local cframe = CFrame.new(0,-2*(1-rise),0)*CFrame.Angles(0,turn,0)
		base:PivotTo(cframe)
		lid:PivotTo(cframe*CFrame.new(0,0.60,-1.36)*CFrame.Angles(-open*1.39,0,0)*CFrame.new(0,0,1.36))
		local lift = easeOut((age-1.11)/0.91)
		for i, egg in ipairs(eggs) do
			if lift > 0 then
				if not egg.Parent then egg.Parent = world end
				local x = (i-(#eggs+1)/2)*1.14
				local spin = (age-1.11)*1.8
				egg:PivotTo(cframe*CFrame.new(x,0.42+lift*1.32,0.12)*CFrame.Angles(0,math.pi+spin,0))
			end
		end
	end

	finish = function()
		if done then return end
		done = true
		if connection then connection:Disconnect() end
		pose(2.53)
		local highest = rewards[1]
		for _, egg in ipairs(rewards) do
			if egg.rank > highest.rank then highest = egg end
		end
		if highest then
			status.TextColor3 = rgb(Cosmetics.rarities[highest.rarity].color)
			Audio.play("Carton" .. highest.rarity)
		end
		status.Text = ("%d %s unlocked"):format(#rewards+#extras,(#rewards+#extras==1 and "cosmetic" or "cosmetics"))
		skip.Visible = false
		collection.Visible, equip.Visible = true,#rewards>0
		list.Visible = true
		for i, egg in ipairs(rewards) do
			local rarity = Cosmetics.rarities[egg.rarity]
			local item = button(list,rarity.mark .. "  " .. egg.name .. "  ·  " .. egg.rarity,
				egg==selected and gold or rgb(rarity.color),UDim2.new(1,-5,0,33),nil,function()
					selected = egg
					for reward, buttonItem in pairs(items) do
						buttonItem.BackgroundColor3 = reward == egg and gold or rgb(Cosmetics.rarities[reward.rarity].color)
					end
					for _, preview in ipairs(eggs) do preview:Destroy() end
					table.clear(eggs)
					local preview = EggModel.build(egg.id,1.05,true)
					table.insert(eggs,preview)
					pose(2.53)
				end)
			item.LayoutOrder = i
			item.TextSize = 13
			items[egg] = item
		end
		for i, extra in ipairs(extras) do
			local row = text(widget("TextLabel",list,nil,UDim2.new(1,-5,0,30)),extra.name or extra.id or "Cosmetic",white,13)
			row.LayoutOrder = #rewards+i
		end
		if gamepad then GuiService.SelectedObject = selected and equip or collection end
	end

	layer.Destroying:Once(function()
		if connection then connection:Disconnect() end
		for _, egg in ipairs(eggs) do if not egg.Parent then egg:Destroy() end end
		if active==layer then
			active = nil
			local current = GuiService.SelectedObject
			if gamepad and (not current or current:IsDescendantOf(layer)) then
				GuiService.SelectedObject = if previousSelection and previousSelection.Parent then previousSelection else nil
			end
		end
	end)
	if props.reducedMotion then
		finish()
	else
		local age = 0
		pose(age)
		connection = RunService.RenderStepped:Connect(function(dt)
			age += dt
			if age>=2.53 then finish() else pose(age) end
		end)
	end
	return layer
end

return Reveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">ChampionshipView</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("EggShared")
local EggModel = require(Shared.EggModel)
local TrophyModel = require(Shared.TrophyModel)

local View = {}
local stageGold = Color3.fromHex("ffcf60")
local titleInk = Color3.fromHex("241843")
local bannerColors = {
	["Expedition Dawn"]="bd7a5f", ["Hidden Grotto"]="387b79", ["Magma Light"]="964b7a",
	Moonrise="525399", ["Royal Violet"]="7e54ab", ["Star Trail"]="35548f",
}

local function podium(parent)
	local riser = Instance.new("Part")
	riser.Name = "Winner's pedestal"
	riser.Anchored = true
	riser.CanCollide = false
	riser.Size = Vector3.new(0.38,6,6)
	riser.Shape = Enum.PartType.Cylinder
	riser.CFrame = CFrame.new(0,-0.29,0)*CFrame.Angles(0,0,math.pi/2)
	riser.Color = stageGold
	riser.Parent = parent
end

local function previewAvatar(userId, scene)
	local winner = userId and Players:GetPlayerByUserId(userId)
	local character = winner and winner.Character
	if not character then return false end
	local original = character.Archivable
	character.Archivable = true
	local copy = character:Clone()
	character.Archivable = original
	if not copy then return false end
	for _, object in copy:GetDescendants() do
		if object:IsA("LuaSourceContainer") or object:IsA("BillboardGui") or object:IsA("ParticleEmitter")
			or object:IsA("Trail") or object:IsA("Highlight") then
			object:Destroy()
		elseif object:IsA("BasePart") then
			object.Anchored = true
			object.CanCollide = false
		elseif object:IsA("Humanoid") then
			object.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
	local root = copy:FindFirstChild("HumanoidRootPart")
	if not root then
		copy:Destroy()
		return false
	end
	copy.PrimaryPart = root
	copy:PivotTo(CFrame.new(-0.72,2.85,0.17))
	copy.Parent = scene
	return true
end

function View.render(parent, championship)
	local card = Instance.new("Frame")
	card.Name = "Champion presentation"
	card.Size = UDim2.new(1,-8,0,210)
	card.BackgroundColor3 = titleInk
	card.BorderSizePixel = 0
	card.Parent = parent
	Instance.new("UICorner",card).CornerRadius = UDim.new(0,14)

	local viewport = Instance.new("ViewportFrame")
	viewport.BorderSizePixel = 0
	viewport.Size = UDim2.new(1,-10,1,-47)
	viewport.Position = UDim2.fromOffset(5,5)
	viewport.BackgroundColor3 = Color3.fromHex(bannerColors[championship.banner or ""] or "5f468c")
	viewport.Ambient = Color3.fromHex("e3d9ff")
	viewport.LightColor = Color3.fromHex("fff5c6")
	viewport.LightDirection = Vector3.new(-2,-4,-2)
	viewport.Parent = card
	Instance.new("UICorner",viewport).CornerRadius = UDim.new(0,11)

	local world = Instance.new("WorldModel",viewport)
	podium(world)
	local camera = Instance.new("Camera",viewport)
	camera.FieldOfView = 38
	camera.CFrame = CFrame.lookAt(Vector3.new(3.8,4,-10.4),Vector3.new(0,2.28,0))
	viewport.CurrentCamera = camera

	local trophy = TrophyModel.build()
	trophy:PivotTo(CFrame.new(1.4,0.05,-0.48)*CFrame.Angles(0,-0.25,0))
	trophy.Parent = world
	local avatarFound = previewAvatar(championship.userId,world)
	local egg = EggModel.build(championship.skin or "Classic",avatarFound and 0.86 or 1.72,true)
	egg:PivotTo(CFrame.new(avatarFound and 1.42 or -0.65,avatarFound and 2.24 or 1.45,-0.2)*CFrame.Angles(0,-0.27,-0.13))
	egg.Parent = world

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0,8,1,-40)
	label.Size = UDim2.new(1,-16,0,36)
	label.TextColor3 = stageGold
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 15
	label.TextWrapped = true
	local earned = ("%s  •  +%d Egg Coins  •  +%d XP"):format(championship.name or "Champion",
		championship.coins or 0,championship.xp or 0)
	if championship.championships then
		earned ..= ("\n%d lifetime championships"):format(championship.championships)
	end
	label.Text = earned
	label.Parent = card
	return card
end

return View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Cinematics</string>
            <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Levels = require(ReplicatedStorage:WaitForChild("EggShared").Levels)
local player = Players.LocalPlayer
local Cinematics = {}
local shot
local reducedMotion = false
local attempted
local actionName = "SkipCourierIntro"

local function stop()
	local active = shot
	if not active then return end
	shot = nil
	active.connection:Disconnect()
	active.gui:Destroy()
	ContextActionService:UnbindAction(actionName)
	if active.camera == workspace.CurrentCamera and active.camera.CameraType == Enum.CameraType.Scriptable then
		active.camera.CameraType = active.cameraType
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then active.camera.CameraSubject = humanoid end
	end
end

function Cinematics.setReducedMotion(enabled)
	reducedMotion = enabled == true
	if reducedMotion then stop() end
end

local function prepareOverlay(level)
	local gui = Instance.new("ScreenGui")
	gui.Name = "CourierCourseIntro"
	gui.DisplayOrder = 30
	gui.ResetOnSpawn = false
	gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets

	local badge = Instance.new("TextLabel")
	badge.BackgroundColor3 = Color3.fromHex("262052")
	badge.BackgroundTransparency = 0.08
	badge.AnchorPoint = Vector2.new(0.5,1)
	badge.Position = UDim2.new(0.5,0,1,-56)
	badge.Size = UDim2.new(0.9,0,0,46)
	badge.TextColor3 = Color3.fromHex("fff7ff")
	badge.Font = Enum.Font.FredokaOne
	badge.TextScaled = true
	badge.Text = level.name
	badge.Parent = gui
	local titleLimit = Instance.new("UITextSizeConstraint",badge)
	titleLimit.MaxTextSize = 24
	Instance.new("UICorner",badge).CornerRadius = UDim.new(0,14)

	local skip = Instance.new("TextButton")
	skip.AnchorPoint = Vector2.new(0.5,1)
	skip.Position = UDim2.new(0.5,0,1,-6)
	skip.Size = UDim2.fromOffset(170,44)
	skip.BackgroundColor3 = Color3.fromHex("ffdb6d")
	skip.TextColor3 = Color3.fromHex("262052")
	skip.Font = Enum.Font.FredokaOne
	skip.TextSize = 16
	skip.Text = "Skip intro"
	skip.Parent = gui
	Instance.new("UICorner",skip).CornerRadius = UDim.new(0,12)
	skip.Activated:Connect(stop)

	gui.Parent = player:WaitForChild("PlayerGui")
	return gui
end

function Cinematics.update(state)
	local eligible = state.racing and (state.stage == "Preparation" or state.stage == "Countdown")
	if not eligible then
		attempted = nil
		stop()
		return
	end
	if reducedMotion or shot or attempted == state.level then return end
	local level = Levels[state.level]
	local model = level and workspace:FindFirstChild(level.name)
	local camera = workspace.CurrentCamera
	if not model or not camera or camera.CameraType == Enum.CameraType.Scriptable then return end
	local start = model:GetAttribute("CinematicStart")
	local finish = model:GetAttribute("CinematicEnd")
	local focus = model:GetAttribute("CinematicFocus")
	if typeof(start) ~= "Vector3" or typeof(finish) ~= "Vector3" or typeof(focus) ~= "Vector3" then return end
	local fullDuration = state.stage == "Preparation" and 2.15 or 1.35
	local duration = if state.stage == "Countdown" and state.deadline
		then math.min(fullDuration,state.deadline-workspace:GetServerTimeNow()-0.45)
		else fullDuration
	if duration < 0.55 then return end
	attempted = state.level

	local active = {camera=camera,cameraType=camera.CameraType,gui=prepareOverlay(level)}
	shot = active
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.lookAt(start,focus)
	ContextActionService:BindAction(actionName, function(_, inputState)
		if inputState == Enum.UserInputState.Begin then stop() end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Space, Enum.KeyCode.ButtonY)

	local elapsed = 0
	active.connection = RunService.RenderStepped:Connect(function(delta)
		elapsed += delta
		if elapsed >= duration or workspace.CurrentCamera ~= camera or not model.Parent then
			stop()
			return
		end
		local t = elapsed/duration
		camera.CFrame = CFrame.lookAt(start:Lerp(finish,t*t*(3-2*t)),focus)
	end)
end

return Cinematics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">EggJournal</string>
            <string name="Source"><![CDATA[local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = RS:WaitForChild("EggShared")
local Cosmetics = require(Shared.Cosmetics)
local EggModel = require(Shared.EggModel)
local Economy = require(Shared.EconomyConfig)
local Journal = {}

local rgb = Color3.fromHex
local ink, plum, pale = rgb("28204f"), rgb("483779"), rgb("f9efff")
local frost, gold, mint = rgb("e8deff"), rgb("ffcf56"), rgb("a5edcb")
local heading, body = Enum.Font.FredokaOne, Enum.Font.GothamMedium
local pageSize = 15
local state = {rarity=0, collection=0, favorites=false, query="", page=1, selected="Classic"}

local function box(kind, parent, color, size, position, radius)
	local object = Instance.new(kind)
	object.BorderSizePixel = 0
	object.BackgroundTransparency = if color then 0 else 1
	if color then object.BackgroundColor3 = color end
	object.Size = size
	object.Position = position or UDim2.new()
	if radius then
		local corner = Instance.new("UICorner",object)
		corner.CornerRadius = UDim.new(0,radius)
	end
	object.Parent = parent
	return object
end

local function label(parent, text, size, position, textColor, font, pixels, alignment)
	local item = box("TextLabel",parent,nil,size,position)
	item.Text = text
	item.TextColor3 = textColor
	item.Font = font
	item.TextSize = pixels
	item.TextXAlignment = alignment or Enum.TextXAlignment.Left
	item.TextTruncate = Enum.TextTruncate.AtEnd
	return item
end

local function callButton(parent, text, size, position, background, textColor, callback)
	local item = box("TextButton",parent,background,size,position,11)
	item.Text = text
	item.TextColor3 = textColor
	item.Font = heading
	item.TextSize = 13
	item.TextTruncate = Enum.TextTruncate.AtEnd
	item.Activated:Connect(callback)
	return item
end

local function sourceLabel(entry)
	local source = Economy.sourceOf[entry.id] or entry.source
	return Cosmetics.sources[source] or "Collection reward"
end

local function preview(parent, entry, owned, reducedMotion)
	local view = box("ViewportFrame",parent,plum,UDim2.new(0.34,-3,1,-18),UDim2.fromOffset(9,9),12)
	view.LightColor = rgb("fff5e2")
	view.Ambient = rgb("dcd1ff")
	view.LightDirection = Vector3.new(-0.7,-0.55,-0.48)
	local camera = Instance.new("Camera",view)
	camera.CFrame = CFrame.lookAt(Vector3.new(0,0.36,3.2),Vector3.new(0,0.15,0))
	camera.FieldOfView = 38
	view.CurrentCamera = camera
	local egg = EggModel.build(entry.id,1.1,true)
	egg.Parent = view
	if not owned then
		for _, part in ipairs(egg:GetChildren()) do
			if part:IsA("BasePart") then
				part.Material = Enum.Material.SmoothPlastic
				part.Color = ink
			end
		end
	end
	EggModel.previewPose(egg,2.68,0)
	if not reducedMotion and owned then
		local elapsed = 0
		local connection = RunService.RenderStepped:Connect(function(dt)
			elapsed += dt
			EggModel.previewPose(egg,2.68+elapsed*0.52,elapsed)
		end)
		view.Destroying:Once(function() connection:Disconnect() end)
	end
end

local function showCompletion(parent, found)
	local band = box("Frame",parent,ink,UDim2.new(1,0,0,72),nil,13)
	label(band,"Egg Encyclopedia",UDim2.new(1,-24,0,26),UDim2.fromOffset(12,6),pale,heading,22)
	label(band,("Discovered %d of %d"):format(found,#Cosmetics.entries),
		UDim2.new(1,-84,0,18),UDim2.fromOffset(12,34),frost,body,12)
	local percent = math.floor(found/#Cosmetics.entries*100)
	local percentLabel = label(band,("%d%%"):format(percent),UDim2.fromOffset(60,18),UDim2.new(1,-72,0,34),gold,heading,13,Enum.TextXAlignment.Right)
	percentLabel.Name = "CompletionPercent"
	local track = box("Frame",band,plum,UDim2.new(1,-24,0,7),UDim2.new(0,12,1,-14),4)
	if found > 0 then box("Frame",track,mint,UDim2.fromScale(found/#Cosmetics.entries,1),nil,4) end
end

function Journal.render(parent, props)
	local profile = props.profile or {}
	local owned, favorites = profile.skins or {}, profile.favorites or {}
	local width = UDim2.new(1,-9,0,0)
	local frame = box("Frame",parent,nil,width)
	frame.Name = "EggEncyclopedia"
	frame.AutomaticSize = Enum.AutomaticSize.Y
	local flow = Instance.new("UIListLayout",frame)
	flow.SortOrder = Enum.SortOrder.LayoutOrder
	flow.Padding = UDim.new(0,8)
	local found = 0
	for _, entry in ipairs(Cosmetics.entries) do
		if owned[entry.id] then found += 1 end
	end
	showCompletion(frame,found)

	local filters = box("Frame",frame,nil,UDim2.new(1,0,0,76))
	filters.LayoutOrder = 1
	local search = box("TextBox",filters,pale,UDim2.new(1,0,0,34),nil,9)
	search.Name = "SearchEggs"
	search.Text = state.query
	search.PlaceholderText = "Search the encyclopedia"
	search.PlaceholderColor3 = plum
	search.TextColor3 = ink
	search.ClearTextOnFocus = false
	search.Font = body
	search.TextSize = 14
	local result = box("Frame",frame,nil,UDim2.new(1,0,0,0))
	result.LayoutOrder = 2
	result.AutomaticSize = Enum.AutomaticSize.Y
	local refresh
	local rarity = callButton(filters,"",UDim2.new(0.33,-3,0,35),UDim2.fromOffset(0,41),plum,pale,function()
		state.rarity = (state.rarity+1)%(#Cosmetics.rarityOrder+1)
		state.page = 1
		refresh()
	end)
	local collection = callButton(filters,"",UDim2.new(0.34,-3,0,35),UDim2.new(0.33,0,0,41),plum,pale,function()
		state.collection = (state.collection+1)%(#Cosmetics.collections+1)
		state.page = 1
		refresh()
	end)
	local fav = callButton(filters,"",UDim2.new(0.33,0,0,35),UDim2.new(0.67,0,0,41),plum,pale,function()
		state.favorites = not state.favorites
		state.page = 1
		refresh()
	end)

	refresh = function()
		result:ClearAllChildren()
		local layout = Instance.new("UIListLayout",result)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0,7)
		local rarityId = Cosmetics.rarityOrder[state.rarity]
		local collectionId = Cosmetics.collections[state.collection]
		rarity.Text = rarityId or "All rarities"
		collection.Text = collectionId and collectionId[2] or "All collections"
		fav.Text = state.favorites and "★ Favorites" or "☆ Favorites"
		fav.BackgroundColor3 = state.favorites and gold or plum
		fav.TextColor3 = state.favorites and ink or pale
		local visible = {}
		local selected
		local query = string.lower(state.query)
		for _, entry in ipairs(Cosmetics.entries) do
			local matches = query == "" or string.find(string.lower(entry.name),query,1,true)
				or string.find(string.lower(entry.collection),query,1,true)
			if matches and (not rarityId or entry.rarity==rarityId)
				and (not collectionId or entry.collection==collectionId[1])
				and (not state.favorites or favorites[entry.id]) then
				table.insert(visible,entry)
				if state.selected==entry.id then selected = entry end
			end
		end
		if #visible==0 then
			label(result,"No eggs match these filters.",UDim2.new(1,0,0,48),nil,ink,body,14)
			return
		end
		local pages = math.ceil(#visible/pageSize)
		state.page = math.clamp(state.page,1,pages)
		local first = (state.page-1)*pageSize+1
		local last = math.min(first+pageSize-1,#visible)
		if not selected then selected = visible[first] end
		local spec = Cosmetics.rarities[selected.rarity]
		local detail = box("Frame",result,ink,UDim2.new(1,0,0,168),nil,14)
		preview(detail,selected,owned[selected.id],props.reducedMotion)
		local function words(txt, y, height, font, size, color)
			return label(detail,txt,UDim2.new(0.64,-11,0,height),UDim2.new(0.36,0,0,y),color,font,size)
		end
		words(spec.mark .. "  " .. selected.rarity .. "  ·  " .. selected.collection,10,18,heading,12,rgb(spec.color))
		words(selected.name,29,28,heading,19,pale)
		local description = words(selected.description,57,40,body,12,frost)
		description.TextWrapped = true
		description.TextTruncate = Enum.TextTruncate.None
		local source = owned[selected.id] and "Owned" or "Undiscovered"
		words(source .. "  ·  " .. sourceLabel(selected),97,21,body,11,mint)
		if owned[selected.id] then
			if profile.skin == selected.id then
				label(detail,"Equipped",UDim2.new(0.33,-3,0,36),UDim2.new(0.36,0,0,124),mint,heading,13,Enum.TextXAlignment.Center)
			else
				callButton(detail,"Equip",UDim2.new(0.33,-3,0,36),UDim2.new(0.36,0,0,124),mint,ink,function()
					props.send("skin",selected.id)
				end)
			end
			callButton(detail,favorites[selected.id] and "★ Saved" or "☆ Favorite",UDim2.new(0.29,-5,0,36),UDim2.new(0.69,0,0,124),gold,ink,function()
				props.send("favorite",selected.id)
			end)
		elseif props.navigate then
			callButton(detail,"Find cartons",UDim2.new(0.53,0,0,36),UDim2.new(0.36,0,0,124),gold,ink,function()
				props.navigate("Cartons")
			end)
		end

		if collectionId then
			local collected = 0
			for _, item in ipairs(visible) do if owned[item.id] then collected += 1 end end
			local caption = label(result,("%s entries found  %d / %d"):format(collectionId[2],collected,#visible),
				UDim2.new(1,0,0,23),nil,ink,body,12)
			caption.LayoutOrder = 1
		end
		local grid = box("Frame",result,nil,UDim2.new(1,0,0,math.ceil((last-first+1)/3)*52-6))
		grid.LayoutOrder = 2
		local grids = Instance.new("UIGridLayout",grid)
		grids.CellSize = UDim2.new(1/3,-4,0,46)
		grids.CellPadding = UDim2.fromOffset(6,6)
		grids.SortOrder = Enum.SortOrder.LayoutOrder
		for i=first,last do
			local entry = visible[i]
			local mark = if owned[entry.id] then Cosmetics.rarities[entry.rarity].mark else "○"
			local tile = callButton(grid,mark .. "  " .. entry.name,UDim2.new(),nil,entry.id==selected.id and gold or frost,ink,function()
				state.selected = entry.id
				refresh()
			end)
			tile.LayoutOrder = i
			tile.TextWrapped = true
			tile.TextTruncate = Enum.TextTruncate.None
			tile.TextSize = 12
		end
		if pages > 1 then
			local controls = box("Frame",result,nil,UDim2.new(1,0,0,40))
			controls.LayoutOrder = 3
			if state.page>1 then
				callButton(controls,"‹ Previous",UDim2.new(0.29,0,1,0),nil,plum,pale,function()
					state.page -= 1
					state.selected = ""
					refresh()
				end)
			end
			label(controls,("%d / %d"):format(state.page,pages),UDim2.new(0.38,0,1,0),UDim2.fromScale(0.31,0),ink,heading,14,Enum.TextXAlignment.Center)
			if state.page<pages then
				callButton(controls,"Next ›",UDim2.new(0.29,0,1,0),UDim2.fromScale(0.71,0),plum,pale,function()
					state.page += 1
					state.selected = ""
					refresh()
				end)
			end
		end
	end
	search:GetPropertyChangedSignal("Text"):Connect(function()
		state.query = search.Text
		state.page = 1
		refresh()
	end)
	refresh()
	return frame
end
return Journal
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="31">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local MarketplaceService = game:GetService("MarketplaceService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("EggShared")
local Config = require(Shared.Config)
local Levels = require(Shared.Levels)
local Rules = require(Shared.RaceRules)
local Cosmetics = require(Shared.Cosmetics)
local Egg = require(Shared.EggModel)
local Audio = require(script.Parent.Audio)
local Economy = require(Shared.EconomyConfig)
local Season = require(Shared.SeasonConfig)
local Atlas = require(script.Parent.AdventureAtlas)
local ProgressUI = require(script.Parent.ProgressUI)
local EggJournal = require(script.Parent.EggJournal)
local CartonReveal = require(script.Parent.CartonReveal)
local SocialUI = require(script.Parent.SocialUI)
local Cinematics = require(script.Parent.Cinematics)
local ChampionshipView = require(script.Parent.ChampionshipView)
local remote = Shared:WaitForChild("CourierEvent")
local player = Players.LocalPlayer

local rgb = Color3.fromHex
local ink, charcoal, muted = rgb("272054"), rgb("493b79"), rgb("5e5078")
local paper, cream = rgb("fff9ff"), rgb("ede3ff")
local yellow, lime, rust = rgb("ffcf4b"), rgb("a8f4bd"), rgb("ff8eb5")
local winnerRed = rgb("fa5451")
local worldColors = {}
for _, world in ipairs(Levels.worlds) do worldColors[world.key] = rgb(world.color) end
local typeface = Enum.Font.GothamMedium
local heavy = Enum.Font.FredokaOne
local digits = Enum.Font.GothamBold
local state = {stage = "Lobby", selected = 1, level = 1, deadline = 0}
local race = {hp = 3, place = 1, total = 1, progress = 0, cooldown = 0, recover = 0}
local profile = {skins = {Classic = true}, skin = "Classic", trails = {}, records = {}, title = 1, deliveries = 0}
local tab, worldKey
local reducedMotion = false
pcall(function() reducedMotion = GuiService.ReducedMotionEnabled end)
Cinematics.setReducedMotion(reducedMotion)
local setTab, draw
local advanceNote
local auraToggle

local gui = Instance.new("ScreenGui")
gui.Name = "CourierBroadcast"
gui.ResetOnSpawn = false
gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent, radius)
	local instance = Instance.new("UICorner")
	instance.CornerRadius = UDim.new(0, radius)
	instance.Parent = parent
end

local function outline(parent, color, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = color
	stroke.Thickness = thickness or 1
	stroke.Parent = parent
end

local function frame(parent, color, size, position, radius)
	local instance = Instance.new("Frame")
	instance.BorderSizePixel = 0
	instance.BackgroundTransparency = color and 0 or 1
	if color then instance.BackgroundColor3 = color end
	instance.Size = size
	instance.Position = position or UDim2.new()
	if radius then corner(instance, math.min(radius + 3, 18)) end
	instance.Parent = parent
	return instance
end

local function label(parent, text, color, size, position, textSize, font)
	local instance = Instance.new("TextLabel")
	instance.BackgroundTransparency = 1
	instance.TextColor3 = color
	instance.Text = text
	instance.Font = font or typeface
	instance.TextSize = textSize
	instance.TextTruncate = Enum.TextTruncate.AtEnd
	instance.Size = size
	instance.Position = position or UDim2.new()
	instance.Parent = parent
	return instance
end

local function left(instance)
	instance.TextXAlignment = Enum.TextXAlignment.Left
	return instance
end

local function button(parent, text, color, textColor, callback)
	local instance = Instance.new("TextButton")
	instance.AutoButtonColor = true
	instance.BorderSizePixel = 0
	instance.BackgroundColor3 = color
	instance.TextColor3 = textColor
	instance.Text = text
	instance.TextTruncate = Enum.TextTruncate.AtEnd
	instance.TextSize = 13
	instance.Font = heavy
	instance.Size = UDim2.new(1, 0, 0, 36)
	corner(instance, 11)
	outline(instance, ink, 1.5)
	local gloss = Instance.new("UIGradient")
	gloss.Rotation = 90
	gloss.Color = ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(206,198,229))
	gloss.Parent = instance
	instance.Parent = parent
	local scale = Instance.new("UIScale")
	scale.Parent = instance
	local scaleTween
	local function animate(target)
		if reducedMotion or not instance.Active then return end
		if scaleTween then scaleTween:Cancel() end
		scaleTween = TweenService:Create(scale,TweenInfo.new(0.12,Enum.EasingStyle.Quad),{Scale=target})
		scaleTween:Play()
	end
	instance.MouseEnter:Connect(function() animate(1.025) end)
	instance.MouseLeave:Connect(function() animate(1) end)
	instance.SelectionGained:Connect(function() animate(1.025) end)
	instance.SelectionLost:Connect(function() animate(1) end)
	instance.MouseButton1Down:Connect(function() animate(0.975) end)
	instance.MouseButton1Up:Connect(function() animate(1) end)
	instance.Activated:Connect(function()
		Audio.play("Click")
		callback()
	end)
	return instance
end

local function bubblePanel(panel)
	outline(panel, rgb("241b50"), 2.5)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(Color3.new(1,1,1),rgb("e7d9ff"))
	gradient.Parent = panel
end

local function limit(parent, x, y)
	local instance = Instance.new("UISizeConstraint")
	instance.MaxSize = Vector2.new(x, y)
	instance.Parent = parent
end

local function fire(action, value)
	remote:FireServer(action, value)
end

local function now()
	return workspace:GetServerTimeNow()
end

local function clock(seconds)
	local rounded = math.max(0, math.ceil(seconds))
	return ("%d:%02d"):format(rounded // 60, rounded % 60)
end

local function isGamepad()
	return UserInputService:GetLastInputType().Name:match("^Gamepad") ~= nil
end

local function heatName(heat)
	local heats = state.heats or 5
	if state.duel or heat >= heats then return "CHAMPIONSHIP" end
	return ("ROUND %d / %d"):format(heat, heats)
end

local function showDock()
	return tab == nil and not state.racing and not state.room
end

local function hasResult()
	return state.stage ~= "Returning" and (typeof(state.result) == "table"
		or (state.stage == "Results" and state.room and state.championship ~= nil))
end

local root = frame(gui, nil, UDim2.fromScale(1, 1))
local tint = frame(root, rust, UDim2.fromScale(1, 1))
tint.BackgroundTransparency = 1

local hud = frame(root, ink, UDim2.new(1, -30, 0, 86), UDim2.new(0.5, 0, 0, 8), 7)
hud.AnchorPoint = Vector2.new(0.5, 0)
limit(hud, 340, 86)
bubblePanel(hud)
local raceHeat = left(label(hud, "", yellow, UDim2.new(1, -94, 0, 16), UDim2.fromOffset(12, 6), 11, digits))
local courseName = left(label(hud, "", paper, UDim2.new(1, -80, 0, 25), UDim2.fromOffset(12, 22), 15, heavy))
local position = left(label(hud, "", paper, UDim2.fromOffset(34, 19), UDim2.fromOffset(12, 50), 12, heavy))
local raceStatus = left(label(hud, "", lime, UDim2.new(1, -64, 0, 20), UDim2.fromOffset(51, 49), 12, digits))
local raceTime = label(hud, "0:00", yellow, UDim2.fromOffset(61, 28), UDim2.new(1, -70, 0, 3), 24, digits)
raceTime.TextXAlignment = Enum.TextXAlignment.Right
local eggs = {}
for index = 1, 3 do
	local icon = frame(hud, paper, UDim2.fromOffset(11, 15), UDim2.new(1, -55 + (index - 1) * 16, 0, 35), 7)
	icon.Rotation = 12
	eggs[index] = icon
end
local progress = frame(hud, charcoal, UDim2.new(1, -24, 0, 3), UDim2.fromOffset(12, 76), 2)
local progressFill = frame(progress, lime, UDim2.fromScale(0, 1), nil, 2)

local wallet = frame(root, paper, UDim2.fromOffset(93, 33), UDim2.new(1, -13, 0, 9), 5)
wallet.AnchorPoint = Vector2.new(1, 0)
outline(wallet, ink, 1.5)
local coin = frame(wallet, yellow, UDim2.fromOffset(14, 14), UDim2.fromOffset(10, 9), 7)
outline(coin, ink)
label(coin, "•", ink, UDim2.fromScale(1, 1), nil, 11, heavy)
local coinCount = left(label(wallet, "0", ink, UDim2.fromOffset(60, 25), UDim2.fromOffset(29, 4), 17, digits))

local dock = frame(root, ink, UDim2.new(1, -24, 0, 109), UDim2.new(0.5, 0, 1, -14), 7)
dock.AnchorPoint = Vector2.new(0.5, 1)
limit(dock, 510, 109)
bubblePanel(dock)
local dockInterior = frame(dock, nil, UDim2.new(1, -12, 1, -12), UDim2.fromOffset(6, 6))
local play = button(dockInterior, "▶  PLAY", yellow, ink, function()
	if state.queued or state.practiceQueued then fire("lobby") else setTab("Play") end
end)
play.Size = UDim2.new(1,-4,0,49)
play.TextSize = 25
for index, item in ipairs({{"WORLDS", "Courses"}, {"EGGS", "Shop"}, {"PASS", "Season"}, {"MORE", "More"}}) do
	local option = button(dockInterior, item[1], (index%2==0 and cream or lime), ink, function()
		setTab(item[2])
	end)
	option.TextSize = 14
	option.Size = UDim2.new(0.25,-4,0,42)
	option.Position = UDim2.new((index-1)*0.25,0,0,54)
end
local queueStatus = label(root, "", paper, UDim2.new(1, -40, 0, 26), UDim2.new(0.5, 0, 1, -126), 13, heavy)
queueStatus.AnchorPoint = Vector2.new(0.5, 1)
queueStatus.TextStrokeColor3 = ink
queueStatus.TextStrokeTransparency = 0.16

local staging = frame(root, ink, UDim2.new(1, -30, 0, 57), UDim2.new(0.5, 0, 0, 8), 7)
staging.AnchorPoint = Vector2.new(0.5, 0)
staging.Visible = false
limit(staging, 340, 57)
local stagingTitle = left(label(staging, "", yellow, UDim2.new(1, -24, 0, 21), UDim2.fromOffset(12, 5), 14, heavy))
local stagingBody = left(label(staging, "", paper, UDim2.new(1, -24, 0, 21), UDim2.fromOffset(12, 28), 12, digits))

local banner = label(root, "", paper, UDim2.new(1, -20, 0, 90), UDim2.new(0.5, 0, 0.33, 0), 72, heavy)
banner.AnchorPoint = Vector2.new(0.5, 0)
banner.TextStrokeColor3 = ink
banner.TextStrokeTransparency = 0.03
banner.Visible = false

local toast = frame(root, ink, UDim2.new(1, -36, 0, 31), UDim2.new(0.5, 0, 0, 103), 5)
toast.AnchorPoint = Vector2.new(0.5, 0)
toast.Visible = false
toast.ZIndex = 12
limit(toast, 400, 31)
local toastText = label(toast, "", yellow, UDim2.new(1, -18, 1, 0), UDim2.fromOffset(9, 0), 12, heavy)
local toastVersion = 0
local function notice(message)
	if typeof(message) ~= "string" or message == "" then return end
	toastVersion += 1
	local current = toastVersion
	toastText.Text = message
	toast.Visible = true
	task.delay(1.9, function()
		if current == toastVersion then toast.Visible = false end
	end)
end

local draft = frame(root, ink, UDim2.new(1, -24, 0, 233), UDim2.fromScale(0.5, 0.5), 7)
draft.AnchorPoint = Vector2.new(0.5, 0.5)
draft.ZIndex = 11
draft.Visible = false
limit(draft, 400, 233)
local draftScale = Instance.new("UIScale")
draftScale.Parent = draft
bubblePanel(draft)
frame(draft, yellow, UDim2.new(1, 0, 0, 4), nil, 2)
left(label(draft, "MAP DRAW", yellow, UDim2.new(1, -120, 0, 24), UDim2.fromOffset(12, 10), 18, heavy))
local draftCounter = label(draft, "", paper, UDim2.fromOffset(71, 24), UDim2.new(1, -82, 0, 11), 13, digits)
draftCounter.TextXAlignment = Enum.TextXAlignment.Right
local reel = frame(draft, charcoal, UDim2.new(1, -24, 0, 47), UDim2.fromOffset(12, 39), 4)
reel.ClipsDescendants = true
frame(reel, paper, UDim2.new(1, 0, 0, 25), UDim2.fromOffset(0, 11))
local reelNames = {}
for index = 1, 3 do
	reelNames[index] = label(reel, "", ink, UDim2.new(1, -16, 0, 25), UDim2.fromOffset(8, 11), 15, heavy)
end
local picks = {}
for index = 1, 5 do
	local row = frame(draft, charcoal, UDim2.new(1, -24, 0, 23), UDim2.fromOffset(12, 93 + (index - 1) * 26), 3)
	local heat = left(label(row, ("H%02d"):format(index), yellow, UDim2.fromOffset(26, 23), UDim2.fromOffset(6, 0), 11, digits))
	local name = left(label(row, "", paper, UDim2.new(1, -108, 1, 0), UDim2.fromOffset(35, 0), 12, heavy))
	local rating = label(row, "", lime, UDim2.fromOffset(68, 23), UDim2.new(1, -73, 0, 0), 10, digits)
	rating.TextXAlignment = Enum.TextXAlignment.Right
	picks[index] = {row = row, heat = heat, name = name, rating = rating}
end

local lastDraftStart, shownPicks = nil, 0
local function updateDraft(current)
	local maps = state.maps
	draft.Visible = state.stage == "Draft" and state.room == true and maps ~= nil and #maps > 0
	if not draft.Visible then return end
	draftScale.Scale = math.clamp((root.AbsoluteSize.Y - 16) / 233, 0.65, 1)
	local started = state.draftStarted or state.deadline - 8
	if started ~= lastDraftStart then
		lastDraftStart = started
		shownPicks = 0
	end
	local cadence = math.max((state.deadline - started) * 0.91 / #maps, 0.1)
	local elapsed = math.max(current - started, 0)
	local heat = math.min(math.floor(elapsed / cadence) + 1, #maps)
	local ratio = math.clamp((elapsed - (heat - 1) * cadence) / (cadence * 0.75), 0, 1)
	local settled = (ratio >= 1 or reducedMotion) and heat or heat - 1
	local steps = 10
	local offset = reducedMotion and steps or (1 - (1 - ratio) ^ 2.5) * steps
	local step = math.floor(offset)
	for index, name in ipairs(reelNames) do
		local ticket = step + index - 2
		local candidate = (heat * 7 + ticket * 3) % #Levels + 1
		if ticket >= steps then candidate = maps[heat] end
		local item = Levels[candidate]
		local y = 11 + (index - 2 - (offset - step)) * 25
		name.Position = UDim2.fromOffset(8, y)
		name.Text = item and item.name or ""
		name.TextColor3 = math.abs(y - 11) < 13 and ink or paper
	end
	draftCounter.Text = ("%02d / %02d"):format(settled, #maps)
	for index, card in ipairs(picks) do
		local item = Levels[maps[index]]
		local picked = index <= settled and item ~= nil
		card.row.Visible = item ~= nil
		card.row.BackgroundColor3 = if picked then (worldColors[item.worldKey] or yellow):Lerp(paper,0.66) elseif index == heat then cream else charcoal
		card.heat.TextColor3 = if picked or index == heat then ink else yellow
		card.name.TextColor3 = if picked or index == heat then ink else paper
		card.rating.TextColor3 = ink
		card.name.Text = if picked then item.name elseif index == heat then "Drawing…" else "—"
		card.rating.Text = if picked then string.upper(item.rating or "") else ""
	end
	if settled > shownPicks then
		shownPicks = settled
		Audio.play("Click")
	end
end

local shove = button(root, "SHOVE", rust, ink, function() fire("shove") end)
shove.AnchorPoint = Vector2.new(1, 0.5)
shove.Position = UDim2.new(1, -14, 0.60, 0)
shove.Size = UDim2.fromOffset(92, 51)
shove.Visible = false
outline(shove, ink, 1.5)

local watchLive = button(root,"WATCH RACE",lime,ink,function()
	if state.spectate and state.spectate[1] then SocialUI.request("spectate",state.spectate[1]) end
end)
watchLive.AnchorPoint = Vector2.new(0.5,1)
watchLive.Position = UDim2.new(0.5,0,1,-128)
watchLive.Size = UDim2.fromOffset(128,42)
watchLive.Visible = false

local practiceExit = button(root, "LEAVE ADVENTURE", ink, paper, function() fire("lobby") end)
practiceExit.AnchorPoint = Vector2.new(0.5, 1)
practiceExit.Position = UDim2.new(0.5, 0, 1, -14)
practiceExit.Size = UDim2.fromOffset(132, 34)
practiceExit.Visible = false

local resultOpen = button(root, "RESULTS", yellow, ink, function() setTab("Results") end)
resultOpen.AnchorPoint = Vector2.new(0.5, 1)
resultOpen.Position = UDim2.new(0.5, 0, 1, -14)
resultOpen.Size = UDim2.fromOffset(106, 36)
resultOpen.Visible = false

ContextActionService:BindAction("CourierShove", function(_, status)
	if not shove.Visible then return Enum.ContextActionResult.Pass end
	if status == Enum.UserInputState.Begin then fire("shove") end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonX)

local modal = frame(root, nil, UDim2.fromScale(1, 1))
modal.ZIndex = 10
modal.Visible = false
local shade = frame(modal, ink, UDim2.fromScale(1, 1))
shade.BackgroundTransparency = 0.31
shade.Active = true
local panel = frame(modal, paper, UDim2.new(1, -26, 0, 240), UDim2.fromScale(0.5, 0.5), 7)
panel.AnchorPoint = Vector2.new(0.5, 0.5)
limit(panel, 610, 655)
bubblePanel(panel)
local panelStripe = frame(panel, yellow, UDim2.new(1, -16, 0, 43), UDim2.fromOffset(8, 7), 11)
outline(panelStripe, ink, 1.5)
local panelTitle = left(label(panel, "", ink, UDim2.new(1, -72, 0, 47), UDim2.fromOffset(20, 5), 25, heavy))
local close = button(panel, "✕", cream, ink, function() setTab(nil) end)
close.Size = UDim2.fromOffset(43, 42)
close.Position = UDim2.new(1, -53, 0, 8)
close.TextSize = 17

local list = Instance.new("ScrollingFrame")
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.Position = UDim2.fromOffset(13, 54)
list.Size = UDim2.new(1, -26, 1, -67)
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.CanvasSize = UDim2.new()
list.ScrollBarThickness = 4
list.ScrollBarImageColor3 = muted
list.Parent = panel
local layout = Instance.new("UIListLayout")
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Padding = UDim.new(0, 6)
layout.Parent = list

local function resizePanel()
	local viewportHeight = root.AbsoluteSize.Y
	if viewportHeight == 0 or not modal.Visible then return end
	panel.Size = UDim2.new(1, -26, 0, math.min(layout.AbsoluteContentSize.Y + 70, viewportHeight - 20, 655))
end
layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resizePanel)
root:GetPropertyChangedSignal("AbsoluteSize"):Connect(resizePanel)

local rowOrder = 0
local function append(instance)
	rowOrder += 1
	instance.LayoutOrder = rowOrder
	return instance
end

local function row(text, color, size, font, height)
	return append(left(label(list, text, color or ink, UDim2.new(1, -9, 0, height or 28), UDim2.new(), size or 14, font)))
end

local function listButton(text, color, textColor, callback)
	local instance = append(button(list, text, color, textColor, callback))
	instance.Size = UDim2.new(1, -7, 0, 44)
	return instance
end

local function eggPreview(parent, skin, size, position, background)
	local view = Instance.new("ViewportFrame")
	view.BackgroundColor3 = background or rgb("ddd1fe")
	view.BorderSizePixel = 0
	view.Ambient = rgb("dfdcff")
	view.LightColor = paper
	view.LightDirection = Vector3.new(-1,-1,-1)
	view.Size, view.Position = size, position
	corner(view,11)
	view.Parent = parent
	local camera = Instance.new("Camera")
	camera.CFrame = CFrame.lookAt(Vector3.new(1.68,0.63,4.5),Vector3.zero)
	camera.FieldOfView = 42
	camera.Parent = view
	view.CurrentCamera = camera
	local ok, shell = pcall(Egg.build, skin, 1.4, true)
	if ok then shell.Parent = view end
	return view
end

local function uiContext()
	return {
		list=list, row=row, append=append, listButton=listButton, frame=frame, label=label, left=left, button=button,
		outline=outline, corner=corner, eggPreview=eggPreview,
		ink=ink, charcoal=charcoal, paper=paper, cream=cream, yellow=yellow, lime=lime, muted=muted, heavy=heavy, digits=digits,
		profile=profile, state=state, reducedMotion=reducedMotion, worldKey=worldKey,
		economy=Economy, season=Season, levels=Levels, config=Config, cosmetics=Cosmetics, rules=Rules,
		send=fire, navigate=setTab, close=function() setTab(nil) end,
		selectWorld=function(key)
			worldKey = key
			setTab("Courses")
		end,
	}
end

local function showCourses() Atlas.render(uiContext()) end
local function showSeason() ProgressUI.season(uiContext()) end
local function showCartons() ProgressUI.cartons(uiContext()) end
local function showCollectors() ProgressUI.collectors(uiContext()) end
local function showQuests() ProgressUI.quests(uiContext()) end
local function showFriends() SocialUI.render("Friends", uiContext()) end
local function showMuseum() SocialUI.render("Museum", uiContext()) end

local function showShop()
	local options = append(frame(list,nil,UDim2.new(1,-7,0,47)))
	local boxes = button(options,"◒  CARTONS",yellow,ink,function() setTab("Cartons") end)
	boxes.Size = UDim2.new(0.5,-5,1,0)
	local styles = button(options,"✦  CUSTOMIZE",cream,ink,function() setTab("Customize") end)
	styles.Size, styles.Position = UDim2.new(0.5,-5,1,0),UDim2.new(0.5,5,0,0)
	append(EggJournal.render(list,{
		profile=profile, send=fire, reducedMotion=reducedMotion, navigate=setTab,
		close=function() setTab(nil) end, rerender=draw,
	}))
end

local function showCustomize()
	local legacy = profile.legacyCoins or 0
	if legacy > 0 then
		row(("%d carried-over coins for trails"):format(legacy),muted,13,digits,27)
	end
	for _, category in {
		{key="trail", items=profile.trails, current=profile.trail, name="Trails"},
		{key="accessory", items=profile.accessories, current=profile.accessory, name="Egg accessories"},
		{key="victory", items=profile.victories, current=profile.victory, name="Victory animations"},
		{key="banner", items=profile.banners, current=profile.banner, name="Profile banners"},
		{key="title", items=profile.titlesOwned, current=profile.customTitle, name="Season titles"},
	} do
		row(category.name,ink,17,heavy,40)
		if category.key ~= "title" and category.current and category.current ~= "" then
			listButton("Remove equipped " .. category.key,cream,ink,function() fire(category.key,"") end)
		end
		local ids = {}
		for id, owned in category.items or {} do
			if owned then table.insert(ids,id) end
		end
		table.sort(ids)
		for _, id in ipairs(ids) do
			local name = string.gsub(id,"[_%-]"," ")
			listButton(name .. (category.current == id and " · Equipped" or ""),cream,ink,function() fire(category.key,id) end)
		end
		if category.key == "trail" then
			local available = {"Lightning","Rainbow"}
			for _, id in ipairs(available) do
				if not (category.items and category.items[id]) and Config.trails[id] then
					listButton(("%s trail  ·  %d coins"):format(id,Config.trails[id]),cream,ink,function() fire("trail",id) end)
				end
			end
		elseif #ids == 0 then
			row("Discover these through play and the Season Pass.",muted,12,nil,31)
		end
	end
end

local function showPlay()
	local hero = append(frame(list,ink,UDim2.new(1,-7,0,123),nil,12))
	outline(hero,ink,2)
	local skin = Cosmetics.byId[profile.skin] or Cosmetics.byId.Classic
	local viewport = eggPreview(hero,skin.id,UDim2.new(0.32,-10,1,-14),UDim2.fromOffset(7,7),lime)
	if not reducedMotion then
		task.spawn(function()
			while viewport.Parent and viewport:IsDescendantOf(list) do
				local camera = viewport.CurrentCamera
				local angle = now()*0.95
				camera.CFrame = CFrame.lookAt(Vector3.new(math.sin(angle)*4.1,0.68,math.cos(angle)*4.1),Vector3.zero)
				task.wait(0.07)
			end
		end)
	end
	left(label(hero,"Ready, courier?",yellow,UDim2.new(0.68,-18,0,35),UDim2.new(0.32,8,0,16),23,heavy))
	local premise = left(label(hero,"Reach the finish with your egg intact.",paper,
		UDim2.new(0.68,-18,0,48),UDim2.new(0.32,8,0,55),14))
	premise.TextWrapped = true
	for _, mode in {
		{title="EGG ROYALE", desc="Qualify across five rounds to become champion.", action="queue", color=yellow},
		{title="QUICK RACE", desc="One competitive race, start to finish.", action="quick", color=lime},
		{title="ADVENTURE MODE", desc="Explore courses and earn medals and relics.", color=cream},
	} do
		local card = append(frame(list,mode.color,UDim2.new(1,-7,0,90),nil,11))
		outline(card,ink,1.8)
		local option = button(card,mode.title,ink,paper,function()
			if mode.action then fire(mode.action); setTab(nil) else setTab("Courses") end
		end)
		option.Size, option.Position = UDim2.new(1,-14,0,43),UDim2.fromOffset(7,7)
		option.TextSize = 17
		local summary = label(card,mode.desc,ink,UDim2.new(1,-20,0,32),UDim2.fromOffset(10,53),12)
		summary.TextWrapped = true
	end
end

local function showMore()
	for _, item in {
		{"◒   Cartons","Cartons",yellow}, {"◎   Friends","Friends",lime}, {"✦   Quests","Quests",cream},
		{"★   Records","Stats",yellow}, {"◆   Egg Museum","Museum",lime}, {"⚙   Settings","Settings",cream},
	} do
		listButton(item[1],item[3],ink,function()
			if item[2] == "Museum" then SocialUI.openMuseum() else setTab(item[2]) end
		end)
	end
end

local function showStats()
	local wins = profile.championships or player:GetAttribute("Wins") or 0
	row(("%d championships  ·  %d finishes"):format(wins,profile.deliveries or 0), ink, 16, digits, 33)
	row(("%d Egg Coins  ·  %d Courier XP"):format(profile.coins or 0,profile.xp or 0),muted,13,digits,26)
	listButton("My Egg Museum",lime,ink,function() SocialUI.openMuseum() end)
	local earned = (profile.wins or player:GetAttribute("Wins") or 0) >= 1
	local proof = append(frame(list, ink, UDim2.new(1, -7, 0, 74), nil, 6))
	local insignia = frame(proof, earned and winnerRed or charcoal, UDim2.fromOffset(24, 33), UDim2.fromOffset(14, 19), 12)
	outline(insignia, earned and paper or muted, 1.5)
	insignia.Rotation = 14
	local textWidth = earned and -145 or -56
	left(label(proof, "Winner aura", paper, UDim2.new(1, textWidth, 0, 23), UDim2.fromOffset(48, 10), 15, heavy))
	local status = earned and "UNLOCKED" or "WIN TO UNLOCK"
	left(label(proof, status, earned and winnerRed or cream, UDim2.new(1, textWidth, 0, 21), UDim2.fromOffset(48, 39), 12, digits))
	if earned then
		local equipped = player:GetAttribute("WinnerAura") ~= false
		auraToggle = button(proof, equipped and "AURA ON" or "AURA OFF", equipped and winnerRed or charcoal, equipped and ink or paper, function()
			fire("aura")
		end)
		auraToggle.Size = UDim2.fromOffset(76, 39)
		auraToggle.Position = UDim2.new(1, -87, 0, 17)
		auraToggle.TextSize = 11
	end
	for index, title in Config.titles do
		if index < 5 and (player:GetAttribute("XP") or 0) >= Config.titleXP[index] then
			listButton(title .. (profile.title == index and "  ✓" or ""), cream, ink, function() fire("title", tostring(index)) end)
		else
			row(title .. (index == 5 and "   /   World 4 reward" or ("   /   %d XP"):format(Config.titleXP[index])), muted, 12)
		end
	end
	for index, course in ipairs(Levels) do
		local record = profile.records and profile.records[Rules.recordKey(index)]
		local medal = profile.medals and profile.medals[tostring(index)]
		local detail = if typeof(medal) == "string" then "  ·  " .. medal else ""
		if record then row(("%s  ·  %.2fs%s"):format(course.name, record,detail), ink, 13, digits) end
	end
end

local function showSettings()
	listButton(reducedMotion and "Reduced motion: On" or "Reduced motion: Off",cream,ink,function()
		reducedMotion = not reducedMotion
		Cinematics.setReducedMotion(reducedMotion)
		draw()
	end)
	for _, key in {"music", "effects"} do
		local caption = key == "music" and "Music" or "Sound effects"
		local control
		local function refresh()
			control.Text = ("%s   /   %d%%"):format(caption, math.round(Audio[key] * 100))
		end
		control = listButton("", cream, ink, function()
			Audio[key] = if Audio[key] >= 0.99 then 0 elseif Audio[key] == 0 then 0.25 else math.min(1, Audio[key] + 0.25)
			Audio.setLobby(not state.racing)
			refresh()
		end)
		refresh()
	end
end

local function showResults()
	local result = state.result
	if result then
		local finished = not result.out and not result.dnf
		local champion = result.champion == true
		local card = append(frame(list, ink, UDim2.new(1, -7, 0, 95), nil, 6))
		local place = if champion then "WIN" elseif finished then ("%02d"):format(result.place or 1) else "OUT"
		local highlight = if champion then winnerRed elseif finished then lime else rust
		label(card, place, highlight, UDim2.fromOffset(103, 89), UDim2.fromOffset(3, 1), 39, heavy)
		frame(card, charcoal, UDim2.fromOffset(1, 62), UDim2.fromOffset(106, 16))
		local headline
		if champion then headline = "CHAMPION"
		elseif result.practice and finished then headline = "ADVENTURE CLEAR"
		elseif finished and result.advanced then headline = "QUALIFIED"
		elseif finished then headline = "FINISHED"
		else headline = "ELIMINATED" end
		left(label(card, headline, paper, UDim2.new(1, -129, 0, 23), UDim2.fromOffset(119, 10), 16, heavy))
		local summary
		if finished and result.completed ~= false and result.time then
			summary = ("%.2fs     +%d coins"):format(result.time, result.coins or 0)
		elseif champion then
			summary = ("+%d coins"):format(result.coins or 0)
		else
			summary = ("%d%% of course"):format(math.floor((result.progress or 0) * 100))
		end
		left(label(card, summary, paper, UDim2.new(1, -129, 0, 22), UDim2.fromOffset(119, 35), 14, digits))
		local detail = if champion then result.reason or "TOURNAMENT WON"
			elseif finished then result.record and "PERSONAL BEST" or ("SHELL %d / 3"):format(result.hp or 0)
			else result.reason or "Time expired"
		local reason = left(label(card, detail, highlight, UDim2.new(1, -125, 0, 25), UDim2.fromOffset(119, 61), 11, heavy))
		reason.TextWrapped = true
		reason.TextTruncate = Enum.TextTruncate.None
	end
	if result and result.completed then
		if result.perfect then row("CLEAN DELIVERY · No hits", ink, 12, heavy, 24) end
		if result.previousBest and result.time then
			local delta = result.time - result.previousBest
			row(("PERSONAL BEST PACE   %+.2fs"):format(delta), ink, 12, digits, 24)
		end
		if result.medal then row("MEDAL  ·  " .. tostring(result.medal),ink,13,heavy,27) end
	end
	if result and result.tournamentPlace and result.tournamentPlace > 1 then
		row(("FINAL PLACE %d  ·  +%d EGG COINS"):format(result.tournamentPlace,result.coins or 0),ink,13,heavy,31)
	end
	if result and (result.xp or 0) > 0 then
		row(("+%d Pass XP"):format(result.xp),ink,13,heavy,26)
	end
	if result and not result.completed and (result.coins or 0) > 0 then
		row(("+%d Egg Coins"):format(result.coins),ink,13,heavy,26)
	end
	local winner = state.championship
	if winner then append(ChampionshipView.render(list,winner)) end
	if result and result.tournamentPlace then
		row(("TOURNAMENT PLACEMENT  ·  #%d"):format(result.tournamentPlace),ink,13,heavy,27)
	end

	local advanced = result and result.advanced and not result.champion
	if advanced then
		advanceNote = row("", ink, 12, digits, 28)
		local nextIndex = state.maps and state.maps[(state.heat or 1)+1]
		local upcoming = nextIndex and Levels[nextIndex]
		if upcoming then
			local tint = (worldColors[upcoming.worldKey] or yellow):Lerp(paper,0.56)
			local ribbon = append(frame(list,tint,UDim2.new(1,-7,0,63),nil,9))
			outline(ribbon,ink,1.5)
			left(label(ribbon,"UP NEXT  ·  " .. (upcoming.island or "Championship"),ink,UDim2.new(1,-22,0,21),UDim2.fromOffset(11,6),11,digits))
			left(label(ribbon,upcoming.name,ink,UDim2.new(1,-22,0,27),UDim2.fromOffset(11,29),17,heavy))
		end
	end
	if state.stage == "Race" and (not state.racing or result) and state.spectate and state.spectate[1] then
		listButton("Watch the race",lime,ink,function() SocialUI.request("spectate",state.spectate[1]) end)
	end
	local standingRows = state.standings or state.scoreboard or {}
	if #standingRows > 0 then
		local qualified = 0
		for _, entry in ipairs(standingRows) do
			if entry.status == "Qualified" then qualified += 1 end
		end
		local title = if state.tournament and state.stage == "Results" and not state.duel
			then ("%d racers advance"):format(qualified)
			else "Race standings"
		row(title,ink,15,heavy,29)
	end
	for _, entry in ipairs(standingRows) do
		local status = entry.status or "Finished"
		local accent = if status == "Eliminated" then rust elseif status == "Champion" then yellow elseif status == "Qualified" then lime else cream
		local standing = append(frame(list,accent,UDim2.new(1,-7,0,38),nil,8))
		if entry.userId then
			local portrait = Instance.new("ImageLabel")
			portrait.Size = UDim2.fromOffset(29,29)
			portrait.Position = UDim2.fromOffset(5,4)
			portrait.BackgroundTransparency = 1
			portrait.Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(entry.userId)
			portrait.Parent = standing
			corner(portrait,9)
		end
		local rank = entry.place and ("%02d  "):format(entry.place) or ""
		left(label(standing,rank .. (entry.name or "Courier"),ink,UDim2.new(1,-136,1,0),UDim2.fromOffset(41,0),12,heavy))
		label(standing,status,ink,UDim2.fromOffset(88,38),UDim2.new(1,-93,0,0),11,digits)
	end
	if not advanced then
		local actions = append(frame(list, nil, UDim2.new(1, -7, 0, 40)))
		local replay = button(actions, state.mode == "adventure" and "RETRY ADVENTURE" or "QUEUE AGAIN", yellow, ink, function()
			if state.mode == "adventure" then fire("practice",tostring(state.level))
			else fire("next",state.mode == "quick" and "quick" or "royale") end
			setTab(nil)
		end)
		replay.Size = UDim2.new(0.54, -4, 1, 0)
		local lobby = button(actions, "BACK TO HUB", cream, ink, function() fire("lobby"); setTab(nil) end)
		lobby.Size = UDim2.new(0.46, -4, 1, 0)
		lobby.Position = UDim2.new(0.54, 4, 0, 0)
	end
end

local tabs = {
	Play = {title="Ready to race?", color=yellow, render=showPlay},
	More = {title="Courier menu", color=yellow, render=showMore},
	Season = {title="Season Pass", color=yellow, render=showSeason},
	Cartons = {title="Egg Cartons", color=yellow, render=showCartons},
	Collectors = {title="Collector Cartons", color=cream, render=showCollectors},
	Customize = {title="Customize", color=lime, render=showCustomize},
	Quests = {title="Quest Journal", color=lime, render=showQuests},
	Friends = {title="Friends and Parties", color=lime, render=showFriends},
	Museum = {title="Egg Museum", color=lime, render=showMuseum},
	Courses = {title = "Adventure Atlas", color = lime, render = showCourses},
	Shop = {title = "Egg Encyclopedia", color = yellow, render = showShop},
	Stats = {title = "Courier record", color = lime, render = showStats},
	Settings = {title = "Settings", color = cream, render = showSettings},
	Results = {title = "Heat results", color = rust, render = showResults},
}

draw = function()
	for _, child in list:GetChildren() do
		if child ~= layout then child:Destroy() end
	end
	rowOrder = 0
	advanceNote = nil
	auraToggle = nil
	modal.Visible = tab ~= nil
	dock.Visible = showDock()
	resultOpen.Visible = tab == nil and hasResult()
	if not tab then return end
	local sheet = tabs[tab]
	panelTitle.Text = if tab == "Results" and state.tournament and state.heat then
		if state.duel then "Championship results" else ("Round %d results"):format(state.heat)
		else sheet.title
	panelStripe.BackgroundColor3 = tab == "Results" and state.result and state.result.champion and winnerRed or sheet.color
	sheet.render()
	task.defer(resizePanel)
end

setTab = function(name)
	if name and not tabs[name] then return end
	local previous = tab
	tab = name
	draw()
	list.CanvasPosition = Vector2.zero
	if isGamepad() or GuiService.SelectedObject then
		GuiService.SelectedObject = if name then close elseif dock.Visible then play elseif state.result then resultOpen else nil
	end
	if (name == "Friends" or name == "Museum") and previous ~= name then SocialUI.request("refresh") end
end

SocialUI.bind({
	redraw=function() if tab == "Friends" or tab == "Museum" then draw() end end,
	notify=notice,
	close=function() setTab(nil) end,
	openMuseum=function() setTab("Museum") end,
	currentCourse=function() return state.selected or 1 end,
})

local function refreshAura()
	if tab ~= "Stats" then return end
	local scrolled = list.CanvasPosition
	local toggled = auraToggle and GuiService.SelectedObject == auraToggle
	draw()
	list.CanvasPosition = scrolled
	if toggled then GuiService.SelectedObject = auraToggle or close end
end
player:GetAttributeChangedSignal("WinnerAura"):Connect(refreshAura)
player:GetAttributeChangedSignal("Wins"):Connect(refreshAura)

local function confetti()
	if reducedMotion then return end
	for index = 1, 19 do
		local color = ({yellow, lime, rust})[index % 3 + 1]
		local bit = frame(root, color, UDim2.fromOffset(6, 9), UDim2.fromScale(0.5, 0.43))
		bit.ZIndex = 9
		bit.Rotation = index * 37
		TweenService:Create(bit, TweenInfo.new(0.8 + index % 4 * 0.12, Enum.EasingStyle.Quad), {
			Position = UDim2.fromScale(0.5 + math.cos(index) * 0.49, 0.49 + math.sin(index) * 0.41),
			Rotation = index * 74,
			BackgroundTransparency = 1,
		}):Play()
		Debris:AddItem(bit, 1.3)
	end
end

local fade = frame(root, ink, UDim2.fromScale(1, 1))
fade.BackgroundTransparency = 1
fade.ZIndex = 20
local function transition()
	if reducedMotion then return end
	fade.BackgroundTransparency = 0.11
	TweenService:Create(fade, TweenInfo.new(0.36, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
end

local lastCount, showGo, finishBanner, finishMessage = nil, 0, 0, ""
remote.OnClientEvent:Connect(function(kind, value, extra)
	if kind == "State" then
		local before = state
		state = value
		if state.racing and not before.racing then SocialUI.stop() end
		Cinematics.update(state,before)
		if state.racing and state.stage ~= before.stage and (state.stage == "Preparation" or state.stage == "Returning") then transition() end
		if state.stage == "Preparation" and before.stage ~= "Preparation" then
			race = {hp = 3, place = 1, total = state.total, progress = 0, cooldown = 0, recover = 0}
			lastCount = nil
		elseif state.stage == "Race" and before.stage == "Countdown" and state.racing then
			showGo = now() + 0.65
			Audio.play("Start")
		end
		local course = Levels[state.level]
		Audio.setScene(course and course.worldKey,state.racing)
		if state.stage == "Returning" or (tab == "Results" and not hasResult()) or (state.room and state.stage == "Draft" and tab) then
			setTab(nil)
		elseif hasResult() and ((state.result and (not before.result or before.result.champion ~= state.result.champion))
			or (state.stage == "Results" and before.stage ~= "Results")) then
			setTab("Results")
		elseif state.racing and not state.result and tab then
			setTab(nil)
		elseif (tab == "Results" and state.stage == "Results" and before.standings ~= state.standings)
			or (tab == "Courses" and before.selected ~= state.selected) then
			local position = list.CanvasPosition
			draw()
			list.CanvasPosition = position
		else
			dock.Visible = showDock()
		end
	elseif kind == "Race" then
		if value.zone and not race.zone and not state.practice and not state.solo then notice("CRACK ZONE · SHOVES LIVE") end
		race = value
	elseif kind == "Profile" then
		profile = value
		if tab and tab ~= "Results" and tab ~= "Settings" and tab ~= "Play" and tab ~= "More" then
			local position = list.CanvasPosition
			local selected = GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(list)
			draw()
			list.CanvasPosition = position
			if selected then GuiService.SelectedObject = close end
		end
	elseif kind == "Open" then
		setTab(value)
	elseif kind == "Notice" then
		notice(value)
	elseif kind == "BoxReward" then
		if typeof(value) == "table" then
			CartonReveal.show(gui,{
				id=value.id, name=value.name, rewards=value.eggs or value.rewards, extras=value.extras,
			},{reducedMotion=reducedMotion,send=fire,onCollection=function() setTab("Shop") end})
		end
	elseif kind == "Pass" then
		local ok = pcall(MarketplaceService.PromptGamePassPurchase, MarketplaceService, player, value)
		if not ok then notice("Purchase prompt unavailable") end
	elseif kind == "FX" then
		Audio.play(value)
		if value == "Crack" or value == "Break" then
			tint.BackgroundTransparency = 0.65
			TweenService:Create(tint, TweenInfo.new(0.32), {BackgroundTransparency = 1}):Play()
			notice(if value == "Break" then "SHELL BROKEN" elseif extra == 1 then "ONE HIT LEFT" else "SHELL CRACKED")
		elseif value == "Out" then
			notice(if typeof(extra) == "string" then extra else "ELIMINATED")
		elseif value == "Restart" then
			notice(extra and "BACK TO YOUR CHECKPOINT" or "BACK TO THE START")
		elseif value == "Checkpoint" then
			notice(("CHECKPOINT %d SAVED"):format(extra))
		elseif value == "Relic" then
			notice("RELIC DISCOVERED")
		elseif value == "Finish" then
			confetti()
			finishBanner = now() + 1.9
			finishMessage = if extra and extra.champion then "CHAMPION!" elseif extra and extra.advanced then "QUALIFIED!" else "FINISH!"
			if extra and (extra.coins or 0) > 0 then Audio.play("Coins") end
			if extra and extra.champion then Audio.play("Victory") end
		end
	end
end)

local queueText = {
	Lobby = "RACE QUEUE",
	Intermission = "QUEUE CLOSES IN %s",
	Draft = "NEXT TOURNAMENT",
	Preparation = "NEXT TOURNAMENT",
	Countdown = "NEXT TOURNAMENT",
	Race = "NEXT TOURNAMENT",
	Results = "NEXT TOURNAMENT",
	Returning = "RACE QUEUE",
}
local function updateHud(current)
	banner.ZIndex = 1
	local racing = state.racing and not state.result and (state.stage == "Race" or state.stage == "Countdown" or state.stage == "Preparation")
	local leftSeconds = state.deadline - current
	updateDraft(current)
	local waiting = state.room == true and not racing and not draft.Visible and not modal.Visible
	local announcement = not state.room and state.stage == "Results" and typeof(state.victor) == "string" and not modal.Visible
	staging.Visible = waiting or announcement
	if announcement then
		stagingTitle.Text = "TOURNAMENT CHAMPION"
		stagingBody.Text = state.victor
	elseif waiting then
		stagingTitle.Text = state.result and state.result.advanced and "QUALIFIED" or "TOURNAMENT"
		stagingBody.Text = state.result and "CHECK YOUR RESULTS" or "WAITING FOR THE NEXT HEAT"
	end
	if advanceNote then
		local nextHeat = heatName((state.heat or 1) + 1)
		advanceNote.Text = if state.stage == "Results" then ("%s IN %s"):format(nextHeat, clock(leftSeconds)) else ("%s · WAITING FOR FINISH"):format(nextHeat)
	end

	hud.Visible = racing
	wallet.Visible = not state.racing and not state.room and not modal.Visible
	local balance = profile.coins or player:GetAttribute("Coins") or 0
	coinCount.Text = tostring(balance)
	local queued = state.queued or state.practiceQueued
	play.Text = queued and "CANCEL QUEUE" or "▶  PLAY"
	queueStatus.Visible = showDock()
	local population = ("%02d / %02d"):format(state.queuedCount or 0, state.capacity or 15)
	local queueState = (queueText[state.stage] or queueText.Lobby):format(clock(leftSeconds))
	queueStatus.Text = if state.practiceQueued then "ADVENTURE QUEUED"
		elseif queued then queueState .. "  ·  " .. population
		else ""
	practiceExit.Visible = racing and state.practice == true and not modal.Visible
	resultOpen.Visible = hasResult() and not modal.Visible
	watchLive.Visible = (not racing and not modal.Visible and not hasResult() and state.stage == "Race"
		and state.spectate ~= nil and #state.spectate > 0)
	if racing then
		courseName.Text = Levels[state.level].name
		raceHeat.Text = if state.practice then "ADVENTURE MODE"
			elseif state.solo then "TIME TRIAL"
			elseif state.tournament then heatName(state.heat or 1)
			else "QUICK RACE"
		raceTime.Text = clock(leftSeconds)
		raceTime.TextColor3 = leftSeconds < 12 and state.stage == "Race" and rust or yellow
		local slots = state.slots or race.slots or 0
		local filled = math.max(state.qualified or 0, race.qualified or 0)
		local percent = math.floor((race.progress or 0) * 100)
		position.Text = (state.practice or state.solo) and ("%d%%"):format(percent) or ("#%02d"):format(race.place)
		raceStatus.Text = if state.practice then "CHECKPOINTS ENABLED"
			elseif state.solo then ""
			elseif slots > 0 then ("%02d/%02d QUALIFIED  ·  %d OPEN"):format(filled, slots, math.max(0, slots - filled))
			else ("%d RACERS"):format(race.total)
		progressFill.Size = UDim2.fromScale(math.clamp(race.progress or 0, 0, 1), 1)
		for index, shell in ipairs(eggs) do
			shell.BackgroundColor3 = if index > race.hp then charcoal elseif race.hp == 1 then rust else paper
		end
	end

	local recover = race.recover or 0
	local shoveAvailable = racing and state.stage == "Race" and race.zone and not state.practice and not state.solo and recover <= current
	shove.Visible = shoveAvailable == true
	if shove.Visible then
		local cooldown = math.max(0, math.ceil((race.cooldown or 0) - current))
		shove.BackgroundColor3 = cooldown > 0 and charcoal or rust
		shove.TextColor3 = cooldown > 0 and paper or ink
		local input = UserInputService:GetLastInputType()
		shove.Text = if cooldown > 0 then ("%ds"):format(cooldown) elseif input == Enum.UserInputType.Touch then "SHOVE" elseif isGamepad() then "X  SHOVE" else "E  SHOVE"
	end
	banner.TextColor3 = paper
	if racing and state.stage == "Countdown" then
		local count = math.max(1, math.ceil(leftSeconds))
		banner.Visible = true
		banner.Text = tostring(count)
		local course = Levels[state.level]
		local world = course and Levels.worldByKey[course.worldKey]
		banner.TextColor3 = if world then rgb(world.accent) else paper
		banner.TextSize = 72
		if lastCount ~= count then
			lastCount = count
			Audio.play("Countdown")
		end
	elseif racing and current < showGo then
		banner.Visible = true
		banner.Text = "GO!"
		banner.TextSize = 72
	elseif racing and recover > current then
		banner.Visible = true
		banner.Text = ("CHECKPOINT IN %d"):format(math.ceil(recover - current))
		banner.TextSize = 28
	elseif current < finishBanner then
		banner.Visible = true
		banner.Text = finishMessage
		banner.TextSize = 43
		banner.ZIndex = 15
	else
		banner.Visible = false
	end
end

local elapsed = 0
RunService.RenderStepped:Connect(function(deltaTime)
	elapsed += deltaTime
	local current = now()
	for _, courier in Players:GetPlayers() do
		local character = courier.Character
		local characterRoot = character and character:FindFirstChild("HumanoidRootPart")
		local egg = character and character:FindFirstChild("CourierEgg")
		local shell = egg and egg.PrimaryPart
		local motor = shell and shell:FindFirstChild("EggMotor")
		if characterRoot and motor then
			local amplitude = reducedMotion and 0 or math.clamp(characterRoot.AssemblyLinearVelocity.Magnitude / 16, 0.2, 1)
			motor.Transform = CFrame.new(0, math.sin(current * 11) * 0.084 * amplitude, 0)
				* CFrame.Angles(math.sin(current * 6) * 0.12 * amplitude, 0, math.cos(current * 9) * 0.14 * amplitude)
			if egg:GetAttribute("Skin") == "Rainbow" then
				local rainbow = Color3.fromHSV((current % 4) / 4, 0.66, 1)
				shell.Color = rainbow
				local crown = egg:FindFirstChild("Crown")
				if crown then crown.Color = rainbow end
			end
		end
	end
	if elapsed >= 0.08 then
		elapsed = 0
		updateHud(current)
	end
end)

ContextActionService:BindAction("CourierCloseMenu", function(_, status)
	if not tab then return Enum.ContextActionResult.Pass end
	if status == Enum.UserInputState.Begin then setTab(nil) end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.ButtonB)

Audio.setLobby(true)
updateHud(now())
fire("hello")
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ProgressUI</string>
            <string name="Source"><![CDATA[local Marketplace = game:GetService("MarketplaceService")
local Atlas = require(script.Parent.AdventureAtlas)
local Pages = {}
local rgb = Color3.fromHex
local passPrices = {}

local function subtitle(ctx, text)
	local message = ctx.row(text, ctx.muted, 12, nil, 40)
	message.TextWrapped = true
	message.TextTruncate = Enum.TextTruncate.None
	return message
end

local function title(ctx, text)
	return ctx.row(text,ctx.ink,16,ctx.heavy,31)
end

local function longButton(ctx, text, color, callback)
	local control = ctx.listButton(text,color,ctx.ink,callback)
	control.Size = UDim2.new(1,-7,0,42)
	return control
end

local function shellName(ctx, id)
	local skin = ctx.cosmetics.byId[id]
	return skin and skin.name or id
end

local function addPrice(control, offer, pass)
	local price = passPrices[pass]
	if typeof(price) == "number" then
		control.Text = ("%s · %d Robux"):format(offer,price)
		return
	end
	task.spawn(function()
		local ok, details = pcall(Marketplace.GetProductInfo,Marketplace,pass,Enum.InfoType.GamePass)
		if ok and typeof(details) == "table" and typeof(details.PriceInRobux) == "number" and details.IsForSale ~= false then
			passPrices[pass] = details.PriceInRobux
		end
		if control.Parent then
			local loaded = passPrices[pass]
			control.Text = loaded and ("%s · %d Robux"):format(offer,loaded) or "View Roblox offer"
		end
	end)
end

local function passButton(ctx, offer, id, pass)
	if typeof(pass) ~= "number" or pass <= 0 then
		subtitle(ctx,"Preview only · This offer is currently unavailable.")
		return
	end
	local control = longButton(ctx, "View Roblox offer",ctx.yellow,function() ctx.send("premium",id) end)
	addPrice(control,offer,pass)
end

local function earnedCarton(ctx, carton)
	local profile = ctx.profile
	local pantry = profile.cartonCredits or {}
	local odds = ctx.economy.odds(carton, profile.skins)
	local credit = pantry[carton.id] or 0
	local accent = rgb(carton.color)
	local card = ctx.append(ctx.frame(ctx.list,accent,UDim2.new(1,-7,0,61),nil,10))
	ctx.outline(card,ctx.ink,1.6)
	local box = ctx.frame(card,ctx.paper,UDim2.fromOffset(46,37),UDim2.fromOffset(10,12),8)
	ctx.outline(box,ctx.ink,1.3)
	local lock = ctx.frame(box,accent,UDim2.fromOffset(29,5),UDim2.fromOffset(8,8),2)
	lock.Rotation = -8
	ctx.label(box,"◒  ◒",ctx.ink,UDim2.fromScale(1,1),UDim2.fromOffset(0,4),13,ctx.heavy)
	ctx.left(ctx.label(card,carton.name,ctx.ink,UDim2.new(1,-76,0,24),UDim2.fromOffset(65,8),18,ctx.heavy))
	local price = if carton.wins then "Championship reward" elseif credit > 0 then ("%d vouchers available"):format(credit) else ("%d earned Egg Coins"):format(carton.price)
	ctx.left(ctx.label(card,price,ctx.ink,UDim2.new(1,-76,0,18),UDim2.fromOffset(65,33),11,ctx.digits))

	if #odds == 0 then
		subtitle(ctx,"Collection complete.")
		return
	end
	local chance = {}
	local totalWeight = 0
	for _, offer in ipairs(odds) do totalWeight += offer.weight end
	for _, offer in ipairs(odds) do
		local skin = ctx.cosmetics.byId[offer.id]
		local description = if skin then ("%s · %s"):format(skin.name,skin.rarity) else shellName(ctx,offer.id)
		table.insert(chance,("%s  %.2f%% (%d/%d)"):format(description,offer.probability*100,offer.weight,totalWeight))
	end
	for _, text in ipairs(chance) do
		local chanceRow = ctx.row(text,ctx.ink,12,nil,27)
		chanceRow.TextWrapped = true
		chanceRow.TextTruncate = Enum.TextTruncate.None
	end
	local wins = profile.championships or 0
	local championReady = wins > (profile.championCartonsOpened or 0)
	local coins = profile.coins or 0
	local claim = credit > 0 or (carton.wins and championReady) or (not carton.wins and coins >= carton.price)
	if claim then
		local label = if credit > 0 then "Use voucher" elseif carton.wins then "Claim championship carton" else ("Open for %d Egg Coins"):format(carton.price)
		longButton(ctx,label,ctx.lime,function()
			ctx.send("carton",("%s|%d"):format(carton.id,profile.cartonRevision or 0))
		end)
	elseif carton.wins then
		subtitle(ctx,"Win Egg Royale to earn this carton.")
	else
		subtitle(ctx,("%d more Egg Coins to open."):format(carton.price - coins))
	end
end

function Pages.cartons(ctx)
	ctx.row(("%d earned Egg Coins"):format(ctx.profile.coins or 0),ctx.ink,17,ctx.heavy,34)
	longButton(ctx,"View Collector Cartons",ctx.cream,function() ctx.navigate("Collectors") end)
	subtitle(ctx,"Each opening gives one new egg. Percentages are rounded. Fractions show the exact odds.")
	for _, carton in ipairs(ctx.economy.cartons) do
		earnedCarton(ctx,carton)
	end
end

local function disclose(ctx, offer)
	title(ctx,offer.name)
	local allOwned = true
	for _, id in ipairs(offer.eggs or {}) do
		ctx.row(shellName(ctx,id),ctx.ink,13,nil,25)
		if not ctx.profile.skins[id] then allOwned = false end
	end
	local entitlements = ctx.profile.entitlements or {}
	for _, item in ipairs(offer.extras or {}) do
		ctx.row(item.name or item.id,ctx.ink,13,nil,25)
		if not entitlements[offer.id] then allOwned = false end
	end
	if allOwned then
		subtitle(ctx,"In your collection.")
	else
		passButton(ctx,"View Roblox offer",offer.id,offer.passId)
	end
end

function Pages.collectors(ctx)
	longButton(ctx,"← Earned Cartons",ctx.cream,function() ctx.navigate("Cartons") end)
	subtitle(ctx,"Collector Cartons include all the cosmetics listed below.")
	for _, carton in ipairs(ctx.economy.collectors) do disclose(ctx,carton) end
	if #(ctx.economy.directOffers or {}) > 0 then
		title(ctx,"Cosmetic offers")
		for _, offer in ipairs(ctx.economy.directOffers) do disclose(ctx,offer) end
	end
end

local rewardSigns = {coins="★", xp="✦", carton="◒", egg="◉", trail="↝", title="◆", cosmetic="◇"}
local rarityByKind = {coins="Common", xp="Common", carton="Rare", trail="Epic", title="Rare", accessory="Uncommon", victory="Epic", banner="Rare"}

local function rewardCard(ctx, parent, reward, reached, claimed, premium, ownedPremium, tier, rowY, width)
	local milestone = tier == #ctx.season.tiers or tier%5 == 0
	local fill = if premium then (milestone and rgb("ffe09a") or rgb("efe3d3")) else (milestone and rgb("b7f1d3") or ctx.cream)
	local card = ctx.frame(parent,fill,UDim2.fromOffset(width-10,107),UDim2.fromOffset(6,rowY),8)
	ctx.outline(card,ctx.ink,milestone and 2 or 1)
	local icon = rewardSigns[reward.kind] or "✦"
	ctx.label(card,icon,ctx.ink,UDim2.new(1,-12,0,24),UDim2.fromOffset(6,2),18,ctx.heavy)
	local text = ctx.label(card,reward.name or "Reward",ctx.ink,UDim2.new(1,-10,0,35),UDim2.fromOffset(5,24),11,ctx.heavy)
	text.TextWrapped = true
	text.TextTruncate = Enum.TextTruncate.None
	local skin = reward.kind == "egg" and ctx.cosmetics.byId[reward.id]
	local rarity = (skin and skin.rarity) or reward.rarity or rarityByKind[reward.kind] or "Special"
	ctx.label(card,rarity,ctx.muted,UDim2.new(1,-8,0,16),UDim2.fromOffset(4,62),10,ctx.digits)
	local status = if claimed then "Claimed"
		elseif not reached then "Locked"
		elseif premium and not ownedPremium then "Premium track"
		else "Ready to claim"
	ctx.label(card,status,ctx.ink,UDim2.new(1,-8,0,19),UDim2.fromOffset(4,81),10,ctx.digits)
end

local function seasonTrack(ctx, level, earned)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "SeasonRewardTracks"
	scroll.BackgroundColor3 = ctx.ink
	scroll.BorderSizePixel = 0
	scroll.Size = UDim2.new(1,-7,0,318)
	scroll.ScrollBarThickness = 8
	scroll.ScrollingDirection = Enum.ScrollingDirection.X
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.None
	scroll.ElasticBehavior = Enum.ElasticBehavior.WhenScrollable
	scroll.ClipsDescendants = true
	scroll.Parent = ctx.list
	ctx.corner(scroll,11)
	ctx.append(scroll)
	local coordinates = {}
	local x = 4
	for index in ipairs(ctx.season.tiers) do
		local width = (index%5 == 0) and 148 or 119
		coordinates[index] = {x=x,width=width}
		x += width
	end
	scroll.CanvasSize = UDim2.fromOffset(x+5,0)
	local visible = {}
	local freeClaims, premiumClaims = earned.claimedFree or {},earned.claimedPremium or {}
	local function updateVisibleTiers()
		local viewportLeft = scroll.CanvasPosition.X
		local viewportRight = viewportLeft + math.max(240,scroll.AbsoluteSize.X)
		for index, position in ipairs(coordinates) do
			local wanted = position.x < viewportRight+135 and position.x+position.width > viewportLeft-135
			local column = visible[index]
			if column and not wanted then
				column:Destroy()
				visible[index] = nil
			elseif wanted and not column then
				local tier = ctx.season.tiers[index]
				local width = position.width
				column = ctx.frame(scroll,nil,UDim2.fromOffset(width,300),UDim2.fromOffset(position.x,6))
				visible[index] = column
				local caption = if index%5 == 0 then ("TIER %02d ★"):format(index) else ("TIER %02d"):format(index)
				ctx.label(column,caption,ctx.paper,UDim2.new(1,-5,0,22),nil,12,ctx.heavy)
				ctx.label(column,"FREE",ctx.lime,UDim2.new(1,-5,0,19),UDim2.fromOffset(0,23),10,ctx.digits)
				ctx.label(column,"PREMIUM",ctx.yellow,UDim2.new(1,-5,0,19),UDim2.fromOffset(0,159),10,ctx.digits)
				rewardCard(ctx,column,tier.free,index<=level,freeClaims[tostring(index)] or freeClaims[index],false,true,index,44,width)
				rewardCard(ctx,column,tier.premium,index<=level,premiumClaims[tostring(index)] or premiumClaims[index],true,earned.premium,index,180,width)
			end
		end
	end
	scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(updateVisibleTiers)
	scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateVisibleTiers)
	updateVisibleTiers()
	local actions = ctx.append(ctx.frame(ctx.list,nil,UDim2.new(1,-7,0,43)))
	local back = ctx.button(actions,"← Earlier tiers",ctx.cream,ctx.ink,function()
		scroll.CanvasPosition -= Vector2.new(math.max(120,scroll.AbsoluteSize.X-25),0)
	end)
	back.Size = UDim2.new(0.5,-4,1,0)
	local forward = ctx.button(actions,"Later tiers →",ctx.cream,ctx.ink,function()
		scroll.CanvasPosition += Vector2.new(math.max(120,scroll.AbsoluteSize.X-25),0)
	end)
	forward.Size, forward.Position = UDim2.new(0.5,-4,1,0),UDim2.new(0.5,4,0,0)
	if coordinates[level] then
		longButton(ctx,"Jump to my tier",ctx.cream,function()
			scroll.CanvasPosition = Vector2.new(coordinates[level].x-4,0)
		end)
	end
end

function Pages.season(ctx)
	local earned = ctx.profile.season or {}
	local xp = earned.xp or 0
	local level = ctx.season.level(xp)
	local count = #ctx.season.tiers
	local hero = ctx.append(ctx.frame(ctx.list,ctx.ink,UDim2.new(1,-7,0,198),nil,12))
	ctx.outline(hero,ctx.ink,2)
	local world = ctx.levels.worlds[1]
	if world then
		Atlas.preview(hero,world,UDim2.new(1,-12,0,128),UDim2.fromOffset(6,6),true)
	end
	ctx.left(ctx.label(hero,("Season %d · %s"):format(ctx.season.number,ctx.season.name),ctx.paper,
		UDim2.new(1,-22,0,27),UDim2.fromOffset(11,136),17,ctx.heavy))
	local status = if level >= count then ("All %d tiers unlocked"):format(count) else ("%d of %d tiers · %d/%d XP to next tier"):format(level,count,xp%ctx.season.xpPerTier,ctx.season.xpPerTier)
	ctx.left(ctx.label(hero,status,ctx.paper,UDim2.new(1,-22,0,18),UDim2.fromOffset(11,161),11,ctx.digits))
	local meter = ctx.frame(hero,ctx.charcoal,UDim2.new(1,-22,0,7),UDim2.fromOffset(11,184),3)
	ctx.frame(meter,ctx.yellow,UDim2.fromScale(if level>=count then 1 else xp%ctx.season.xpPerTier/ctx.season.xpPerTier,1),nil,3)
	longButton(ctx,"Claim all unlocked rewards",ctx.lime,function() ctx.send("season","claim") end)
	seasonTrack(ctx,level,earned)
	local final = ctx.season.tiers[count]
	local grandEgg = final.premium.kind == "egg" and final.premium.id or final.free.kind == "egg" and final.free.id
	if grandEgg then
		local showcase = ctx.append(ctx.frame(ctx.list,ctx.cream,UDim2.new(1,-7,0,145),nil,10))
		ctx.eggPreview(showcase,grandEgg,UDim2.new(0.42,-10,1,-16),UDim2.fromOffset(8,8))
		ctx.left(ctx.label(showcase,("TIER %d"):format(count),ctx.muted,UDim2.new(0.58,-13,0,24),UDim2.new(0.42,6,0,23),12,ctx.digits))
		local caption = ctx.left(ctx.label(showcase,shellName(ctx,grandEgg),ctx.ink,UDim2.new(0.58,-13,0,53),UDim2.new(0.42,6,0,49),18,ctx.heavy))
		caption.TextWrapped = true
	end
	if earned.premium then
		subtitle(ctx,"Premium track unlocked.")
	else
		passButton(ctx,"Preview Premium","season",ctx.season.premiumPassId)
	end
end

function Pages.quests(ctx)
	local profile = ctx.profile
	local installed = profile.quests or {}
	local sections = {daily="Daily",weekly="Weekly",lifetime="Lifetime"}
	local previous
	for _, quest in ipairs(ctx.economy.quests or {}) do
		if previous ~= quest.period then
			title(ctx,sections[quest.period] or quest.period)
			previous = quest.period
		end
		local status = installed[quest.id] or {}
		local progress = math.min(status.progress or 0,quest.goal)
		local reward = ("%d coins · %d Pass XP"):format(quest.coins or 0,quest.xp or 0)
		if quest.carton then reward ..= " · Carton" end
		local card = ctx.append(ctx.frame(ctx.list,ctx.cream,UDim2.new(1,-7,0,80),nil,9))
		ctx.left(ctx.label(card,quest.name,ctx.ink,UDim2.new(1,-20,0,25),UDim2.fromOffset(10,6),15,ctx.heavy))
		local info = if status.claimed then "Claimed" else ("%d/%d  ·  %s"):format(progress,quest.goal,reward)
		ctx.left(ctx.label(card,info,ctx.muted,UDim2.new(1,-20,0,22),UDim2.fromOffset(10,32),11,ctx.digits))
		local bar = ctx.frame(card,rgb("d8caee"),UDim2.new(1,-20,0,7),UDim2.fromOffset(10,62),3)
		ctx.frame(bar,ctx.lime,UDim2.fromScale(progress/quest.goal,1),nil,3)
	end
	longButton(ctx,"Claim completed quests",ctx.yellow,function() ctx.send("quest","claim") end)
end

return Pages
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">SocialUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("EggShared")
local Cosmetics = require(Shared.Cosmetics)
local Egg = require(Shared.EggModel)
local Trophy = require(Shared.TrophyModel)

local SocialUI = {}
local hooks, remote
local party = {members = {}, invites = {}, roster = {}, limit = 5}
local museum, requestedMuseum
local selectedSlot, choosing, pickerPage = 1, false, 1
local viewing, stopGui
local watchConnections = {}

local function notify(message)
	if hooks and hooks.notify then hooks.notify(message) end
end

local function redraw()
	if hooks and hooks.redraw then hooks.redraw() end
end

function SocialUI.request(action, payload)
	if remote then remote:FireServer(action, payload) end
end

function SocialUI.stop()
	if not viewing then return end
	viewing = nil
	for _, connection in watchConnections do connection:Disconnect() end
	table.clear(watchConnections)
	if stopGui then stopGui:Destroy(); stopGui = nil end
	local camera = workspace.CurrentCamera
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if camera and humanoid then camera.CameraSubject = humanoid end
end

local function watch(target)
	if not target then return end
	local character = target.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera
	if not camera or not humanoid or target:GetAttribute("CourseRacing") ~= true then
		notify("That race is over.")
		return
	end
	SocialUI.stop()
	viewing = target
	if hooks.close then hooks.close() end
	camera.CameraSubject = humanoid
	table.insert(watchConnections, target:GetAttributeChangedSignal("CourseRacing"):Connect(function()
		if target:GetAttribute("CourseRacing") ~= true then SocialUI.stop() end
	end))
	table.insert(watchConnections, player:GetAttributeChangedSignal("CourseRacing"):Connect(function()
		if player:GetAttribute("CourseRacing") then SocialUI.stop() end
	end))
	table.insert(watchConnections, target.AncestryChanged:Connect(function()
		if target.Parent ~= Players then SocialUI.stop() end
	end))
	table.insert(watchConnections, target.CharacterRemoving:Connect(SocialUI.stop))
	table.insert(watchConnections, player.CharacterAdded:Connect(SocialUI.stop))

	stopGui = Instance.new("ScreenGui")
	stopGui.Name = "CourierSpectator"
	stopGui.ResetOnSpawn = false
	stopGui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	stopGui.DisplayOrder = 12
	stopGui.Parent = player:WaitForChild("PlayerGui")
	local leave = Instance.new("TextButton")
	leave.Name = "ExitSpectating"
	leave.AnchorPoint = Vector2.new(0.5, 1)
	leave.Position = UDim2.new(0.5, 0, 1, -74)
	leave.Size = UDim2.fromOffset(184, 44)
	leave.BackgroundColor3 = Color3.fromHex("ffcc4a")
	leave.TextColor3 = Color3.fromHex("272054")
	leave.Font = Enum.Font.FredokaOne
	leave.Text = "STOP WATCHING"
	leave.TextSize = 16
	leave.BorderSizePixel = 0
	leave.Parent = stopGui
	Instance.new("UICorner", leave).CornerRadius = UDim.new(0, 12)
	local stroke = Instance.new("UIStroke", leave)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = leave.TextColor3
	stroke.Thickness = 2
	leave.Activated:Connect(SocialUI.stop)
end

function SocialUI.bind(options)
	hooks = options
	if remote then return end
	task.spawn(function()
		remote = Shared:WaitForChild("CourierSocial", 15)
		if not remote then return end
		remote.OnClientEvent:Connect(function(kind, value)
			if kind == "Party" then
				party = value
				redraw()
			elseif kind == "Notice" then
				notify(value)
			elseif kind == "Museum" then
				local nextOwner = museum and museum.owner.id ~= value.owner.id
				museum = value
				if nextOwner then selectedSlot, choosing = 1, false end
				if requestedMuseum and requestedMuseum == value.owner.id then
					requestedMuseum = nil
					hooks.openMuseum()
				else
					redraw()
				end
			elseif kind == "Spectate" then
				watch(Players:GetPlayerByUserId(value))
			end
		end)
		SocialUI.request("refresh")
	end)
end

local function skinName(id)
	local skin = Cosmetics.byId[id]
	return skin and skin.name or id
end

local function badge(parent, id, size, position)
	local image = Instance.new("ImageLabel")
	image.Name = "Avatar portrait"
	image.BackgroundTransparency = 0
	image.BackgroundColor3 = Color3.fromHex("e5caff")
	image.Size = UDim2.fromOffset(size, size)
	image.Position = position
	image.BorderSizePixel = 0
	image.ScaleType = Enum.ScaleType.Crop
	if id > 0 then image.Image = ("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150"):format(id) end
	image.Parent = parent
	Instance.new("UICorner", image).CornerRadius = UDim.new(0, 10)
end

function SocialUI.openMuseum(owner)
	requestedMuseum = owner or player.UserId
	SocialUI.request("museum", owner)
end

local function partyEgg(parent, skin)
	local view = Instance.new("ViewportFrame")
	view.Name = "Equipped egg preview"
	view.BackgroundTransparency = 1
	view.Size = UDim2.fromOffset(51, 48)
	view.Position = UDim2.new(1,-56,0,3)
	view.Ambient = Color3.fromHex("cec0dc")
	view.LightColor = Color3.fromHex("fff7de")
	view.Parent = parent
	local camera = Instance.new("Camera", view)
	camera.CFrame = CFrame.lookAt(Vector3.new(1.15,0.35,-2.65),Vector3.zero)
	camera.FieldOfView = 44
	view.CurrentCamera = camera
	Egg.build(skin, 1.05, true).Parent = view
end

local function renderFriends(ctx)
	local ownGroup = #party.members > 0
	local leader = party.leader == player.UserId
	ctx.listButton("MY EGG MUSEUM", ctx.yellow, ctx.ink, function() SocialUI.openMuseum() end)
	ctx.row(ownGroup and ("Party  %d/%d"):format(#party.members, party.limit) or "Party invites", ctx.ink, 18, ctx.heavy, 30)
	if ownGroup then
		for _, member in party.members do
			local card = ctx.append(ctx.frame(ctx.list, ctx.cream, UDim2.new(1, -8, 0, 55), nil, 8))
			badge(card, member.id, 39, UDim2.fromOffset(8, 8))
			partyEgg(card, member.skin)
			ctx.left(ctx.label(card, member.name .. (member.id == party.leader and "  ·  Leader" or ""), ctx.ink,
				UDim2.new(1, -117, 0, 24), UDim2.fromOffset(56, 4), 15, ctx.heavy))
			ctx.left(ctx.label(card, skinName(member.skin), ctx.muted, UDim2.new(1, -117, 0, 22), UDim2.fromOffset(56, 26), 12))
		end
		if leader then
			local function queue(mode, private)
				SocialUI.request("queue", {mode=mode, course=hooks.currentCourse(), private=private})
			end
			ctx.listButton("QUEUE EGG ROYALE", ctx.yellow, ctx.ink, function() queue("royale", false) end)
			ctx.listButton("QUEUE QUICK RACE", ctx.lime, ctx.ink, function() queue("quick", false) end)
			ctx.listButton("START PRIVATE QUICK RACE", ctx.cream, ctx.ink, function() queue("quick", true) end)
		end
		ctx.listButton("LEAVE PARTY", ctx.cream, ctx.ink, function() SocialUI.request("leave") end)
	end
	for _, invite in party.invites do
		ctx.row(("Invite from %s"):format(invite.name), ctx.ink, 15, ctx.heavy, 26)
		local actions = ctx.append(ctx.frame(ctx.list, nil, UDim2.new(1, -8, 0, 44)))
		local accept = ctx.button(actions, "JOIN PARTY", ctx.lime, ctx.ink, function() SocialUI.request("accept", invite.id) end)
		accept.Size = UDim2.new(0.5, -4, 1, 0)
		local decline = ctx.button(actions, "DECLINE", ctx.cream, ctx.ink, function() SocialUI.request("decline", invite.id) end)
		decline.Size = accept.Size
		decline.Position = UDim2.new(0.5, 4, 0, 0)
	end
	ctx.row("Players in this server", ctx.ink, 17, ctx.heavy, 31)
	if #party.roster == 0 then
		ctx.row("Friends who join this server will appear here.", ctx.muted, 12, nil, 28)
	else
		ctx.row("Invite, watch, or visit Roblox friends in this server.", ctx.muted, 12, nil, 27)
	end
	ctx.listButton("REFRESH PLAYERS", ctx.cream, ctx.ink, function() SocialUI.request("refresh") end)
	for _, candidate in party.roster do
		local target = Players:GetPlayerByUserId(candidate.id)
		if not target then continue end
		local active = target:GetAttribute("CourseRacing") == true
		local card = ctx.append(ctx.frame(ctx.list, ctx.cream, UDim2.new(1, -8, 0, 94), nil, 8))
		badge(card, candidate.id, 38, UDim2.fromOffset(7, 6))
		ctx.left(ctx.label(card, candidate.name, ctx.ink, UDim2.new(1, -64, 0, 21), UDim2.fromOffset(52, 4), 15, ctx.heavy))
		local status = active and "Racing" or "In the lobby"
		ctx.left(ctx.label(card, status .. "  /  " .. skinName(candidate.skin), ctx.muted,
			UDim2.new(1, -64, 0, 19), UDim2.fromOffset(52, 25), 11))
		local isMember = false
		for _, member in party.members do
			if member.id == candidate.id then isMember = true; break end
		end
		local actions = {
			{"MUSEUM", function() SocialUI.openMuseum(candidate.id) end},
		}
		if leader and not isMember and not active then
			table.insert(actions, {"INVITE", function() SocialUI.request("invite", candidate.id) end})
		end
		if active then
			table.insert(actions, {"WATCH", function() SocialUI.request("spectate", candidate.id) end})
		end
		for index, item in actions do
			local action = ctx.button(card, item[1], ctx.paper, ctx.ink, item[2])
			action.Position = UDim2.new((index-1)/#actions, 6, 0, 47)
			action.Size = UDim2.new(1/#actions, -12, 0, 40)
		end
	end
end

local function museumPart(parent, name, color, size, position, shape)
	local part = Instance.new("Part")
	part.Name = name
	part.Color = Color3.fromHex(color)
	part.Size = size
	part.Position = position
	part.Anchored = true
	part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
	if shape then part.Shape = shape end
	part.Parent = parent
	return part
end

local function cylinder(parent, name, color, height, width, position)
	local part = museumPart(parent, name, color, Vector3.new(height, width, width), position, Enum.PartType.Cylinder)
	part.CFrame = CFrame.new(position)*CFrame.Angles(0,0,math.pi/2)
	return part
end

local roomStyles = {
	velvet = {name="Velvet", wall="432b64", floor="674f93", rail="d7a159", pillar="9164ab", pedestal="9064c1"},
	ocean = {name="Ocean", wall="214d67", floor="3c788a", rail="80cce3", pillar="4ea8a7", pedestal="4674a1"},
	sunset = {name="Sunset", wall="7b394f", floor="af6277", rail="f7b568", pillar="d47d77", pedestal="bd606e"},
}

local function display(ctx)
	local style = roomStyles[museum.decoration] or roomStyles.velvet
	local view = Instance.new("ViewportFrame")
	view.Name = "Gallery preview"
	view.Size = UDim2.new(1, -8, 0, 190)
	view.BackgroundColor3 = Color3.fromHex(style.wall)
	view.BorderSizePixel = 0
	view.LightDirection = Vector3.new(-0.7,-1,-0.5)
	view.LightColor = Color3.fromHex("fff0d2")
	view.Ambient = Color3.fromHex("c8c3e8")
	view.Parent = ctx.list
	Instance.new("UICorner", view).CornerRadius = UDim.new(0, 12)
	ctx.append(view)
	local room = Instance.new("WorldModel", view)
	museumPart(room, "Gallery floor", style.floor, Vector3.new(15,0.3,8), Vector3.new(0,-0.16,0.3))
	museumPart(room, "Gallery wall", style.wall, Vector3.new(15,7,0.35), Vector3.new(0,3.5,-4))
	museumPart(room, "Gallery rail", style.rail, Vector3.new(15,0.21,0.14), Vector3.new(0,0.67,-3.74))
	museumPart(room, "Gallery rail", style.rail, Vector3.new(15,0.21,0.14), Vector3.new(0,4.85,-3.74))
	for _, x in {-6, -3.1, 3.1, 6} do
		cylinder(room, "Gallery pillar", style.pillar, 5.1, 0.55, Vector3.new(x,2.55,-3.55))
		museumPart(room, "Gallery lamp", "ffcd82", Vector3.new(0.38,0.38,0.38), Vector3.new(x,4.95,-3.42), Enum.PartType.Ball)
	end
	cylinder(room, "Trophy stand", "7452aa", 1.45, 2.45, Vector3.new(0,0.72,-2.65))
	if museum.championships > 0 then
		local trophy = Trophy.build()
		trophy:PivotTo(CFrame.new(0,1.59,-2.65)*CFrame.Angles(0,math.pi,0))
		trophy.Parent = room
	end
	local medalColors = {gold="fbd269", silver="e1ebfa", bronze="f39058"}
	for i, rank in {"bronze","silver","gold"} do
		local earned = (museum.ribbons[rank] or 0) > 0
		local x = (i-2)*1.05
		local medal = museumPart(room, rank .. " medal", earned and medalColors[rank] or style.wall,
			Vector3.new(0.17,0.58,0.58), Vector3.new(x,4.25,-3.71), Enum.PartType.Cylinder)
		medal.CFrame *= CFrame.Angles(0,-math.pi/2,0)
	end
	for slot = 1, 4 do
		local x = (slot-2.5)*2.85
		local skin = museum.slots[tostring(slot)]
		cylinder(room, "Display pedestal", style.pedestal, 0.72, 2.24, Vector3.new(x,0.36,0.75))
		cylinder(room, "Display rim", selectedSlot == slot and "ffcd65" or "c49be6", 0.12, 2.25, Vector3.new(x,0.78,0.75))
		if skin and Cosmetics.byId[skin] then
			local model = Egg.build(skin, 1.2, true)
			model:PivotTo(CFrame.new(x,1.73,0.75)*CFrame.Angles(0,math.pi+0.2,0))
			model.Parent = room
		end
	end
	local camera = Instance.new("Camera", view)
	camera.FieldOfView = 39
	camera.CFrame = CFrame.lookAt(Vector3.new(0,5.42,17.6),Vector3.new(0,1.8,0))
	view.CurrentCamera = camera
end

local function chooseEgg(ctx)
	local choices = {}
	local profile = ctx.profile or {}
	for id, owned in profile.skins or {} do
		if owned and Cosmetics.byId[id] then table.insert(choices, id) end
	end
	local favorites = profile.favorites or {}
	table.sort(choices, function(a, b)
		local aFavorite, bFavorite = favorites[a] == true, favorites[b] == true
		if aFavorite ~= bFavorite then return aFavorite end
		return skinName(a) < skinName(b)
	end)
	local pages = math.max(1, math.ceil(#choices/5))
	pickerPage = math.clamp(pickerPage, 1, pages)
	for i = (pickerPage-1)*5+1, math.min(pickerPage*5,#choices) do
		local skin = choices[i]
		ctx.listButton(skinName(skin) .. (favorites[skin] and "  ★" or ""), ctx.cream, ctx.ink, function()
			choosing = false
			SocialUI.request("pedestal", {slot=selectedSlot, skin=skin})
		end)
	end
	if pages > 1 then
		ctx.listButton(("MORE EGGS  %d/%d"):format(pickerPage, pages), ctx.cream, ctx.ink, function()
			pickerPage = pickerPage%pages+1
			redraw()
		end)
	end
end

local function renderMuseum(ctx)
	if not museum then
		ctx.listButton("OPEN MY EGG MUSEUM", ctx.yellow, ctx.ink, function() SocialUI.openMuseum() end)
		return
	end
	ctx.row(museum.editable and "Your Egg Museum" or museum.owner.name .. "’s Egg Museum", ctx.ink, 19, ctx.heavy, 30)
	display(ctx)
	ctx.row(("%d titles  /  %d medals  /  %d PBs"):format(museum.championships,museum.medals,museum.records), ctx.ink, 13, ctx.heavy, 28)
	ctx.row(("%d complete collections"):format(museum.collections), ctx.muted, 12, nil, 22)
	local pedestals = ctx.append(ctx.frame(ctx.list, nil, UDim2.new(1, -8, 0, 44)))
	for slot = 1, 4 do
		local picker = ctx.button(pedestals, ("SLOT %d"):format(slot), slot == selectedSlot and ctx.yellow or ctx.cream, ctx.ink, function()
			selectedSlot, choosing, pickerPage = slot, false, 1
			redraw()
		end)
		picker.Size = UDim2.new(0.25, -4, 1, 0)
		picker.Position = UDim2.new((slot-1)/4, 2, 0, 0)
	end
	local current = museum.slots[tostring(selectedSlot)]
	ctx.row(current and skinName(current) or "Empty pedestal", ctx.ink, 15, ctx.heavy, 25)
	if museum.editable then
		ctx.listButton(choosing and "CANCEL" or "CHOOSE EGG FOR THIS SLOT", ctx.lime, ctx.ink, function()
			choosing, pickerPage = not choosing, 1
			redraw()
		end)
		if choosing then chooseEgg(ctx) end
		if not choosing then
			local nextStyle = if museum.decoration == "velvet" then "ocean" elseif museum.decoration == "ocean" then "sunset" else "velvet"
			ctx.listButton("GALLERY DECOR · " .. roomStyles[museum.decoration].name, ctx.cream, ctx.ink, function()
				SocialUI.request("decorate", nextStyle)
			end)
		end
		if current then
			ctx.listButton("CLEAR SLOT", ctx.cream, ctx.ink, function()
				choosing = false
				SocialUI.request("pedestal", {slot=selectedSlot, skin=""})
			end)
		end
	else
		ctx.listButton("MY EGG MUSEUM", ctx.yellow, ctx.ink, function() SocialUI.openMuseum() end)
	end
end

function SocialUI.render(page, ctx)
	if page == "Museum" then renderMuseum(ctx) else renderFriends(ctx) end
end

return SocialUI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="34">
